{
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "none",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["**/*.md", "**/*.mdx"],
      "options": {
        "proseWrap": "always"
      }
    }
  ],
  "ignorePatterns": [
    "**/*.astro",
    "**/.astro/**",
    "**/.turbo/**",
    "**/@generated/**",
    "**/coverage/**",
    "**/dist/**",
    "**/generated/**",
    "**/node_modules/**",
    "**/pnpm-lock.yaml",
    "apps/cli/starter-projects/**",
    "apps/docs/content/**",
    "packages/config/src/**"
  ]
}
