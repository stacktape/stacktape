{
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "none",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/*.astro",
    "**/.astro/**",
    "**/.turbo/**",
    "**/@generated/**",
    "**/coverage/**",
    "**/dist/**",
    "**/generated/**",
    "**/node_modules/**",
    "**/pnpm-lock.yaml",
    "apps/cli/starter-projects/**",
    "apps/docs/content/**",
    "packages/config/src/**"
  ]
}
