{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "console-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:console:ui"],
      "port": 4000
    },
    {
      "name": "website",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:website"],
      "port": 9002
    },
    {
      "name": "website-studies",
      "runtimeExecutable": "node",
