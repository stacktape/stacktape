{
  "description": "An HTTP API that reaches containers through a VPC link, next to a blue/green web service behind an application load balancer and one behind a network load balancer.",
  "config": "resources:\n  api:\n    type: http-api-gateway\n  app:\n    type: multi-container-workload\n    properties:\n      containers:\n        - name: server\n          packaging:\n            type: prebuilt-image\n            properties:\n              image: example.invalid/app:v1\n          events:\n            - type: http-api-gateway\n              properties:\n                httpApiGatewayName: api\n                containerPort: 8080\n                method: '*'\n                path: /{proxy+}\n      resources:\n        cpu: 0.25\n        memory: 512\n  albWeb:\n    type: web-service\n    properties:\n      packaging:\n        type: prebuilt-image\n        properties:\n          image: example.invalid/app:v1\n      resources:\n        cpu: 0.25\n        memory: 512\n      loadBalancing:\n        type: application-load-balancer\n      deployment:\n        strategy: Canary10Percent5Minutes\n  tcpWeb:\n    type: web-service\n    properties:\n      packaging:\n        type: prebuilt-image\n        properties:\n          image: example.invalid/app:v1\n      resources:\n        cpu: 0.25\n        memory: 512\n      loadBalancing:\n        type: network-load-balancer\n        properties:\n          ports:\n            - port: 5000\n              protocol: TCP\n",
  "stacktapeResources": [
    {
      "name": "app",
      "type": "multi-container-workload",
      "logicalIds": [
        "AppApiToPort8080Integration",
        "AppCluster",
        "AppPort8080DiscoveryService",
        "AppRole",
        "AppScalableTarget",
        "AppSecurityGroup",
        "AppServerLogGroup",
        "AppService",
        "AppTaskDefinition",
        "StpApiAnyProxyRoute"
      ]
    },
    {
      "name": "api",
      "type": "http-api-gateway",
      "logicalIds": [
        "ApiApi",
        "ApiApiMapping",
        "ApiDefaultDomainCustomResource",
        "ApiDomainName",
        "ApiLogGroup",
        "ApiStage",
        "ApiVpcLink",
        "ApiVpcLinkSecurityGroup"
      ]
    },
    {
      "name": "albWeb",
      "type": "web-service",
      "logicalIds": [
        "AlbWebAlbWebToPort3000BgTargetGroup",
        "AlbWebAlbWebToPort3000TargetGroup",
        "AlbWebBlueGreenService",
        "AlbWebCluster",
        "AlbWebDefaultDomainCustomResource",
        "AlbWebDeploymentGroup",
        "AlbWebDeregisterTargetsCustomResource",
        "AlbWebLbSecurityGroup",
