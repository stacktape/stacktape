        "WebLogGroup",
        "WebPort3000DiscoveryService",
        "WebRole",
        "WebScalableTarget",
        "WebSecurityGroup",
        "WebService",
        "WebServiceContainerLogGroup",
        "WebStage",
        "WebTaskDefinition",
        "WebVpcLink",
        "WebVpcLinkSecurityGroup",
        "WebWebToPort3000Integration"
      ]
    }
  ],
