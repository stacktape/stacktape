    "StacktapeServiceLambdaCustomResourceFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "security-fixture-stpService-CR",
        "Architectures": [
          "x86_64"
        ],
        "Code": {
          "S3Key": "stacktapeServiceLambda/v000001-characterization.zip",
          "S3Bucket": "stp-deployment-bucket-7e618203"
        },
        "Handler": "index.default",
        "MemorySize": 2048,
        "Timeout": 900,
        "Environment": {
          "Variables": {
            "AWS_PARTITION": {
              "Ref": "AWS::Partition"
            },
            "AWS_ACCOUNT_ID": {
              "Ref": "AWS::AccountId"
            },
            "STACK_NAME": "security-fixture",
            "PROJECT_NAME": "security",
            "STAGE": "fixture",
            "GLOBALLY_UNIQUE_STACK_HASH": "7e618203",
            "STACKTAPE_TRPC_API_ENDPOINT": "https://api.stacktape.com",
            "NODE_OPTIONS": "--enable-source-maps",
            "ISSUE_MAX_ERRORS_PER_INVOCATION": "20",
            "ISSUE_MAX_CONTEXT_FETCHES_PER_INVOCATION": "5",
            "ISSUE_MAX_LOG_AGE_MS": "600000"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "StacktapeServiceLambdaRole",
            "Arn"
          ]
        },
        "Runtime": "nodejs22.x",
        "Tags": [
          {
            "Key": "stp:code-digest",
            "Value": "characterization"
          },
          {
            "Key": "stp:stack-name",
            "Value": "security-fixture"
          },
          {
            "Key": "stp:project-name",
            "Value": "security"
          },
          {
            "Key": "stp:stage",
            "Value": "fixture"
          },
          {
            "Key": "stp:globally-unique-stack-hash",
            "Value": "7e618203"
          }
        ]
      },
      "DependsOn": [
        "StacktapeServiceLambdaRole",
        "StacktapeServiceLambdaLogGroup"
      ]
    },
    "StpStpCustomTaggingScheduleRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "State": "ENABLED",
        "ScheduleExpression": "rate(2 hours)",
        "Targets": [
          {
            "Input": {
              "Fn::Sub": [
                "{\"tagHostedZoneAttributedToCloudMapNamespace\":[{\"attributionCfResourceLogicalName\":\"StpDiscoveryService\",\"namespaceId\":\"${sub0}\"}],\"tagNetworkInterfaceWithSecurityGroup\":[{\"securityGroupId\":\"${sub1}\",\"attributionCfResourceLogicalName\":\"PublicDbDbSubnetGroup\"},{\"securityGroupId\":\"${sub2}\",\"attributionCfResourceLogicalName\":\"VpcDbDbSubnetGroup\"},{\"securityGroupId\":\"${sub3}\",\"attributionCfResourceLogicalName\":\"ScopedDbDbSubnetGroup\"}]}",
                {
                  "sub0": {
                    "Fn::GetAtt": [
                      "StpDiscoveryService",
                      "Id"
                    ]
                  },
                  "sub1": {
                    "Ref": "PublicDbSecurityGroup"
                  },
                  "sub2": {
                    "Ref": "VpcDbSecurityGroup"
                  },
                  "sub3": {
                    "Ref": "ScopedDbSecurityGroup"
                  }
                }
              ]
            },
            "Arn": {
              "Fn::GetAtt": [
                "StacktapeServiceLambdaCustomResourceFunction",
                "Arn"
              ]
            },
            "Id": "scheduledService"
          }
        ]
      }
    },
    "StpStpCustomTaggingScheduleRulePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "FunctionName": {
          "Fn::GetAtt": [
            "StacktapeServiceLambdaCustomResourceFunction",
            "Arn"
          ]
        },
        "SourceArn": {
          "Fn::GetAtt": [
            "StpStpCustomTaggingScheduleRule",
            "Arn"
          ]
        }
      }
    },
