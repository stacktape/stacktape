{
  "description": "A private service behind an internal load balancer, a worker in private subnets with a NAT gateway, scoped Redis and EFS mounted by the worker.",
  "config": "stackConfig:\n  nat: gateway\nresources:\n  internalApi:\n    type: private-service\n    properties:\n      packaging:\n        type: prebuilt-image\n        properties:\n          image: example.invalid/app:v1\n      resources:\n        cpu: 0.25\n        memory: 512\n      port: 3000\n      loadBalancing:\n        type: application-load-balancer\n  worker:\n    type: worker-service\n    properties:\n      packaging:\n        type: prebuilt-image\n        properties:\n          image: example.invalid/app:v1\n      resources:\n        cpu: 0.25\n        memory: 512\n      usePrivateSubnetsWithNAT: true\n      connectTo: [cache]\n      volumeMounts:\n        - type: efs\n          properties:\n            efsFilesystemName: files\n            mountPath: /data\n  cache:\n    type: redis\n    properties:\n      engine:\n        type: valkey\n        properties:\n          instanceSize: cache.t4g.micro\n      defaultUserPassword: synthetic-redis-password\n      accessibility:\n        accessibilityMode: scoping-workloads-in-vpc\n  files:\n    type: efs-filesystem\n",
  "stacktapeResources": [
    {
      "name": "cache",
      "type": "redis",
      "logicalIds": [
        "CacheLogGroup",
        "CacheParameterGroup",
        "CacheReplicationGroup",
        "CacheSecurityGroup",
        "CacheSubnetGroup"
      ]
    },
    {
      "name": "internalApi",
      "type": "private-service",
      "logicalIds": [
        "InternalApiCluster",
        "InternalApiDefaultDomainCustomResource",
        "InternalApiDeregisterTargetsCustomResource",
        "InternalApiInternalApiToPort3000TargetGroup",
        "InternalApiLbSecurityGroup",
        "InternalApiLoadBalancer",
        "InternalApiPort3000Listener",
        "InternalApiPort3000Priority3ListenerRule",
        "InternalApiRole",
        "InternalApiScalableTarget",
        "InternalApiSecurityGroup",
        "InternalApiService",
        "InternalApiServiceContainerLogGroup",
        "InternalApiTaskDefinition"
      ]
    },
    {
      "name": "worker",
      "type": "worker-service",
      "logicalIds": [
        "WorkerCluster",
        "WorkerFilesRootAccessPoint",
        "WorkerRole",
        "WorkerScalableTarget",
        "WorkerSecurityGroup",
        "WorkerService",
        "WorkerServiceContainerLogGroup",
        "WorkerTaskDefinition"
      ]
    },
