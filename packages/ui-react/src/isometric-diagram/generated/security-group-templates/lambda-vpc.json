  "config": "resources:\n  search:\n    type: function\n    properties:\n      packaging:\n        type: js-bundle\n        properties:\n          entryfilePath: handler.ts\n      joinDefaultVpc: true\n      connectTo: [searchDomain, cache]\n  indexer:\n    type: function\n    properties:\n      packaging:\n        type: js-bundle\n        properties:\n          entryfilePath: handler.ts\n      joinDefaultVpc: true\n      connectTo: [searchDomain, cache]\n  plain:\n    type: function\n    properties:\n      packaging:\n        type: js-bundle\n        properties:\n          entryfilePath: handler.ts\n      joinDefaultVpc: true\n  searchDomain:\n    type: open-search-domain\n    properties:\n      clusterConfig:\n        instanceType: t3.small.search\n        instanceCount: 1\n      storage:\n        size: 10\n      accessibility:\n        accessibilityMode: vpc\n  cache:\n    type: redis\n    properties:\n      engine:\n        type: valkey\n        properties:\n          instanceSize: cache.t4g.micro\n      defaultUserPassword: synthetic-redis-password\n      accessibility:\n        accessibilityMode: scoping-workloads-in-vpc\n",
