{
  "name": "@stacktape/ui-react",
  "version": "4.0.0-dev.0",
  "private": true,
  "description": "Reusable React controls and product UI shared by Stacktape applications.",
  "type": "module",
  "exports": {
    "./alert": {
      "types": "./dist/alert/Alert.d.ts",
      "default": "./dist/alert/Alert.js"
    },
    "./badge": {
      "types": "./dist/badge/Badge.d.ts",
      "default": "./dist/badge/Badge.js"
    },
    "./button": {
      "types": "./dist/button/Button.d.ts",
      "default": "./dist/button/Button.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/Checkbox.d.ts",
      "default": "./dist/checkbox/Checkbox.js"
    },
    "./config-editor": {
      "types": "./dist/config-editor/ConfigEditor.d.ts",
      "default": "./dist/config-editor/ConfigEditor.js"
    },
    "./config-editor.css": "./src/config-editor/config-editor.css",
    "./config-editor/capabilities": {
      "types": "./dist/config-editor/capabilities.d.ts",
      "default": "./dist/config-editor/capabilities.js"
    },
    "./config-editor/document": {
      "types": "./dist/config-editor/document.d.ts",
      "default": "./dist/config-editor/document.js"
    },
    "./config-editor/paths": {
      "types": "./dist/config-editor/paths.d.ts",
      "default": "./dist/config-editor/paths.js"
    },
    "./dialog": {
      "types": "./dist/dialog/Dialog.d.ts",
      "default": "./dist/dialog/Dialog.js"
    },
    "./framework-icon": {
      "types": "./dist/framework-icon/FrameworkIcon.d.ts",
      "default": "./dist/framework-icon/FrameworkIcon.js"
    },
    "./grid-list": {
      "types": "./dist/grid-list/GridList.d.ts",
      "default": "./dist/grid-list/GridList.js"
    },
    "./icon-button": {
      "types": "./dist/icon-button/IconButton.d.ts",
      "default": "./dist/icon-button/IconButton.js"
    },
    "./isometric-diagram": {
      "types": "./dist/isometric-diagram/IsometricDiagram.d.ts",
      "default": "./dist/isometric-diagram/IsometricDiagram.js"
    },
    "./isometric-diagram.css": "./src/isometric-diagram/isometric-diagram.css",
    "./isometric-diagram/fixtures": {
      "types": "./dist/isometric-diagram/fixtures.d.ts",
      "default": "./dist/isometric-diagram/fixtures.js"
    },
    "./linear-loader": {
      "types": "./dist/linear-loader/LinearLoader.d.ts",
      "default": "./dist/linear-loader/LinearLoader.js"
    },
    "./link": {
      "types": "./dist/link/Link.d.ts",
      "default": "./dist/link/Link.js"
    },
    "./monaco-editor": {
      "types": "./dist/monaco-editor/MonacoEditor.d.ts",
      "default": "./dist/monaco-editor/MonacoEditor.js"
    },
    "./progress": {
      "types": "./dist/progress/Progress.d.ts",
      "default": "./dist/progress/Progress.js"
    },
    "./radio-group": {
      "types": "./dist/radio-group/RadioGroup.d.ts",
      "default": "./dist/radio-group/RadioGroup.js"
    },
    "./resource-icon": {
      "types": "./dist/resource-icon/ResourceIcon.d.ts",
      "default": "./dist/resource-icon/ResourceIcon.js"
    },
    "./resource-icon/catalog": {
      "types": "./dist/resource-icon/catalog.d.ts",
      "default": "./dist/resource-icon/catalog.js"
    },
    "./section-loader": {
      "types": "./dist/section-loader/SectionLoader.d.ts",
      "default": "./dist/section-loader/SectionLoader.js"
    },
    "./select": {
      "types": "./dist/select/Select.d.ts",
      "default": "./dist/select/Select.js"
    },
    "./selection-card": "./src/selection-card/SelectionCard.tsx",
    "./spinner": {
      "types": "./dist/spinner/Spinner.d.ts",
      "default": "./dist/spinner/Spinner.js"
    },
    "./styles.css": "./src/styles.css",
    "./switch": {
      "types": "./dist/switch/Switch.d.ts",
      "default": "./dist/switch/Switch.js"
    },
    "./tabs": {
      "types": "./dist/tabs/Tabs.d.ts",
      "default": "./dist/tabs/Tabs.js"
    },
    "./text-field": {
      "types": "./dist/text-field/TextField.d.ts",
      "default": "./dist/text-field/TextField.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/Tooltip.d.ts",
      "default": "./dist/tooltip/Tooltip.js"
    }
  },
  "scripts": {
    "copy:assets": "node scripts/copy-assets.ts",
    "prebuild": "pnpm run copy:assets",
    "predev": "pnpm run copy:assets",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.isometric-diagram.build.json",
    "dev": "pnpm run --parallel \"/^dev:(base|isometric-diagram)$/\"",
    "dev:base": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:isometric-diagram": "tsc -p tsconfig.isometric-diagram.build.json --watch --preserveWatchOutput",
    "test": "bun test src",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.isometric-diagram.json"
  },
  "dependencies": {
    "@isoflow/isopacks": "^0.0.10",
    "@stacktape/config": "workspace:*",
    "@stacktape/design-tokens": "workspace:*",
    "@tippyjs/react": "^4.2.6",
    "aws-react-icons": "^2.1.1",
    "monaco-types": "^0.1.0",
    "react-icons": "^5.5.0",
    "react-select": "^5.10.2",
    "thinking-orbs": "0.2.0",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "monaco-editor": "0.43.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
