{
  "name": "@stacktape/ui-react",
  "version": "4.0.0-dev.0",
  "private": true,
  "description": "Reusable React controls and product UI shared by Stacktape applications.",
  "type": "module",
  "exports": {
    "./button": {
      "types": "./dist/button.d.ts",
      "default": "./dist/button.js"
    },
    "./icon-button": {
      "types": "./dist/icon-button.d.ts",
      "default": "./dist/icon-button.js"
    },
    "./code-editor": {
      "types": "./dist/code-editor/CodeEditor.d.ts",
      "default": "./dist/code-editor/CodeEditor.js"
    },
    "./config-editor/diagram": {
      "types": "./dist/config-editor/diagram/ConfigDiagram.d.ts",
      "default": "./dist/config-editor/diagram/ConfigDiagram.js"
    },
    "./config-editor/diagram/fixtures": {
      "types": "./dist/config-editor/diagram/fixtures.d.ts",
      "default": "./dist/config-editor/diagram/fixtures.js"
    },
    "./config-editor/diagram.css": "./src/config-editor/diagram/diagram.css",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.diagram.build.json",
    "dev": "pnpm run --parallel \"/^dev:(base|diagram)$/\"",
    "dev:base": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:diagram": "tsc -p tsconfig.diagram.build.json --watch --preserveWatchOutput",
    "test": "bun test src",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.diagram.json"
  },
  "dependencies": {
    "@isoflow/isopacks": "^0.0.10",
    "@stacktape/config": "workspace:*",
    "@stacktape/design-tokens": "workspace:*",
    "monaco-types": "^0.1.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "monaco-editor": "0.43.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
