{
  "name": "@stacktape/cloudformation",
  "version": "4.0.0-dev.0",
  "private": true,
  "description": "Typed, plain-object CloudFormation resources and intrinsic functions used by Stacktape synthesis and configuration authoring.",
  "type": "module",
  "exports": {
    "./intrinsics": "./src/intrinsics.ts",
    "./resource": "./src/resource.ts",
    "./resource-types": "./generated/resource-types.ts",
    "./resources/*": "./generated/resources/*.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "generate:check": "node scripts/generate.ts --check",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json"
  },
  "devDependencies": {
    "@aws-cdk/aws-service-spec": "0.1.199",
    "@aws-cdk/service-spec-types": "0.0.265",
    "@types/node": "catalog:",
    "bun-types": "^1.3.2",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
