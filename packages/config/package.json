{
  "name": "@stacktape/config",
  "version": "4.0.0-dev.0",
  "private": true,
  "description": "The user-authored Stacktape configuration language: the resource model, its CloudFormation escape hatch and the primitives the published config schema is generated from.",
  "type": "module",
  "exports": {
    ".": "./src/config.ts",
    "./config-schema.json": "./generated/config-schema.json",
    "./shared": "./src/shared.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "@stacktape/cloudformation": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "^1.3.2",
    "typescript": "catalog:"
  }
}
