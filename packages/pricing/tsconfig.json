{
  "extends": "../../tsconfig.package.json",
  "include": ["src", "scripts"],
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "module": "preserve",
    "moduleResolution": "bundler",
    "noImplicitReturns": true,
