{
  "name": "@stacktape/init-ui",
  "version": "4.0.0-dev.0",
  "private": true,
  "description": "The browser wizard for `stacktape init`. Builds to static assets embedded in the CLI, served from a localhost server for one session.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "dev": "vite",
    "test": "bun test src",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "pnpm run typecheck:e2e && turbo run build --filter=@stacktape/init-ui && playwright test",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@stacktape/config-inference": "workspace:*",
    "@stacktape/console-api": "workspace:*",
    "@stacktape/design-tokens": "workspace:*",
    "@stacktape/ui-react": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@stacktape/config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24"
  }
}
