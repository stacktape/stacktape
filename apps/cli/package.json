{
  "name": "@stacktape/cli",
  "version": "4.0.0-dev.0",
  "private": true,
  "description": "Stacktape CLI: the developer-facing application that packages, synthesizes and deploys Stacktape projects.",
  "exports": {
    "./catalogs/aws-prices.json": "./@generated/aws-price/prices.json",
    "./catalogs/cloudformation-resource-types.json": "./@generated/cloudformation-resource-types.json",
    "./catalogs/rds-engine-versions.json": "./@generated/db-engine-versions/versions.json",
    "./local/server": "./src/api/local/server.ts",
    "./local/config-sdk": "./src/api/local/config-sdk.ts",
    "./monaco-declarations/cloudformation.d.ts": "./generated/monaco-declarations/cloudformation.d.ts",
    "./monaco-declarations/index.d.ts": "./generated/monaco-declarations/index.d.ts",
    "./monaco-declarations/plain.d.ts": "./generated/monaco-declarations/plain.d.ts",
    "./monaco-declarations/types.d.ts": "./generated/monaco-declarations/types.d.ts",
    "./starter-projects-metadata.json": "./starter-projects-metadata.json"
  },
  "scripts": {
    "analyze:bundle": "bun scripts/analyze-bundle.ts",
    "build": "bun scripts/build-npm.ts",
    "build:dist": "bun scripts/build-dist-package.ts",
    "build:npm": "bun --max_old_space_size=32768 scripts/build-npm.ts",
    "build:npm:main": "bun --max_old_space_size=32768 scripts/build-npm-main-export.ts",
    "clean": "rimraf __stacktape-dist __source-maps __publish-folder .stacktape __starter-projects __binary-dist __release __release-npm __platform-packages",
    "compile:cf:schema": "bun scripts/compile-cf-schema.ts",
    "dev": "bun run scripts/dev.ts",
    "docker:clean": "docker system prune --all --force --volumes",
    "esp": "bun scripts/execute-starter-project.ts",
    "generate": "bun scripts/generate-starter-projects-metadata.ts && bun scripts/generate-schemas.ts",
    "generate:check": "bun scripts/generate-starter-projects-metadata.ts --check",
    "generate:llm-docs": "bun scripts/enhance-config-schema.ts && bun scripts/generate-llm-docs.ts",
    "generate:monaco": "bun scripts/generate-monaco-declarations.ts",
    "generate:monaco:check": "bun scripts/generate-monaco-declarations.ts --check",
    "gen:cf:types": "bun scripts/generate-cloudformation-types.ts",
    "gen:cloudform": "bun scripts/generate-cloudform.ts",
    "gen:db:engines": "bun scripts/generate-db-engine-versions-json.ts",
    "gen:llm-docs": "bun run generate:llm-docs",
    "gen:pack:builders": "bun scripts/generate-pack-builders-json.ts",
    "gen:price:info": "bun scripts/generate-static-aws-price-info.ts",
    "gen:res:descriptions": "bun scripts/generate-resource-descriptions.ts",
    "gen:schema": "bun scripts/generate-schemas.ts",
    "gen:sp": "bun scripts/generate-starter-project.ts",
    "gen:sp:metadata": "bun scripts/generate-starter-projects-metadata.ts",
    "lint:gen:sp": "bun scripts/lint-generated-starter-projects.ts",
    "pkg:hl": "bun scripts/package-helper-lambdas.ts",
    "publish:install:scripts": "bun scripts/publish-install-scripts.ts",
    "publish:llm:docs": "bun scripts/publish-llm-docs.ts",
    "publish:schemas": "bun scripts/publish-schemas.ts",
    "push:gh:repo": "bun scripts/push-to-github-repo.ts",
    "push:starters": "bun scripts/push-starter-projects.ts",
    "release:checksums": "bun scripts/release/checksums.ts",
    "rm:temp": "rimraf .stacktape",
    "stp": "stacktape",
    "test": "bun run test:characterization && bun run test:config-unit && bun run test:generators && bun run test:starter-projects && bun run test:command-safety && bun run test:docker-secrets && bun run test:release-security && bun run test:mcp-docs && bun run test:helper-lambdas && bun run test:characterization:helper-lambdas && bun run test:cli-smoke",
    "test:characterization": "bun test tests/characterization",
    "test:characterization:helper-lambdas": "bun run pkg:hl && bun scripts/verify-helper-lambda-artifacts.ts",
    "test:characterization:npm": "bun run test:release-artifact",
    "test:cli-smoke": "bun scripts/verify-cli-smoke.ts",
    "test:config-unit": "bun test src/api/npm/ts/config.spec.ts src/utils/directives.spec.ts",
    "test:command-safety": "bun test src/domain/debug-services/aws-read-only-operations.spec.ts",
    "test:docker-secrets": "bun test src/utils/__tests__/docker-secret-handling.test.ts",
    "test:generated-types": "node ../../node_modules/typescript/bin/tsc -p @generated/tsconfig.json",
    "test:generators": "bun test scripts/generate-cloudform.spec.ts scripts/generate-cloudformation-types.spec.ts scripts/generate-starter-projects-metadata.spec.ts scripts/generate-llm-docs.spec.ts scripts/cloudform-root-helpers.spec.ts scripts/code-generation/jsdoc-extractor.spec.ts scripts/code-generation/resource-overrides.spec.ts scripts/code-generation/type-properties.spec.ts scripts/build-npm-declarations.spec.ts scripts/verify-npm-declarations.spec.ts scripts/tsconfig-projects.spec.ts",
    "test:llm-docs": "bun test scripts/generate-llm-docs.spec.ts",
    "test:floci:feasibility": "bun scripts/floci/feasibility-spike.ts",
    "test:helper-lambdas": "bun test helper-lambdas/ src/utils/helper-lambdas.spec.ts",
    "test:mcp-docs": "bun test src/commands/mcp",
    "test:mcp-production": "bun scripts/test-mcp-production-eval.ts",
    "test:mcp-smoke": "bun scripts/test-mcp-smoke.ts",
    "test:npm-declarations": "bun scripts/verify-npm-declarations.ts",
    "test:release-artifact": "bun scripts/verify-release-artifact.ts",
    "test:release-security": "bun test scripts/release/checksums.spec.ts scripts/release-workflow.spec.ts scripts/platform-runtime.spec.ts src/api/npm/bin/stacktape.spec.ts scripts/install-scripts/checksums.spec.ts",
    "test:starter-projects": "bun test scripts/starter-projects src/commands/init/using-starter-project/utils.spec.ts",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json && node ../../node_modules/typescript/bin/tsc -p tests/tsconfig.json && node ../../node_modules/typescript/bin/tsc -p _test-stacks/config-loading-smoke/tsconfig.json && node ../../node_modules/typescript/bin/tsc -p _test-stacks/packaging-smoke/tsconfig.json && node ../../node_modules/typescript/bin/tsc -p @generated/tsconfig.json"
  },
