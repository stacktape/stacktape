exports[`help for defaults set 1`] = `
"Usage: stacktape defaults set [key] [value] [options]

Sets system-wide default arguments for Stacktape commands.

Arguments:
  key                       Default setting to update: region, stage, profile, project, aws-account, api-key, executable-python or executable-javascript.
  value                     New value for the selected default setting.

Options:
      --key <value>                Default setting to update: region, stage, profile, project, aws-account, api-key, executable-python or executable-javascript.
      --value <value>              New value for the selected default setting.

Global options:
  -h, --help               Show help for a command or group
  -v, --version            Print the CLI version
      --json               Emit NDJSON (does not confirm operations)
      --debug              Show debug messages
      --quiet              Show errors only
      --log-level <level>  info, debug, error; quiet wins, otherwise last flag wins

Documentation: https://docs.stacktape.com/cli/"
`;
