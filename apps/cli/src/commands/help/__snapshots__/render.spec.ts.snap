exports[`help for dev 1`] = `
"Usage: stacktape dev [options]

Runs your application locally for development and debugging.

Commands:
  dev stop                  Stops a running dev agent.

Options:
  -p, --profile <value>            The AWS profile to use for the command. You can manage profiles using the aws-profile:* commands and set a default profile with defaults set.
      --aws-account <value>        The name of the AWS account to use for the operation. The account must first be connected in the [Stacktape Console](https://console.stacktape.com/aws-accounts).
  -s, --stage <name>               The stage for the operation (e.g., production, staging, dev-john). You can set a default stage using the defaults set command. The maximum length is 12 characters. (required)
  -r, --region <value>             The AWS region for the operation. For a list of available regions, see the [AWS documentation](https://docs.aws.amazon.com/general/latest/gr/rande.html). (required unless set in the config)
      --project <value>            The name of the Stacktape project for this operation. (default: from the config)
  -c, --config <value>             The path to your Stacktape configuration file, relative to the current working directory.
      --cwd <value>                The working directory for the operation. All file paths in your configuration will be resolved relative to this directory. By default, this is the directory containing the configuration file.
      --watch                      If true, watches for changes to your source files and automatically re-executes the compute resource when a change is detected.
      --no-emulation               Disables the automatic injection of parameters and credentials during local emulation. Use this flag if you want to run a compute resource locally that has not yet been deployed.
      --keep-temp-files            If true, preserves the temporary files generated by the operation, such as the CloudFormation template and packaged resources. These files are saved to .stacktape/[invocation-id].
      --docker-args <value>        Additional arguments to pass to the docker run or docker build commands.
      --no-tunnel                  Disables automatic tunneling for Lambda functions. Stacktape creates tunnels (using bore.pub) so that AWS Lambda functions can reach your locally emulated databases. Use this flag if you don't need Lambda-to-local connectivity or if tunneling causes issues.
      --remote-resources <value>   Databases and Redis run locally by default. Use this flag to connect selected resources to their deployed AWS counterparts instead. Useful when you need to test against real data or when local emulation is insufficient. Examples: --remote-resources myDb, --remote-resources postgres,redis.
      --resources <value>          Specify which resources to run in dev mode. Can include workloads (containers, functions) and databases. If not provided, an interactive picker is shown. Use all to run all resources without prompting. Examples: --resources myApi, --resources myApi,myDb, or --resources all.
      --skip-resources <value>     Exclude specified resources from dev mode. All other compatible resources will run. Useful when you want to run most resources but exclude a few. Examples: --skip-resources myHeavyDb, --skip-resources fn1,fn2.
      --fresh-db                   If true, deletes existing local database data before starting. Use this to start with a clean database state.

Global options:
  -h, --help               Show help for a command or group
  -v, --version            Print the CLI version
      --json               Emit NDJSON (does not confirm operations)
      --debug              Show debug messages
      --quiet              Hide progress, banners and hints; output, warnings and errors stay
      --log-level <level>  info, debug or error

Documentation: https://docs.stacktape.com/cli/"
`;

exports[`help for dev stop 1`] = `
"Usage: stacktape dev stop [options]

Stops a running dev agent.

Options:
  -p, --profile <value>            The AWS profile to use for the command. You can manage profiles using the aws-profile:* commands and set a default profile with defaults set.
      --aws-account <value>        The name of the AWS account to use for the operation. The account must first be connected in the [Stacktape Console](https://console.stacktape.com/aws-accounts).
      --cleanup-containers         Finds and removes orphaned Stacktape dev containers (containers whose dev agent is no longer running). Use this to clean up containers left behind after a crash or improper shutdown.

Global options:
  -h, --help               Show help for a command or group
  -v, --version            Print the CLI version
      --json               Emit NDJSON (does not confirm operations)
      --debug              Show debug messages
      --quiet              Hide progress, banners and hints; output, warnings and errors stay
      --log-level <level>  info, debug or error

Documentation: https://docs.stacktape.com/cli/"
`;

exports[`help for mcp 1`] = `
"Usage: stacktape mcp [options]

Starts the local Stacktape MCP (Model Context Protocol) server for coding agents.

Commands:
  mcp add                   Connects your coding agents to Stacktape: Claude Code, Codex, Cursor, VS Code (GitHub Copilot), GitHub Copilot CLI, Windsurf and OpenCode.
  mcp remove                Removes the user-level Stacktape MCP server entry that stacktape mcp add added to your coding agents.

Options:

Global options:
  -h, --help               Show help for a command or group
  -v, --version            Print the CLI version
      --json               Emit NDJSON (does not confirm operations)
      --debug              Show debug messages
      --quiet              Hide progress, banners and hints; output, warnings and errors stay
      --log-level <level>  info, debug or error

Documentation: https://docs.stacktape.com/cli/"
`;

exports[`help for mcp add 1`] = `
"Usage: stacktape mcp add [options]

Connects your coding agents to Stacktape: Claude Code, Codex, Cursor, VS Code (GitHub Copilot), GitHub Copilot CLI, Windsurf and OpenCode.

Options:
  -y, --yes                        If true, automatically confirms prompts during deploy or delete operations, skipping the manual confirmation step.
      --coding-agents <value>      The coding agents to set up (or remove), for example --coding-agents claude-code,cursor. Without it, an interactive terminal asks with the agents found on this machine preselected; a non-interactive run uses every agent it finds.

Global options:
  -h, --help               Show help for a command or group
  -v, --version            Print the CLI version
      --json               Emit NDJSON (does not confirm operations)
      --debug              Show debug messages
      --quiet              Hide progress, banners and hints; output, warnings and errors stay
      --log-level <level>  info, debug or error

Documentation: https://docs.stacktape.com/cli/"
`;

exports[`help for defaults set 1`] = `
"Usage: stacktape defaults set [key] [value] [options]

Sets system-wide default arguments for Stacktape commands.

Arguments:
  key                       Default setting to update: region, stage, profile, project, aws-account, api-key, executable-python or executable-javascript.
  value                     New value for the selected default setting.

Options:
      --key <value>                Default setting to update: region, stage, profile, project, aws-account, api-key, executable-python or executable-javascript.
      --value <value>              New value for the selected default setting.

Global options:
  -h, --help               Show help for a command or group
  -v, --version            Print the CLI version
      --json               Emit NDJSON (does not confirm operations)
      --debug              Show debug messages
      --quiet              Hide progress, banners and hints; output, warnings and errors stay
      --log-level <level>  info, debug or error

Documentation: https://docs.stacktape.com/cli/"
`;
