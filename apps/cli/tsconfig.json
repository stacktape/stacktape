{
  "compilerOptions": {
    "strict": false,
    "target": "ES6",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ES2023"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@utils/*": ["./src/utils/*"],
      "@schemas/*": ["./@generated/schemas/*"],
      "@domain-services/*": ["./src/domain/*"],
      "@application-services/*": ["./src/app/*"],
      "@config": ["./src/config/random.ts"],
      "@cli-config": ["./src/config/cli.ts"],
      "@errors": ["./src/config/error-messages.ts"],
      "@stacktape-api/*": ["./src/stacktape-api/*"],
      "@helper-lambdas/*": ["./helper-lambdas/*"],
      "@scripts/*": ["./scripts/*"],
      "@generated/*": ["./@generated/*"],
      "src/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "types": ["bun-types"],
    "allowJs": true,
    "skipLibCheck": true,
    "noImplicitThis": true,
    "declaration": false,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./src/**/*", "./scripts/**/*", "./helper-lambdas/**/*"],
  "exclude": ["./@generated/**/*"]
}
