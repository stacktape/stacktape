      "    \"drizzle-orm\": \"^0.43.1\",",
      "    \"jose\": \"^6.0.11\",",
      "    \"lucide-react\": \"^0.511.0\",",
      "    \"next\": \"15.6.0-canary.59\",",
      "    \"postcss\": \"^8.5.3\",",
      "    \"postgres\": \"^3.4.5\",",
      "    \"radix-ui\": \"^1.4.2\",",
      "    \"react\": \"19.1.0\",",
      "    \"react-dom\": \"19.1.0\",",
      "    \"server-only\": \"^0.0.1\",",
      "    \"stripe\": \"^18.1.0\",",
