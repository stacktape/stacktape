---
import DocsLayout from '@/layouts/DocsLayout.astro';
import { getAllDocPages } from '@/utils/docs-data';
import { SITE_URL, type DocsSeo } from '@/utils/seo';

// Emits out/404.html — the Stacktape CDN serves this as its errorDocument for unknown URLs.
const allDocPages = await getAllDocPages();

const seo: DocsSeo = {
  title: 'Page not found | Stacktape Docs',
  description: "The page you're looking for could not be found.",
  canonical: `${SITE_URL}/404/`,
  faqItems: [],
  breadcrumb: [{ name: 'Docs', url: `${SITE_URL}/` }],
  noindex: true
};

const popular = [
  { title: 'Deploy your first stage', href: '/getting-started/deploy-your-first-stage/' },
  { title: 'Configure your stack', href: '/getting-started/configure-your-stack/' },
  { title: 'Resources', href: '/resources/compute/web-service/' },
  { title: 'CLI commands', href: '/cli/deploy/' }
];
---

<DocsLayout
  title="Page not found"
  seo={seo}
  allDocPages={allDocPages}
  tableOfContents={[]}
  currentPath="/404/"
  hideTitle
>
  <div class="docs-404">
    <p class="docs-404-code">404</p>
    <h1>This page doesn't exist</h1>
    <p>It may have moved when the docs were reorganized for Stacktape v4. Search usually finds the new place.</p>
    <div class="docs-404-actions">
      <button type="button" class="docs-button is-primary" data-docs-open-search>Search the docs</button>
      <a href="/" class="docs-button docs-unstyled-link">Docs home</a>
    </div>
    <div class="docs-404-links">
      <p>Pages people often look for:</p>
      <ul>
        {popular.map((page) => <li><a href={page.href}>{page.title}</a></li>)}
      </ul>
    </div>
  </div>
</DocsLayout>

<script>
// Opens the header's search dialog, which listens for Ctrl/Cmd+K.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-docs-open-search]')) return;
    const button = document.querySelector<HTMLButtonElement>('.DocSearch-Button');
    if (button) button.click();
  });
</script>
