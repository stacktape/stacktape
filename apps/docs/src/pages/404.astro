---
import { Search } from 'react-feather';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { getAllDocPages } from '@/utils/docs-data';
import { SITE_URL, type DocsSeo } from '@/utils/seo';

// Emits out/404.html — the Stacktape CDN serves this as its errorDocument for unknown URLs.
const allDocPages = await getAllDocPages();

const seo: DocsSeo = {
  title: 'Page not found | Stacktape Docs',
  description: "The page you're looking for could not be found.",
  canonical: `${SITE_URL}/404/`,
  faqItems: [],
  breadcrumb: [{ name: 'Docs', url: `${SITE_URL}/` }],
  noindex: true
};
---

<DocsLayout
  title="This page doesn't exist"
  seo={seo}
  allDocPages={allDocPages}
  tableOfContents={[]}
  currentPath="/404/"
>
  <p slot="before-title" class="docs-page-section">Error 404</p>
  <p>It may have moved when the docs were reorganized for Stacktape v4. Search usually finds the new place.</p>
  <form class="docs-404-search" role="search" data-docs-404-search>
    <label class="docs-ref-search docs-directory-search">
      <Search size={14} aria-hidden="true" />
      <input type="search" name="q" placeholder="Search the docs" aria-label="Search the docs" autocomplete="off" />
    </label>
    <button type="submit" class="docs-button is-primary">Search</button>
  </form>
  <h2>Or start from one of these</h2>
  <ul>
    <li class="docs-dir-row">
      <a href="/getting-started/" class="docs-dir-name docs-unstyled-link is-stretched">Quickstart</a>
      <span class="docs-dir-text">Install the CLI and deploy your app</span>
    </li>
    <li class="docs-dir-row">
      <a href="/getting-started/deploy-an-existing-app/" class="docs-dir-name docs-unstyled-link is-stretched"
      >Deploy an existing app</a>
      <span class="docs-dir-text">The init wizard, step by step</span>
    </li>
    <li class="docs-dir-row">
      <a href="/resources/" class="docs-dir-name docs-unstyled-link is-stretched">Resource catalog</a>
      <span class="docs-dir-text">Every resource and the AWS service behind it</span>
    </li>
    <li class="docs-dir-row">
      <a href="/cli/" class="docs-dir-name docs-unstyled-link is-stretched">Command index</a>
      <span class="docs-dir-text">Every CLI command, with a filter</span>
    </li>
    <li class="docs-dir-row">
      <a href="/" class="docs-dir-name docs-unstyled-link is-stretched">Docs home</a>
      <span class="docs-dir-text">What Stacktape is and where to start</span>
    </li>
  </ul>
</DocsLayout>

<script>
import '@/components/Search/not-found-search';
</script>
