{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "e2e/**/*",
    "playwright.config.ts",
    "astro.config.mjs",
    "stacktape.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
