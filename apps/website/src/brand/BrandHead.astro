---
const image = new URL('/brand/open-graph.png', Astro.site ?? Astro.url).href;
---

<link rel="icon" type="image/png" sizes="16x16" href="/brand/icon-16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" />
<link rel="icon" type="image/svg+xml" sizes="any" href="/brand/logo-icon.svg" />
<link rel="apple-touch-icon" href="/brand/icon-180.png" />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content="Stacktape wordmark" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={image} />
