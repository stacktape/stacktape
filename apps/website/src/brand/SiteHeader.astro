---
import { ButtonLink } from '@stacktape/ui-react/button';
import Logo from './Logo.astro';
import './site.css';

type Props = {
  /** Use #install when the command box is on the current page. */
  startHref?: string;
};

const { startHref = '/#install' } = Astro.props;
const links = [
  { label: 'Docs', href: 'https://docs.stacktape.com' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Blog', href: '/blog' },
  { label: 'GitHub', href: 'https://github.com/stacktape/stacktape' },
  { label: 'Console', href: 'https://console.stacktape.com' }
];
const path = Astro.url.pathname.replace(/\/$/, '');
const current = (href: string) => (path === href ? 'page' : path.startsWith(`${href}/`) ? 'true' : undefined);
---

<header class="brand-header">
  <div class="site-frame header-inner">
    <a class="home" href="/" aria-label="Stacktape home"><Logo alt="" /></a>
    <nav class="desktop-nav" aria-label="Main">
      {
        links.map(({ href, label }) => (
          <a class="brand-link brand-link--muted" href={href} aria-current={current(href)}>{label}</a>
        ))
      }
    </nav>
    <ButtonLink href={startHref} variant="primary" className="brand-button">Get started</ButtonLink>
    <details class="menu">
      <summary aria-label="Menu">
        <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav aria-label="Main">
        {
          links.map(({ href, label }) => (
            <a class="brand-link brand-link--muted" href={href} aria-current={current(href)}>{label}</a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.s-b .brand-header .menu');
  if (menu) {
    const phone = window.matchMedia('(max-width: 40rem)');
    phone.addEventListener('change', () => { menu.open = false; });
    document.addEventListener('click', (event) => {
      if (phone.matches && menu.open && event.target instanceof Element && !event.target.closest('.menu summary, .menu nav')) {
        menu.open = false;
      }
    });
    document.addEventListener('keydown', (event) => {
      if (phone.matches && menu.open && event.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .brand-header {
    position: sticky;
    z-index: 20;
    inset-block-start: 0;
    background: var(--brand-page);
    border-block-end: 1px solid var(--brand-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--brand-space-5);
    min-height: 4.25rem;
    font-family: var(--brand-font-body);
    font-size: var(--brand-type-sm);
    white-space: nowrap;
  }

  .home {
    display: flex;
    flex: none;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: var(--brand-space-5);
    flex: 1;
  }

  .desktop-nav a:last-child {
    margin-inline-start: auto;
  }

  a[aria-current] {
    color: var(--brand-text);
    text-decoration: underline;
    text-decoration-color: var(--brand-teal);
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: var(--brand-control-height);
    height: var(--brand-control-height);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    color: var(--brand-text);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu nav {
    position: absolute;
    inset-block-start: calc(100% + var(--brand-space-2));
    inset-inline-end: 0;
    display: grid;
    min-width: 12rem;
    padding: var(--brand-space-2);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-surface);
    box-shadow: var(--brand-shadow-menu);
  }

  .menu nav a {
    padding: var(--brand-space-3);
  }

  @media (max-width: 54rem) {
    .header-inner {
      gap: var(--brand-space-2);
    }

    .home {
      margin-inline-end: auto;
    }

    .home :global(img) {
      max-width: 32vw;
      height: auto;
    }

    .desktop-nav {
      display: none;
    }

    .menu {
      display: block;
    }
  }
  @media (max-width: 40rem) {
    :global(.s-b) .header-inner {
      min-height: calc(3.5rem - 1px);
    }

    :global(.s-b) .brand-header:not([data-past-install]) :global(.brand-button) {
      display: none;
    }

    :global(.s-b) .menu {
      position: static;
    }

    :global(.s-b) .menu summary {
      border: 0;
    }

    :global(.s-b) .menu[open]::before {
      position: fixed;
      inset: 3.5rem 0 0;
      background: color-mix(in srgb, var(--brand-inset), transparent 25%);
      content: '';
    }

    :global(.s-b) .menu nav {
      inset: 100% 0 auto;
      max-height: calc(100dvh - 3.5rem);
      min-width: 0;
      padding: var(--brand-space-2) var(--site-gutter) var(--brand-space-5);
      overflow-y: auto;
      border-inline: 0;
      font-size: 1.0625rem;
    }

    :global(.s-b) .menu nav a {
      display: flex;
      align-items: center;
      min-height: 3.25rem;
      padding: var(--brand-space-2) 0;
      border-bottom: 1px solid var(--brand-border);
      color: var(--brand-text);
    }

    :global(.s-b) .menu nav a:last-child {
      justify-content: center;
      margin-top: var(--brand-space-4);
      border: 1px solid var(--brand-muted);
    }
  }
</style>
