---
import { TESTIMONIALS } from './data';
---

<section class="hx-quotes" aria-labelledby="hx-quotes-title">
  <h2 class="hx-quotes__title" id="hx-quotes-title"><span>Teams running on Stacktape</span></h2>
  <div class="hx-quotes__grid">
    {
      TESTIMONIALS.map((item) => (
        <figure class="hx-quote" data-hx-reveal>
          <div class="hx-quote__stub">
            <blockquote class="hx-quote__text">“{item.quote}”</blockquote>
            <figcaption class="hx-quote__meta">
              <span class="hx-quote__who">
                <b>{item.name}</b>
                <span>· {item.role}</span>
                <a href={item.url} rel="noopener">· {item.company}</a>
              </span>
              <span class="hx-quote__facts">{item.facts}</span>
            </figcaption>
          </div>
        </figure>
      ))
    }
  </div>
</section>
