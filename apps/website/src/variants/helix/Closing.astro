---
import CommandBox from './CommandBox.astro';
import { LINKS } from './data';
---

<section class="hx-close" aria-labelledby="hx-close-title">
  <span class="hx-close__prompt" aria-hidden="true">$</span>
  <h2 class="hx-close__title" id="hx-close-title">Put your project on AWS.</h2>
  <p class="hx-close__sub">Ten minutes on your machine. Nothing is created and nothing is billed until you press Deploy.</p>
  <div class="hx-close__cmd">
    <CommandBox id="hx-close-cmd" />
    <div class="hx-hero__actions">
      <a class="hx-btn hx-btn--quiet" href={LINKS.signUp}>Sign up</a>
      <a class="hx-btn hx-btn--quiet" href={LINKS.demo}>Book a demo</a>
    </div>
  </div>
</section>
