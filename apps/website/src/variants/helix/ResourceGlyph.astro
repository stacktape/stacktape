---
/**
 * A small inline mark per resource type, tinted with the resource's AWS category colour.
 *
 * `@stacktape/ui-react/resource-icon` cannot be server-rendered here: `aws-react-icons` ships
 * extensionless ESM imports that Node rejects once Vite externalizes the package for SSR. These
 * six glyphs keep the Console preview static HTML.
 */
type Props = { type: string; size?: number };
const { type, size = 18 } = Astro.props;

const CATEGORY: Record<string, string> = {
  'nextjs-web': 'var(--stp-aws-category-network)',
  'web-service': 'var(--stp-aws-category-compute)',
  function: 'var(--stp-aws-category-compute)',
  'relational-database': 'var(--stp-aws-category-database)',
  'redis-cluster': 'var(--stp-aws-category-database)',
  'web-app-firewall': 'var(--stp-aws-category-security)'
};
const color = CATEGORY[type] ?? 'var(--hx-muted)';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke={color}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {type === 'nextjs-web' && <path d="M4 16V4h1l9 12h1V4M13 4v7" />}
  {type === 'web-service' && <path d="M3 6.5 10 3l7 3.5v7L10 17l-7-3.5v-7ZM3 6.5 10 10l7-3.5M10 10v7" />}
  {type === 'function' && <path d="M5 16l4-8M9 8l-1.5-4H12M9 8l4 8h2" />}
  {type === 'relational-database' && (
    <>
      <ellipse cx="10" cy="5" rx="6" ry="2.5" />
      <path d="M4 5v10c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5V5M4 10c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5" />
    </>
  )}
  {type === 'redis-cluster' && (
    <path d="M3 7.5 10 4l7 3.5-7 3.5-7-3.5ZM3 10.5l7 3.5 7-3.5M3 13.5 10 17l7-3.5" />
  )}
  {type === 'web-app-firewall' && <path d="M10 3 4 5.5v4.5c0 3.5 2.5 6 6 7 3.5-1 6-3.5 6-7V5.5L10 3ZM7.5 10l2 2 3.5-4" />}
</svg>
