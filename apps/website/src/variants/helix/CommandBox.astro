---
/**
 * The primary CTA: one install command with a switcher and a copy button.
 *
 * Renders every command server-side and marks the `npx` one as selected, so the box is complete
 * without JavaScript. The script below only switches tabs and copies. Several boxes can share a
 * page (the hero and the closing prompt), so every id is derived from `id`.
 */
import { INSTALL_COMMANDS } from './data';

type Props = { id: string };
const { id } = Astro.props;
---

<div class="hx-cmd" data-hx-cmd>
  <div class="hx-cmd__tabs" role="tablist" aria-label="Install method">
    {
      INSTALL_COMMANDS.map((item, index) => (
        <button
          class="hx-cmd__tab"
          type="button"
          role="tab"
          id={`${id}-tab-${item.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`${id}-code`}
          tabindex={index === 0 ? 0 : -1}
          data-command={item.command}
        >
          {item.label}
        </button>
      ))
    }
  </div>
  <div class="hx-cmd__row" role="tabpanel" id={`${id}-code`} aria-labelledby={`${id}-tab-npx`}>
    <span class="hx-cmd__prompt" aria-hidden="true">$</span>
    <code class="hx-cmd__code" data-code>{INSTALL_COMMANDS[0].command}</code>
    <button class="hx-cmd__copy" type="button" data-copy aria-label="Copy command">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
        <path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"></path>
      </svg>
      <span data-copy-label>Copy</span>
    </button>
  </div>
  <span class="hx-cmd__status" data-status aria-live="polite"></span>
</div>

<script>
  const boxes = document.querySelectorAll<HTMLElement>('[data-hx-cmd]');

  boxes.forEach((box) => {
    const tabs = Array.from(box.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const code = box.querySelector<HTMLElement>('[data-code]')!;
    const copy = box.querySelector<HTMLButtonElement>('[data-copy]')!;
    const copyLabel = box.querySelector<HTMLElement>('[data-copy-label]')!;
    const status = box.querySelector<HTMLElement>('[data-status]')!;
    const panel = box.querySelector<HTMLElement>('[role="tabpanel"]')!;
    let timer = 0;

    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((other) => {
        const selected = other === tab;
        other.setAttribute('aria-selected', selected ? 'true' : 'false');
        other.tabIndex = selected ? 0 : -1;
      });
      code.textContent = tab.dataset.command ?? '';
      panel.setAttribute('aria-labelledby', tab.id);
      copy.dataset.state = '';
      copyLabel.textContent = 'Copy';
      status.textContent = '';
      if (focus) tab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!delta) return;
        event.preventDefault();
        select(tabs[(index + delta + tabs.length) % tabs.length], true);
      });
    });

    const settle = (text: string, state: string) => {
      copy.dataset.state = state;
      copyLabel.textContent = state === 'copied' ? 'Copied' : 'Copy';
      status.textContent = text;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        copy.dataset.state = '';
        copyLabel.textContent = 'Copy';
        status.textContent = '';
      }, 2400);
    };

    copy.addEventListener('click', async () => {
      const text = code.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        settle('Copied to clipboard. Run it in your project folder.', 'copied');
      } catch {
        // No clipboard permission (or an insecure context): select the text so a keyboard copy works.
        const range = document.createRange();
        range.selectNodeContents(code);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        settle('Clipboard unavailable. The command is selected — press Ctrl+C or ⌘C.', 'failed');
      }
    });
  });
</script>
