---
import AcmeDiagram from '../AcmeDiagram';
import WizardFrame from '../WizardFrame.astro';
import { ACME_CONFIG, DECISIONS, GENERATED_YAML, PROJECT } from '../data';

const escape = (text: string) =>
  text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

// A three-colour YAML tint: comments dim, keys muted, values bright. Enough to read as a file.
const yamlHtml = GENERATED_YAML.split('\n')
  .map((line) => {
    if (line.trim().startsWith('#')) return `<em>${escape(line)}</em>`;
    const match = line.match(/^(\s*)(- )?([\w-]+):(.*)$/);
    if (!match) return escape(line);
    const [, indent, dash = '', key, value] = match;
    const tinted = value.replace(/(\[.*\]|\{.*\}|[^\s].*)/, (v) => `<b>${escape(v)}</b>`);
    return `${indent}${dash}<i>${escape(key)}</i>:${tinted}`;
  })
  .join('\n');
---

<WizardFrame step="Review">
  <div class="hx-review">
    <div class="hx-review__main">
      <h4 class="hx-wiz__title">Here's your app on AWS</h4>
      <p class="hx-p hx-review__summary">{PROJECT.summary}</p>
      <div class="hx-m-hide">
        <AcmeDiagram client:visible config={ACME_CONFIG} />
      </div>
      <div class="hx-estimate hx-m-hide">
        <div>
          <span class="hx-label">Estimate</span>
          <span class="hx-p">{PROJECT.resourceCount} AWS resources · standard size</span>
        </div>
        <span class="hx-estimate__price">~{PROJECT.monthly} <small>/ month</small></span>
        <span class="hx-minibtn hx-minibtn--primary">Ready to deploy</span>
      </div>
    </div>
    <div class="hx-review__side">
      <div>
        <span class="hx-label">Decided for you</span>
        <ul class="hx-decide">
          {
            DECISIONS.map((decision) => (
              <li>
                <span class="hx-decide__statement">{decision.statement}</span>
                <span class="hx-decide__detail hx-m-hide">{decision.detail}</span>
                <span class="hx-decide__change">Change</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="hx-file hx-m-hide">
        <div class="hx-file__name">
          <span>stacktape.yml</span>
          <span class="hx-chip hx-chip--brand">generated</span>
        </div>
        <pre class="hx-code" set:html={yamlHtml} />
      </div>
    </div>
  </div>
</WizardFrame>
