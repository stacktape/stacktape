---
import ConsoleFrame from '../ConsoleFrame.astro';
import { COSTS, PROJECT } from '../data';

const max = Math.max(...COSTS.rows.map((row) => row.amount));
const money = (amount: number) => `$${amount.toFixed(2)}`;
const usedPct = Math.round((COSTS.total / COSTS.budget) * 100);
---

<ConsoleFrame active="Organization/Costs" crumb={[PROJECT.name, COSTS.stage]} tab="Costs">
  <div>
    <span class="hx-label">AWS cost per resource · {COSTS.stage} · {COSTS.period}</span>
    <ul class="hx-costs">
      {
        COSTS.rows.map((row, index) => (
          <li>
            <span class="hx-costs__name">{row.name}</span>
            <span class="hx-bar">
              <span class="hx-bar__fill" style={`--hx-fill: ${(row.amount / max) * 100}%; --i: ${index}`} />
            </span>
            <span class="hx-costs__amount">{money(row.amount)}</span>
          </li>
        ))
      }
    </ul>
    <div class="hx-costs__total">
      <span>Total, month to date</span>
      <span>{money(COSTS.total)}</span>
    </div>
  </div>
  <div class="hx-budget hx-m-hide">
    <div class="hx-budget__head">
      <span>Budget <b>${COSTS.budget}</b> / month · alert at {COSTS.alertAt * 100}%</span>
      <span><b>{usedPct}%</b> used</span>
    </div>
    <div class="hx-budget__track" role="img" aria-label={`${money(COSTS.total)} of a $${COSTS.budget} budget used; alert at ${COSTS.alertAt * 100}%`}>
      <span class="hx-budget__fill" style={`--hx-fill: ${usedPct}%`}></span>
      <span class="hx-budget__mark" style={`--hx-at: ${COSTS.alertAt * 100}%`} data-label={`alert · $${COSTS.budget * COSTS.alertAt}`}></span>
    </div>
  </div>
  <p class="hx-p hx-m-hide">Read from your own AWS cost data. AWS bills you directly; the Stacktape subscription is separate.</p>
</ConsoleFrame>
