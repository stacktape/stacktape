---
import ConsoleFrame from '../ConsoleFrame.astro';
import { CICD, PROJECT, RELEASES } from '../data';
---

<ConsoleFrame active="Organization/Activity" crumb={[PROJECT.name, 'production']} tab="Activity">
  <div>
    <span class="hx-label">Push to deploy · {PROJECT.repo}</span>
    <ol class="hx-runs">
      {
        CICD.pushes.map((run) => (
          <li>
            <span class="hx-runs__ref">{run.ref}</span>
            <span class="hx-runs__msg">{run.message}</span>
            <span class:list={['hx-chip', 'hx-runs__state', run.state === 'Deployed' ? 'hx-chip--green' : 'hx-chip--brand']}>
              {run.state}
            </span>
            <span class="hx-runs__meta">
              deploy {run.run} → <i>{run.target}</i> · {run.duration}
              {run.target === 'production' ? ` · ${RELEASES.fix}` : ''}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="hx-agent">
    <span class="hx-agent__from">preview environment · stage pr-128</span>
    <span>
      <b style="color: var(--hx-text); font-weight: 500;">{CICD.previewUrl}</b> — created from the pull request, deleted when it is
      merged or closed.
    </span>
  </div>
  <div class="hx-runner hx-m-hide">
    <span class="hx-runner__box" aria-hidden="true">
      <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4">
        <rect x="3" y="3" width="14" height="14" rx="2"></rect>
        <rect x="7" y="7" width="6" height="6" rx="1"></rect>
      </svg>
    </span>
    <span class="hx-runner__text">
      <b>Build runner · {CICD.runner.type} · {CICD.runner.region}</b>
      {CICD.runner.spec} · in your AWS account · warm · caches kept between runs · {CICD.runner.idle}
    </span>
  </div>
</ConsoleFrame>
