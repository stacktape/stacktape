---
/**
 * The hero's receipt: what `stacktape init` read, found, decided, priced and wrote, printed line by
 * line. The file it wrote is the strongest line, with the first lines of the YAML under it. Lines
 * before the written file carry `data-fold` so a phone shows only the file and the price.
 */
import { RECEIPT_LINES, PROJECT } from './data';

const foldUntil = RECEIPT_LINES.findIndex((line) => line.kind === 'written') - 1;

/** `key: value` → key muted, value bright, so the YAML reads as a file and not as prose. */
const yamlParts = (text: string) => {
  const at = text.indexOf(':');
  return at === -1 ? [text, ''] : [text.slice(0, at), text.slice(at)];
};
---

<figure class="hx-receipt" aria-label="What stacktape init produced for the example project">
  <figcaption class="hx-receipt__tag">
    <span>stacktape init · receipt</span>
    <span>example · {PROJECT.name}</span>
  </figcaption>
  <p class="hx-receipt__fold" aria-hidden="true">
    … read 41 files on this machine · found a Next.js app, a worker, Postgres, Redis · decided 4 things, each one changeable
  </p>
  <ol class="hx-receipt__lines">
    {
      RECEIPT_LINES.map((line, index) => (
        <li
          class={`hx-receipt__line hx-receipt__line--${line.kind}`}
          style={`--i:${index}`}
          data-fold={index < foldUntil ? '' : undefined}
          aria-hidden={line.kind === 'rule' ? 'true' : undefined}
        >
          {line.kind === 'rule' ? null : line.kind === 'yaml' ? (
            <span>
              <i>{yamlParts(line.text)[0]}</i>
              <b>{yamlParts(line.text)[1]}</b>
            </span>
          ) : (
            <span>{line.text}</span>
          )}
          {'right' in line ? <span>{line.right}</span> : null}
        </li>
      ))
    }
  </ol>
</figure>
