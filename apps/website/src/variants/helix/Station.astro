---
/**
 * One stop on the spine. Three layouts:
 * - `side` (default): a caption on one side of the spine, the product preview (the slot) on the
 *   other. Odd stations put the panel left; `flip` mirrors it.
 * - `anchor`: the two moments that carry the page (Review, the incident). The caption sits centred
 *   on the spine and the panel spans both sides, one surface lighter with a lit top edge.
 * - `half`: one of two stations sharing a row (Security and Costs); the caption sits above its
 *   panel and the marker belongs to the row, not the station.
 * Backticks in the caption text become inline code.
 */
import type { StationCopy } from './data';

type Props = { station: StationCopy; flip?: boolean; deploy?: boolean; layout?: 'side' | 'anchor' | 'half' };
const { station, flip = false, deploy = false, layout = 'side' } = Astro.props;

const parts = station.text.split('`');
const number = String(station.number).padStart(2, '0');
---

<article
  class:list={['hx-station', flip && 'hx-station--flip', layout !== 'side' && `hx-station--${layout}`]}
  id={`hx-${station.anchor}`}
  data-hx-reveal
  data-hx-deploy={deploy ? '' : undefined}
  aria-labelledby={`hx-${station.anchor}-title`}
>
  {layout !== 'half' ? <span class="hx-station__marker" aria-hidden="true" /> : null}
  <div class="hx-station__caption">
    <span class="hx-station__number">Station {number}</span>
    <h3 class="hx-station__title" id={`hx-${station.anchor}-title`}>{station.title}</h3>
    <p class="hx-station__text">
      {parts.map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}
    </p>
  </div>
  <div class="hx-station__panel">
    <slot />
  </div>
</article>
