---
type Props = { day: number; label: string; hint: string };
const { day, label, hint } = Astro.props;
---

<div class="hx-day" data-hx-reveal>
  <span class="hx-day__numeral" aria-hidden="true">{day}</span>
  <h2 class="hx-day__label"><b>Day {day}</b> — {label}</h2>
  <p class="hx-day__hint">{hint}</p>
</div>
