---
import DayMarker from './DayMarker.astro';
import Station from './Station.astro';
import Analyze from './stations/Analyze.astro';
import Cicd from './stations/Cicd.astro';
import Costs from './stations/Costs.astro';
import Deploy from './stations/Deploy.astro';
import Incident from './stations/Incident.astro';
import Observability from './stations/Observability.astro';
import Project from './stations/Project.astro';
import Review from './stations/Review.astro';
import Security from './stations/Security.astro';
import Start from './stations/Start.astro';
import { STATIONS } from './data';

const s = (n: number) => STATIONS[n - 1]!;
---

<section aria-label="The customer journey">
  <DayMarker
    day={0}
    label="the first ten minutes"
    hint="From a repository on your laptop to a running production, without writing infrastructure by hand."
  />
  <Station station={s(1)}><Start /></Station>
  <Station station={s(2)} flip><Analyze /></Station>
  <Station station={s(3)} layout="anchor"><Review /></Station>
  <Station station={s(4)} flip deploy><Deploy /></Station>

  <DayMarker
    day={1}
    label="everything after"
    hint="The part of the job that never ends: shipping, watching, incidents, security and cost, in one Console."
  />
  <Station station={s(5)}><Project /></Station>
  <Station station={s(6)} flip><Cicd /></Station>
  <Station station={s(7)}><Observability /></Station>
  <Station station={s(8)} layout="anchor"><Incident /></Station>
  <div class="hx-pair" data-hx-reveal>
    <span class="hx-station__marker" aria-hidden="true"></span>
    <Station station={s(9)} layout="half"><Security /></Station>
    <Station station={s(10)} layout="half" flip><Costs /></Station>
  </div>
</section>
