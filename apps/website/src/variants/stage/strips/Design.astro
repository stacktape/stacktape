---
/** 01 — the Review step's decisions and its footer: the estimate and the Deploy button. */
import Cursor from '../Cursor.astro';
import { DECIDED, ESTIMATE } from '../data';
import { PreviewButton } from '../ui';
---

<p class="sg-strip__label">Decided for you</p>
<ul class="sg-decided">
  {
    DECIDED.map((item) => (
      <li class="sg-decided__row">
        <span class="sg-decided__check" aria-hidden="true">
          <svg viewBox="0 0 12 12" width="11" height="11" fill="none">
            <path d="m2.5 6.3 2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="sg-decided__text">
          <span class="sg-decided__what">{item.what}</span>
          <span class="sg-decided__why">{item.why}</span>
        </span>
        <PreviewButton variant="secondary" small>Change</PreviewButton>
      </li>
    ))
  }
</ul>
<div class="sg-decided__foot">
  <p class="sg-decided__estimate">
    <b>{ESTIMATE.resources}</b> <span aria-hidden="true">·</span> <b>{ESTIMATE.monthly}</b>
  </p>
  <span class="sg-press">
    <PreviewButton variant="primary" icon="arrow" iconPosition="end">Deploy</PreviewButton>
    <Cursor />
  </span>
</div>
