---
/** 04 — the posture ring and the three findings with what the Console offers for each. */
import { POSTURE } from '../data';
import { PreviewButton, StatusBadge } from '../ui';

const RADIUS = 24;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
const passingArc = (POSTURE.passing / POSTURE.total) * CIRCUMFERENCE;
---

<div class="sg-posture">
  <svg class="sg-ring" viewBox="0 0 60 60" width="60" height="60" aria-hidden="true">
    <circle cx="30" cy="30" r={RADIUS} class="sg-ring__track"></circle>
    <circle
      cx="30"
      cy="30"
      r={RADIUS}
      class="sg-ring__value"
      stroke-dasharray={`${passingArc.toFixed(2)} ${CIRCUMFERENCE.toFixed(2)}`}
      transform="rotate(-90 30 30)"></circle>
  </svg>
  <p class="sg-posture__num">
    <b>{POSTURE.passing}</b> of {POSTURE.total}
    <span class="sg-posture__sub">checks passing</span>
  </p>
</div>

<ul class="sg-findings" aria-label="Findings">
  {
    POSTURE.findings.map((item) => (
      <li class="sg-finding">
        <span class="sg-finding__mark" aria-hidden="true" />
        <span class="sg-finding__what">{item.finding}</span>
        <span class="sg-finding__action">
          {'badge' in item && (
            <StatusBadge tone="success" dot>
              {item.badge}
            </StatusBadge>
          )}
          <PreviewButton variant="secondary" small>
            {item.action}
          </PreviewButton>
        </span>
      </li>
    ))
  }
</ul>
