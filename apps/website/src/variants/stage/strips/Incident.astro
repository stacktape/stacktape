---
/** 05 — the incident: the release that caused it, the handoff, the timeline, the switch that is off. */
import Cursor from '../Cursor.astro';
import { INCIDENT } from '../data';
import { OptInSwitch, PreviewButton, StatusBadge } from '../ui';

const { release } = INCIDENT;
---

<div class="sg-inc__head">
  <StatusBadge tone="success" dot>Resolved</StatusBadge>
  <StatusBadge tone="danger">Error</StatusBadge>
  <span class="sg-inc__title">{INCIDENT.title}</span>
</div>

<p class="sg-inc__release">
  <b>{release.opened} <span class="sg-mono">{release.version}</span></b>
  <span class="sg-inc__sep" aria-hidden="true">·</span>
  <span class="sg-mono">{release.commit}</span>
  <span class="sg-inc__sep" aria-hidden="true">·</span>
  {release.message}
  <span class="sg-inc__sep" aria-hidden="true">·</span>
  <span class="sg-inc__link">{release.link}</span>
</p>

<div class="sg-inc__handoff">
  <span class="sg-press">
    <PreviewButton variant="secondary" icon="copy">Copy details for agent</PreviewButton>
    <Cursor />
  </span>
</div>

<ol class="sg-timeline" aria-label="Timeline">
  {
    INCIDENT.timeline.map((event) => (
      <li class={`sg-tl sg-tl--${event.tone}`}>
        <span class="sg-tl__time">{event.time}</span>
        <span class="sg-tl__mark" aria-hidden="true" />
        <span class="sg-tl__text">{event.text}</span>
      </li>
    ))
  }
</ol>

<div class="sg-optin">
  <OptInSwitch label={INCIDENT.optIn} />
  <span class="sg-optin__text">
    <span class="sg-optin__what">{INCIDENT.optIn}</span>
    <span class="sg-optin__state">{INCIDENT.optInState}</span>
  </span>
</div>
