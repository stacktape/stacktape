---
import { TESTIMONIALS, TESTIMONIALS_TITLE } from './data';
---

<section class="sg-voices" aria-labelledby="sg-voices-title">
  <div class="sg-container">
    <h2 class="sg-voices__title" id="sg-voices-title">{TESTIMONIALS_TITLE}</h2>
    <ul class="sg-voices__list">
      {
        TESTIMONIALS.map((item) => (
          <li class="sg-voice">
            <blockquote class="sg-voice__quote">
              <p>“{item.quote}”</p>
            </blockquote>
            <p class="sg-voice__who">
              <span class="sg-voice__name">{item.name}</span>
              <span class="sg-voice__role">{item.role}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
