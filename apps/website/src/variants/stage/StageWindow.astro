---
/**
 * The stage window: a slim bar with the project and the chapter's word, and the island below it.
 *
 * The island writes the active chapter to `data-chapter` on the sticky container; the stylesheet
 * shows the matching word here and tints the light behind the window. All seven words are in the
 * markup, stacked in one cell, so the bar never changes height.
 */
import { CHAPTERS, PROJECT } from './data';
import Stage from './Stage';
---

<div class="sg-stagecol">
  <div class="sg-sticky" data-sg-stage data-chapter="0">
    <div class="sg-light" aria-hidden="true"></div>
    <div class="sg-window">
      <div class="sg-window__bar">
        <span class="sg-window__title">
          <span class="sg-window__project">{PROJECT.name}</span> · production · {PROJECT.region}
        </span>
        <span class="sg-window__labels">
          {CHAPTERS.map((chapter) => <span class="sg-window__label" data-ch={chapter.index}>{chapter.label}</span>)}
        </span>
      </div>
      <div class="sg-window__body">
        <Stage client:only="react" />
      </div>
    </div>
  </div>
</div>
