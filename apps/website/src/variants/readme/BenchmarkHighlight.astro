---
/**
 * One benchmark result under a homepage section: the headline number, the same bars the
 * benchmark page draws for one application (static here, no island), and a link to that tab of
 * `/benchmarks`. The numbers come from `src/data/deploy-benchmarks.json`.
 */
import { BenchmarkGroup } from './BenchmarkTabs';
import { BENCHMARKS, findGroup, formatValue } from './benchmarks';

type Props = { comparison: string; view: string; app: string; headline: string; context: string };

const { comparison: comparisonId, view, app, headline, context } = Astro.props;
const { comparison, group } = findGroup(comparisonId, view, app);
const stacktape = group.values.find((value) => value.tool === 'stacktape');
const max = Math.max(...group.values.map((value) => value.median));
---

<aside class="rm-bh" aria-label={`Benchmark: ${headline}`}>
  <div class="rm-bh__head">
    <span class="rm-bh__kicker">{BENCHMARKS.status}</span>
    <a class="rm-bh__more" href={`/benchmarks#${comparison.id}`}
      >All benchmarks <span class="rm-arrow" aria-hidden="true">→</span></a
    >
  </div>
  <p class="rm-bh__title">
    {stacktape && <b>{formatValue(stacktape.median, comparison.unit)}</b>}
    {headline}
  </p>
  <BenchmarkGroup data={BENCHMARKS} group={group} unit={comparison.unit} max={max} compact />
  <p class="rm-bh__foot">{context}</p>
</aside>
