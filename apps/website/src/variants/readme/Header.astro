---
/**
 * The repository header, which is the site's nav: the repo icon, `stacktape / stacktape`, the
 * visibility badge, the nav items as header tabs and the actions. Sticky. Under 900px the tabs and
 * the secondary actions move into a panel behind a menu button; the primary action stays visible.
 */
import { ButtonLink } from '@stacktape/ui-react/button';
import { LINKS, NAV_LINKS, REPO } from './data';
---

<header class="rm-header" data-rm-header>
  <div class="rm-container rm-header__inner">
    <a class="rm-repo" href="/" aria-label="Stacktape home">
      <svg class="rm-repo__icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path
          d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"
        ></path>
      </svg>
      <span class="rm-repo__owner">{REPO.owner}</span>
      <span class="rm-repo__slash" aria-hidden="true">/</span>
      <b class="rm-repo__name">{REPO.name}</b>
    </a>
    <span class="rm-repo__vis">{REPO.visibility}</span>

    <nav class="rm-tabs" aria-label="Primary">
      <ul class="rm-tabs__list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a class="rm-tab" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="rm-header__actions">
      <a class="rm-signin" href={LINKS.console}>Console</a>
      <ButtonLink className="rm-hbtn rm-hbtn--start" href={LINKS.getStarted} variant="primary">Get started</ButtonLink>
      <button class="rm-menu" type="button" aria-expanded="false" aria-controls="rm-header-panel" data-rm-menu>
        <span class="rm-visually-hidden">Menu</span>
        <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
          <path d="M3 6h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          <path d="M3 10h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          <path d="M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="rm-header__panel" id="rm-header-panel" hidden data-rm-panel>
    <div class="rm-container">
      <ul class="rm-header__panel-links">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} data-rm-panel-link>
                {link.label}
              </a>
            </li>
          ))
        }
        <li><a href={LINKS.console} data-rm-panel-link>Console</a></li>
      </ul>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-rm-header]');
  const menu = document.querySelector<HTMLButtonElement>('[data-rm-menu]');
  const panel = document.querySelector<HTMLElement>('[data-rm-panel]');

  const setOpen = (open: boolean) => {
    if (!menu || !panel) return;
    menu.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    header?.classList.toggle('is-open', open);
  };

  menu?.addEventListener('click', () => setOpen(menu.getAttribute('aria-expanded') !== 'true'));
  for (const link of document.querySelectorAll('[data-rm-panel-link]')) {
    link.addEventListener('click', () => setOpen(false));
  }
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
