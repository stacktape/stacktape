---
import { CommandBox } from './CommandBox';
import { HeroBoard } from './HeroBoard';
import { LINKS } from './data';
---

<section class="pl-section pl-hero" aria-labelledby="pl-hero-title">
  <!-- The drafting table: a real CSS 3D plane. Everything on it is drawn in the plane's own coordinates and
       projected by the transform, so the footprint, dimension line and coordinates sit on the ground, not over it. -->
  <div class="pl-table" aria-hidden="true">
    <div class="pl-table__plane">
      <div class="pl-table__footprint"></div>
      <div class="pl-table__dim"><span class="pl-table__dim-label">private subnet · 2 AZs</span></div>
      <span class="pl-table__coord pl-table__coord--nw">x 12 · y 04</span>
      <span class="pl-table__coord pl-table__coord--se">x 24 · y 16</span>
      <span class="pl-table__coord pl-table__coord--origin">eu-west-1 · sheet 1 of 1</span>
    </div>
  </div>

  <div class="pl-container pl-hero__inner">
    <div class="pl-hero__copy">
      <p class="pl-hero__eyebrow pl-label">Your own AWS account · open-source CLI · hosted Console</p>
      <h1 class="pl-hero__title" id="pl-hero-title">AWS DevOps, fully automated</h1>
      <p class="pl-hero__sub">
        Stacktape reads your repository, designs the infrastructure a good DevOps team would build, and runs it in
        your own AWS account.
      </p>
      <div class="pl-hero__cta">
        <CommandBox client:load />
        <div class="pl-hero__actions">
          <a class="pl-btn pl-btn--ghost" href={LINKS.signUp}>Sign up</a>
          <a class="pl-btn pl-btn--ghost" href={LINKS.demo}>Book a demo</a>
        </div>
      </div>
    </div>

    <div class="pl-hero__stage">
      <div class="pl-board-shadow" aria-hidden="true"></div>
      <HeroBoard client:load />
    </div>
  </div>
</section>
