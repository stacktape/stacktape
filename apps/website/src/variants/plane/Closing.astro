---
import { CommandBox } from './CommandBox';
import { LINKS } from './data';
---

<section class="pl-section pl-closing" aria-labelledby="pl-closing-title">
  <div class="pl-container">
    <div class="pl-closing__plate">
      <p class="pl-label pl-label--brand">Start here</p>
      <h2 class="pl-closing__title" id="pl-closing-title">Put your project on AWS</h2>
      <p class="pl-closing__text">
        One command opens the wizard on your machine. It reads your repository, composes the configuration and shows you
        the result before anything is created.
      </p>
      <CommandBox client:load />
      <div class="pl-hero__actions">
        <a class="pl-btn pl-btn--ghost" href={LINKS.signUp}>Sign up</a>
        <a class="pl-btn pl-btn--ghost" href={LINKS.demo}>Book a demo</a>
      </div>
    </div>
  </div>
</section>
