---
/** The wizard's guide rail: four bands, read top to bottom. */
type Props = { active: 'Start' | 'Analyze' | 'Review' | 'Deploy' };

const BANDS = ['Start', 'Analyze', 'Review', 'Deploy'] as const;
const { active } = Astro.props;
const activeIndex = BANDS.indexOf(active);
---

<ol class="pl-rail" aria-label="Wizard steps">
  {
    BANDS.map((band, index) => (
      <li
        class:list={['pl-rail__item', index < activeIndex && 'pl-rail__item--done', index === activeIndex && 'pl-rail__item--active']}
        aria-current={index === activeIndex ? 'step' : undefined}
      >
        {band}
      </li>
    ))
  }
</ol>
