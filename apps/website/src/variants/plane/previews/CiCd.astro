---
import Frame from '../Frame.astro';
import { CICD, PROJECT } from '../data';
---

<Frame title={`console.stacktape.com · ${PROJECT.name} / Activity`} tag="example project">
  <div class="pl-ci">
    <div class="pl-ci__row">
      <span class="pl-ci__icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <circle cx="4" cy="3.5" r="1.5"></circle><circle cx="4" cy="12.5" r="1.5"></circle><circle cx="12" cy="5.5" r="1.5"></circle>
          <path d="M4 5v6M12 7c0 3-8 2-8 4"></path>
        </svg>
      </span>
      <div class="pl-ci__main">
        <div class="pl-ci__title">Push to <span class="pl-mono">{CICD.push.branch}</span> → {CICD.push.stage}</div>
        <div class="pl-ci__meta">deploy {CICD.push.number} · {CICD.push.duration} · CloudFormation · zero-downtime</div>
      </div>
      <span class="pl-pill pl-pill--green">{CICD.push.result}</span>
    </div>
    <div class="pl-ci__row">
      <span class="pl-ci__icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <circle cx="4" cy="3.5" r="1.5"></circle><circle cx="4" cy="12.5" r="1.5"></circle><circle cx="12" cy="12.5" r="1.5"></circle>
          <path d="M4 5v6M12 11V7a2 2 0 0 0-2-2H8m2-2L8 5l2 2"></path>
        </svg>
      </span>
      <div class="pl-ci__main">
        <div class="pl-ci__title">PR {CICD.pr.number} · {CICD.pr.title}</div>
        <div class="pl-ci__meta">preview stage {CICD.pr.stage} · {CICD.pr.url}</div>
      </div>
      <span class="pl-pill pl-pill--brand">{CICD.pr.result}</span>
    </div>
    <div class="pl-ci__runner">
      <div class="pl-ci__runner-title">
        Build runner
        <span class="pl-pill pl-pill--muted">{CICD.runner.instance} · {CICD.runner.size}</span>
        <span class="pl-pill pl-pill--green pl-pill--live">{CICD.runner.state}</span>
      </div>
      <ul class="pl-ci__runner-notes">
        <li>in your AWS account, {CICD.runner.region}</li>
        {CICD.runner.notes.map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </div>
</Frame>
