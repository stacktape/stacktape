---
import Frame from '../Frame.astro';
import { COSTS } from '../data';

const max = Math.max(...COSTS.rows.map((row) => row.amount));
const money = (amount: number) => `$${amount.toFixed(2)}`;
const used = COSTS.total / COSTS.budget.amount;
const alertAt = COSTS.budget.alertAt * 100;
---

<Frame title="console.stacktape.com · production / Costs" tag="example project">
  <div class="pl-cost">
    <div>
      <h5 class="pl-subhead">Month to date · per resource · from your AWS cost data</h5>
      <ul class="pl-cost__rows" aria-label="Cost per resource">
        {
          COSTS.rows.map((row) => (
            <li class="pl-cost__row">
              <span class="pl-cost__name">
                <i class:list={['pl-dot', `pl-cat-${row.category}`]} aria-hidden="true" />
                {row.name}
              </span>
              <span class="pl-cost__track">
                <span class:list={['pl-cost__fill', `pl-cat-${row.category}`]} style={`width:${((row.amount / max) * 100).toFixed(1)}%`} />
              </span>
              <span class="pl-cost__amount">{money(row.amount)}</span>
            </li>
          ))
        }
      </ul>
      <div class="pl-cost__total pl-mono">
        <span>Total</span>
        <span>{money(COSTS.total)}</span>
      </div>
    </div>
    <div class="pl-budget">
      <div class="pl-budget__head">
        <span>Budget · production</span>
        <span class="pl-mono">{money(COSTS.total)} of ${COSTS.budget.amount} · alert at {alertAt}%</span>
      </div>
      <div class="pl-budget__track-wrap">
        <div class="pl-budget__track">
          <div class="pl-budget__fill" style={`width:${(used * 100).toFixed(1)}%`}></div>
          <span class="pl-budget__alert" style={`left:${alertAt}%`}></span>
          <span class="pl-budget__alert-label" style={`left:${alertAt}%`}>alert · ${COSTS.budget.amount * COSTS.budget.alertAt}</span>
        </div>
      </div>
      <p class="pl-station__text" style="font-size: 0.76rem; margin-top: 4px;">
        AWS bills you directly. The Stacktape subscription is separate.
      </p>
    </div>
  </div>
</Frame>
