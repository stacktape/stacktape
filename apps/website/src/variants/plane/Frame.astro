---
/** Window chrome around a product preview: a title strip and, when the numbers inside are illustrative, a tag. */
type Props = { title: string; tag?: string; tight?: boolean; class?: string };

const { title, tag, tight = false, class: className } = Astro.props;
---

<div class:list={['pl-frame', className]}>
  <div class="pl-frame__bar">
    <span class="pl-frame__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="pl-frame__title">{title}</span>
    {tag && <span class="pl-frame__tag">{tag}</span>}
  </div>
  <div class:list={['pl-frame__body', tight && 'pl-frame__body--tight']}>
    <slot />
  </div>
</div>
