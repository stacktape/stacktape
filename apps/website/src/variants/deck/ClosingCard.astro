---
/** The last card: the closing line, the same command box, the way back in. It pins on top of the whole stack. */
import { CommandBox } from './CommandBox';
import { CLOSING_LINE, LINKS, TRUST_LINE } from './data';
---

<article class="dk-card dk-card--closing" style="--i: 7" data-dk-card aria-labelledby="dk-closing-title">
  <div class="dk-closing">
    <h2 class="dk-closing__title" id="dk-closing-title">{CLOSING_LINE}</h2>
    <div class="dk-closing__cta">
      <CommandBox client:load label="Get started" hint={false} />
    </div>
    <p class="dk-trust">{TRUST_LINE}</p>
    <p class="dk-closing__signin">Already set up? <a href={LINKS.console}>Sign in to the Console</a></p>
  </div>
</article>
