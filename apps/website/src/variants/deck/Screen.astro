---
/**
 * A screen: one window of the wizard or the Console, composed for the space the card gives it.
 *
 * The bar is slim and carries only what orients the visitor: the wizard's address and its rail, or
 * the project and the Console page. Everything else is the screen's own body.
 */
import { PROJECT, WIZARD_RAIL } from './data';

type Props = {
  /** `wizard` shows `localhost:3000 · stacktape init` and the rail; `console` shows the project. */
  kind: 'wizard' | 'console';
  /** The rail step that is current (wizard) or the Console page (console). */
  current: string;
  class?: string;
};

const { kind, current, class: className } = Astro.props;
---

<div class={['dk-screen', className].filter(Boolean).join(' ')}>
  <div class="dk-screen__bar">
    {
      kind === 'wizard' ? (
        <>
          <span class="dk-screen__title">
            <span class="dk-screen__addr">localhost:3000 <span class="dk-screen__sep">·</span> </span><b>stacktape init</b>
          </span>
          <ol class="dk-rail" aria-label="Wizard steps">
            {WIZARD_RAIL.map((step) => (
              <li class={step === current ? 'is-current' : undefined} aria-current={step === current ? 'step' : undefined}>
                {step}
              </li>
            ))}
          </ol>
        </>
      ) : (
        <>
          <span class="dk-screen__title">
            <b>{PROJECT.name}</b> <span class="dk-screen__sep">·</span> production
          </span>
          <span class="dk-screen__where">{current}</span>
        </>
      )
    }
  </div>
  <div class="dk-screen__body">
    <slot />
  </div>
</div>
