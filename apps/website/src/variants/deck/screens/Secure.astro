---
/** 04 — the posture ring, the three findings with what the Console offers for each, and the guardrails that are on. */
import { GUARDRAILS, GUARDRAILS_LINE, POSTURE } from '../data';
import Screen from '../Screen.astro';
import { PreviewButton, StatusBadge } from '../ui';

const RADIUS = 30;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
const passingArc = (POSTURE.passing / POSTURE.total) * CIRCUMFERENCE;
---

<Screen kind="console" current="Security">
  <div class="dk-posture">
    <svg class="dk-ring" viewBox="0 0 72 72" width="72" height="72" aria-hidden="true">
      <circle cx="36" cy="36" r={RADIUS} class="dk-ring__track"></circle>
      <circle
        cx="36"
        cy="36"
        r={RADIUS}
        class="dk-ring__value"
        stroke-dasharray={`${passingArc.toFixed(2)} ${CIRCUMFERENCE.toFixed(2)}`}
        transform="rotate(-90 36 36)"></circle>
    </svg>
    <p class="dk-posture__num">
      <b>{POSTURE.passing}</b> of {POSTURE.total}
      <span class="dk-posture__sub">checks passing</span>
    </p>
  </div>

  <ul class="dk-findings" aria-label="Findings">
    {
      POSTURE.findings.map((item) => (
        <li class="dk-finding">
          <span class="dk-finding__mark" aria-hidden="true" />
          <span class="dk-finding__what">{item.finding}</span>
          <span class="dk-finding__action">
            {'badge' in item && (
              <StatusBadge tone="success" dot>
                {item.badge}
              </StatusBadge>
            )}
            <PreviewButton variant="secondary" small>
              {item.action}
            </PreviewButton>
          </span>
        </li>
      ))
    }
  </ul>

  <div class="dk-guard">
    <p class="dk-screen__label">Guardrails on</p>
    <p class="dk-guard__chips">
      {
        GUARDRAILS.map((rule) => (
          <span class="dk-chip dk-chip--lock">
            <svg viewBox="0 0 16 16" width="11" height="11" fill="none" aria-hidden="true">
              <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.4" />
              <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
            {rule}
          </span>
        ))
      }
    </p>
    <p class="dk-guard__line">{GUARDRAILS_LINE}</p>
  </div>
</Screen>
