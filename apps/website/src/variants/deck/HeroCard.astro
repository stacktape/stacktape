---
/** Card 0: the copy and the command on the left, the fanned deck on the right. */
import { CommandBox } from './CommandBox';
import { EYEBROW, HEADLINE_LINES, SUBHEADLINE, TRUST_LINE } from './data';
import Fan from './Fan.astro';
---

<article class="dk-card dk-card--hero" style="--i: 0" data-dk-card aria-labelledby="dk-hero-title">
  <span class="dk-card__edge" aria-hidden="true"></span>
  <div class="dk-hero">
    <div class="dk-hero__copy">
      <p class="dk-eyebrow">{EYEBROW}</p>
      <h1 class="dk-hero__title" id="dk-hero-title">
        <span class="dk-hero__line">{HEADLINE_LINES[0]}</span>
        <span class="dk-hero__line">{HEADLINE_LINES[1]}</span>
      </h1>
      <p class="dk-hero__sub">{SUBHEADLINE}</p>
      <div class="dk-hero__cta">
        <CommandBox client:load label="Get started" />
      </div>
      <p class="dk-trust">{TRUST_LINE}</p>
    </div>
    <div class="dk-hero__deck">
      <Fan />
    </div>
  </div>
</article>
