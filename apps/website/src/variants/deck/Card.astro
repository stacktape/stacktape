---
/**
 * One of the six cards: the number, the name, the text and the screen's name on the left, the
 * screen on the right, inside one surface. Where the visitor decides something, an amber tab is
 * attached to the card's top edge; it stays visible after the card is covered.
 *
 * `--i` is the card's place in the deck and decides where it pins; `--slot` is the tab's place
 * along the top edge so the four tabs never overlap once the deck is stacked.
 */
import type { Card as CardData } from './data';
import { TAB_SLOTS } from './data';

type Props = { card: CardData };

const { card } = Astro.props;
const slot = TAB_SLOTS[card.index] ?? 0;
---

<article
  class="dk-card"
  id={card.id}
  style={`--i: ${card.index}; --slot: ${slot}`}
  data-dk-card
  aria-labelledby={`dk-${card.id}-title`}
>
  <span class="dk-card__edge" aria-hidden="true">{card.number}</span>
  {
    card.tab && (
      <span class="dk-tab">
        <svg class="dk-tab__you" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
          <circle cx="8" cy="5" r="3" fill="currentColor" />
          <path d="M2.5 14.5a5.5 5.5 0 0 1 11 0z" fill="currentColor" />
        </svg>
        {card.tab}
      </span>
    )
  }

  <div class="dk-card__grid">
    <div class="dk-card__copy">
      <p class="dk-card__num" aria-hidden="true">{card.number}</p>
      <h2 class="dk-card__title" id={`dk-${card.id}-title`}>
        <span class="dk-visually-hidden">{card.number} </span>{card.name}
      </h2>
      <p class="dk-card__text">{card.text}</p>
      <p class="dk-card__screen">{card.screen}</p>
    </div>
    <div class="dk-card__stage">
      <slot />
    </div>
  </div>
</article>
