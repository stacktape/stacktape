---
/**
 * The deck preview in the hero: the six cards' screens as 280×176 miniatures, spread like a hand.
 *
 * Card 01 lies on top; the other five climb behind it to the right, each showing its name plate
 * along its top edge. On load they fan out from one stack. Everything here is a static picture:
 * the miniatures repeat the values of the real screens in a few strokes each.
 */
import { BUDGET, CARDS, COST_TOTAL, COSTS, ESTIMATE, FAN_LINE, INCIDENT, METRICS, money, POSTURE, PROJECT, sparkline } from './data';

const largest = Math.max(...COSTS.map((cost) => cost.amount));
const withYou = new Set([1, 2, 5, 6]);
const RING_R = 9;
const RING_C = 2 * Math.PI * RING_R;
---

<div class="dk-fan" aria-label="The six screens of the deck, fanned" role="img">
  {
    CARDS.map((card, i) => (
      <div class={`dk-mini dk-mini--${card.id}`} style={`--i: ${i}`}>
        <span class="dk-mini__plate">
          <span class="dk-mini__num">{card.number}</span>
          <span class="dk-mini__name">{card.name}</span>
          {withYou.has(card.index) && (
            <svg class="dk-mini__you" viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
              <circle cx="8" cy="5" r="3" fill="currentColor" />
              <path d="M2.5 14.5a5.5 5.5 0 0 1 11 0z" fill="currentColor" />
            </svg>
          )}
        </span>

        {card.index === 1 && (
          <div class="dk-mini__body dk-mini__review">
            <pre class="dk-mini__yaml">{`web:\n  type: nextjs-web\napiService:\n  type: web-service\nmainDatabase:\n  type: aurora-postgresql`}</pre>
            <div class="dk-mini__decided" aria-hidden="true">
              <span class="dk-mini__drow"><span /></span>
              <span class="dk-mini__drow"><span /></span>
              <span class="dk-mini__drow"><span /></span>
            </div>
            <p class="dk-mini__foot">
              <span>
                {ESTIMATE.resources} · {ESTIMATE.monthly}
              </span>
              <span class="dk-mini__primary">Deploy</span>
            </p>
          </div>
        )}

        {card.index === 2 && (
          <div class="dk-mini__body dk-mini__live">
            <span class="dk-mini__badge">Live</span>
            <span class="dk-mini__url">{PROJECT.urls.web}</span>
            <span class="dk-mini__url">{PROJECT.urls.api}</span>
            <span class="dk-mini__meta">3 m 08 s · {PROJECT.region}</span>
          </div>
        )}

        {card.index === 3 && (
          <div class="dk-mini__body dk-mini__tiles">
            {METRICS.map((metric) => (
              <span class="dk-mini__tile">
                <span class="dk-mini__tilev">
                  {metric.value}
                  <small>{metric.unit}</small>
                </span>
                <svg viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
                  <polyline points={sparkline(metric.points)} fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                </svg>
              </span>
            ))}
          </div>
        )}

        {card.index === 4 && (
          <div class="dk-mini__body dk-mini__posture">
            <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
              <circle cx="12" cy="12" r={RING_R} class="dk-mini__ring-track" />
              <circle
                cx="12"
                cy="12"
                r={RING_R}
                class="dk-mini__ring-value"
                stroke-dasharray={`${((POSTURE.passing / POSTURE.total) * RING_C).toFixed(2)} ${RING_C.toFixed(2)}`}
                transform="rotate(-90 12 12)"
              />
            </svg>
            <span class="dk-mini__posturenum">
              <b>{POSTURE.passing}</b> of {POSTURE.total} checks
            </span>
            <span class="dk-mini__lines">
              <span class="dk-mini__line dk-mini__line--red" />
              <span class="dk-mini__line" />
              <span class="dk-mini__line" />
            </span>
          </div>
        )}

        {card.index === 5 && (
          <div class="dk-mini__body dk-mini__incident">
            <span class="dk-mini__badges">
              <span class="dk-mini__badge">Resolved</span>
              <span class="dk-mini__badge dk-mini__badge--red">Error</span>
            </span>
            <span class="dk-mini__release">
              {INCIDENT.release.opened} <b>{INCIDENT.release.version}</b>
            </span>
            <span class="dk-mini__lines">
              <span class="dk-mini__line dk-mini__line--red" />
              <span class="dk-mini__line dk-mini__line--white" />
              <span class="dk-mini__line dk-mini__line--green" />
            </span>
          </div>
        )}

        {card.index === 6 && (
          <div class="dk-mini__body dk-mini__costs">
            <span class="dk-mini__total">{money(COST_TOTAL)}</span>
            {COSTS.slice(0, 4).map((cost) => (
              <span class="dk-mini__cost">
                <span class="dk-mini__costname">{cost.name}</span>
                <span class="dk-mini__costlane">
                  <span style={`width: ${((cost.amount / largest) * 100).toFixed(0)}%`} />
                </span>
              </span>
            ))}
            <span class="dk-mini__budget">
              budget {money(BUDGET.limit)} · alert at {BUDGET.alertAt} %
            </span>
          </div>
        )}
      </div>
    ))
  }
</div>
<p class="dk-fan__line">{FAN_LINE}</p>
