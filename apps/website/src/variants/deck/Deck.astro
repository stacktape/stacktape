---
/**
 * The deck: the hero, the six cards and the closing, in flow. On viewports at least 900px wide
 * and 780px tall every card is sticky, pinned 9px lower than the one before it, so each card
 * slides up over the last and the covered cards remain as thin edges at the top of the viewport.
 *
 * The script below measures how far the next card has risen over each card and writes it to
 * `--covered`; the stylesheet turns that into the scale, the dimming and the shadow swap. Without
 * the script the deck still stacks, only without the recession.
 */
import Card from './Card.astro';
import ClosingCard from './ClosingCard.astro';
import { CARDS } from './data';
import HeroCard from './HeroCard.astro';
import Costs from './screens/Costs.astro';
import Design from './screens/Design.astro';
import Incident from './screens/Incident.astro';
import Live from './screens/Live.astro';
import Monitor from './screens/Monitor.astro';
import Secure from './screens/Secure.astro';

const screens = [Design, Live, Monitor, Secure, Incident, Costs];
---

<section class="dk-deck" data-dk-deck aria-label="What Stacktape does">
  <HeroCard />
  {
    CARDS.map((card, i) => {
      const ScreenFor = screens[i]!;
      return (
        <Card card={card}>
          <ScreenFor />
        </Card>
      );
    })
  }
  <ClosingCard />
  <div class="dk-deck__hold" aria-hidden="true"></div>
</section>

<script>
  const nav = document.querySelector<HTMLElement>('[data-dk-nav]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-dk-card]'));
  const stacking = window.matchMedia('(min-width: 900px) and (min-height: 780px)');
  let ticking = false;

  const clamp = (value: number) => Math.min(1, Math.max(0, value));

  const update = () => {
    ticking = false;
    nav?.classList.toggle('is-scrolled', window.scrollY > 40);

    if (!stacking.matches) {
      for (const card of cards) {
        card.style.removeProperty('--covered');
        card.classList.remove('is-covered');
      }
      return;
    }

    const viewport = window.innerHeight;
    for (let i = 0; i < cards.length - 1; i += 1) {
      const card = cards[i]!;
      const next = cards[i + 1]!;
      // The next card's own pin position: while it is below that, the fraction of its rise it has
      // completed is how covered this card is.
      const pinned = parseFloat(getComputedStyle(next).top) || 0;
      const top = next.getBoundingClientRect().top;
      const covered = clamp(1 - (top - pinned) / Math.max(1, viewport - pinned));
      card.style.setProperty('--covered', covered.toFixed(3));
      card.classList.toggle('is-covered', covered > 0.5);
    }
  };

  const schedule = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  };

  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule, { passive: true });
  stacking.addEventListener('change', schedule);
  update();
</script>
