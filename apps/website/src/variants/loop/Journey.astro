---
/**
 * The customer journey: seven chapters scrolling past one sticky product window.
 *
 * Every window state is rendered twice: once inside the sticky stage (wide screens with motion
 * allowed) and once inline under its chapter (narrow screens, reduced motion, or no JavaScript).
 * CSS shows exactly one copy, so the page reads completely in every mode.
 */
import Icon from './Icon.astro';
import WindowFrame from './WindowFrame.astro';
import StateAgain from './window/StateAgain.astro';
import StateDeploy from './window/StateDeploy.astro';
import StateIncident from './window/StateIncident.astro';
import StateInit from './window/StateInit.astro';
import StateOperate from './window/StateOperate.astro';
import StateReview from './window/StateReview.astro';
import StateWatch from './window/StateWatch.astro';
import { CHAPTERS } from './data';

const STATES = [StateInit, StateReview, StateDeploy, StateOperate, StateWatch, StateIncident, StateAgain];
const chapters = CHAPTERS.map((chapter, i) => Object.assign({}, chapter, { State: STATES[i] }));
---

<section class="lp-journey" id="journey" aria-labelledby="lp-journey-title">
  <div class="lp-wrap">
    <div class="lp-journey__head">
      <p class="lp-eyebrow">The customer journey · one window, the whole job</p>
      <h2 id="lp-journey-title" class="lp-display lp-journey__title">Seven chapters. One window. Then it loops.</h2>
      <p class="lp-lede">
        Follow acme-project from a repository on a laptop to a production incident that fixed itself through the
        pipeline. Everything shown is one product; the last chapter hands back to the first.
      </p>
    </div>

    <div class="lp-journey__grid">
      <ol class="lp-rail" aria-label="Chapters">
        {
          chapters.map((c, i) => (
            <li>
              <a class={`lp-rail__tick${i === 0 ? ' is-active' : ''}`} href={`#lp-ch-${c.id}`} aria-label={`Chapter ${c.n}: ${c.title}`} aria-current={i === 0 ? 'true' : undefined} />
            </li>
          ))
        }
      </ol>

      <div class="lp-chapters">
        {
          chapters.map((c, i) => (
            <article class={`lp-chapter${i === 0 ? ' is-active' : ''}`} id={`lp-ch-${c.id}`} data-chapter={i} aria-labelledby={`lp-ch-${c.id}-title`}>
              <p class="lp-chapter__num" aria-hidden="true">{c.n}</p>
              <p class="lp-eyebrow lp-chapter__kicker">{c.kicker}</p>
              <h3 id={`lp-ch-${c.id}-title`} class="lp-display lp-chapter__title">
                <span class="lp-sr">Chapter {c.n}: </span>{c.title}
              </h3>
              <div class="lp-chapter__body">{c.body.map((p) => <p>{p}</p>)}</div>
              <ul class="lp-chapter__facts">{c.facts.map((f) => <li>{f}</li>)}</ul>
              <div class="lp-chapter__win">
                <WindowFrame url={c.url} frame={c.frame}>
                  <c.State variant="inline" />
                </WindowFrame>
              </div>
              {i === chapters.length - 1 && (
                <a class="lp-chapter__loop" href="#lp-ch-init">
                  <Icon name="loop" />
                  <span>back to 01 · the next push starts here</span>
                </a>
              )}
            </article>
          ))
        }
      </div>

      <div class="lp-stage">
        <div class="lp-stage__stack">
          {
            chapters.map((c, i) => (
              <div class={`lp-pane${i === 0 ? ' is-active' : ''}`} data-pane={i} aria-hidden={i === 0 ? 'false' : 'true'}>
                <WindowFrame url={c.url} frame={c.frame}>
                  <c.State variant="sticky" />
                </WindowFrame>
              </div>
            ))
          }
        </div>
        <p class="lp-stage__note" aria-hidden="true">
          <span data-stage-label>{chapters[0].n} / {String(chapters.length).padStart(2, '0')} · {chapters[0].title}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<noscript>
  <style is:inline>
    .lp-stage,
    .lp-rail {
      display: none !important;
    }
    .lp-chapter__win {
      display: block !important;
    }
  </style>
</noscript>

<style>
  .lp-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  const journey = document.querySelector<HTMLElement>('.lp-journey');
  const stage = journey?.querySelector<HTMLElement>('.lp-stage');

  if (journey && stage) {
    const chapters = Array.from(journey.querySelectorAll<HTMLElement>('.lp-chapter'));
    const panes = Array.from(stage.querySelectorAll<HTMLElement>('.lp-pane'));
    const ticks = Array.from(journey.querySelectorAll<HTMLElement>('.lp-rail__tick'));
    const label = stage.querySelector<HTMLElement>('[data-stage-label]');
    const total = String(chapters.length).padStart(2, '0');
    let active = 0;

    const apply = (index: number) => {
      if (index === active) return;
      active = index;
      chapters.forEach((el, i) => el.classList.toggle('is-active', i === index));
      panes.forEach((el, i) => {
        el.classList.toggle('is-active', i === index);
        el.setAttribute('aria-hidden', String(i !== index));
      });
      ticks.forEach((el, i) => {
        el.classList.toggle('is-active', i === index);
        if (i === index) el.setAttribute('aria-current', 'true');
        else el.removeAttribute('aria-current');
      });
      const chapter = chapters[index];
      const title = chapter?.querySelector('.lp-chapter__title')?.textContent?.replace(/^Chapter \d+: /, '') ?? '';
      if (label) label.textContent = `${String(index + 1).padStart(2, '0')} / ${total} · ${title.trim()}`;
    };

    // The chapter that spans the middle of the viewport owns the window. Only measured when a
    // chapter crosses the middle band, so scrolling stays cheap.
    const pick = () => {
      const mid = window.innerHeight / 2;
      let best = 0;
      let bestDistance = Number.POSITIVE_INFINITY;
      chapters.forEach((el, i) => {
        const rect = el.getBoundingClientRect();
        const distance = rect.top > mid ? rect.top - mid : rect.bottom < mid ? mid - rect.bottom : 0;
        if (distance < bestDistance) {
          bestDistance = distance;
          best = i;
        }
      });
      apply(best);
    };

    const observer = new IntersectionObserver(pick, { rootMargin: '-35% 0px -35% 0px' });
    chapters.forEach((el) => observer.observe(el));
    pick();
  }
</script>
