---
/**
 * The browser/terminal chrome every product preview sits in.
 *
 * The title bar is rendered at three lengths and the frame's own width (a CSS container, not the
 * viewport) picks one, so a long Console path stays readable in the 560px sticky window, the 490px
 * one at 1024 wide, and a phone-width inline window alike. The "example project" tag is rendered
 * twice for the same reason: in the bar on wide frames, as a footer strip on narrow ones.
 */
type Props = {
  url: string;
  frame: 'terminal' | 'browser';
  class?: string;
  /** Shown top-right, e.g. "example project". */
  tag?: string;
};

const { url, frame, class: className, tag = 'example project' } = Astro.props;
const [host, ...segments] = frame === 'browser' ? url.split('/') : [url];
const path = segments.length ? `/${segments.join('/')}` : '';
const collapse = (keep: number) => (segments.length > keep ? `/…/${segments.slice(-keep).join('/')}` : path);
const tiers = [
  { tier: 'full', path: url.length <= 56 ? path : collapse(3) },
  { tier: 'mid', path: url.length <= 44 ? path : collapse(2) },
  { tier: 'tight', path: url.length <= 36 ? path : collapse(1) }
];
---

<div class={['lp-win', className].filter(Boolean).join(' ')} data-frame={frame}>
  <div class="lp-win__bar">
    <div class="lp-win__dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="lp-win__url">
      {tiers.map((t) => <span class="lp-win__url-v" data-tier={t.tier}><b>{host}</b>{t.path}</span>)}
    </div>
    <div class="lp-win__tag">{tag}</div>
  </div>
  <div class="lp-win__body">
    <slot />
  </div>
  <div class="lp-win__foot">{tag}</div>
</div>
