---
/** 03 Deploy: the account line, the four phases, the resource table and "It's live". */
import Icon from '../Icon.astro';
import { APP, DEPLOY, RESOURCES } from '../data';

type Props = { variant: 'sticky' | 'inline' };
---

<div class="lp-wiz">
  <div class="lp-wiz__rail" aria-hidden="true">
    <div class="lp-wiz__band lp-wiz__band--done">Start</div>
    <div class="lp-wiz__band lp-wiz__band--done">Analyze</div>
    <div class="lp-wiz__band lp-wiz__band--done">Review</div>
    <div class="lp-wiz__band lp-wiz__band--active">Deploy</div>
  </div>
  <div class="lp-wiz__main">
    <h3 class="lp-p-title">Ready to deploy</h3>
    <p class="lp-p-sub">{DEPLOY.intro}</p>

    <div class="lp-deploy__phases">
      <div class="lp-deploy__phase">
        <Icon name="check" class="lp-ico--ok" />
        <span>Initialize</span>
        <span class="lp-p-dim">done</span>
      </div>
      <div class="lp-deploy__phase">
        <Icon name="check" class="lp-ico--ok" />
        <span>Package</span>
        <span class="lp-p-muted lp-p-mono">{DEPLOY.packaged.map((p) => `${p.name} ${p.time}`).join(' · ')}</span>
      </div>
      <div class="lp-deploy__phase">
        <Icon name="check" class="lp-ico--ok" />
        <span>Deploy</span>
        <span class="lp-p-muted lp-p-mono">{DEPLOY.progress.total} of {DEPLOY.progress.total} CloudFormation resources</span>
      </div>
      <div class="lp-deploy__phase">
        <Icon name="check" class="lp-ico--ok" />
        <span>Outputs</span>
        <span class="lp-p-muted lp-p-mono">2 public URLs</span>
      </div>
    </div>

    <table class="lp-deploy__table">
      <thead>
        <tr>
          <th>Resource</th>
          <th class="lp-deploy__col-extra">Type</th>
          <th>Reachable</th>
        </tr>
      </thead>
      <tbody>
        {
          RESOURCES.map((r) => (
            <tr>
              <td class="lp-p-mono">{r.name}</td>
              <td class="lp-deploy__col-extra lp-p-muted">{r.label}</td>
              <td class={r.detail.includes('public') ? '' : 'lp-p-muted'}>
                {r.detail.includes('public') ? 'public URL' : 'private network only'}
              </td>
            </tr>
          ))
        }
        <tr>
          <td colspan="3" class="lp-p-dim">and 8 more created for you: VPC, private subnets, IAM roles, the jump box</td>
        </tr>
      </tbody>
    </table>

    <div class="lp-deploy__live">
      <div class="lp-p-h" style="margin-bottom: 4px;">
        <span style="color: var(--lp-ok);">It's live</span>
        <span class="lp-p-dim">Where to go from here → Console</span>
      </div>
      <a>{APP.urls.web}</a><br />
      <a>{APP.urls.api}</a>
    </div>
  </div>
</div>

<style>
  .lp-deploy__phases {
    margin-top: 8px;
  }
</style>
