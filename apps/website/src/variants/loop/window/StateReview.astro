---
/**
 * 02 Review: the wizard's summary, the real architecture diagram, "Decided for you" and the estimate.
 *
 * The diagram is client-only: server-rendering it embeds ~100 KB of icon data per copy, and this
 * state is rendered twice (sticky and inline). The text fallback behind it covers no-JS readers.
 */
import Diagram from '../Diagram';
import { APP, DECIDED } from '../data';

type Props = { variant: 'sticky' | 'inline' };
---

<div class="lp-wiz">
  <div class="lp-wiz__rail" aria-hidden="true">
    <div class="lp-wiz__band lp-wiz__band--done">Start</div>
    <div class="lp-wiz__band lp-wiz__band--done">Analyze</div>
    <div class="lp-wiz__band lp-wiz__band--active">Review</div>
    <div class="lp-wiz__band">Deploy</div>
  </div>
  <div class="lp-wiz__main">
    <h3 class="lp-p-title">Here's your app on AWS</h3>
    <p class="lp-p-sub">{APP.summary}</p>
    <ul class="lp-wiz__tabs" aria-hidden="true">
      <li aria-current="true">Diagram</li>
      <li>stacktape.yml</li>
      <li>Estimate</li>
    </ul>
    <div class="lp-wiz__diagram">
      <p class="lp-wiz__diagram-fallback">
        Architecture diagram: web and apiService behind the firewall; worker, mainDatabase and cache inside the private
        network.
      </p>
      <Diagram client:only="react" />
    </div>
    <div class="lp-p-h">
      <span>Decided for you</span>
      <span class="lp-p-dim">each one is a click to change</span>
    </div>
    <ul class="lp-decided">
      {
        DECIDED.map((row) => (
          <li>
            <div>
              <strong set:html={row.statement} />
              <span>{row.detail}</span>
            </div>
            <span class="lp-p-btn lp-p-btn--small">Change</span>
          </li>
        ))
      }
    </ul>
    <div class="lp-wiz__foot">
      <span class="lp-p-mono">
        <b>{APP.resourceCount} resources</b> · <b>~{APP.monthly}/month</b>
        <span class="lp-p-dim"> · standard size · estimate</span>
      </span>
      <span class="lp-p-btn lp-p-btn--primary">Write stacktape.yml</span>
    </div>
  </div>
</div>
