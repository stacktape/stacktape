---
/** 01 Init: the command, then the wizard's Start band and the Analyze feed. */
import { ANALYZE_DONE, ANALYZE_FILES, APP } from '../data';

type Props = { variant: 'sticky' | 'inline' };

/** What the scan concluded from the files above; the Review summary sentence follows from it. */
const FOUND = ['Next.js app · web/', 'Node API with a Dockerfile · api/', 'worker · api/src/worker.ts', 'Prisma → Postgres', 'Redis'];
---

<div class="lp-term" aria-label="Terminal">
  <p><span class="lp-term__prompt">~/acme-project $</span> npx stacktape init</p>
  <p class="lp-p-muted">stacktape · reading {APP.repo} on this machine</p>
  <p><span class="lp-term__ok">✓</span> Opening http://localhost:5173 in your browser…</p>
</div>
<div class="lp-wiz">
  <div class="lp-wiz__rail" aria-hidden="true">
    <div class="lp-wiz__band lp-wiz__band--active">Start</div>
    <div class="lp-wiz__band lp-wiz__band--active">Analyze</div>
    <div class="lp-wiz__band">Review</div>
    <div class="lp-wiz__band">Deploy</div>
  </div>
  <div class="lp-wiz__main">
    <h3 class="lp-p-title">Put this project on AWS</h3>
    <p class="lp-p-sub">
      {APP.repo} is read on this machine. Nothing leaves it, and nothing is created or billed until you press Deploy.
    </p>
    <div class="lp-wiz__actions">
      <span class="lp-p-btn lp-p-btn--primary">Analyze my project</span>
      <span class="lp-p-chip">using Claude Code on this machine</span>
    </div>
    <div class="lp-wiz__feed">
      <div class="lp-p-h">
        <span>Reading your project — 12 files so far</span>
        <i class="lp-p-dot lp-p-dot--busy"></i>
      </div>
      <ul class="lp-wiz__files">
        {ANALYZE_FILES.map((file) => <li>{file}</li>)}
      </ul>
      <p class="lp-p-mono lp-p-muted" style="margin: 10px 0 0;">
        <span class="lp-term__ok">✓</span> {ANALYZE_DONE}
      </p>
      <div class="lp-wiz__found">
        <span class="lp-p-dim">Found</span>
        {FOUND.map((item) => <span class="lp-p-chip">{item}</span>)}
      </div>
    </div>
  </div>
</div>
