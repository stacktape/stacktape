---
/** 05 Watch: metric tiles, the trace waterfall, uptime by region and a slice of the live log tail. */
import ConsoleShell from './ConsoleShell.astro';
import { APP, METRICS, TRACE, UPTIME } from '../data';

type Props = { variant: 'sticky' | 'inline' };

const total = TRACE[0].dur;
const SPARKS = [
  '0,14 10,12 20,13 30,9 40,11 50,8 60,10 70,6 80,9 90,7 100,8',
  '0,10 10,11 20,9 30,12 40,10 50,9 60,11 70,10 80,8 90,10 100,9',
  '0,16 10,16 20,15 30,16 40,16 50,15 60,16 70,16 80,15 90,16 100,16'
];
const LOGS = [
  { t: '09:12:04', src: 'apiService', text: 'GET /orders 200 · 41 ms' },
  { t: '09:12:04', src: 'web', text: 'GET /account 200 · 12 ms' },
  { t: '09:12:05', src: 'worker', text: 'invocation ok · 338 ms' }
];
---

<ConsoleShell active={['Observability/Metrics']} crumb={[APP.project, 'production', 'Metrics']}>
  <span slot="top-right" class="lp-p-chip">apiService · last 1 h</span>

  <div class="lp-tiles">
    {
      METRICS.map((m, i) => (
        <div class="lp-tile">
          <div class="lp-tile__label">{m.label}</div>
          <div class="lp-tile__value">
            {m.value}
            <small>{m.unit}</small>
          </div>
          <svg viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
            <polyline points={SPARKS[i]} />
          </svg>
        </div>
      ))
    }
  </div>

  <div class="lp-p-h"><span>Trace · GET /orders</span><span class="lp-p-mono lp-p-muted">{total} ms · OpenTelemetry</span></div>
  <ul class="lp-trace">
    {
      TRACE.map((span) => (
        <li>
          <span class="lp-trace__name" style={`padding-left:${span.depth * 10}px`}>
            {span.name}
          </span>
          <span class="lp-trace__lane">
            <i
              class={`lp-trace__span lp-trace__span--${span.kind}`}
              style={`left:${(span.start / total) * 100}%;width:${(span.dur / total) * 100}%`}
            />
          </span>
          <span class="lp-trace__ms">{span.dur} ms</span>
        </li>
      ))
    }
  </ul>

  <div class="lp-p-h" style="margin-top: 12px;">
    <span>Uptime · {UPTIME.target.replace('https://', '')}</span>
    <span class="lp-p-mono lp-p-muted">{UPTIME.thirtyDay} · 30 days</span>
  </div>
  <div class="lp-uptime">
    {
      UPTIME.regions.map((region) => (
        <div>
          <i class="lp-p-dot lp-p-dot--ok" />
          <span>{region}</span>
          <span class="lp-p-dim lp-p-mono" style="margin-left:auto">up</span>
        </div>
      ))
    }
  </div>

  <div class="lp-p-h" style="margin-top: 12px;"><span>Logs · live tail</span><i class="lp-p-dot lp-p-dot--busy"></i></div>
  <div class="lp-logs">
    {
      LOGS.map((line) => (
        <p>
          <span class="lp-p-dim">{line.t}</span> <b>{line.src}</b> {line.text}
        </p>
      ))
    }
  </div>
</ConsoleShell>

<style>
  .lp-logs {
    padding: 6px 10px;
    border: 1px solid var(--lp-ui-line);
    border-radius: 4px;
    background: #0b0f0f;
    font-family: var(--lp-mono);
    font-size: 10.5px;
    line-height: 1.6;
  }

  .lp-logs p {
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lp-logs b {
    color: var(--lp-brand);
    font-weight: 500;
  }
</style>
