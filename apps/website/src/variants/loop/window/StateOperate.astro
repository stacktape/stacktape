---
/** 04 Operate: the stage page with two stages, the resources, and the CI/CD strip. */
import ConsoleShell from './ConsoleShell.astro';
import Icon from '../Icon.astro';
import { APP, CICD, RESOURCES } from '../data';

type Props = { variant: 'sticky' | 'inline' };

const ICON_FOR: Record<string, 'box' | 'lambda' | 'db' | 'bolt' | 'shield' | 'globe'> = {
  'nextjs-web': 'globe',
  'web-service': 'box',
  function: 'lambda',
  'relational-database': 'db',
  'redis-cluster': 'bolt',
  'web-app-firewall': 'shield'
};
---

<ConsoleShell
  active={['/Overview']}
  crumb={['Projects', APP.project, 'production']}
  tabs={['Overview', 'Activity', 'Logs', 'Metrics', 'Costs', 'Configuration', 'Danger zone']}
  activeTab="Overview"
>
  <span slot="top-right" class="lp-p-chip">{APP.repo}</span>

  <div class="lp-stages">
    <div class="lp-p-panel">
      <div class="lp-stages__name"><span>staging</span><span class="lp-p-chip lp-p-chip--ok"><i class="lp-p-dot lp-p-dot--ok"></i>Updated 2 hours ago</span></div>
      <span class="lp-p-muted lp-p-mono">{APP.region}</span>
    </div>
    <div class="lp-p-panel" style="border-color: rgba(54, 190, 190, 0.45);">
      <div class="lp-stages__name"><span>production</span><span class="lp-p-chip lp-p-chip--brand"><i class="lp-p-dot lp-p-dot--busy"></i>Deploying…</span></div>
      <span class="lp-p-muted lp-p-mono">{APP.region} · from main</span>
    </div>
  </div>

  <div class="lp-p-h"><span>Resources</span><span class="lp-p-dim">{RESOURCES.length} defined · 14 on AWS</span></div>
  <ul class="lp-resources">
    {
      RESOURCES.map((r) => (
        <li>
          <span class={`lp-p-icon lp-p-icon--${r.category}`}>
            <Icon name={ICON_FOR[r.type] ?? 'box'} />
          </span>
          <span class="lp-p-mono">{r.name}</span>
          <span class="lp-resources__detail">{r.label} · {r.detail}</span>
          <i class="lp-p-dot lp-p-dot--ok" title="healthy"></i>
        </li>
      ))
    }
  </ul>

  <div class="lp-p-h" style="margin-top: 12px;"><span>CI/CD</span><span class="lp-p-dim">push-to-deploy · PR previews</span></div>
  <div class="lp-cicd">
    <div class="lp-cicd__row">
      <span class="lp-p-icon"><Icon name="branch" /></span>
      <div>push to <b class="lp-p-mono">{CICD.push.branch}</b> → {CICD.push.stage} deploy <b class="lp-p-mono">{CICD.push.deploy}</b></div>
      <span class="lp-p-chip lp-p-chip--ok">{CICD.push.duration}</span>
    </div>
    <div class="lp-cicd__row">
      <span class="lp-p-icon"><Icon name="pr" /></span>
      <div>PR <b class="lp-p-mono">{CICD.pr.number}</b> {CICD.pr.title} → preview <b class="lp-p-mono">{CICD.pr.stage}</b></div>
      <span class="lp-p-chip lp-p-chip--brand">{CICD.pr.url.replace('https://', '')}</span>
    </div>
    <p class="lp-cicd__runner" style="margin: 0;">{CICD.runner}</p>
  </div>
</ConsoleShell>
