---
import Logo from '../../components/Logo.astro';
import { LINKS } from './data';
---

<header class="lp-nav">
  <div class="lp-wrap lp-nav__in">
    <a class="lp-nav__logo" href="/" aria-label="Stacktape home">
      <Logo height={24} />
    </a>
    <nav aria-label="Primary">
      <ul class="lp-nav__links">
        <li><a class="lp-nav__link lp-nav__link--docs" href={LINKS.docs}>Docs</a></li>
        <li><a class="lp-nav__link" href={LINKS.github}>GitHub</a></li>
        <li><a class="lp-nav__link lp-nav__link--demo" href={LINKS.demo}>Book a demo</a></li>
        <li><a class="lp-nav__link lp-nav__link--cta" href={LINKS.signIn}>Sign in</a></li>
      </ul>
    </nav>
  </div>
</header>
