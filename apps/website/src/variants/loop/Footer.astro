---
import Logo from '../../components/Logo.astro';
import { FOOTER_COLUMNS } from './data';
---

<footer class="lp-footer">
  <div class="lp-wrap">
    <div class="lp-footer__grid">
      <div class="lp-footer__brand">
        <Logo height={22} />
        <p style="margin: 0;">
          An open-source AWS framework and a hosted Console. Everything deploys into your own AWS account as plain
          CloudFormation.
        </p>
      </div>
      {
        FOOTER_COLUMNS.map((col) => (
          <div class="lp-footer__col">
            <h3>{col.title}</h3>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="lp-footer__bottom">© {new Date().getFullYear()} Stacktape · AWS bills you directly; Stacktape charges a subscription separately.</p>
  </div>
</footer>
