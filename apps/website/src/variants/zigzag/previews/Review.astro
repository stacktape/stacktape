---
/**
 * 01 — the wizard's Review screen. The file and the picture are two views of the same app: the
 * file on the left, the real diagram on the right, a draggable divider between them. Below, the
 * three things the wizard decided, each changeable, and the estimate before anything exists.
 */
import { ACME_CONFIG, ACME_YAML, DECIDED, ESTIMATE, REVIEW, highlightYaml } from '../data';
import { GatedDiagram } from '../GatedDiagram';
import Window from '../Window.astro';
import { PreviewButton } from './ui';

const file = highlightYaml(ACME_YAML);
const DIAGRAM_LABEL =
  'Architecture diagram of acme-project: web and apiService are public behind the firewall; worker, cache and mainDatabase sit inside the private network';
---

<Window title="localhost:3000 · <b>stacktape init</b>">
  <ol class="zz-rail" slot="bar" aria-label="Wizard progress">
    <li>Start</li>
    <li>Read</li>
    <li class="is-current" aria-current="step">Review</li>
    <li>Deploy</li>
  </ol>

  <div class="zz-screen__head">
    <h3 class="zz-screen__title">{REVIEW.title}</h3>
    <p class="zz-screen__sub">{REVIEW.line}</p>
  </div>

  <div class="zz-reveal" data-zz-reveal style="--reveal: 40%">
    <div class="zz-reveal__picture">
      <div class="zz-reveal__canvas">
        <GatedDiagram client:only="react" config={ACME_CONFIG} ariaLabel={DIAGRAM_LABEL} />
      </div>
    </div>

    <div class="zz-reveal__file">
      <div class="zz-editor">
        <div class="zz-editor__tab">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
            <path d="M4 1.5h5.5L13 5v9.5H4z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
            <path d="M9.5 1.5V5H13" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
          </svg>
          <span>{REVIEW.file}</span>
          <span class="zz-editor__lines">{file.lineCount} lines</span>
        </div>
        <div class="zz-editor__scroll">
          <div class="zz-editor__pane">
            <div class="zz-editor__gutter" aria-hidden="true">
              {Array.from({ length: file.lineCount }, (_, n) => <span>{n + 1}</span>)}
            </div>
            <pre class="zz-editor__code"><code set:html={file.html} /></pre>
          </div>
        </div>
      </div>
    </div>

    <div
      class="zz-reveal__handle"
      data-zz-handle
      role="slider"
      tabindex="0"
      aria-label="How much of the file to show; the rest is the diagram"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="40"
    >
      <span class="zz-reveal__grip" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
          <path d="M6 4 2.5 8 6 12M10 4l3.5 4L10 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>

  <div class="zz-decided">
    <p class="zz-label">Decided for you</p>
    <ul class="zz-decided__list">
      {
        DECIDED.map((item) => (
          <li class="zz-decided__row">
            <span class="zz-check" aria-hidden="true">
              <svg viewBox="0 0 12 12" width="11" height="11" fill="none">
                <path d="m2.5 6.3 2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="zz-decided__text">
              <span class="zz-decided__what">{item.what}</span>
              <span class="zz-decided__why">{item.why}</span>
            </span>
            <PreviewButton variant="secondary" small>Change</PreviewButton>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="zz-screen__foot">
    <p class="zz-estimate"><b>{ESTIMATE.resources}</b> <span aria-hidden="true">·</span> <b>{ESTIMATE.monthly}</b></p>
    <PreviewButton variant="primary" icon="arrow" iconPosition="end">Deploy</PreviewButton>
  </div>
</Window>

<script>
  // The reveal divider: pointer drag with capture, keyboard arrows, Home/End, double-click to reset.
  const boxes = document.querySelectorAll<HTMLElement>('[data-zz-reveal]');

  for (const box of boxes) {
    const handle = box.querySelector<HTMLElement>('[data-zz-handle]');
    if (!handle) continue;

    const min = 10;
    const max = 90;
    const home = 40;
    let value = home;

    const apply = (next: number) => {
      value = Math.min(max, Math.max(min, next));
      box.style.setProperty('--reveal', `${value}%`);
      handle.setAttribute('aria-valuenow', String(Math.round(value)));
    };

    const fromPointer = (clientX: number) => {
      const rect = box.getBoundingClientRect();
      apply(((clientX - rect.left) / rect.width) * 100);
    };

    handle.addEventListener('pointerdown', (event: PointerEvent) => {
      event.preventDefault();
      handle.setPointerCapture(event.pointerId);
      box.classList.add('is-dragging');
      fromPointer(event.clientX);
    });
    handle.addEventListener('pointermove', (event: PointerEvent) => {
      if (!box.classList.contains('is-dragging')) return;
      fromPointer(event.clientX);
    });
    const release = (event: PointerEvent) => {
      if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
      box.classList.remove('is-dragging');
    };
    handle.addEventListener('pointerup', release);
    handle.addEventListener('pointercancel', release);
    handle.addEventListener('dblclick', () => apply(home));
    handle.addEventListener('keydown', (event: KeyboardEvent) => {
      const step = event.shiftKey ? 12 : 4;
      if (event.key === 'ArrowLeft') apply(value - step);
      else if (event.key === 'ArrowRight') apply(value + step);
      else if (event.key === 'Home') apply(min);
      else if (event.key === 'End') apply(max);
      else return;
      event.preventDefault();
    });
  }
</script>
