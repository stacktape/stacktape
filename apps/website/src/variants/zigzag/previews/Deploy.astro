---
/**
 * 02 — the deploy, finished: the two live URLs and where they run, the three phases as a done
 * checklist, and one strip saying what deploying looks like from now on.
 */
import { DEPLOY, PROJECT } from '../data';
import Window from '../Window.astro';
import { PreviewButton, StatusBadge } from './ui';

const { push, pullRequest, rollback } = DEPLOY.after;
---

<Window title="localhost:3000 · <b>stacktape init</b>">
  <ol class="zz-rail" slot="bar" aria-label="Wizard progress">
    <li>Start</li>
    <li>Read</li>
    <li>Review</li>
    <li class="is-current" aria-current="step">Deploy</li>
  </ol>

  <div class="zz-live">
    <div class="zz-live__head">
      <StatusBadge tone="success" dot>Live</StatusBadge>
      <h3 class="zz-screen__title">It's live</h3>
    </div>
    <ul class="zz-live__urls">
      <li>{PROJECT.urls.web}</li>
      <li>{PROJECT.urls.api}</li>
    </ul>
    <p class="zz-live__meta">{DEPLOY.meta}</p>
  </div>

  <ol class="zz-phases" aria-label="Deploy phases">
    {
      DEPLOY.phases.map((phase) => (
        <li class="zz-phase">
          <span class="zz-check" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="11" height="11" fill="none">
              <path d="m2.5 6.3 2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="zz-phase__body">
            <span class="zz-phase__name">{phase.name}</span>
            {'chips' in phase ? (
              <span class="zz-phase__chips">
                {phase.chips.map((chip) => (
                  <span class="zz-chip">{chip}</span>
                ))}
              </span>
            ) : (
              <span class="zz-phase__note">{phase.note}</span>
            )}
          </span>
        </li>
      ))
    }
  </ol>

  <div class="zz-after">
    <p class="zz-label">From now on</p>
    <div class="zz-after__strip">
      <span class="zz-after__item">
        <span class="zz-mono">{push.from}</span> <span class="zz-after__arrow" aria-hidden="true">→</span>{' '}
        <b class="zz-mono">{push.to}</b> <span aria-hidden="true">·</span> {push.note}
      </span>
      <span class="zz-after__item">
        <span class="zz-mono">{pullRequest.from}</span> <span class="zz-after__arrow" aria-hidden="true">→</span>{' '}
        <span class="zz-mono">{pullRequest.to}</span>
      </span>
      <PreviewButton variant="secondary" small>{rollback}</PreviewButton>
    </div>
  </div>
</Window>
