---
/** 03 — apiService in production: three metric tiles, the trace of one request, one uptime line. */
import { ALERTS_CHIP, METRICS, PROJECT, TRACE, UPTIME } from '../data';
import Window from '../Window.astro';
import { StatusBadge } from './ui';

const sparkline = (points: readonly number[]) => {
  const max = Math.max(...points);
  const min = Math.min(...points);
  const range = Math.max(1, max - min);
  return points
    .map((point, index) => {
      const x = (index / (points.length - 1)) * 100;
      const y = 30 - ((point - min) / range) * 24;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
};

const pct = (value: number) => `${((value / TRACE.total) * 100).toFixed(2)}%`;
---

<Window title={`${PROJECT.name} · <b>production</b>`}>
  <span class="zz-win__side" slot="bar">
    <StatusBadge tone="neutral" caps={false}>{ALERTS_CHIP}</StatusBadge>
  </span>

  <div class="zz-screen__head">
    <h3 class="zz-screen__title">apiService</h3>
    <p class="zz-screen__sub">last hour</p>
  </div>

  <div class="zz-tiles">
    {
      METRICS.map((metric) => (
        <div class="zz-tile">
          <p class="zz-tile__label">{metric.label}</p>
          <p class="zz-tile__value">
            {metric.value}
            <span class="zz-tile__unit">{metric.unit}</span>
          </p>
          <svg class="zz-spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
            <polyline points={sparkline(metric.points)} fill="none" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke" />
          </svg>
        </div>
      ))
    }
  </div>

  <div class="zz-trace">
    <p class="zz-trace__head"><span class="zz-mono">{TRACE.name}</span> <span aria-hidden="true">·</span> {TRACE.total} ms</p>
    <ol class="zz-trace__rows">
      {
        TRACE.spans.map((span) => (
          <li class={`zz-trace__row zz-trace__row--${span.kind}`}>
            <span class="zz-trace__name">{span.name}</span>
            <span class="zz-trace__lane">
              <span class="zz-trace__bar" style={`left: ${pct(span.start)}; width: ${pct(span.duration)}`} />
            </span>
            <span class="zz-trace__ms">{span.duration} ms</span>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="zz-uptime">
    <span class="zz-mono zz-uptime__url">{UPTIME.url}</span>
    <StatusBadge tone="success" dot>Up</StatusBadge>
    {
      UPTIME.regions.map((check) => (
        <span class="zz-uptime__region">
          {check.region} <span class="zz-mono">{check.latency}</span>
        </span>
      ))
    }
    <span class="zz-uptime__total">{UPTIME.thirtyDay}</span>
  </p>
</Window>
