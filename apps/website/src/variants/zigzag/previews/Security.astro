---
/** 04 — security posture with its three findings, and the guardrails that are on. */
import { GUARDRAILS, POSTURE, PROJECT } from '../data';
import Window from '../Window.astro';
import { PreviewButton, StatusBadge } from './ui';

const RADIUS = 30;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
const passingArc = (POSTURE.passing / POSTURE.total) * CIRCUMFERENCE;
---

<Window title={`${PROJECT.name} · production · <b>security</b>`}>
  <div class="zz-sec">
    <div class="zz-posture">
      <svg class="zz-ring" viewBox="0 0 72 72" width="72" height="72" aria-hidden="true">
        <circle cx="36" cy="36" r={RADIUS} class="zz-ring__track"></circle>
        <circle
          cx="36"
          cy="36"
          r={RADIUS}
          class="zz-ring__value"
          stroke-dasharray={`${passingArc.toFixed(2)} ${CIRCUMFERENCE.toFixed(2)}`}
          transform="rotate(-90 36 36)"></circle>
      </svg>
      <div>
        <p class="zz-posture__num"><b>{POSTURE.passing}</b> of {POSTURE.total}</p>
        <p class="zz-posture__sub">checks passing</p>
      </div>
    </div>

    <ul class="zz-findings" aria-label="Findings">
      {
        POSTURE.findings.map((item) => (
          <li class="zz-finding">
            <span class="zz-finding__mark" aria-hidden="true" />
            <span class="zz-finding__text">{item.finding}</span>
            <span class="zz-finding__action">
              {'badge' in item && (
                <StatusBadge tone="success" dot>
                  {item.badge}
                </StatusBadge>
              )}
              <PreviewButton variant="secondary" small>
                {item.action}
              </PreviewButton>
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="zz-guardrails">
    <p class="zz-label">Guardrails on</p>
    <div class="zz-guardrails__row">
      {
        GUARDRAILS.on.map((rule) => (
          <StatusBadge tone="brand" caps={false}>
            {rule}
          </StatusBadge>
        ))
      }
    </div>
    <p class="zz-guardrails__line">{GUARDRAILS.line}</p>
  </div>
</Window>
