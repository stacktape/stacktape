---
/** 06 — per-resource cost bars from the AWS bill beside the budget. */
import { BUDGET, COST_TOTAL, COSTS, PROJECT } from '../data';
import Window from '../Window.astro';

const largest = Math.max(...COSTS.map((cost) => cost.amount));
const money = (amount: number) => `$${amount.toFixed(2)}`;
const used = (COST_TOTAL / BUDGET.limit) * 100;
const alertAmount = (BUDGET.limit * BUDGET.alertAt) / 100;
---

<Window title={`${PROJECT.name} · production · <b>costs</b>`}>
  <div class="zz-costs">
    <div class="zz-bars">
      <div class="zz-bars__head">
        <p class="zz-label">Cost by resource <span aria-hidden="true">·</span> month to date</p>
        <p class="zz-cost__total">{money(COST_TOTAL)}</p>
      </div>
      <ul class="zz-bars__list" aria-label="Cost per resource">
        {
          COSTS.map((cost) => (
            <li class="zz-bar">
              <span class="zz-bar__name zz-mono">{cost.name}</span>
              <span class="zz-bar__lane">
                <span class="zz-bar__fill" style={`width: ${((cost.amount / largest) * 100).toFixed(1)}%`} />
              </span>
              <span class="zz-bar__amount zz-mono">{money(cost.amount)}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="zz-budget">
      <div class="zz-budget__head">
        <p class="zz-label">Budget</p>
        <p class="zz-budget__limit"><b>{money(BUDGET.limit)}</b> / month</p>
      </div>
      <div
        class="zz-budget__lane"
        role="img"
        aria-label={`${money(COST_TOTAL)} of ${money(BUDGET.limit)} used; alert at ${BUDGET.alertAt} %`}
      >
        <span class="zz-budget__fill" style={`width: ${used.toFixed(1)}%`}></span>
        <span class="zz-budget__mark" style={`left: ${BUDGET.alertAt}%`}></span>
      </div>
      <p class="zz-budget__legend">
        <span><b>{used.toFixed(0)} %</b> used</span>
        <span>alert at <b>{BUDGET.alertAt} %</b> ({money(alertAmount)})</span>
      </p>
      <p class="zz-budget__line">{BUDGET.line}</p>
    </div>
  </div>
</Window>
