---
/** 05 — the incident, resolved: the release that caused it, the signals, the timeline, the opt-in off. */
import { INCIDENT, PROJECT } from '../data';
import Window from '../Window.astro';
import { OptInSwitch, PreviewButton, StatusBadge } from './ui';

const { release } = INCIDENT;
---

<Window title={`${PROJECT.name} · production · incidents · <b>${INCIDENT.id}</b>`}>
  <div class="zz-inc__head">
    <div class="zz-inc__heading">
      <p class="zz-inc__badges">
        <StatusBadge tone="success" dot>Resolved</StatusBadge>
        <StatusBadge tone="danger">Error</StatusBadge>
      </p>
      <h3 class="zz-screen__title zz-inc__title">{INCIDENT.title}</h3>
    </div>
    <PreviewButton variant="secondary" icon="copy">{INCIDENT.handoff}</PreviewButton>
  </div>

  <p class="zz-inc__release">
    <b>{release.opened}</b>
    <span class="zz-inc__sep" aria-hidden="true">·</span>
    <span class="zz-mono">{release.commit}</span>
    <span class="zz-inc__sep" aria-hidden="true">·</span>
    <span class="zz-inc__message">{release.message}</span>
    <span class="zz-inc__sep" aria-hidden="true">·</span>
    <span class="zz-inc__link">{release.link}</span>
  </p>

  <div class="zz-inc__grid">
    <ul class="zz-signals" aria-label="Signals">
      {
        INCIDENT.signals.map((signal) => (
          <li class="zz-signal">
            <span class="zz-signal__text">{signal.text}</span>
            <span class="zz-signal__meta">{signal.meta}</span>
          </li>
        ))
      }
    </ul>

    <ol class="zz-timeline" aria-label="Timeline">
      {
        INCIDENT.timeline.map((event) => (
          <li class={`zz-tl zz-tl--${event.tone}`}>
            <span class="zz-tl__time zz-mono">{event.time}</span>
            <span class="zz-tl__mark" aria-hidden="true" />
            <span class="zz-tl__text">{event.text}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="zz-optin">
    <OptInSwitch label={INCIDENT.optIn.label} />
    <span class="zz-optin__text">
      <span class="zz-optin__what">{INCIDENT.optIn.label}</span>
      <span class="zz-optin__state">{INCIDENT.optIn.state}</span>
    </span>
  </div>
</Window>
