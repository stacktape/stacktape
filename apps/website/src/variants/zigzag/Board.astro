---
/**
 * The drafting table: an isometric grid in screen space under the hero and the six surfaces, a fog
 * that calms it at the page edges and behind the hero text, and one SVG in the same coordinate
 * space carrying the route and its faint dashed plan. `route.ts` measures the surfaces and the
 * interchanges, draws the route and reveals it with scroll.
 */
---

<div class="zz-board" data-zz-board>
  <div class="zz-board__grid" aria-hidden="true"></div>
  <div class="zz-board__fog" aria-hidden="true"></div>

  <svg class="zz-route" data-zz-route aria-hidden="true" focusable="false">
    <path class="zz-route__plan" d=""></path>
    <path class="zz-route__glow" d=""></path>
    <path class="zz-route__line" d=""></path>
  </svg>

  <slot />
</div>

<script>
  import './route';
</script>
