---
/**
 * One step: a single surface on the Console's material with, top to bottom, the number and the
 * name (what Stacktape does), the explanation, the reader's own line where they do something, and
 * the screen in its own window. Beside the card, in the free strip on the path's side, the plate
 * the path passes through.
 */
import type { Step } from './data';
import { inline } from './data';
import Plate from './Plate.astro';

type Props = { step: Step };

const { step } = Astro.props;
const { number, id, name, text, you, side } = step;
---

<li class:list={['hm-moment', `hm-moment--${side}`]} id={id} data-hm-moment>
  <article class="hm-card" aria-labelledby={`${id}-title`} data-hm-card>
    <div class="hm-card__head">
      <span class="hm-card__num" aria-hidden="true">{number}</span>
      <h3 class="hm-card__title" id={`${id}-title`}>{name}</h3>
    </div>
    <p class="hm-card__text" set:html={inline(text)} />
    {
      you && (
        <p class="hm-you">
          <b class="hm-you__tag">You:</b>
          <span set:html={inline(you)} />
        </p>
      )
    }
    <div class="hm-card__ui">
      <slot />
    </div>
  </article>
  <Plate kind="moment" number={number} />
</li>
