---
/**
 * The six steps, straight after the hero: no intro and no legend. The cards and the screens say
 * who does what; the path joins the plates from the start plate under the command box to the
 * arrival plate at the end.
 */
import { PROJECT, STEPS } from './data';
import Moment from './Moment.astro';
import Plate from './Plate.astro';
import Costs from './previews/Costs.astro';
import Deploys from './previews/Deploys.astro';
import Incident from './previews/Incident.astro';
import Review from './previews/Review.astro';
import Secures from './previews/Secures.astro';
import Watches from './previews/Watches.astro';

const step = (id: string) => {
  const found = STEPS.find((candidate) => candidate.id === id);
  if (!found) throw new Error(`home: no step with id "${id}"`);
  return found;
};
---

<section class="hm-moments" aria-label="What Stacktape does">
  <div class="hm-container">
    <ol class="hm-moments__list">
      <Moment step={step('designs')}><Review /></Moment>
      <Moment step={step('deploys')}><Deploys /></Moment>
      <Moment step={step('monitors')}><Watches /></Moment>
      <Moment step={step('secures')}><Secures /></Moment>
      <Moment step={step('incidents')}><Incident /></Moment>
      <Moment step={step('costs')}><Costs /></Moment>
    </ol>

    <Plate kind="end" class="hm-arrival">
      <div class="hm-arrival__panel">
        <p class="hm-arrival__line">
          <i class="hm-dot hm-dot--live" aria-hidden="true"></i>
          <span class="hm-mono">{PROJECT.name}</span>
          <span aria-hidden="true">·</span> production <span aria-hidden="true">·</span> running
        </p>
        <ul class="hm-arrival__urls">
          <li><a href={PROJECT.urls.web}>{PROJECT.urls.web}</a></li>
          <li><a href={PROJECT.urls.api}>{PROJECT.urls.api}</a></li>
        </ul>
      </div>
    </Plate>
  </div>
</section>
