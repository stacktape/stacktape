---
/**
 * The board: an isometric grid in screen space under the hero and the six steps, a fog that
 * keeps it strongest around the path, and one SVG in the same coordinate space carrying the
 * route and its faint plan. `board.ts` measures the plates and the cards, draws the route (down
 * the free strip beside each card, diagonally across the gaps) and reveals it with scroll.
 */
---

<div class="hm-board" data-hm-board>
  <div class="hm-board__grid" aria-hidden="true"></div>
  <div class="hm-board__fog" aria-hidden="true"></div>

  <svg class="hm-path" aria-hidden="true" focusable="false">
    <path class="hm-path__plan" d=""></path>
    <path class="hm-path__glow" d=""></path>
    <path class="hm-path__line" d=""></path>
  </svg>

  <slot />
</div>

<script>
  import './board';
</script>
