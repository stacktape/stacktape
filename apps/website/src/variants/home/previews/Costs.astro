---
/** 06 — per-resource cost bars from the AWS bill, and the budget. */
import Callout from '../Callout.astro';
import { ACCOUNT, BUDGET, COST_TOTAL, COSTS, PROJECT } from '../data';
import Window from '../Window.astro';

const largest = Math.max(...COSTS.map((cost) => cost.amount));
const money = (amount: number) => `$${amount.toFixed(2)}`;
const used = (COST_TOTAL / BUDGET.limit) * 100;
---

<Window title={`Console · ${PROJECT.name} · production · <b>costs</b>`}>
  <div class="hm-screen__head">
    <div class="hm-screen__heading">
      <h4 class="hm-screen__title">Cost by resource</h4>
      <p class="hm-screen__sub">production · month to date · billed by AWS to account {ACCOUNT.id}</p>
    </div>
    <p class="hm-cost__total">{money(COST_TOTAL)}</p>
  </div>

  <ul class="hm-bars" aria-label="Cost per resource">
    {
      COSTS.map((cost) => (
        <li class="hm-bar">
          <span class="hm-bar__name hm-mono">{cost.name}</span>
          <span class="hm-bar__lane">
            <span class="hm-bar__fill" style={`width: ${((cost.amount / largest) * 100).toFixed(1)}%`} />
          </span>
          <span class="hm-bar__amount hm-mono">{money(cost.amount)}</span>
        </li>
      ))
    }
  </ul>
  <Callout side="below" text="from your AWS bill, per resource; AWS bills you, not Stacktape" />

  <div class="hm-panel hm-budget">
    <div class="hm-panel__head">
      <h5 class="hm-panel__title">Budget</h5>
      <p class="hm-panel__meta"><b class="hm-budget__limit">{money(BUDGET.limit)}</b> / month</p>
    </div>
    <div class="hm-budget__lane" role="img" aria-label={`${money(COST_TOTAL)} of ${money(BUDGET.limit)} used; alert at ${BUDGET.alertAt}%`}>
      <span class="hm-budget__fill" style={`width: ${used.toFixed(1)}%`}></span>
      <span class="hm-budget__mark" style={`left: ${BUDGET.alertAt}%`}></span>
    </div>
    <p class="hm-budget__legend">
      <span><b>{used.toFixed(0)}%</b> used</span>
      <span>alert at <b>{BUDGET.alertAt}%</b> ({money((BUDGET.limit * BUDGET.alertAt) / 100)})</span>
    </p>
    <Callout side="below" text="set once; the alert comes before the invoice, not after" />
  </div>
</Window>
