---
/** 04 — the incident page, from the first signal to "recovered", with the opt-in switch off. */
import Callout from '../Callout.astro';
import { INCIDENT, PROJECT } from '../data';
import Window from '../Window.astro';
import { OptInSwitch, PreviewButton, StatusBadge } from './ui';

const { release } = INCIDENT;
---

<Window title={`Console · ${PROJECT.name} · production · incidents · <b>${INCIDENT.id}</b>`}>
  <div class="hm-inc__head">
    <p class="hm-inc__badges">
      <StatusBadge tone="success" dot>Resolved</StatusBadge>
      <StatusBadge tone="danger">Error</StatusBadge>
      <StatusBadge tone="neutral" caps={false}>production</StatusBadge>
      <span class="hm-inc__id hm-mono">{INCIDENT.id}</span>
    </p>
    <h4 class="hm-screen__title hm-inc__title">{INCIDENT.title}</h4>
  </div>

  <div class="hm-inc__release-wrap">
    <p class="hm-inc__release">
      <b>{release.opened}</b>
      <span class="hm-inc__sep" aria-hidden="true">·</span>
      <span class="hm-mono">{release.version}</span>
      <span class="hm-inc__sep" aria-hidden="true">·</span>
      <span class="hm-mono">{release.commit}</span> — {release.message}
      <span class="hm-inc__sep" aria-hidden="true">·</span>
      previous release <span class="hm-mono">{release.previous}</span>
      <span class="hm-inc__sep" aria-hidden="true">·</span>
      config unchanged
      <span class="hm-inc__sep" aria-hidden="true">·</span>
      <span class="hm-inc__link">{release.changed}</span>
    </p>
    <Callout side="below" text="opened 4 minutes after deploy v41: the cause is in the picture" />
  </div>

  <ul class="hm-signals" aria-label="Signals" data-hm-phone="hide">
    {
      INCIDENT.signals.map((signal) => (
        <li class="hm-signal">
          <span class="hm-signal__kind">{signal.kind}</span>
          <span class="hm-signal__text">{signal.text}</span>
          <span class="hm-signal__meta">{signal.meta}</span>
        </li>
      ))
    }
  </ul>

  <div class="hm-inc__handoff">
    <PreviewButton variant="secondary" icon="copy">Copy details for agent</PreviewButton>
    <Callout side="right" text="one click gives your agent the evidence; you review the fix" />
  </div>

  <ol class="hm-timeline" aria-label="Timeline">
    {
      INCIDENT.timeline.map((event) => (
        <li class={`hm-tl hm-tl--${event.tone}`}>
          <span class="hm-tl__time hm-mono">{event.time}</span>
          <span class="hm-tl__mark" aria-hidden="true" />
          <span class="hm-tl__text">{event.text}</span>
        </li>
      ))
    }
  </ol>
  <Callout side="below" text="closed by the same checks that opened it" />

  <div class="hm-optin">
    <OptInSwitch label={INCIDENT.optIn} />
    <span class="hm-optin__text">
      <span class="hm-optin__what">{INCIDENT.optIn}</span>
      <span class="hm-optin__state">Opt-in. Off by default.</span>
    </span>
  </div>
</Window>
