---
/**
 * 01 · the wizard's Review screen. The file and the architecture diagram are two views of the same
 * app, so they share one window with a draggable divider between them.
 */
import Check from '../Check.astro';
import { ACME_CONFIG, CONFIG_LINE_COUNT, CONFIG_LINES, DECISIONS } from '../data';
import DiagramIsland from '../DiagramIsland';
import Frame from '../Frame.astro';
import GeneratedFile from '../GeneratedFile.astro';

const diagramLabel =
  'Architecture diagram of acme-project: web and apiService are public behind the firewall; worker, cache and mainDatabase are private inside the VPC';
---

<Frame url="<b>localhost:3000</b> · stacktape init · Review" tag="runs on your machine">
  <div class="rl-frame__body">
    <ol class="rl-steps" aria-label="Wizard steps">
      <li class="is-done">Start</li>
      <li class="is-done">Analyze</li>
      <li class="is-on">Review</li>
      <li>Deploy</li>
    </ol>
    <div class="rl-review__head">
      <div>
        <h3 class="rl-h rl-h--lg">Here's your app on AWS</h3>
        <p class="rl-p">A Next.js app with a background worker, using a Postgres database and a Redis cache.</p>
      </div>
      <span class="rl-chip rl-chip--ok"><i aria-hidden="true"></i>Opened 41 files in 38s, all on this machine</span>
    </div>

    <div class="rl-reveal" data-rl-reveal style="--reveal:46%">
      <div class="rl-reveal__picture">
        <span class="rl-reveal__loading" aria-hidden="true">architecture diagram</span>
        <DiagramIsland client:only="react" config={ACME_CONFIG} label={diagramLabel} />
        <button class="rl-reveal__tag rl-reveal__tag--picture" type="button" data-rl-snap="picture">
          Architecture · 14 AWS resources
        </button>
      </div>
      <div class="rl-reveal__file">
        <GeneratedFile lines={CONFIG_LINES} mode="pane" />
        <button class="rl-reveal__tag" type="button" data-rl-snap="file">stacktape.yml · {CONFIG_LINE_COUNT} lines</button>
      </div>
      <div
        class="rl-reveal__handle"
        role="slider"
        tabindex="0"
        aria-label="How much of the file to show; the rest is the architecture diagram"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="46"
        data-rl-handle
      >
        <span class="rl-reveal__grip" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
            <path d="M6 4 2.5 8 6 12M10 4l3.5 4L10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
      </div>
    </div>
    <p class="rl-reveal__hint">Drag the divider. The file on the left and the picture on the right describe the same 14 resources.</p>

    <div class="rl-two rl-review__grid">
      <div>
        <p class="rl-kicker">Decided for you</p>
        <ul class="rl-decided">
          {
            DECISIONS.map((decision) => (
              <li>
                <Check />
                <span>
                  <span class="rl-decided__s" set:html={decision.statement.replace(/`([^`]+)`/g, '<code>$1</code>')} />
                  <span class="rl-decided__d">{decision.detail}</span>
                </span>
                <span class="rl-wbtn rl-wbtn--ghost rl-wbtn--sm">Change</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rl-estimate">
        <div class="rl-estimate__row">
          <span><b>14</b> AWS resources</span>
          <span><b>~$112</b> per month</span>
        </div>
        <p class="rl-p rl-small">Estimated for the standard size, before any traffic. AWS bills you directly.</p>
        <hr class="rl-hr" />
        <p class="rl-kicker">Ready to deploy</p>
        <p class="rl-p rl-small">
          Deploying to AWS account <b>4128…9903</b> (acme-dev) as matus. 14 resources will be created. web and apiService get a public
          URL. Nothing else is reachable from the internet.
        </p>
        <span class="rl-wbtn rl-estimate__btn">Deploy</span>
      </div>
    </div>
  </div>
</Frame>

<script>
  for (const reveal of document.querySelectorAll<HTMLElement>('[data-rl-reveal]')) {
    const handle = reveal.querySelector<HTMLElement>('[data-rl-handle]');
    if (!handle) continue;
    const min = 6;
    const max = 94;
    const home = 46;
    let value = home;

    const apply = (next: number) => {
      value = Math.min(max, Math.max(min, next));
      reveal.style.setProperty('--reveal', `${value}%`);
      handle.setAttribute('aria-valuenow', String(Math.round(value)));
    };
    const fromPointer = (clientX: number) => {
      const box = reveal.getBoundingClientRect();
      apply(((clientX - box.left) / box.width) * 100);
    };

    handle.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      handle.setPointerCapture(event.pointerId);
      reveal.classList.add('is-dragging');
      fromPointer(event.clientX);
    });
    handle.addEventListener('pointermove', (event) => {
      if (reveal.classList.contains('is-dragging')) fromPointer(event.clientX);
    });
    const release = (event: PointerEvent) => {
      if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
      reveal.classList.remove('is-dragging');
    };
    handle.addEventListener('pointerup', release);
    handle.addEventListener('pointercancel', release);
    handle.addEventListener('dblclick', () => apply(home));
    handle.addEventListener('keydown', (event) => {
      const step = event.shiftKey ? 12 : 4;
      if (event.key === 'ArrowLeft') apply(value - step);
      else if (event.key === 'ArrowRight') apply(value + step);
      else if (event.key === 'Home') apply(min);
      else if (event.key === 'End') apply(max);
      else return;
      event.preventDefault();
    });

    // The corner labels snap the divider for anyone who would rather not drag.
    for (const snap of reveal.querySelectorAll<HTMLButtonElement>('[data-rl-snap]')) {
      snap.addEventListener('click', () => apply(snap.dataset.rlSnap === 'file' ? max : min));
    }
  }
</script>
