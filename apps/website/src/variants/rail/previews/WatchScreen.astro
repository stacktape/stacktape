---
/** 03 · observability: metric tiles, a trace waterfall, uptime by region, a live log line. */
import ConsoleNav from '../ConsoleNav.astro';
import Frame from '../Frame.astro';

const spark = (values: number[]) => {
  const max = Math.max(...values);
  const min = Math.min(...values);
  const span = max - min || 1;
  const points = values.map(
    (value, index) => `${((index / (values.length - 1)) * 100).toFixed(1)},${(26 - ((value - min) / span) * 22).toFixed(1)}`
  );
  return { line: points.join(' '), area: `M0,28 L${points.join(' L')} L100,28 Z` };
};

const metrics = [
  { label: 'Requests · apiService', value: '184', unit: '/s', data: spark([151, 160, 172, 168, 181, 176, 190, 184, 179, 188, 184]) },
  { label: 'p95 latency', value: '212', unit: 'ms', data: spark([230, 224, 218, 221, 215, 219, 209, 214, 210, 213, 212]) },
  { label: '5xx rate', value: '0.02', unit: '%', data: spark([0.03, 0.02, 0.02, 0.01, 0.02, 0.03, 0.02, 0.02, 0.01, 0.02, 0.02]) }
];

const spans = [
  { name: 'GET /orders', ms: 212, left: 0, width: 100, depth: 0 },
  { name: 'apiService handler', ms: 198, left: 3, width: 93, depth: 1 },
  { name: 'SELECT … FROM orders', ms: 48, left: 9, width: 23, depth: 2, db: true },
  { name: 'redis GET', ms: 2, left: 34, width: 1.5, depth: 2 },
  { name: 'POST /events', ms: 31, left: 61, width: 15, depth: 2 }
];
---

<Frame url="<b>console.stacktape.com</b> / acme-project / production / metrics">
  <div class="rl-console">
    <ConsoleNav active="Observability/Metrics" />
    <div class="rl-console__main">
      <p class="rl-crumb">acme-project · <b>production</b> · eu-west-1 · last 15 minutes</p>
      <ul class="rl-tabs" aria-label="Environment tabs">
        <li>Overview</li>
        <li>Activity</li>
        <li>Logs</li>
        <li class="is-on">Metrics</li>
        <li>Costs</li>
        <li>Configuration</li>
        <li>Danger zone</li>
      </ul>
      <div class="rl-metrics">
        {
          metrics.map((metric) => (
            <div class="rl-metric">
              <div class="rl-metric__l">{metric.label}</div>
              <div class="rl-metric__v">
                {metric.value}
                <small>{metric.unit}</small>
              </div>
              <svg class="rl-spark" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
                <path d={metric.data.area} />
                <polyline points={metric.data.line} />
              </svg>
            </div>
          ))
        }
      </div>
      <div class="rl-two rl-gap">
        <div>
          <p class="rl-kicker">Trace · GET /orders · 212 ms · OpenTelemetry</p>
          <ul class="rl-trace" aria-label="Trace waterfall">
            {
              spans.map((span) => (
                <li>
                  <span class="rl-trace__name" style={`--d:${span.depth}`}>
                    {span.depth === 0 ? <b>{span.name}</b> : span.name}
                  </span>
                  <span class="rl-trace__lane">
                    <i class={span.db ? 'is-db' : undefined} style={`--l:${span.left}%;--w:${span.width}%;--d:${span.depth}`} />
                  </span>
                  <span class="rl-trace__ms">{span.ms} ms</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="rl-kicker">Uptime · https://api.acme.com/health · 99.98% over 30 days</p>
          <ul class="rl-uptime">
            <li><span class="rl-dot" aria-hidden="true"></span><span>Ireland</span><span>up · 74 ms</span></li>
            <li><span class="rl-dot" aria-hidden="true"></span><span>Virginia</span><span>up · 118 ms</span></li>
            <li><span class="rl-dot" aria-hidden="true"></span><span>Singapore</span><span>up · 231 ms</span></li>
          </ul>
          <p class="rl-kicker rl-gap rl-hide-phone">Logs · live tail</p>
          <pre class="rl-log rl-hide-phone"><span class="t">14:36:02</span> apiService  <span class="ok">200</span> GET /orders 41ms
<span class="t">14:36:02</span> worker      job orders.sync done <span class="hi">128 rows</span>
<span class="t">14:36:03</span> apiService  <span class="ok">200</span> POST /checkout 118ms</pre>
        </div>
      </div>
      <p class="rl-p rl-small rl-gap-sm rl-hide-phone">
        Alarms on error rate, latency and uptime were created by the deploy. Alerts go to Slack, email or a webhook.
      </p>
    </div>
  </div>
</Frame>
