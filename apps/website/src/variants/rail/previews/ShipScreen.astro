---
/** 02 · the Console project: two environments, a production deploy in progress, a pull-request preview. */
import Check from '../Check.astro';
import ConsoleNav from '../ConsoleNav.astro';
import Frame from '../Frame.astro';
---

<Frame url="<b>console.stacktape.com</b> / acme-project">
  <div class="rl-console">
    <ConsoleNav active="Organization/Projects" />
    <div class="rl-console__main">
      <p class="rl-crumb">Projects · <b>acme-project</b> · github.com/acme/acme-project</p>
      <div class="rl-head">
        <h3 class="rl-h">acme-project</h3>
        <span class="rl-chip"><i aria-hidden="true"></i>2 environments · eu-west-1</span>
      </div>

      <div class="rl-stage rl-stage--busy">
        <span class="rl-stage__name">production <small>eu-west-1</small></span>
        <span class="rl-stage__sub">deploy #42 · v42 · push to main · e5f6a7b — production: run the migration hook after deploy</span>
        <span class="rl-stage__status rl-chip rl-chip--live"><i aria-hidden="true"></i>Deploying · 2m 10s</span>
      </div>
      <div class="rl-stage">
        <span class="rl-stage__name">staging <small>eu-west-1</small></span>
        <span class="rl-stage__sub">v42 · same commit, deployed from the staging branch</span>
        <span class="rl-stage__status rl-chip rl-chip--ok"><i aria-hidden="true"></i>Healthy · updated 2 hours ago</span>
      </div>

      <p class="rl-kicker rl-gap">Deploy #42 · production · started by a push to main</p>
      <ol class="rl-phases" aria-label="Deploy phases">
        <li class="is-done">
          <Check kind="ok" label="done" />
          <span class="rl-phases__name">Initialize</span>
          <span class="rl-phases__detail">account 4128…9903 (acme-dev) · eu-west-1 · 3s</span>
        </li>
        <li class="is-done">
          <Check kind="ok" label="done" />
          <span class="rl-phases__name">Package</span>
          <span class="rl-phases__detail">web 41s · apiService 58s · worker 6s · built on the runner in your account, caches warm</span>
        </li>
        <li class="is-on">
          <Check kind="live" label="in progress" />
          <span class="rl-phases__name">Deploy</span>
          <span class="rl-phases__detail">
            21 of 33 resources · rolling apiService, new instances pass their health check before old ones drain
            <span class="rl-bar rl-bar--live" style="--w:64%"><i></i></span>
          </span>
        </li>
        <li>
          <Check kind="idle" label="pending" />
          <span class="rl-phases__name">Outputs</span>
          <span class="rl-phases__detail">https://acme.com · https://api.acme.com</span>
        </li>
      </ol>
      <p class="rl-p rl-small rl-gap-sm">
        Zero downtime, and v41 stays ready for a one-click rollback. Builds run on a build runner in your AWS account (c7a.2xlarge) that
        keeps its caches between runs and stops after 15 minutes idle.
      </p>

      <hr class="rl-hr" />
      <p class="rl-kicker">Pull request preview</p>
      <div class="rl-pr">
        <Check kind="ok" label="preview up" />
        <span>
          <b>#128 · checkout: retry payment webhook</b>
          <span>environment pr-128 · https://pr-128.acme-preview.com · its own database and cache · removed when the pull request closes</span>
        </span>
        <span class="rl-chip rl-chip--ok"><i aria-hidden="true"></i>up · 1m 21s</span>
      </div>
    </div>
  </div>
</Frame>
