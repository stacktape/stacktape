---
/** 06 · costs: month-to-date per resource from the customer's AWS cost data, and the budget. */
import ConsoleNav from '../ConsoleNav.astro';
import Frame from '../Frame.astro';

const rows = [
  { name: 'mainDatabase', label: 'Aurora PostgreSQL', value: 61.4 },
  { name: 'apiService', label: 'Fargate · 2 instances', value: 34.2 },
  { name: 'cache', label: 'ElastiCache Redis', value: 11.9 },
  { name: 'web', label: 'Lambda + CloudFront', value: 3.8 },
  { name: 'worker', label: 'Lambda', value: 0.7 },
  { name: 'other', label: 'private network, logs, jump box', value: 0.9 }
];
const total = rows.reduce((sum, row) => sum + row.value, 0);
const max = Math.max(...rows.map((row) => row.value));
const budget = 150;
const alertAt = 0.8;
const used = (total / budget) * 100;
---

<Frame url="<b>console.stacktape.com</b> / acme-project / production / costs">
  <div class="rl-console">
    <ConsoleNav active="Organization/Costs" />
    <div class="rl-console__main">
      <p class="rl-crumb">acme-project · <b>production</b> · Costs</p>
      <ul class="rl-tabs" aria-label="Environment tabs">
        <li>Overview</li>
        <li>Activity</li>
        <li>Logs</li>
        <li>Metrics</li>
        <li class="is-on">Costs</li>
        <li>Configuration</li>
        <li>Danger zone</li>
      </ul>
      <div class="rl-total">
        <span class="rl-total__n">${total.toFixed(2)}</span>
        <span class="rl-total__l">month to date · from your AWS cost data</span>
      </div>
      <ul class="rl-costs rl-gap" aria-label="Cost per resource">
        {
          rows.map((row, index) => (
            <li>
              <span class="rl-costs__n">
                {row.name} <small>{row.label}</small>
              </span>
              <span class="rl-bar" style={`--w:${((row.value / max) * 100).toFixed(1)}%;--i:${index}`}>
                <i />
              </span>
              <span class="rl-costs__v">${row.value.toFixed(2)}</span>
            </li>
          ))
        }
      </ul>
      <hr class="rl-hr" />
      <p class="rl-kicker">Budget · ${budget} per month · alert at {alertAt * 100}%</p>
      <span class="rl-bar rl-bar--budget" style={`--w:${used.toFixed(1)}%`} role="img" aria-label={`$${total.toFixed(2)} of the $${budget} budget used`}>
        <i></i>
        <span class="rl-bar__mark" style={`--at:${alertAt * 100}%`}></span>
      </span>
      <p class="rl-p rl-small rl-gap-sm">
        {used.toFixed(0)}% used. The warning goes to #ops on Slack at ${(budget * alertAt).toFixed(0)}. AWS bills you directly; Stacktape's
        subscription is separate.
      </p>
    </div>
  </div>
</Frame>
