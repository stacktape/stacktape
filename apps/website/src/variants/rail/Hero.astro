---
/**
 * The split begins immediately. Left: what Stacktape is and the one thing to do. Right: proof that
 * the file was written for you, then the index of the six things the page explains.
 */
import CommandBox from './CommandBox.astro';
import { EYEBROW, FEATURES, HERO_LINES, HERO_TRUST, PHONE_LINES, PHONE_START, SUBHEADLINE } from './data';
import GeneratedFile from './GeneratedFile.astro';
---

<section class="rl-hero rl-split" aria-labelledby="rl-hero-title">
  <div class="rl-cell rl-cell--you rl-cell--rule">
    <div class="rl-cell__in">
      <p class="rl-hero__eyebrow rl-mono">{EYEBROW}</p>
      <h1 class="rl-hero__title" id="rl-hero-title">AWS DevOps, <em>fully automated.</em></h1>
      <p class="rl-hero__sub">{SUBHEADLINE}</p>
      <CommandBox id="rl-hero-cmd" />
      <p class="rl-hero__trust">{HERO_TRUST}</p>
      <div class="rl-hero__phone">
        <p class="rl-proof__caption">
          The file <code>npx stacktape init</code> writes for an example app. Each badge says where a line came from.
        </p>
        <GeneratedFile lines={PHONE_LINES} start={PHONE_START} />
      </div>
    </div>
  </div>
  <div class="rl-cell rl-cell--stp rl-cell--rule">
    <div class="rl-cell__in">
      <div class="rl-proof">
        <div class="rl-proof__head">
          <span class="rl-mono">The file it writes for you</span>
          <span class="rl-proof__sub">acme-project · an example · nothing exists on AWS yet</span>
        </div>
        <GeneratedFile lines={HERO_LINES} class="rl-proof__file" />
        <p class="rl-proof__caption">
          <code>npx stacktape init</code> read the example repository on this machine, a Next.js app with a background worker, a Postgres
          database and a Redis cache, and wrote this file: what runs where, how it connects, and the production defaults. Each badge says
          where a line came from. Read it, change anything, then press Deploy. Nothing exists on AWS until you do.
        </p>
      </div>
      <nav class="rl-index" aria-labelledby="rl-index-title">
        <p class="rl-index__head rl-mono" id="rl-index-title">Six things it does, on this page</p>
        <ol class="rl-index__list">
          {
            FEATURES.map((feature) => (
              <li>
                <a href={`#f-${feature.id}`}>
                  <span class="rl-index__n">{feature.number}</span>
                  <b>{feature.name}</b>
                  <span class="rl-index__s">{feature.short}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </div>
</section>
