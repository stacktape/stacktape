---
/** The Console sidebar with the real navigation labels. `active` is "Group/Item" or a top-level item. */
type Props = { active: string };

const { active } = Astro.props;

const groups: { title?: string; items: string[] }[] = [
  { items: ['Overview', 'Config editor'] },
  { title: 'Organization', items: ['Projects', 'Activity', 'Users', 'Costs'] },
  { title: 'Observability', items: ['Logs', 'Metrics', 'Traces', 'Uptime', 'Synthetics', 'Error tracking', 'Incidents'] },
  { title: 'Alerting', items: ['Channels', 'Notifications', 'Alarms', 'Budgets'] },
  { title: 'Security', items: ['Overview', 'Vulnerabilities', 'Posture'] },
  { title: 'Configuration', items: ['Guardrails', 'Secrets', 'SSM Params', 'AWS Accounts', 'Domains'] }
];

const isActive = (group: { title?: string }, item: string) =>
  group.title ? `${group.title}/${item}` === active : item === active;
---

<nav class="rl-console__nav" aria-label="Console navigation">
  {
    groups.map((group) => (
      <>
        {group.title && <div class="rl-console__group">{group.title}</div>}
        <ul>
          {group.items.map((item) => (
            <li class={isActive(group, item) ? 'is-on' : undefined}>{item}</li>
          ))}
        </ul>
      </>
    ))
  }
</nav>
