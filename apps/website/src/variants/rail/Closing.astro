---
import CommandBox from './CommandBox.astro';
import { LINKS, TRUST_LINE } from './data';
---

<section class="rl-close" aria-labelledby="rl-close-title">
  <div class="rl-close__in">
    <p class="rl-mono rl-close__kicker">Start with one command</p>
    <h2 class="rl-close__title" id="rl-close-title">That is <em>the whole DevOps job.</em></h2>
    <p class="rl-close__text">
      Run it on your machine. Nothing is created on AWS and nothing is billed until you press Deploy, and the Deploy step names the
      account it is about to touch before it touches it.
    </p>
    <CommandBox id="rl-close-cmd" />
    <p class="rl-close__trust">{TRUST_LINE}</p>
    <a class="rl-close__signin" href={LINKS.signIn}>Sign in to the Console</a>
  </div>
</section>
