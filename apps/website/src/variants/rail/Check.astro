---
/** A small status mark. `brand` is the default tick; `maybe` is the hollow "only if needed" mark. */
type Props = { kind?: 'ok' | 'warn' | 'err' | 'idle' | 'live' | 'brand' | 'maybe'; label?: string; class?: string };

const { kind = 'brand', label, class: className } = Astro.props;
const showsTick = kind === 'ok' || kind === 'brand';
---

<span
  class={['rl-check', `rl-check--${kind}`, className].filter(Boolean).join(' ')}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {
    kind === 'warn' ? (
      <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M5 2.2v3.4M5 7.8v.1" />
      </svg>
    ) : kind === 'err' ? (
      <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M3 3l4 4M7 3l-4 4" />
      </svg>
    ) : showsTick ? (
      <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path class="rl-check__path" d="M2 5.2 4.2 7.3 8 3" />
      </svg>
    ) : null
  }
</span>
