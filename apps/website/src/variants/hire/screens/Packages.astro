---
/** 02 — the package phase of a deploy: two workloads built in parallel, one skipped because nothing changed. */
import { DEPLOY_COMMAND, PACKAGE, TERMINAL_TITLE } from '../data';
import Window from '../Window.astro';
---

<Window kind="terminal" title={TERMINAL_TITLE}>
  <div class="hr-term">
    <p class="hr-term__cmd"><span class="hr-term__prompt">$</span> {DEPLOY_COMMAND}</p>

    <p class="hr-term__phase hr-term__phase--done">
      <i aria-hidden="true">✓</i>
      <span>Initialize</span>
      <span class="hr-term__dim">2 s</span>
    </p>

    <p class="hr-term__phase hr-term__phase--done">
      <i aria-hidden="true">✓</i>
      <span>Package</span>
      <span class="hr-term__dim">58 s</span>
    </p>

    <ul class="hr-term__rows" aria-label="Packaged workloads">
      {
        PACKAGE.rows.map((row) => (
          <li class={row.skipped ? 'hr-term__row hr-term__row--skipped' : 'hr-term__row'}>
            <i aria-hidden="true">{row.skipped ? '–' : '✓'}</i>
            <b>{row.name}</b>
            <span class="hr-term__kind">{row.kind}</span>
            <span class="hr-term__result">{row.result}</span>
            <span class="hr-term__time">{row.time}</span>
          </li>
        ))
      }
    </ul>
    <p class="hr-term__sum">{PACKAGE.summary}</p>

    <p class="hr-term__phase hr-term__phase--active">
      <i aria-hidden="true">●</i>
      <span>{PACKAGE.next}</span>
      <span class="hr-term__dim">starting…</span>
    </p>
    <p class="hr-term__phase hr-term__phase--todo">
      <i aria-hidden="true"></i>
      <span>Outputs</span>
    </p>
  </div>
</Window>
