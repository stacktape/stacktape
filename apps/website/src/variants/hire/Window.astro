---
/**
 * A product window. A browser window carries three dots and the URL pill (a lock when the address
 * is on the public internet, none for the wizard on the visitor's own machine); a terminal window
 * carries three dots and its title. Nothing else identifies a screen.
 */
type Props =
  | { kind: 'browser'; host: string; path: string; lock?: boolean; class?: string }
  | { kind: 'terminal'; title: string; class?: string };

const props = Astro.props;
const className = ['hr-win', `hr-win--${props.kind}`, props.class].filter(Boolean).join(' ');
const lock = props.kind === 'browser' ? (props.lock ?? true) : false;
---

<div class={className}>
  <div class="hr-win__bar">
    <span class="hr-win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    {
      props.kind === 'browser' ? (
        <span class="hr-win__url">
          {lock && (
            <svg class="hr-win__lock" viewBox="0 0 16 16" width="11" height="11" fill="none" aria-hidden="true">
              <rect x="3" y="7" width="10" height="7" rx="2" stroke="currentColor" stroke-width="1.5" />
              <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          )}
          <span class="hr-win__addr">
            <b>{props.host}</b>{props.path}
          </span>
        </span>
      ) : (
        <span class="hr-win__title">{props.title}</span>
      )
    }
    <span class="hr-win__spacer" aria-hidden="true"></span>
  </div>
  <div class="hr-win__body">
    <slot />
  </div>
</div>
