---
import { TESTIMONIALS, VOICES_TITLE } from './data';
---

<section class="ky-voices" aria-labelledby="ky-voices-title">
  <div class="ky-container">
    <h2 class="ky-voices__title" id="ky-voices-title">{VOICES_TITLE}</h2>
    <ul class="ky-voices__list">
      {
        TESTIMONIALS.map((item) => (
          <li class="ky-voice">
            <blockquote class="ky-voice__quote">
              <p>“{item.quote}”</p>
            </blockquote>
            <div class="ky-voice__who">
              <span class="ky-voice__name">{item.name}</span>
              <span class="ky-voice__role">{item.role}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
