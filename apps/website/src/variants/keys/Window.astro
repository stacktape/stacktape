---
/**
 * The window a screen stands in: the Console's element surface with a floating shadow, a slim
 * title bar only where it helps orientation, then one focused screen area. No navigation, no
 * sidebar, no browser tabs: each stage shows one screen, not the whole application.
 */
type Props = { title?: string; class?: string };

const { title, class: className } = Astro.props;
---

<div class:list={['ky-win', className]}>
  {
    (title || Astro.slots.has('bar')) && (
      <div class="ky-win__bar">
        <span class="ky-win__dots" aria-hidden="true">
          <i />
          <i />
          <i />
        </span>
        {title && <span class="ky-win__title" set:html={title} />}
        <slot name="bar" />
      </div>
    )
  }
  <div class="ky-win__body">
    <slot />
  </div>
</div>
