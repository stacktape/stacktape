---
import { ButtonLink } from '@stacktape/ui-react/button';
import Logo from '../../components/Logo.astro';
import { LINKS } from './data';
---

<header class="ky-nav" data-ky-nav>
  <div class="ky-container ky-nav__inner">
    <a class="ky-nav__logo" href="/" aria-label="Stacktape home"><Logo height={24} /></a>
    <nav aria-label="Primary">
      <ul class="ky-nav__links">
        <li><a class="ky-nav__link ky-nav__link--phone-optional" href={LINKS.docs}>Docs</a></li>
        <li><a class="ky-nav__link ky-nav__link--optional" href={LINKS.github}>GitHub</a></li>
        <li><a class="ky-nav__link" href={LINKS.console}>Sign in</a></li>
        <li>
          <ButtonLink className="ky-nav__demo" href={LINKS.demo} variant="secondary">Book a demo</ButtonLink>
        </li>
      </ul>
    </nav>
  </div>
</header>
