---
/** 04 — the posture ring with its three findings, and the guardrails that are on. */
import { POSTURE, PROJECT } from '../data';
import Window from '../Window.astro';
import { PreviewButton, StatusBadge } from './ui';

const RADIUS = 34;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
const passingArc = (POSTURE.passing / POSTURE.total) * CIRCUMFERENCE;
---

<Window title={`<b>${PROJECT.name}</b> · production · security`}>
  <div class="ky-posture">
    <svg class="ky-ring" viewBox="0 0 80 80" width="80" height="80" aria-hidden="true">
      <circle cx="40" cy="40" r={RADIUS} class="ky-ring__track"></circle>
      <circle
        cx="40"
        cy="40"
        r={RADIUS}
        class="ky-ring__value"
        stroke-dasharray={`${passingArc.toFixed(2)} ${CIRCUMFERENCE.toFixed(2)}`}
        transform="rotate(-90 40 40)"></circle>
    </svg>
    <div class="ky-posture__num">
      <p class="ky-posture__big"><b>{POSTURE.passing}</b> of {POSTURE.total}</p>
      <p class="ky-posture__sub">checks passing</p>
    </div>
  </div>

  <ul class="ky-findings" aria-label="Findings">
    {
      POSTURE.findings.map((item) => (
        <li class="ky-finding">
          <span class="ky-finding__mark" aria-hidden="true" />
          <span class="ky-finding__what">{item.finding}</span>
          <span class="ky-finding__action">
            {'badge' in item && (
              <StatusBadge tone="success" dot>
                {item.badge}
              </StatusBadge>
            )}
            <PreviewButton variant="secondary" small>
              {item.action}
            </PreviewButton>
          </span>
        </li>
      ))
    }
  </ul>

  <div class="ky-guard">
    <span class="ky-panel__title">Guardrails on</span>
    <p class="ky-guard__chips">
      {
        POSTURE.guardrails.map((rule) => (
          <StatusBadge tone="brand" caps={false}>
            {rule}
          </StatusBadge>
        ))
      }
    </p>
    <p class="ky-guard__line">{POSTURE.guardrailsLine}</p>
  </div>
</Window>
