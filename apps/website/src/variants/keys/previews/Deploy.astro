---
/**
 * 02 — the deploy, finished: the two live URLs large, the time and the account they landed in, the
 * phases as a done checklist, and what deploying looks like from now on.
 */
import { DEPLOY, PROJECT } from '../data';
import Window from '../Window.astro';
import { PreviewButton, StatusBadge } from './ui';
---

<Window title="localhost:3000 · <b>stacktape init</b>">
  <ol class="ky-rail" slot="bar" aria-label="Wizard steps">
    <li>Start</li>
    <li>Read</li>
    <li>Review</li>
    <li class="is-current" aria-current="step">Deploy</li>
  </ol>

  <div class="ky-live">
    <div class="ky-live__head">
      <StatusBadge tone="success" dot>Live</StatusBadge>
      <h4 class="ky-screen__title">It's live</h4>
    </div>
    <ul class="ky-live__urls">
      <li><span class="ky-live__url">{PROJECT.urls.web}</span><span class="ky-live__res">web</span></li>
      <li><span class="ky-live__url">{PROJECT.urls.api}</span><span class="ky-live__res">apiService</span></li>
    </ul>
    <p class="ky-live__meta">{DEPLOY.meta}</p>
  </div>

  <ol class="ky-phases" aria-label="Deploy phases">
    {
      DEPLOY.phases.map((phase) => (
        <li class="ky-phase">
          <span class="ky-phase__mark" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="10" height="10" fill="none">
              <path d="m2.5 6.3 2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="ky-phase__name">{phase.name}</span>
          <span class="ky-phase__note ky-mono">{phase.note}</span>
        </li>
      ))
    }
  </ol>

  <div class="ky-after">
    <span class="ky-panel__title">From now on</span>
    <ul class="ky-after__list">
      {
        DEPLOY.fromNowOn.map((item) => (
          <li class="ky-after__item">
            <span class="ky-mono ky-after__from">{item.from}</span>
            <span class="ky-after__arrow" aria-hidden="true">→</span>
            <span class="ky-after__to">{item.to}</span>
          </li>
        ))
      }
    </ul>
    <PreviewButton variant="secondary" small>{DEPLOY.rollback}</PreviewButton>
  </div>
</Window>
