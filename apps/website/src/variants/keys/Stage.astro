---
/**
 * One stage: the title block at the top-left, and below it the window, which stands up from the
 * floor as it scrolls into view. Where the visitor makes a decision, a keycap stands on the floor
 * in front of the window's bottom-left corner, with a small floor plate beside it.
 */
import type { Stage } from './data';
import Key from './Key.astro';

type Props = { stage: Stage };

const { stage } = Astro.props;
const { number, id, name, text, tone, key } = stage;
---

<section class="ky-stage" id={id} data-ky-stage={number} data-tone={tone} aria-labelledby={`${id}-title`}>
  <div class="ky-container">
    <div class="ky-stage__head">
      <span class="ky-stage__num ky-mono" aria-hidden="true">{number}</span>
      <h2 class="ky-stage__title" id={`${id}-title`}>{name}</h2>
      <p class="ky-stage__text">{text}</p>
    </div>
    <div class:list={['ky-stage__screen', key && 'ky-stage__screen--keyed']}>
      <div class="ky-stage__window">
        <slot />
      </div>
      {key && <Key class="ky-stage__key" label={key.label} mono={key.mono} plate={key.plate} />}
    </div>
  </div>
</section>
