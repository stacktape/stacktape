---
/**
 * One of the six sections: the sparse "You" statement on the left, the story and the product
 * screen on the right. The left column stays sticky while the taller right column scrolls past.
 */
import type { Section } from './data';
import { inline } from './data';

type Props = { section: Section };

const { section } = Astro.props;
const { index, id, name, lead, you } = section;
---

<section class="du-sec" id={id} data-du-enter aria-labelledby={`${id}-name`}>
  <div class="du-sec__in">
    <div class="du-you">
      <div class="du-you__in">
        <p class="du-you__label">
          <span class="du-dot du-dot--you" aria-hidden="true"></span>
          <span>You</span>
          <span class="du-you__idx" aria-hidden="true">{index}</span>
        </p>
        {
          you.nothing ? (
            <p class="du-you__say du-you__say--nothing">
              <span class="du-you__dash" aria-hidden="true">—</span>
              <span>Nothing to do.</span>
            </p>
          ) : (
            <p class="du-you__say" set:html={inline(you.say)} />
          )}
        {you.detail && <p class="du-you__how" set:html={inline(you.detail)} />}
      </div>
    </div>
    <div class="du-stp">
      <p class="du-stp__idx">
        <span class="du-dot du-dot--stp" aria-hidden="true"></span>
        <span class="du-stp__who">Stacktape</span>
        <span class="du-stp__num" aria-hidden="true">{index}</span>
      </p>
      <h2 class="du-stp__name" id={`${id}-name`}>{name}</h2>
      <p class="du-stp__lead" set:html={inline(lead)} />
      <div class="du-stp__ui">
        <slot />
      </div>
    </div>
  </div>
</section>
