---
/** The two voices, named once and kept in view: gold for you, teal for Stacktape. */
---

<div class="du-cols">
  <div class="du-cols__in">
    <p class="du-cols__you">
      <span class="du-dot du-dot--you" aria-hidden="true"></span>
      <strong>You</strong>
      <span class="du-cols__sub">what you do</span>
    </p>
    <p class="du-cols__stp">
      <span class="du-dot du-dot--stp" aria-hidden="true"></span>
      <strong>Stacktape</strong>
      <span class="du-cols__sub">what it does for you</span>
    </p>
  </div>
</div>
