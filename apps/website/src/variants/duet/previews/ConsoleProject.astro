---
/** 02 — the Console project page: two environments, a deploy in progress, a pull-request preview. */
import Frame from '../Frame.astro';
import { PHASES, PROJECT, RESOURCES } from '../data';
import ResourceIconIsland from './ResourceIconIsland';
---

<Frame url={`console.stacktape.com/projects/<b>${PROJECT.name}</b>`} active="Projects">
  <div class="du-project">
    <p class="du-crumbs"><span>Projects</span><span aria-hidden="true">›</span><b>{PROJECT.name}</b></p>
    <div class="du-project__head">
      <h3 class="du-project__name">{PROJECT.name}</h3>
      <span class="du-chip du-chip--mono">
        <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true">
          <path
            d="M8 .8a7.2 7.2 0 0 0-2.3 14c.4.1.5-.1.5-.3v-1.3c-2 .4-2.4-.9-2.4-.9-.3-.8-.8-1-.8-1-.7-.5 0-.5 0-.5.7.1 1.1.8 1.1.8.7 1.1 1.7.8 2.1.6.1-.5.3-.8.5-1-1.6-.2-3.3-.8-3.3-3.6 0-.8.3-1.4.7-1.9-.1-.2-.3-.9.1-1.9 0 0 .6-.2 2 .7a6.9 6.9 0 0 1 3.6 0c1.4-.9 2-.7 2-.7.4 1 .2 1.7.1 1.9.5.5.7 1.1.7 1.9 0 2.8-1.7 3.4-3.3 3.6.3.2.5.7.5 1.3v2c0 .2.1.4.5.3A7.2 7.2 0 0 0 8 .8Z"
          ></path>
        </svg>
        {PROJECT.repo}
      </span>
      <span class="du-chip du-chip--mono">{PROJECT.region}</span>
    </div>
    <p class="du-project__summary">{PROJECT.summary}</p>

    <div class="du-project__grid">
      <div class="du-project__envs">
        <p class="du-panel__title">Environments</p>
        <div class="du-env">
          <div class="du-env__row">
            <span class="du-env__name">staging</span>
            <span class="du-chip du-chip--ok"><i class="du-chip__dot" aria-hidden="true"></i>Live</span>
            <span class="du-env__meta">v42 · {PROJECT.region} · 12 min ago</span>
          </div>
          <p class="du-env__url">https://staging.acme.com</p>
        </div>
        <div class="du-env du-env--deploying">
          <div class="du-env__row">
            <span class="du-env__name">production</span>
            <span class="du-chip du-chip--busy"><i class="du-chip__dot" aria-hidden="true"></i>Deploying…</span>
            <span class="du-env__meta">v42 · {PROJECT.region} · 1m 40s</span>
          </div>
          <p class="du-env__url">https://acme.com · https://api.acme.com</p>
          <div class="du-progress" role="progressbar" aria-label="Deploy progress" aria-valuenow="21" aria-valuemin="0" aria-valuemax="33">
            <span class="du-progress__bar" style="width: 64%"></span>
          </div>
        </div>

        <p class="du-panel__title du-panel__title--gap">Resources</p>
        <ul class="du-resources">
          {
            RESOURCES.map((resource) => (
              <li class={`du-resource du-resource--${resource.category}`}>
                <span class="du-resource__icon">
                  <ResourceIconIsland client:only="react" type={resource.type} />
                </span>
                <span class="du-resource__text">
                  <span class="du-resource__name">{resource.name}</span>
                  <span class="du-resource__type">{resource.type}</span>
                  <span class="du-resource__detail">{resource.detail}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="du-project__side">
        <div class="du-side">
          <p class="du-panel__title">Deploy #42 · production</p>
          <p class="du-side__trigger">push to <code>main</code> · <span class="du-mono">c9e41f0</span> orders: apply pending migration</p>
          <ol class="du-phases">
            {
              PHASES.map((phase) => (
                <li class={`du-phase du-phase--${phase.state}`}>
                  <span class="du-phase__mark" aria-hidden="true">
                    {phase.state === 'done' && (
                      <svg viewBox="0 0 12 12" width="10" height="10" fill="none">
                        <path d="m2.5 6.3 2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                  </span>
                  <span class="du-phase__name">{phase.name}</span>
                  <span class="du-phase__note">{phase.note}</span>
                </li>
              ))
            }
          </ol>
          <p class="du-side__runner">Builds run on a build runner inside your AWS account. It keeps caches between runs and stops after 15 minutes idle.</p>
        </div>

        <div class="du-side">
          <p class="du-panel__title">Pull requests</p>
          <div class="du-pr">
            <p class="du-pr__title"><span class="du-mono">#128</span> checkout: retry payment webhook</p>
            <p class="du-pr__preview">
              <span class="du-chip du-chip--ok"><i class="du-chip__dot" aria-hidden="true"></i>preview</span>
              <span class="du-mono">pr-128</span>
              <span class="du-pr__arrow" aria-hidden="true">→</span>
              <span class="du-pr__url">https://pr-128.acme-preview.com</span>
            </p>
            <p class="du-pr__note">Its own copy of the whole app. Removed when the pull request closes.</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Frame>
