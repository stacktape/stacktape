---
/** 03 — metrics tiles, a trace waterfall, uptime by region and a live log line. */
import Frame from '../Frame.astro';
import { METRICS, PROJECT, TRACE, UPTIME } from '../data';

const sparkline = (points: readonly number[]) => {
  const max = Math.max(...points);
  const min = Math.min(...points);
  const range = Math.max(1, max - min);
  return points
    .map((point, index) => {
      const x = (index / (points.length - 1)) * 100;
      const y = 30 - ((point - min) / range) * 24;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
};

const pct = (value: number) => `${((value / TRACE.total) * 100).toFixed(2)}%`;
---

<Frame url={`console.stacktape.com/projects/${PROJECT.name}/<b>production</b>/metrics`} active="Metrics">
  <div class="du-obs">
    <div class="du-obs__head">
      <p class="du-crumbs"><span>{PROJECT.name}</span><span aria-hidden="true">›</span><span>production</span><span aria-hidden="true">›</span><b>apiService</b></p>
      <span class="du-chip du-chip--mono">last 1 hour</span>
    </div>

    <div class="du-tiles">
      {
        METRICS.map((metric) => (
          <div class="du-tile">
            <p class="du-tile__label">{metric.label}</p>
            <p class="du-tile__value">
              {metric.value}<span class="du-tile__unit">{metric.unit}</span>
            </p>
            <svg class="du-spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
              <polyline points={sparkline(metric.points)} fill="none" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke" />
            </svg>
          </div>
        ))
      }
    </div>

    <div class="du-obs__grid">
      <div class="du-panel">
        <div class="du-panel__row">
          <p class="du-panel__title">Trace</p>
          <p class="du-panel__meta"><span class="du-mono">{TRACE.name}</span> · {TRACE.total} ms</p>
        </div>
        <ol class="du-trace">
          {
            TRACE.spans.map((span) => (
              <li class={`du-trace__row du-trace__row--${span.kind}`}>
                <span class="du-trace__name">{span.name}</span>
                <span class="du-trace__lane">
                  <span class="du-trace__bar" style={`left: ${pct(span.start)}; width: ${pct(span.duration)}`} />
                </span>
                <span class="du-trace__ms">{span.duration} ms</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="du-panel">
        <div class="du-panel__row">
          <p class="du-panel__title">Uptime</p>
          <p class="du-panel__meta">https://api.acme.com/health · 99.98% over 30 days</p>
        </div>
        <ul class="du-uptime">
          {
            UPTIME.map((check) => (
              <li class="du-uptime__row">
                <span class="du-chip du-chip--ok"><i class="du-chip__dot" aria-hidden="true"></i>Up</span>
                <span class="du-uptime__region">{check.region}</span>
                <span class="du-uptime__code">{check.code}</span>
                <span class="du-uptime__ms">{check.latency}</span>
              </li>
            ))
          }
        </ul>
        <div class="du-log">
          <span class="du-log__live"><i aria-hidden="true"></i>Live</span>
          <span class="du-log__line">
            <span class="du-log__time">15:41:07.412</span>
            <span class="du-log__src">apiService</span>
            <span class="du-log__level">INFO</span>
            <span>GET /orders 200 · 212 ms · trace 3fa9c1</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</Frame>
