---
/** 06 — per-resource cost bars from the AWS bill, and the budget. */
import Frame from '../Frame.astro';
import { BUDGET, COST_TOTAL, COSTS, PROJECT } from '../data';

const largest = Math.max(...COSTS.map((cost) => cost.amount));
const money = (amount: number) => `$${amount.toFixed(2)}`;
const used = (COST_TOTAL / BUDGET.limit) * 100;
---

<Frame url={`console.stacktape.com/projects/${PROJECT.name}/<b>production</b>/costs`} active="Costs">
  <div class="du-cost">
    <div class="du-cost__head">
      <p class="du-crumbs"><span>{PROJECT.name}</span><span aria-hidden="true">›</span><b>production</b></p>
      <span class="du-chip du-chip--mono">month to date</span>
    </div>

    <div class="du-cost__grid">
      <div class="du-panel">
        <div class="du-panel__row">
          <p class="du-panel__title">Cost by resource</p>
          <p class="du-cost__total">{money(COST_TOTAL)}</p>
        </div>
        <ul class="du-bars">
          {
            COSTS.map((cost) => (
              <li class="du-bar">
                <span class="du-bar__name">{cost.name}</span>
                <span class="du-bar__lane">
                  <span class="du-bar__fill" style={`width: ${((cost.amount / largest) * 100).toFixed(1)}%`} />
                </span>
                <span class="du-bar__amount">{money(cost.amount)}</span>
              </li>
            ))
          }
        </ul>
        <p class="du-cost__source">From your own AWS cost data. AWS bills you directly.</p>
      </div>

      <div class="du-panel du-budget">
        <div class="du-panel__row">
          <p class="du-panel__title">Budget</p>
          <p class="du-panel__meta">production</p>
        </div>
        <p class="du-budget__num"><b>{money(BUDGET.limit)}</b> / month</p>
        <div class="du-budget__lane" role="img" aria-label={`${money(COST_TOTAL)} of ${money(BUDGET.limit)} used; alert at ${BUDGET.alertAt}%`}>
          <span class="du-budget__fill" style={`width: ${used.toFixed(1)}%`}></span>
          <span class="du-budget__mark" style={`left: ${BUDGET.alertAt}%`}></span>
        </div>
        <p class="du-budget__legend">
          <span><b>{used.toFixed(0)}%</b> used</span>
          <span>alert at <b>{BUDGET.alertAt}%</b> ({money((BUDGET.limit * BUDGET.alertAt) / 100)})</span>
        </p>
        <p class="du-side__note">When spend crosses the threshold, you hear about it in Slack, email or a webhook.</p>
      </div>
    </div>
  </div>
</Frame>
