---
/**
 * 01 — the wizard's Review screen. The configuration file and the architecture diagram are two
 * views of the same app; a draggable divider decides how much of each you see.
 */
import { ACME_CONFIG, ACME_YAML, DECIDED, highlightYaml } from '../data';
import DiagramIsland from './DiagramIsland';

const file = highlightYaml(ACME_YAML);
const DIAGRAM_LABEL =
  'Architecture diagram of acme-project: web and apiService are public behind the firewall; worker, cache and mainDatabase sit inside the private network';
---

<div class="du-review">
  <div class="du-win du-wizard" data-du-reveal-box style="--reveal: 50%">
    <div class="du-win__bar du-wizard__bar">
      <span class="du-win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="du-win__url">localhost:3000 · <b>stacktape init</b></span>
      <ol class="du-wizard__steps" aria-label="Wizard steps">
        <li>Start</li>
        <li>Analyze</li>
        <li class="is-current" aria-current="step">Review</li>
        <li>Deploy</li>
      </ol>
      <span class="du-tag">example project</span>
    </div>

    <div class="du-wizard__head">
      <h3 class="du-wizard__title">Here's your app on AWS</h3>
      <p class="du-wizard__sub">Opened 41 files in 38s, all on this machine. Nothing has been created yet.</p>
    </div>

    <div class="du-reveal">
      <div class="du-reveal__picture">
        <span class="du-reveal__badge du-reveal__badge--right">Architecture · what Stacktape will create</span>
        <div class="du-reveal__canvas">
          <DiagramIsland client:only="react" config={ACME_CONFIG} ariaLabel={DIAGRAM_LABEL} />
        </div>
      </div>

      <div class="du-reveal__file">
        <div class="du-editor">
          <div class="du-editor__tab">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
              <path d="M4 1.5h5.5L13 5v9.5H4z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
              <path d="M9.5 1.5V5H13" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
            </svg>
            <span>stacktape.yml</span>
            <span class="du-editor__lines">{file.lineCount} lines</span>
          </div>
          <div class="du-editor__scroll">
            <div class="du-editor__pane">
              <div class="du-editor__gutter" aria-hidden="true">
                {Array.from({ length: file.lineCount }, (_, n) => <span>{n + 1}</span>)}
              </div>
              <pre class="du-editor__code"><code set:html={file.html} /></pre>
            </div>
          </div>
        </div>
      </div>

      <div
        class="du-reveal__handle"
        data-du-handle
        role="slider"
        tabindex="0"
        aria-label="How much of the file to show; the rest is the diagram"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
      >
        <span class="du-reveal__grip" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
            <path
              d="M6 4 2.5 8 6 12M10 4l3.5 4L10 12"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="du-reveal__hint" aria-hidden="true">drag to compare file and diagram</span>
      </div>
    </div>
  </div>

  <div class="du-decided">
    <div class="du-decided__head">
      <h4>Decided for you</h4>
      <p>Open questions, answered with a recommendation. Each one is a statement you can change.</p>
    </div>
    <ul class="du-decided__list">
      {
        DECIDED.map((item) => (
          <li class="du-decided__row">
            <span class="du-decided__check" aria-hidden="true">
              <svg viewBox="0 0 12 12" width="11" height="11" fill="none">
                <path d="m2.5 6.3 2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="du-decided__text">
              <span class="du-decided__what">{item.what}</span>
              <span class="du-decided__why">{item.why}</span>
            </span>
            <button type="button" class="du-btn du-btn--ghost du-decided__change">Change</button>
          </li>
        ))
      }
    </ul>
    <p class="du-decided__estimate">
      <strong>14 AWS resources</strong> · <strong>~$112 / month</strong> estimated
      <span class="du-decided__note">Nothing is created or billed until you press Deploy.</span>
    </p>
  </div>
</div>

<script>
  const box = document.querySelector<HTMLElement>('[data-du-reveal-box]');
  const handle = box?.querySelector<HTMLElement>('[data-du-handle]');
  const area = box?.querySelector<HTMLElement>('.du-reveal');

  if (box && handle && area) {
    const min = 10;
    const max = 90;
    const home = 50;
    let value = home;

    const apply = (next: number) => {
      value = Math.min(max, Math.max(min, next));
      box.style.setProperty('--reveal', `${value}%`);
      handle.setAttribute('aria-valuenow', String(Math.round(value)));
    };

    const fromPointer = (clientX: number) => {
      const rect = area.getBoundingClientRect();
      apply(((clientX - rect.left) / rect.width) * 100);
    };

    handle.addEventListener('pointerdown', (event: PointerEvent) => {
      event.preventDefault();
      handle.setPointerCapture(event.pointerId);
      box.classList.add('is-dragging', 'has-dragged');
      fromPointer(event.clientX);
    });
    handle.addEventListener('pointermove', (event: PointerEvent) => {
      if (!box.classList.contains('is-dragging')) return;
      fromPointer(event.clientX);
    });
    const release = (event: PointerEvent) => {
      if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
      box.classList.remove('is-dragging');
    };
    handle.addEventListener('pointerup', release);
    handle.addEventListener('pointercancel', release);
    handle.addEventListener('dblclick', () => apply(home));
    handle.addEventListener('keydown', (event: KeyboardEvent) => {
      const step = event.shiftKey ? 12 : 4;
      if (event.key === 'ArrowLeft') apply(value - step);
      else if (event.key === 'ArrowRight') apply(value + step);
      else if (event.key === 'Home') apply(min);
      else if (event.key === 'End') apply(max);
      else return;
      box.classList.add('has-dragged');
      event.preventDefault();
    });
  }
</script>
