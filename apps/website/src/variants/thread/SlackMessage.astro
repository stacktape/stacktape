---
/** The alert in Slack the moment the incident opens, with the way into the Console. */
import { INCIDENT, PROJECT } from './data';
import { PreviewButton } from './ui';
---

<div class="th-slack">
  <p class="th-slack__title">Incident opened</p>
  <p class="th-slack__line">
    Uptime check down · <span class="th-mono">{PROJECT.urls.api}/health</span> · 3 of 3 regions
  </p>
  <p class="th-slack__line">
    {INCIDENT.release.opened} <span class="th-mono">{INCIDENT.release.version}</span>
    <span class="th-slack__arrow" aria-hidden="true">→</span>
    <span class="th-slack__link">what changed</span>
  </p>
  <div class="th-slack__action">
    <PreviewButton variant="secondary" small>Open in Console</PreviewButton>
  </div>
</div>
