---
/** A pull request's checks, the way GitHub lists them: three rows, all green. */
import { PULL_REQUEST } from './data';
---

<div class="th-pr">
  <p class="th-pr__head">
    <svg class="th-pr__glyph" viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
      <circle cx="4.5" cy="3.4" r="1.7" stroke="currentColor" stroke-width="1.5"></circle>
      <circle cx="4.5" cy="12.6" r="1.7" stroke="currentColor" stroke-width="1.5"></circle>
      <circle cx="11.5" cy="12.6" r="1.7" stroke="currentColor" stroke-width="1.5"></circle>
      <path d="M4.5 5.2v5.6M11.5 10.8V6.2L9 3.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    <span class="th-pr__number">PR {PULL_REQUEST.number}</span>
    <span class="th-pr__title">{PULL_REQUEST.title}</span>
  </p>
  <ul class="th-checks" aria-label="Checks">
    {
      PULL_REQUEST.checks.map((check) => (
        <li class="th-check">
          <span class="th-check__ok" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="11" height="11" fill="none">
              <path d="m2.5 6.3 2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="th-check__name">{check.name}</span>
          <span class="th-check__detail">{check.detail}</span>
        </li>
      ))
    }
  </ul>
</div>
