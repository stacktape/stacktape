---
import { CommandBox } from './CommandBox';
import { EYEBROW, HEADLINE, SUBHEADLINE, TRUST_LINE } from './data';
---

<section class="th-hero" aria-labelledby="th-hero-title">
  <div class="th-container th-hero__inner">
    <p class="th-eyebrow">{EYEBROW}</p>
    <h1 class="th-hero__title" id="th-hero-title">{HEADLINE}</h1>
    <p class="th-hero__sub">{SUBHEADLINE}</p>
    <div class="th-hero__cta">
      <CommandBox client:load label="Get started" />
    </div>
    <p class="th-trust">{TRUST_LINE}</p>
  </div>
</section>
