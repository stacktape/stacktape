---
/**
 * The round mark on the hairline: one per event, carrying the glyph of the tool the event happened
 * in. Glyphs only, no third-party logos; the tool's name sits in the event header beside it.
 *
 * The Stacktape mark's paths are the canonical ones from `components/Logo.astro`, filled in the
 * brand teal instead of the wordmark gradient.
 */
export type Tool = 'you' | 'stacktape' | 'github' | 'slack';

type Props = { tool: Tool };

const { tool } = Astro.props;
---

<span class={`th-mark th-mark--${tool}`} aria-hidden="true">
  {
    tool === 'you' && (
      <svg viewBox="0 0 16 16" width="15" height="15" fill="none">
        <circle cx="8" cy="5" r="3" stroke="currentColor" stroke-width="1.6" />
        <path
          d="M2.6 14.4c.6-3.1 2.8-4.7 5.4-4.7s4.8 1.6 5.4 4.7"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </svg>
    )
  }
  {
    tool === 'stacktape' && (
      <svg viewBox="0 0 42 49" width="13" height="15" fill="currentColor">
        <path d="M41.7636 14.3985L37.4928 37.8262L13.8142 45.812C13.4647 45.934 13.0741 45.8036 12.8578 45.5013L0.253235 27.8495C0.22812 27.8199 0.203008 27.7825 0.182777 27.7487C0.0662745 27.5725 0 27.3625 0 27.1356C0 27.0813 0.0041868 27.0264 0.0125582 26.9721L1.89613 26.3378L25.0633 18.5204L40.5867 13.2822C41.2355 13.0624 41.8927 13.6839 41.7636 14.3985Z" />
        <path d="M25.0635 18.5195L1.89626 26.3376L0.0126953 26.9719C0.0378096 26.7999 0.099898 26.6442 0.191286 26.5054C0.195472 26.5011 0.199656 26.4927 0.208028 26.4842L0.345457 26.3242L22.2235 0.728862C22.6183 0.266567 23.3669 0.548453 23.4255 1.1827L25.0635 18.5195Z" />
        <path d="M37.493 37.8262L29.4369 48.1848C29.0434 48.7662 28.1616 48.4928 28.0891 47.7669L27.4473 41.2145L37.493 37.8262Z" />
      </svg>
    )
  }
  {
    tool === 'github' && (
      <svg viewBox="0 0 16 16" width="15" height="15" fill="none">
        <circle cx="4.5" cy="3.4" r="1.7" stroke="currentColor" stroke-width="1.5" />
        <circle cx="4.5" cy="12.6" r="1.7" stroke="currentColor" stroke-width="1.5" />
        <circle cx="11.5" cy="4.6" r="1.7" stroke="currentColor" stroke-width="1.5" />
        <path d="M4.5 5.2v5.6" stroke="currentColor" stroke-width="1.5" />
        <path d="M11.5 6.4c0 3.1-7 1.9-7 4.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    )
  }
  {
    tool === 'slack' && (
      <svg viewBox="0 0 16 16" width="15" height="15" fill="none">
        <path d="M6.3 2 4.7 14M11.3 2 9.7 14M2.6 6h11M2 10h11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
    )
  }
</span>
