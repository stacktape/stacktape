---
/** 03 — three metric tiles with sparklines, one request's trace, and one uptime line. */
import { ALERTS_CHIP, METRICS, PROJECT, sparkline, TRACE, UPTIME } from '../data';
import { StatusBadge } from '../ui';
import Window from '../Window.astro';

const pct = (ms: number) => `${((ms / TRACE.total) * 100).toFixed(2)}%`;
---

<Window title={`<b>${PROJECT.name}</b> · production`}>
  <span class="th-win__where" slot="bar">apiService</span>

  <div class="th-tiles">
    {
      METRICS.map((metric) => (
        <div class="th-tile">
          <p class="th-tile__label">{metric.label}</p>
          <p class="th-tile__value">
            {metric.value}<span class="th-tile__unit">{metric.unit}</span>
          </p>
          <svg class="th-spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
            <polyline points={sparkline(metric.points)} fill="none" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke" />
          </svg>
        </div>
      ))
    }
  </div>

  <div class="th-trace" role="img" aria-label={`Trace of ${TRACE.name}, ${TRACE.total} ms in total`}>
    <div class="th-trace__head">
      <span class="th-trace__name">{TRACE.name}</span>
      <span class="th-trace__total">{TRACE.total} ms</span>
    </div>
    <ol class="th-trace__spans" aria-hidden="true">
      {
        TRACE.spans.map((span) => (
          <li class={`th-span th-span--${span.kind}`}>
            <span class="th-span__name">{span.name}</span>
            <span class="th-span__lane">
              <span class="th-span__bar" style={`left: ${pct(span.start)}; width: ${pct(span.duration)}`} />
            </span>
            <span class="th-span__ms">{span.duration} ms</span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="th-monitor__foot">
    <p class="th-uptime">
      <span class="th-uptime__url">{UPTIME.url}</span>
      <StatusBadge tone="success" dot>Up</StatusBadge>
      {
        UPTIME.regions.map((check) => (
          <span class="th-uptime__region">
            {check.region} <span class="th-mono">{check.latency}</span>
          </span>
        ))
      }
      <span class="th-uptime__total">{UPTIME.thirtyDay}</span>
    </p>
    <span class="th-chip">
      <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true">
        <path d="M8 2.5a3.5 3.5 0 0 0-3.5 3.5v2.2L3.2 10.5h9.6L11.5 8.2V6A3.5 3.5 0 0 0 8 2.5ZM6.5 12.5a1.5 1.5 0 0 0 3 0" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"></path>
      </svg>
      {ALERTS_CHIP}
    </span>
  </div>
</Window>
