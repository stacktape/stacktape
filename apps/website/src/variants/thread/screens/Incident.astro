---
/** 05 — the incident: the release that caused it, the signals, the handoff, the timeline, the switch that is off. */
import Cursor from '../Cursor.astro';
import { INCIDENT, PROJECT } from '../data';
import { OptInSwitch, PreviewButton, StatusBadge } from '../ui';
import Window from '../Window.astro';

const { release } = INCIDENT;
---

<Window title={`<b>${PROJECT.name}</b> · production`}>
  <span class="th-win__where" slot="bar">Incident <span class="th-mono">{INCIDENT.id}</span></span>

  <div class="th-inc__head">
    <StatusBadge tone="success" dot>Resolved</StatusBadge>
    <StatusBadge tone="danger">Error</StatusBadge>
    <h3 class="th-inc__title">{INCIDENT.title}</h3>
  </div>

  <div class="th-inc">
    <div class="th-inc__main">
      <p class="th-inc__release">
        <b>{release.opened} <span class="th-mono">{release.version}</span></b>
        <span class="th-inc__sep" aria-hidden="true">·</span>
        <span class="th-mono">{release.commit}</span>
        <span class="th-inc__sep" aria-hidden="true">·</span>
        {release.message}
        <span class="th-inc__sep" aria-hidden="true">·</span>
        <span class="th-inc__link">{release.link}</span>
      </p>

      <ul class="th-signals" aria-label="Signals">
        {
          INCIDENT.signals.map((signal) => (
            <li class="th-signal">
              <span class="th-signal__mark" aria-hidden="true" />
              <span class="th-signal__text">
                <span class="th-signal__what">{signal.text}</span>
                <span class="th-signal__meta">{signal.meta}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <div class="th-inc__handoff">
        <span class="th-press">
          <PreviewButton variant="secondary" icon="copy">{INCIDENT.handoff}</PreviewButton>
          <Cursor />
        </span>
      </div>
    </div>

    <div class="th-inc__side">
      <ol class="th-timeline" aria-label="Timeline">
        {
          INCIDENT.timeline.map((event) => (
            <li class={`th-tl th-tl--${event.tone}`}>
              <span class="th-tl__time">{event.time}</span>
              <span class="th-tl__mark" aria-hidden="true" />
              <span class="th-tl__text">{event.text}</span>
            </li>
          ))
        }
      </ol>

      <div class="th-optin">
        <OptInSwitch label={INCIDENT.optIn} />
        <span class="th-optin__text">
          <span class="th-optin__what">{INCIDENT.optIn}</span>
          <span class="th-optin__state">{INCIDENT.optInState}</span>
        </span>
      </div>
    </div>
  </div>
</Window>
