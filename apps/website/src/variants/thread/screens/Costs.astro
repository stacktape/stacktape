---
/** 06 — cost per resource from the AWS bill, and the budget the visitor set once. */
import Cursor from '../Cursor.astro';
import { BUDGET, COST_TOTAL, COSTS, money, PROJECT } from '../data';
import Window from '../Window.astro';

const largest = Math.max(...COSTS.map((cost) => cost.amount));
const used = (COST_TOTAL / BUDGET.limit) * 100;
---

<Window title={`<b>${PROJECT.name}</b> · production`}>
  <span class="th-win__where" slot="bar">Costs</span>

  <div class="th-cost">
    <div class="th-cost__main">
      <div class="th-cost__head">
        <p class="th-label">Cost by resource · month to date</p>
        <p class="th-cost__total">{money(COST_TOTAL)}</p>
      </div>
      <ul class="th-bars" aria-label="Cost per resource">
        {
          COSTS.map((cost) => (
            <li class="th-bar">
              <span class="th-bar__name">{cost.name}</span>
              <span class="th-bar__lane">
                <span class="th-bar__fill" style={`width: ${((cost.amount / largest) * 100).toFixed(1)}%`} />
              </span>
              <span class="th-bar__amount">{money(cost.amount)}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="th-budget">
      <div class="th-budget__head">
        <p class="th-label">Budget</p>
        <span class="th-press th-press--field">
          <span class="th-budget__limit"><b>{money(BUDGET.limit)}</b> / month</span>
          <Cursor />
        </span>
      </div>
      <div
        class="th-budget__lane"
        role="img"
        aria-label={`${money(COST_TOTAL)} of ${money(BUDGET.limit)} used; alert at ${BUDGET.alertAt}%`}
      >
        <span class="th-budget__fill" style={`width: ${used.toFixed(1)}%`}></span>
        <span class="th-budget__mark" style={`left: ${BUDGET.alertAt}%`}></span>
      </div>
      <p class="th-budget__legend">
        <span><b>{used.toFixed(0)} %</b> used</span>
        <span>alert at <b>{BUDGET.alertAt} %</b> ({money((BUDGET.limit * BUDGET.alertAt) / 100)})</span>
      </p>
      <p class="th-budget__billed">Billed by AWS to account <span class="th-mono">{PROJECT.account}</span>.</p>
    </div>
  </div>
</Window>
