---
/**
 * The visitor's pointer: an 18px arrow resting on the control they press. Together with the amber
 * "You" events it is the only mark of the visitor's own actions on the page.
 */
type Props = { class?: string };

const { class: className } = Astro.props;
---

<svg
  class={['th-cursor', className].filter(Boolean).join(' ')}
  viewBox="0 0 24 24"
  width="18"
  height="18"
  aria-hidden="true"
>
  <path
    d="M5.5 3v16.4l4.3-4 2.9 6.4 3-1.4-2.9-6.2 6-.3z"
    fill="#fff"
    stroke="#0e1113"
    stroke-width="1.6"
    stroke-linejoin="round"></path>
</svg>
