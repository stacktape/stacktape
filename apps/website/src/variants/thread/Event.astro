---
/**
 * One event on the thread: the tool's mark on the hairline, a header row with the tool's name and
 * the time, and the body beside them. A big event's body is one of the six surfaces and spans the
 * full column; the hairline runs on behind it.
 */
import type { Tool } from './Mark.astro';
import Mark from './Mark.astro';

type Props = {
  tool: Tool;
  /** Who or what the event belongs to, as shown: You, Wizard, Console, GitHub, Slack #alerts. */
  name: string;
  time: string;
  big?: boolean;
  id?: string;
};

const { tool, name, time, big = false, id } = Astro.props;
const classes = ['th-event', `th-event--${tool}`, big && 'th-event--big'].filter(Boolean).join(' ');
---

<li class={classes} id={id}>
  <Mark tool={tool} />
  <p class="th-event__head">
    <span class="th-event__tool">{name}</span>
    <span class="th-event__time">{time}</span>
  </p>
  <div class="th-event__body">
    <slot />
  </div>
</li>
