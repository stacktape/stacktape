---
/**
 * The first week, as one thread of events in the tools the team already uses. The six things
 * Stacktape does are the big events (a full-width surface each); the visitor's own actions and
 * the tools' notices are the short ones. Every mark on the hairline is the tool the event
 * happened in.
 */
import { Badge } from '@stacktape/ui-react/badge';
import Big from './Big.astro';
import Cursor from './Cursor.astro';
import { BUDGET, COST_TOTAL, INCIDENT, money, PROJECT, SURFACES } from './data';
import Event from './Event.astro';
import PullRequest from './PullRequest.astro';
import Costs from './screens/Costs.astro';
import Design from './screens/Design.astro';
import Incident from './screens/Incident.astro';
import Live from './screens/Live.astro';
import Monitor from './screens/Monitor.astro';
import Secure from './screens/Secure.astro';
import SlackMessage from './SlackMessage.astro';
import Terminal from './Terminal.astro';
import { PreviewButton } from './ui';

const { release } = INCIDENT;
---

<section class="th-thread" aria-label="The first week with Stacktape">
  <div class="th-container">
    <ol class="th-events">
      <Event tool="you" name="You" time="09:41">
        <Terminal />
      </Event>

      <Event tool="stacktape" name="Wizard" time="09:42" big id={SURFACES[0].id}>
        <Big surface={SURFACES[0]}><Design /></Big>
      </Event>

      <Event tool="you" name="You" time="09:49">
        <p class="th-line">
          <span>Pressed Deploy.</span>
          <span class="th-press">
            <PreviewButton variant="primary" icon="arrow" iconPosition="end" small>Deploy</PreviewButton>
            <Cursor />
          </span>
        </p>
      </Event>

      <Event tool="stacktape" name="Wizard" time="09:52" big id={SURFACES[1].id}>
        <Big surface={SURFACES[1]}><Live /></Big>
      </Event>

      <Event tool="github" name="GitHub" time="Tue 11:20">
        <PullRequest />
      </Event>

      <Event tool="github" name="GitHub" time="Tue 15:04">
        <p class="th-line">
          <span><b>Merged.</b> <span class="th-mono">v42</span> live in production, zero downtime.</span>
        </p>
      </Event>

      <Event tool="stacktape" name="Console" time="Wed 09:10" big id={SURFACES[2].id}>
        <Big surface={SURFACES[2]}><Monitor /></Big>
      </Event>

      <Event tool="stacktape" name="Console" time="Wed 09:12" big id={SURFACES[3].id}>
        <Big surface={SURFACES[3]}><Secure /></Big>
      </Event>

      <Event tool="github" name="GitHub" time="Wed 09:15">
        <p class="th-line">
          <span>
            Fix <span class="th-mono">PR #129</span> opened by Stacktape: <span class="th-mono">openssl 3.0.13 → 3.0.15</span> in
            apiService image.
          </span>
        </p>
      </Event>

      <Event tool="github" name="GitHub" time="Thu 13:58">
        <p class="th-line">
          <span>
            <span class="th-mono">{release.version}</span> deployed · <span class="th-mono">{release.commit}</span> · {release.message}
          </span>
        </p>
      </Event>

      <Event tool="slack" name="Slack #alerts" time="Thu 14:02">
        <SlackMessage />
      </Event>

      <Event tool="stacktape" name="Console" time="Thu 14:03" big id={SURFACES[4].id}>
        <Big surface={SURFACES[4]}><Incident /></Big>
      </Event>

      <Event tool="you" name="You" time="Thu 14:08">
        <p class="th-line">
          <span>Reviewed <span class="th-mono">PR #131</span> (apply the missing migration) and merged it.</span>
          <Badge caps={false} className="th-badge" tone="accent">Merged</Badge>
        </p>
      </Event>

      <Event tool="slack" name="Slack #alerts" time="Thu 14:13">
        <p class="th-line">
          <span><i class="th-dot" aria-hidden="true"></i>Resolved · recovered on its own signals · <span class="th-mono">11 min</span></span>
        </p>
      </Event>

      <Event tool="slack" name="Slack #billing" time="Mon 08:00">
        <p class="th-line">
          <span>
            Budget: <span class="th-mono">{money(COST_TOTAL)}</span> of <span class="th-mono">${BUDGET.limit}</span> used this month
            (75 %). Alert at {BUDGET.alertAt} %.
          </span>
        </p>
      </Event>

      <Event tool="stacktape" name="Console" time="Mon 08:02" big id={SURFACES[5].id}>
        <Big surface={SURFACES[5]}><Costs /></Big>
      </Event>

      <Event tool="stacktape" name="Console" time="today">
        <p class="th-line th-line--end">
          <span class="th-mono">{PROJECT.name}</span>
          <span class="th-line__sep" aria-hidden="true">·</span>
          <span>production</span>
          <span class="th-line__sep" aria-hidden="true">·</span>
          <span class="th-line__state"><i class="th-dot" aria-hidden="true"></i>running</span>
          <span class="th-line__sep" aria-hidden="true">·</span>
          <span class="th-mono">{PROJECT.urls.web}</span>
          <span class="th-line__sep" aria-hidden="true">·</span>
          <span class="th-mono">{PROJECT.urls.api}</span>
        </p>
      </Event>
    </ol>
  </div>
</section>

<script>
  const root = document.documentElement;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Entrances: an event fades in 8px the first time it enters the view, one way. Events already in
  // view at load are marked before the hiding class lands on <html>, so nothing flashes.
  const events = Array.from(document.querySelectorAll<HTMLElement>('.th-event'));
  if (!reduced && 'IntersectionObserver' in window && events.length) {
    const viewport = window.innerHeight;
    for (const event of events) {
      if (event.getBoundingClientRect().top < viewport) event.classList.add('is-in');
    }
    root.classList.add('th-io');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.04 }
    );
    for (const event of events) if (!event.classList.contains('is-in')) observer.observe(event);
  }

  // The terminal's output types itself on load. `th-typing` on <html> (set inline in the head, and
  // only without reduced motion) keeps the lines hidden until each one starts; the head script is
  // the only thing that sets it, so without JavaScript the lines are simply there.
  const lines = Array.from(document.querySelectorAll<HTMLElement>('[data-th-type]'));
  if (root.classList.contains('th-typing') && lines.length) {
    const texts = lines.map((line) => line.textContent ?? '');
    for (const line of lines) line.textContent = '';

    const typeLine = (index: number) => {
      const line = lines[index];
      const text = texts[index];
      if (!line || text === undefined) {
        root.classList.remove('th-typing');
        return;
      }
      line.classList.add('is-live', 'is-typing');
      let at = 0;
      const tick = () => {
        at += 1;
        line.textContent = text.slice(0, at);
        if (at < text.length) {
          // The tool pauses on its ellipsis the way the real one does while it reads the files.
          window.setTimeout(tick, text[at - 1] === '…' ? 650 : 14);
          return;
        }
        line.classList.remove('is-typing');
        window.setTimeout(() => typeLine(index + 1), 320);
      };
      tick();
    };

    window.setTimeout(() => typeLine(0), 420);
  }
</script>
