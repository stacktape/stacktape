---
/**
 * One of the six surfaces: number, name, text, then the screen (a simplified recreation of the
 * wizard or Console) below the text inside the same surface.
 */
import type { Surface } from './data';

type Props = { surface: Surface };

const { surface } = Astro.props;
---

<article class="th-big" aria-labelledby={`th-${surface.id}-title`}>
  <p class="th-big__num" aria-hidden="true">{surface.number}</p>
  <h2 class="th-big__title" id={`th-${surface.id}-title`}>
    <span class="th-visually-hidden">{surface.number} </span>{surface.name}
  </h2>
  <p class="th-big__text">{surface.text}</p>
  <div class="th-big__screen">
    <slot />
  </div>
</article>
