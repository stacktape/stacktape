---
/** 04 — monitoring: three metric tiles, one request followed through the services, one uptime line. */
import { METRICS, sparkline, TRACE, UPTIME, URLS } from '../data';
import Window from '../Window.astro';

const pct = (ms: number) => `${((ms / TRACE.total) * 100).toFixed(2)}%`;
---

<Window kind="browser" host={URLS.monitoring.host} path={URLS.monitoring.path}>
  <ul class="ss-tiles" aria-label="Metrics">
    {
      METRICS.map((metric) => (
        <li class="ss-tile">
          <p class="ss-tile__label">{metric.label}</p>
          <p class="ss-tile__value">
            {metric.value}<span class="ss-tile__unit">{metric.unit}</span>
          </p>
          <svg class="ss-spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
            <polyline points={sparkline(metric.points)} fill="none" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke" />
          </svg>
        </li>
      ))
    }
  </ul>

  <div class="ss-trace">
    <p class="ss-trace__head">
      <span class="ss-mono">{TRACE.name}</span>
      <span class="ss-trace__total">{TRACE.total} ms</span>
    </p>
    <ol class="ss-trace__spans" aria-label="Spans">
      {
        TRACE.spans.map((span) => (
          <li class={`ss-span ss-span--${span.kind}`}>
            <span class="ss-span__name">{span.name}</span>
            <span class="ss-span__lane">
              <span class="ss-span__bar" style={`left: ${pct(span.start)}; width: max(${pct(span.end - span.start)}, 3px)`} />
            </span>
            <span class="ss-span__ms">{span.end - span.start} ms</span>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="ss-uptime">
    <span class="ss-uptime__ok" aria-hidden="true"></span>
    <span class="ss-uptime__url">{UPTIME.url}</span>
    <span class="ss-uptime__sep" aria-hidden="true">·</span>
    <b>{UPTIME.availability}</b>
    {
      UPTIME.regions.map((check) => (
        <>
          <span class="ss-uptime__sep" aria-hidden="true">·</span>
          <span class="ss-uptime__region">
            {check.region} <span class="ss-mono">{check.latency}</span>
          </span>
        </>
      ))
    }
  </p>
</Window>
