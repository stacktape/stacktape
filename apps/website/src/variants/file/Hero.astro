---
/** The hero: the promise, the one command, and the editor beginning right under it. */
import { CommandBox } from './CommandBox';
import { EYEBROW, HEADLINE, SUBHEADLINE, TRUST_LINE } from './data';
---

<div class="fl-hero">
  <p class="fl-eyebrow">{EYEBROW}</p>
  <h1 class="fl-hero__title" id="fl-hero-title">{HEADLINE}</h1>
  <p class="fl-hero__sub">{SUBHEADLINE}</p>
  <div class="fl-hero__cta">
    <CommandBox client:load label="Get started" />
  </div>
  <p class="fl-trust">{TRUST_LINE}</p>
</div>
