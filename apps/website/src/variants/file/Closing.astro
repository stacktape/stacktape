---
/** After the editor: the closing line, the same command box, the way back in. */
import { CommandBox } from './CommandBox';
import { CLOSING_LINE, LINKS, TRUST_LINE } from './data';
---

<section class="fl-closing" aria-labelledby="fl-closing-title">
  <h2 class="fl-closing__title" id="fl-closing-title">{CLOSING_LINE}</h2>
  <div class="fl-closing__cta">
    <CommandBox client:load label="Get started" />
  </div>
  <p class="fl-trust">{TRUST_LINE}</p>
  <p class="fl-closing__signin">Already set up? <a href={LINKS.console}>Sign in to the Console</a></p>
</section>
