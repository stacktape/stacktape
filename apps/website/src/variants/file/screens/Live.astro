---
/** 02 — "It's live", the phases that got there, and what deploying looks like from now on. */
import Cursor from '../Cursor.astro';
import { AFTER_FIRST, DEPLOY, PROJECT } from '../data';
import { PreviewButton, StatusBadge } from '../ui';
---

<div class="fl-live">
  <div class="fl-live__panel">
    <div class="fl-live__head">
      <StatusBadge tone="success" dot>Live</StatusBadge>
      <h3 class="fl-scr__heading">It's live</h3>
    </div>
    <p class="fl-live__urls">
      <span class="fl-live__url">{PROJECT.urls.web}</span>
      <span class="fl-live__url">{PROJECT.urls.api}</span>
    </p>
    <p class="fl-live__meta">
      {DEPLOY.duration} · {PROJECT.region} · your AWS account <span class="fl-mono">{PROJECT.account}</span>
    </p>
  </div>

  <ol class="fl-phases" aria-label="Deploy phases">
    {
      DEPLOY.phases.map((phase) => (
        <li class="fl-phase">
          <span class="fl-check" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="11" height="11" fill="none">
              <path d="m2.5 6.3 2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="fl-phase__name">{phase.name}</span>
          <span class="fl-phase__note">{phase.note}</span>
        </li>
      ))
    }
  </ol>
</div>

<div>
  <p class="fl-scr__label">From now on</p>
  <ul class="fl-after">
    <li class="fl-after__row fl-after__row--press">
      <span class="fl-after__trigger">{AFTER_FIRST.push.trigger}</span>
      <span class="fl-after__arrow" aria-hidden="true">→</span>
      <span class="fl-after__result">{AFTER_FIRST.push.result}</span>
      <span class="fl-after__note">{AFTER_FIRST.push.note}</span>
      <Cursor class="fl-cursor--row" />
    </li>
    <li class="fl-after__row">
      <span class="fl-after__trigger">{AFTER_FIRST.pullRequest.trigger}</span>
      <span class="fl-after__arrow" aria-hidden="true">→</span>
      <span class="fl-after__result">{AFTER_FIRST.pullRequest.result}</span>
    </li>
    <li class="fl-after__row">
      <span class="fl-after__trigger">{AFTER_FIRST.release.trigger}</span>
      <span class="fl-after__arrow" aria-hidden="true">→</span>
      <PreviewButton variant="secondary" small>{DEPLOY.rollback}</PreviewButton>
    </li>
  </ul>
</div>
