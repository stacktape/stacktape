---
/** 04 — the posture ring, the three findings with what the Console offers for each, the guardrails. */
import { GUARDRAIL_RULE, GUARDRAILS_ON, POSTURE } from '../data';
import { PreviewButton, StatusBadge } from '../ui';

const RADIUS = 26;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
const passingArc = (POSTURE.passing / POSTURE.total) * CIRCUMFERENCE;
---

<div class="fl-sec">
  <div class="fl-posture">
    <svg class="fl-ring" viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
      <circle cx="32" cy="32" r={RADIUS} class="fl-ring__track"></circle>
      <circle
        cx="32"
        cy="32"
        r={RADIUS}
        class="fl-ring__value"
        stroke-dasharray={`${passingArc.toFixed(2)} ${CIRCUMFERENCE.toFixed(2)}`}
        transform="rotate(-90 32 32)"></circle>
    </svg>
    <p class="fl-posture__num">
      <b>{POSTURE.passing}</b> of {POSTURE.total}
      <span class="fl-posture__sub">checks passing</span>
    </p>
  </div>

  <ul class="fl-findings" aria-label="Findings">
    {
      POSTURE.findings.map((item) => (
        <li class="fl-finding">
          <span class="fl-finding__mark" aria-hidden="true" />
          <span class="fl-finding__what">{item.finding}</span>
          <span class="fl-finding__action">
            {'badge' in item && (
              <StatusBadge tone="success" dot>
                {item.badge}
              </StatusBadge>
            )}
            <PreviewButton variant="secondary" small>
              {item.action}
            </PreviewButton>
          </span>
        </li>
      ))
    }
  </ul>
</div>

<div class="fl-guard">
  <p class="fl-scr__label">Guardrails on</p>
  <p class="fl-guard__chips">
    {
      GUARDRAILS_ON.map((rule) => (
        <span class="fl-chip fl-chip--violet">
          <span class="fl-chip__dot" aria-hidden="true" />
          {rule}
        </span>
      ))
    }
  </p>
  <p class="fl-guard__rule">{GUARDRAIL_RULE}</p>
</div>
