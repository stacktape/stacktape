---
/**
 * The editor: one tall surface showing `stacktape.yml`, with the six comments inserted inline after
 * the lines they refer to.
 *
 * The first segment's lines type themselves on load; everything below them fades in once the
 * typing ends, so the fold shows the command and the file being written. From then on the only
 * motion is one-way: when a comment enters view the editor gains `fl-on-<n>`, and the stylesheet
 * shows that chapter's lens rows, price inlays and gutter bracket.
 */
import type { Typing } from './data';
import { buildSegments, PROJECT } from './data';
import Comment from './Comment.astro';
import Lines from './Lines.astro';
import Costs from './screens/Costs.astro';
import Design from './screens/Design.astro';
import Incident from './screens/Incident.astro';
import Live from './screens/Live.astro';
import Monitor from './screens/Monitor.astro';
import Secure from './screens/Secure.astro';

const [first, ...rest] = buildSegments();

/* Seconds. A line takes its length times PER_CHAR, then a short pause before the next one. */
const TYPE_START = 0.2;
const PER_CHAR = 0.0055;
const PER_LINE = 0.06;

const typing = new Map<number, Typing>();
let clock = TYPE_START;
let lastTyped = 0;
for (const row of first?.rows ?? []) {
  if (row.kind !== 'line') continue;
  const chars = row.text.length;
  const duration = chars * PER_CHAR;
  if (chars > 0) {
    typing.set(row.n, { delay: clock, duration, chars });
    lastTyped = row.n;
  }
  clock += duration + PER_LINE;
}
const restDelay = clock + 0.1;
---

<section
  class="fl-editor fl-intro"
  data-fl-editor
  data-fl-intro-ms={Math.round((restDelay + 0.7) * 1000)}
  aria-label="stacktape.yml, with Stacktape's comments"
  style={`--fl-rest-d: ${restDelay.toFixed(2)}s`}
>
  <div class="fl-tabbar">
    <span class="fl-tab">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
        <path d="M4 1.5h5.5L13 5v9.5H4z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
        <path d="M9.5 1.5V5H13" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
      </svg>
      stacktape.yml
    </span>
    <span class="fl-tabbar__by">
      <span class="fl-tabbar__extra">written by </span><b>stacktape init</b><span class="fl-tabbar__extra"> from {PROJECT.repo}</span> · {PROJECT.read.seconds}
    </span>
  </div>

  <div class="fl-body">
    {first && <Lines segment={first} typing={typing} lastTyped={lastTyped} />}
    <div class="fl-rest">
      {
        first && (
          <Comment chapter={first.chapter}>
            <Design />
          </Comment>
        )
      }
      {
        rest.map((segment) => (
          <>
            <Lines segment={segment} />
            <Comment chapter={segment.chapter}>
              {segment.chapter.index === 2 && <Live />}
              {segment.chapter.index === 3 && <Monitor />}
              {segment.chapter.index === 4 && <Secure />}
              {segment.chapter.index === 5 && <Incident />}
              {segment.chapter.index === 6 && <Costs />}
            </Comment>
          </>
        ))
      }
    </div>
  </div>
</section>

<script>
  // One-way reveals. When a comment enters view the editor learns its chapter, and the stylesheet
  // shows that chapter's lens rows, price inlays and gutter bracket. Nothing is ever hidden again.
  const editor = document.querySelector<HTMLElement>('[data-fl-editor]');
  const comments = editor ? Array.from(editor.querySelectorAll<HTMLElement>('[data-fl-comment]')) : [];

  // The intro (the first lines typing, the rest fading in) runs once. Its rules are gated behind
  // `fl-intro`; dropping the class after it ends leaves the same picture and makes sure nothing
  // that restarts CSS animations later (a viewport crossing 900px, a full-page capture) replays it.
  if (editor) {
    const ms = Number(editor.dataset.flIntroMs) || 3000;
    window.setTimeout(() => editor.classList.remove('fl-intro'), ms);
  }

  const reveal = (comment: HTMLElement) => {
    editor?.classList.add(`fl-on-${comment.dataset.flComment}`);
  };

  if (editor && comments.length > 0) {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            reveal(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px' }
      );
      for (const comment of comments) observer.observe(comment);
    } else {
      for (const comment of comments) reveal(comment);
    }
  }
</script>
