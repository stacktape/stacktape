---
/**
 * The sticky nav: paper, ink text, a 1px rule once the page has scrolled. Under 900px the links
 * fold into a panel behind a menu button; the primary action stays visible.
 */
import { ButtonLink } from '@stacktape/ui-react/button';
import { LINKS, NAV_LINKS } from './data';
import Wordmark from './Wordmark.astro';
---

<header class="sh-nav" data-sh-nav>
  <div class="sh-container sh-nav__inner">
    <a class="sh-nav__logo" href="/" aria-label="Stacktape home"><Wordmark height={24} /></a>
    <nav class="sh-nav__primary" aria-label="Primary">
      <ul class="sh-nav__links">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a class="sh-nav__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="sh-nav__actions">
      <a class="sh-nav__link sh-nav__signin" href={LINKS.console}>Sign in</a>
      <ButtonLink className="sh-nav__demo" href={LINKS.demo} variant="secondary">Book a demo</ButtonLink>
      <ButtonLink className="sh-nav__start" href="#get-started" variant="primary">Get started</ButtonLink>
      <button
        class="sh-nav__menu"
        type="button"
        aria-expanded="false"
        aria-controls="sh-menu"
        aria-label="Menu"
        data-sh-menu
      >
        <span class="sh-nav__burger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div class="sh-menu" id="sh-menu" hidden data-sh-menu-panel>
    <ul class="sh-menu__list">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a class="sh-menu__link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li><a class="sh-menu__link" href={LINKS.console}>Sign in</a></li>
      <li><a class="sh-menu__link" href={LINKS.demo}>Book a demo</a></li>
    </ul>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-sh-nav]');
  const menu = document.querySelector<HTMLButtonElement>('[data-sh-menu]');
  const panel = document.querySelector<HTMLElement>('[data-sh-menu-panel]');

  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  if (menu && panel) {
    const setOpen = (open: boolean) => {
      menu.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      nav?.classList.toggle('is-open', open);
    };
    menu.addEventListener('click', () => setOpen(Boolean(panel.hidden)));
    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) setOpen(false);
    });
  }
</script>
