---
/** 05 — the organization's guardrails: four rules that are on, and the deploy one of them blocked. */
import { GUARDRAILS } from '../data';
import { PreviewButton, RuleSwitch } from '../ui';
import Window from '../Window.astro';
---

<Window kind="browser" title={GUARDRAILS.url}>
  <div class="sh-gr">
    <div class="sh-screen__head">
      <h3 class="sh-screen__h">{GUARDRAILS.heading}</h3>
      <p class="sh-screen__sub">{GUARDRAILS.line}</p>
    </div>

    <ul class="sh-rules" aria-label="Rules">
      {
        GUARDRAILS.rules.map((rule) => (
          <li class="sh-rule">
            <RuleSwitch label={rule} />
            <span class="sh-rule__name">{rule}</span>
          </li>
        ))
      }
    </ul>

    <div class="sh-blocked">
      <span class="sh-blocked__mark" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
          <circle cx="8" cy="8" r="6.2" stroke="currentColor" stroke-width="1.6" />
          <path d="M8 4.8v3.9M8 11.2v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </span>
      <p class="sh-blocked__text">
        <b>{GUARDRAILS.blocked.title}</b><span class="sh-screen__sep" aria-hidden="true">·</span>{GUARDRAILS.blocked.detail}
      </p>
      <PreviewButton variant="secondary" small>{GUARDRAILS.blocked.action}</PreviewButton>
    </div>
  </div>
</Window>
