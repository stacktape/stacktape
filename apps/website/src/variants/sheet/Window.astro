---
/**
 * A product window on the paper: the Console material, a shadow, and only the chrome that names
 * the window. A browser window carries three dots and the URL pill (with a lock unless the page
 * is local); a terminal window carries three dots and its mono title. Nothing else in the bar.
 */
type Props = {
  kind: 'browser' | 'terminal';
  /** The URL (browser) or the title (terminal). */
  title: string;
  /** Browser only: hide the lock for a page served from the machine itself. */
  lock?: boolean;
  class?: string;
};

const { kind, title, lock = true, class: className } = Astro.props;
---

<div class={['sh-window', `sh-window--${kind}`, className].filter(Boolean).join(' ')}>
  <div class="sh-window__bar" aria-hidden="true">
    <span class="sh-dots"><i></i><i></i><i></i></span>
    {
      kind === 'browser' ? (
        <span class="sh-window__url">
          {lock && (
            <svg viewBox="0 0 16 16" width="10" height="10" fill="none">
              <rect x="3" y="7" width="10" height="7" rx="1.6" stroke="currentColor" stroke-width="1.5" />
              <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          )}
          <span class="sh-window__addr">{title}</span>
        </span>
      ) : (
        <span class="sh-window__title">{title}</span>
      )
    }
    <span class="sh-window__spacer"></span>
  </div>
  <div class="sh-window__body">
    <slot />
  </div>
</div>
