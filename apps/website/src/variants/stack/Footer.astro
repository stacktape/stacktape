---
import Logo from '../../components/Logo.astro';
import { FOOTER_COLUMNS, FOOTER_NOTES, LINKS } from './data';
---

<footer class="st-footer">
  <div class="st-container">
    <div class="st-footer__columns">
      {
        FOOTER_COLUMNS.map((column) => (
          <div class="st-footer__col">
            <p class="st-footer__heading">{column.title}</p>
            <ul class="st-footer__links">
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="st-footer__bottom">
      <a class="st-footer__logo" href="/" aria-label="Stacktape home"><Logo height={18} /></a>
      {FOOTER_NOTES.map((note) => <span class="st-footer__note">{note}</span>)}
      <a class="st-footer__status" href={LINKS.status}>
        <i aria-hidden="true"></i>
        System status
      </a>
    </div>
  </div>
</footer>
