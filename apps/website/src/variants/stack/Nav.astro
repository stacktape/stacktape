---
/**
 * The sticky nav: transparent over the hero, the ground's colour with a blur once scrolled. Under
 * 900px the links move into a panel behind a menu button; the primary action stays visible.
 */
import { ButtonLink } from '@stacktape/ui-react/button';
import Logo from '../../components/Logo.astro';
import { LINKS, NAV_LINKS } from './data';
---

<header class="st-nav" data-st-nav>
  <div class="st-container st-nav__inner">
    <a class="st-nav__logo" href="/" aria-label="Stacktape home"><Logo height={24} /></a>

    <nav class="st-nav__primary" aria-label="Primary">
      <ul class="st-nav__links">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a class="st-nav__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="st-nav__actions">
      <a class="st-nav__link st-nav__signin" href={LINKS.console}>Sign in</a>
      <ButtonLink className="st-nav__demo" href={LINKS.demo} variant="secondary">Book a demo</ButtonLink>
      <ButtonLink className="st-nav__start" href={LINKS.getStarted} variant="primary">Get started</ButtonLink>
      <button class="st-nav__menu" type="button" aria-expanded="false" aria-controls="st-nav-panel" data-st-menu>
        <span class="st-visually-hidden">Menu</span>
        <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
          <path class="st-nav__bar1" d="M3 6h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          <path class="st-nav__bar2" d="M3 10h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          <path class="st-nav__bar3" d="M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="st-nav__panel" id="st-nav-panel" hidden data-st-panel>
    <div class="st-container">
      <ul class="st-nav__panel-links">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} data-st-panel-link>
                {link.label}
              </a>
            </li>
          ))
        }
        <li><a href={LINKS.console} data-st-panel-link>Sign in</a></li>
        <li><a href={LINKS.demo} data-st-panel-link>Book a demo</a></li>
      </ul>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-st-nav]');
  const menu = document.querySelector<HTMLButtonElement>('[data-st-menu]');
  const panel = document.querySelector<HTMLElement>('[data-st-panel]');

  const setOpen = (open: boolean) => {
    if (!menu || !panel) return;
    menu.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    nav?.classList.toggle('is-open', open);
  };

  menu?.addEventListener('click', () => setOpen(menu.getAttribute('aria-expanded') !== 'true'));
  for (const link of document.querySelectorAll('[data-st-panel-link]')) {
    link.addEventListener('click', () => setOpen(false));
  }
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  let ticking = false;
  const update = () => {
    ticking = false;
    nav?.classList.toggle('is-scrolled', window.scrollY > 40);
  };
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    },
    { passive: true }
  );
  update();
</script>
