---
import { CommandBox } from './CommandBox';
import { CLOSING_LINE, LINKS, TRUST_LINE } from './data';
---

<section class="tk-closing" aria-labelledby="tk-closing-title">
  <div class="tk-closing__panel">
    <h2 class="tk-closing__title" id="tk-closing-title">{CLOSING_LINE}</h2>
    <CommandBox client:load label="Get started" />
    <p class="tk-trust tk-trust--closing">{TRUST_LINE}</p>
    <p class="tk-closing__signin">Already set up? <a href={LINKS.console}>Sign in to the Console</a></p>
  </div>
</section>
