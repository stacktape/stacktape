---
/** 06 — per-resource cost bars from the AWS bill, and the budget with its alert marker. */
import { BILLED_LINE, BUDGET, COST_TOTAL, COSTS, PROJECT } from '../data';
import Window from '../Window.astro';

const largest = Math.max(...COSTS.map((cost) => cost.amount));
const money = (amount: number) => `$${amount.toFixed(2)}`;
---

<Window title={`${PROJECT.name} · <b>costs</b>`}>
  <div class="tk-screen__head tk-screen__head--row">
    <div>
      <h3 class="tk-screen__title">Cost by resource</h3>
      <p class="tk-screen__sub">month to date</p>
    </div>
    <p class="tk-cost__total">{money(COST_TOTAL)}</p>
  </div>

  <ul class="tk-bars" aria-label="Cost per resource">
    {
      COSTS.map((cost) => (
        <li class="tk-bar">
          <span class="tk-bar__name tk-mono">{cost.name}</span>
          <span class="tk-bar__lane">
            <span class="tk-bar__fill" style={`width: ${((cost.amount / largest) * 100).toFixed(1)}%`} />
          </span>
          <span class="tk-bar__amount tk-mono">{money(cost.amount)}</span>
        </li>
      ))
    }
  </ul>

  <div class="tk-panel tk-budget">
    <div class="tk-panel__head">
      <span class="tk-panel__title">Budget</span>
      <span class="tk-panel__meta"><b>${BUDGET.limit}</b> / month</span>
    </div>
    <div
      class="tk-budget__lane"
      role="img"
      aria-label={`${BUDGET.usedPct} % of $${BUDGET.limit} used; alert at ${BUDGET.alertPct} % ($${BUDGET.alertAt})`}
    >
      <span class="tk-budget__fill" style={`width: ${BUDGET.usedPct}%`}></span>
      <span class="tk-budget__mark" style={`left: ${BUDGET.alertPct}%`}></span>
    </div>
    <p class="tk-budget__legend">
      <span><b>{BUDGET.usedPct} %</b> used</span>
      <span>alert at <b>{BUDGET.alertPct} %</b> (${BUDGET.alertAt})</span>
    </p>
  </div>

  <p class="tk-billed">{BILLED_LINE}</p>
</Window>
