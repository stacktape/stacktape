---
/** 04 — security posture with its three findings, and the guardrails that are on. */
import { GUARDRAILS, POSTURE, PROJECT } from '../data';
import { PreviewButton, StatusBadge } from '../ui';
import Window from '../Window.astro';

const RADIUS = 26;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
const passingArc = (POSTURE.passing / POSTURE.total) * CIRCUMFERENCE;
---

<Window title={`${PROJECT.name} · <b>security</b>`}>
  <div class="tk-posture">
    <svg class="tk-ring" viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
      <circle cx="32" cy="32" r={RADIUS} class="tk-ring__track"></circle>
      <circle
        cx="32"
        cy="32"
        r={RADIUS}
        class="tk-ring__value"
        stroke-dasharray={`${passingArc.toFixed(2)} ${CIRCUMFERENCE.toFixed(2)}`}
        transform="rotate(-90 32 32)"></circle>
    </svg>
    <div class="tk-posture__num">
      <p class="tk-posture__big"><b>{POSTURE.passing}</b> of {POSTURE.total}</p>
      <p class="tk-posture__sub">checks passing</p>
    </div>
  </div>

  <ul class="tk-findings" aria-label="Findings">
    {
      POSTURE.findings.map((item) => (
        <li class="tk-finding">
          <span class="tk-finding__mark" aria-hidden="true" />
          <span class="tk-finding__text">{item.text}</span>
          <span class="tk-finding__action">
            {'badge' in item && (
              <StatusBadge tone="success" dot>
                {item.badge}
              </StatusBadge>
            )}
            <PreviewButton variant="secondary" small>
              {item.action}
            </PreviewButton>
          </span>
        </li>
      ))
    }
  </ul>

  <div class="tk-panel tk-guardrails">
    <div class="tk-panel__head">
      <span class="tk-panel__title">Guardrails on</span>
    </div>
    <p class="tk-guardrails__list">
      {
        GUARDRAILS.on.map((rule) => (
          <StatusBadge tone="brand" caps={false}>
            {rule}
          </StatusBadge>
        ))
      }
    </p>
    <p class="tk-guardrails__line">{GUARDRAILS.line}</p>
  </div>
</Window>
