---
import Logo from '../../components/Logo.astro';
import { LINKS } from './data';
---

<footer class="tk-footer">
  <div class="tk-footer__inner">
    <a href="/" aria-label="Stacktape home" class="tk-footer__logo"><Logo height={20} /></a>
    <ul class="tk-footer__links">
      <li><a href={LINKS.docs}>Docs</a></li>
      <li><a href={LINKS.github}>GitHub</a></li>
      <li><a href={LINKS.console}>Console</a></li>
      <li><a href={LINKS.discord}>Discord</a></li>
      <li><a href={LINKS.privacy}>Privacy</a></li>
    </ul>
    <span class="tk-footer__note">Open-source CLI (MIT) · hosted Console</span>
  </div>
</footer>
