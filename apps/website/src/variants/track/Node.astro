---
/**
 * A visitor node on the left track: a gold dot on the route line with a small card under it that
 * says what the visitor does here and what follows. `alignTo` names a row inside the neighbouring
 * screen that the dot should line up with; `route.ts` positions the node when it is set.
 *
 * Below 960px the track disappears and the node becomes a compact row above its surface.
 */
import type { VisitorNode } from './data';
import { inline } from './data';

type Props = { node: VisitorNode; alignTo?: string };

const { node, alignTo } = Astro.props;
---

<div class:list={['tk-node', alignTo && 'tk-node--aligned']} data-tk-node={node.id} data-tk-align-to={alignTo}>
  <i class="tk-node__dot" data-tk-dot aria-hidden="true"></i>
  <div class="tk-node__card">
    <p class="tk-node__what" set:html={inline(node.what)} />
    <p class="tk-node__note">{node.note}</p>
  </div>
</div>
