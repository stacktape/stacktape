---
/**
 * A step marker on the route: a 2:1 isometric rhombus carrying the number. The route passes
 * straight through its centre, so the number is painted with a ground-coloured stroke behind it
 * and stays legible over the line. Its stroke brightens once the drawn line has reached it.
 */
type Props = { number: string };

const { number } = Astro.props;
---

<div class="tk-plate" data-tk-plate={number}>
  <svg viewBox="0 0 56 28" width="56" height="28" aria-hidden="true" focusable="false">
    <polygon class="tk-plate__face" points="28,0.5 55.5,14 28,27.5 0.5,14"></polygon>
    <text class="tk-plate__num" x="28" y="14.5" text-anchor="middle" dominant-baseline="central">{number}</text>
  </svg>
</div>
