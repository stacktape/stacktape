---
import Check from '../Check.astro';
import Frame from '../Frame.astro';
---

<Frame url="<b>localhost</b> · stacktape init">
  <div class="sp-frame__body">
    <ol class="sp-rail" aria-label="Wizard steps">
      <li class="is-done">Start</li>
      <li class="is-done">Analyze</li>
      <li class="is-done">Review</li>
      <li class="is-on">Deploy</li>
    </ol>
    <h3 class="sp-h sp-h--lg">Deploying</h3>
    <p class="sp-p">
      Deploying to AWS account <b>4128…9903 (acme-dev)</b> as <b>matus</b>. 14 resources will be created. <b>web</b> and <b>apiService</b> get a public URL. Nothing else is reachable from the internet.
    </p>
    <hr class="sp-hr" />
    <ul class="sp-phases" aria-label="Deploy phases">
      <li>
        <Check kind="ok" label="done" />
        <span class="sp-phases__name">Initialize</span>
        <span class="sp-phases__detail">stage production · eu-west-1 · CloudFormation stack acme-project-production</span>
      </li>
      <li>
        <Check kind="ok" label="done" />
        <span class="sp-phases__name">Package</span>
        <span class="sp-phases__detail">web 41s · apiService 58s · worker 6s · built from source, zero config</span>
      </li>
      <li>
        <Check kind="brand" label="in progress" />
        <span class="sp-phases__name">Deploy</span>
        <span>
          <span class="sp-phases__detail">30 / 33 resources · mainDatabase · CREATE_IN_PROGRESS</span>
          <span class="sp-bar sp-bar--live" style="--w:91%" role="progressbar" aria-valuenow="30" aria-valuemin="0" aria-valuemax="33" aria-label="Deploy progress"><i></i></span>
        </span>
      </li>
      <li>
        <Check kind="idle" label="pending" />
        <span class="sp-phases__name">Outputs</span>
        <span class="sp-phases__detail">URLs and connection details</span>
      </li>
    </ul>
  </div>
</Frame>
