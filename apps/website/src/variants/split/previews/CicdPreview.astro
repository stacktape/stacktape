---
import Check from '../Check.astro';
import Frame from '../Frame.astro';
import ConsoleNav from './ConsoleNav.astro';
---

<Frame url="<b>console.stacktape.com</b> / acme-project / activity">
  <div class="sp-console">
    <ConsoleNav active="Organization/Activity" />
    <div class="sp-console__main">
      <p class="sp-crumb">acme-project · <b>Activity</b> · pull request #128</p>
      <div class="sp-inc__head">
        <h3 class="sp-h" style="margin:0">#128 · checkout: retry payment webhook</h3>
        <span class="sp-chip sp-chip--ok"><i aria-hidden="true"></i>preview environment</span>
      </div>
      <div class="sp-run">
        <ul class="sp-run__steps" aria-label="Pipeline steps">
          <li class="is-done">pull request → preview stage</li>
          <li class="is-done">checkout 4s</li>
          <li class="is-done">build · cache hit 52s</li>
          <li class="is-done">deploy stage pr-128 1m 21s</li>
          <li class="is-done">preview URL</li>
        </ul>
        <ul class="sp-list">
          <li>
            <Check kind="ok" label="up" />
            <span class="sp-list__main">
              <span class="sp-list__name">https://pr-128.acme-preview.com</span>
              <span class="sp-list__sub">stage pr-128 · its own database and cache · deleted when the pull request closes</span>
            </span>
          </li>
        </ul>
        <div class="sp-panel">
          <p class="sp-kicker">Build runner · in your AWS account</p>
          <dl class="sp-runner">
            <dt>Instance</dt>
            <dd>c7a.2xlarge · 8 vCPU / 16 GB · eu-west-1</dd>
            <dt>State</dt>
            <dd>warm · dependency and build caches kept between runs</dd>
            <dt>Idle</dt>
            <dd>stops after 15 minutes, and compute charges stop with it</dd>
            <dt>Also runs</dt>
            <dd>your self-hosted GitHub Actions jobs</dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</Frame>
