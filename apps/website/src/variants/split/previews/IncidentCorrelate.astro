---
import Frame from '../Frame.astro';
---

<Frame url="<b>console.stacktape.com</b> / acme-project / incidents / inc_8f2k">
  <div class="sp-frame__body">
    <div class="sp-inc__head">
      <span class="sp-sev sp-sev--error">Error</span>
      <span class="sp-sev sp-sev--open">Open</span>
      <span class="sp-inc__id">inc_8f2k · release correlation</span>
    </div>
    <div class="sp-corr" role="note">
      <span>
        <b>Opened 4m after the last deploy</b> · v41 · commit a1b2c3d — orders: add fulfillment status column · previous release v40 · config unchanged ·
        <span class="sp-corr__link">what changed (3 commits)</span>
      </span>
    </div>
    <div class="sp-rel" style="margin-top:12px" aria-label="Releases">
      <div class="sp-rel__v">
        <b>v40</b>
        <span>previous release · healthy</span>
      </div>
      <div class="sp-rel__v is-bad">
        <b>v41 · a1b2c3d</b>
        <span>deployed 18:01 · incident 18:05</span>
      </div>
      <div class="sp-rel__v">
        <b>v40 → v41</b>
        <span>3 commits · 0 config lines</span>
      </div>
    </div>
    <hr class="sp-hr" />
    <p class="sp-kicker">Around this time (same stack)</p>
    <ul class="sp-timeline">
      <li><span class="sp-timeline__t">18:01</span><span class="sp-dot" aria-hidden="true"></span><span><b>Deploy finished</b> · v41 · production · push to main</span></li>
      <li><span class="sp-timeline__t">18:04</span><span class="sp-dot sp-dot--amber" aria-hidden="true"></span><span><b>Alarm firing</b> · apiService 5xx rate above 1%</span></li>
      <li><span class="sp-timeline__t">18:05</span><span class="sp-dot sp-dot--err" aria-hidden="true"></span><span><b>Uptime check down</b> · https://api.acme.com/health · 3 of 3 regions</span></li>
      <li><span class="sp-timeline__t">18:05</span><span class="sp-dot sp-dot--err" aria-hidden="true"></span><span><b>Incident opened</b> · inc_8f2k · Error</span></li>
    </ul>
  </div>
</Frame>
