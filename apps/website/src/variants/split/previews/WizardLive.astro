---
import Check from '../Check.astro';
import Frame from '../Frame.astro';
---

<Frame url="<b>localhost</b> · stacktape init">
  <div class="sp-frame__body">
    <ol class="sp-rail" aria-label="Wizard steps">
      <li class="is-done">Start</li>
      <li class="is-done">Analyze</li>
      <li class="is-done">Review</li>
      <li class="is-done">Deploy</li>
    </ol>
    <div class="sp-inc__head">
      <h3 class="sp-h sp-h--lg" style="margin:0">It's live</h3>
      <span class="sp-chip sp-chip--ok"><i aria-hidden="true"></i>33 / 33 resources · 5m 48s</span>
    </div>
    <ul class="sp-list" aria-label="Public URLs">
      <li>
        <Check kind="ok" label="up" />
        <span class="sp-list__main">
          <span class="sp-list__name">https://acme.com</span>
          <span class="sp-list__sub">web · Next.js Web · CloudFront in front, firewall attached</span>
        </span>
        <span class="sp-list__aside">200 · 84 ms</span>
      </li>
      <li>
        <Check kind="ok" label="up" />
        <span class="sp-list__main">
          <span class="sp-list__name">https://api.acme.com</span>
          <span class="sp-list__sub">apiService · Web Service · 2 instances · migrations applied</span>
        </span>
        <span class="sp-list__aside">200 · 61 ms</span>
      </li>
    </ul>
    <hr class="sp-hr" />
    <p class="sp-kicker">Where to go from here</p>
    <ul class="sp-list">
      <li>
        <span class="sp-list__main">
          <span class="sp-list__name">Open the Console</span>
          <span class="sp-list__sub">Logs, metrics, traces and costs for this stage are already there.</span>
        </span>
        <span class="sp-wbtn sp-wbtn--ghost sp-wbtn--sm">Open</span>
      </li>
      <li>
        <span class="sp-list__main">
          <span class="sp-list__name">Connect GitHub</span>
          <span class="sp-list__sub">Push-to-deploy and a preview environment for every pull request.</span>
        </span>
        <span class="sp-wbtn sp-wbtn--ghost sp-wbtn--sm">Connect</span>
      </li>
    </ul>
  </div>
</Frame>
