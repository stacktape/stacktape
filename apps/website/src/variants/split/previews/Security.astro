---
import Check from '../Check.astro';
import Frame from '../Frame.astro';
import ConsoleNav from './ConsoleNav.astro';
---

<Frame url="<b>console.stacktape.com</b> / acme-project / security">
  <div class="sp-console">
    <ConsoleNav active="Security/Overview" />
    <div class="sp-console__main">
      <p class="sp-crumb">Security · <b>Overview</b> · acme-project</p>
      <ul class="sp-tabs" aria-label="Security tabs">
        <li class="is-on">Overview</li>
        <li>Vulnerabilities</li>
        <li>Posture</li>
      </ul>
      <div class="sp-score">
        <span class="sp-score__n">27<small>of 30</small></span>
        <span>
          <span class="sp-p" style="display:block;margin-bottom:6px">posture checks passing · re-graded nightly</span>
          <span class="sp-bar" style="--w:90%" role="img" aria-label="27 of 30 posture checks passing"><i></i></span>
        </span>
      </div>
      <hr class="sp-hr" />
      <p class="sp-kicker">Needs attention</p>
      <ul class="sp-findings">
        <li>
          <Check kind="warn" label="warning" />
          <span>
            <span class="sp-findings__t">mainDatabase backups retained 1 day (staging)</span>
            <span class="sp-findings__r">Posture · rule: Require recoverable data stores</span>
          </span>
          <span class="sp-wbtn sp-wbtn--ghost sp-wbtn--sm">Fix in config</span>
        </li>
        <li>
          <Check kind="err" label="critical" />
          <span>
            <span class="sp-findings__t">apiService image: 2 critical CVEs in openssl 3.0.13</span>
            <span class="sp-findings__r">Vulnerabilities · SBOM of deploy v42 · fix PR opened</span>
          </span>
          <span class="sp-chip sp-chip--ok"><i aria-hidden="true"></i>PR #130</span>
        </li>
        <li>
          <Check kind="warn" label="warning" />
          <span>
            <span class="sp-findings__t">apiService: plaintext STRIPE_KEY in config</span>
            <span class="sp-findings__r">Secrets · one click moves it to $Secret('stripe.key')</span>
          </span>
          <span class="sp-wbtn sp-wbtn--sm">Convert to $Secret</span>
        </li>
      </ul>
      <hr class="sp-hr" />
      <p class="sp-kicker">Guardrails on · enforced before any deploy changes anything</p>
      <div class="sp-chips">
        <span class="sp-chip sp-chip--ok"><i aria-hidden="true"></i>Keep SQL and OpenSearch private</span>
        <span class="sp-chip sp-chip--ok"><i aria-hidden="true"></i>Require WAF on load balancers</span>
        <span class="sp-chip sp-chip--ok"><i aria-hidden="true"></i>Require recoverable data stores</span>
        <span class="sp-chip"><i aria-hidden="true"></i>15 more types available</span>
      </div>
    </div>
  </div>
</Frame>
