---
type Props = { kind?: 'ok' | 'warn' | 'err' | 'idle' | 'brand'; label?: string };

const { kind = 'brand', label } = Astro.props;
---

<span class={`sp-check sp-check--${kind}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  {
    kind === 'warn' ? (
      <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M5 2.2v3.4M5 7.8v.1" />
      </svg>
    ) : kind === 'err' ? (
      <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M3 3l4 4M7 3l-4 4" />
      </svg>
    ) : kind === 'idle' ? null : (
      <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 5.2 4.2 7.3 8 3" />
      </svg>
    )
  }
</span>
