---
import type { JourneyRow } from './data';

type Props = { row: JourneyRow };

const { row } = Astro.props;
const youCount = row.you.count;
const stacktapeCount = row.stacktape.did.length;
const textHtml = row.you.text.replace(/`([^`]+)`/g, '<code>$1</code>');
const classes = ['sp-row', 'sp-split', row.tone === 'incident' && 'sp-row--incident'].filter(Boolean).join(' ');
---

<article class={classes} id={`row-${row.id}`} data-sp-row data-you={youCount} data-stacktape={stacktapeCount}>
  <span class="sp-row__time sp-row__time--seam" aria-hidden="true">{row.time}</span>
  <div class="sp-cell sp-cell--you sp-cell--rule">
    <div class="sp-cell__in">
      <div class="sp-row__you-in">
        <p class="sp-row__tag">
          <span class="sp-row__chapter">{row.chapter}</span>
          <span class="sp-row__who">You</span>
          <span class="sp-row__time sp-row__time--inline">{row.time}</span>
        </p>
        {row.you.nothing ? <p class="sp-row__dash" aria-label="Nothing">—</p> : <p class="sp-row__text" set:html={textHtml} />}
        {row.you.note && <p class="sp-row__note">{row.you.note}</p>}
        <p class="sp-row__meta">
          {row.you.nothing ? 'nothing to do' : youCount === 0 ? '0 actions' : <><b>+{youCount}</b> {youCount === 1 ? 'action' : 'actions'}</>}
        </p>
      </div>
    </div>
  </div>
  <div class="sp-cell sp-cell--stp sp-cell--rule">
    <div class="sp-cell__in">
      <slot />
      {
        stacktapeCount > 0 && (
          <ul class="sp-ledger" aria-label="What Stacktape did">
            {row.stacktape.did.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>
