---
import { CALLOUTS, LINKS, SUBHEADLINE } from './data';
import CommandBox from './CommandBox.astro';
import GeneratedConfig from './GeneratedConfig.astro';
---

<section class="sp-hero sp-split" aria-labelledby="sp-hero-title">
  <div class="sp-cell sp-cell--you sp-cell--rule">
    <div class="sp-cell__in">
      <p class="sp-hero__eyebrow sp-mono">Your own AWS account · open-source CLI</p>
      <h1 class="sp-hero__title" id="sp-hero-title">AWS DevOps, <em>fully automated.</em></h1>
      <p class="sp-hero__sub">{SUBHEADLINE}</p>
      <div class="sp-cta">
        <CommandBox id="sp-hero-cmd" />
        <div class="sp-cta__row">
          <a class="sp-btn sp-btn--ghost" href={LINKS.signUp}>Sign up</a>
          <a class="sp-btn sp-btn--ghost" href={LINKS.demo}>Book a demo</a>
        </div>
      </div>
      <div class="sp-hero__proof">
        <GeneratedConfig compact />
      </div>
      <p class="sp-hero__foot">
        The wizard runs on your machine. Nothing is created on AWS and nothing is billed until you press Deploy.
        <a href={LINKS.github}>MIT-licensed CLI</a> · plain CloudFormation in your account · eject anytime.
      </p>
    </div>
  </div>
  <div class="sp-cell sp-cell--stp sp-cell--rule">
    <div class="sp-cell__in">
      <div class="sp-board">
        <div class="sp-board__head">
          <span class="sp-mono">What Stacktape does</span>
          <span class="sp-board__sub">for acme/acme-project · example project</span>
        </div>
        <div class="sp-board__file">
          <GeneratedConfig />
        </div>
        <ul class="sp-callouts" aria-label="Everything a DevOps team does, Stacktape does">
          {
            CALLOUTS.map((item) => (
              <li>
                <b>{item.verb}</b>
                <span aria-hidden="true">—</span>
                <span>{item.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
