---
/**
 * Figure 2: the project page in the Console. Two environments, a deploy running in production
 * after a push to main, and the preview environment a pull request got on its own.
 */
import ConsoleFrame from './ConsoleFrame.astro';

type Phase = { name: string; state: 'done' | 'running' | 'pending'; detail: string; progress?: number };

const PHASES: Phase[] = [
  { name: 'Initialize', state: 'done', detail: '3s' },
  { name: 'Package', state: 'done', detail: 'web 41s · apiService 58s · worker 6s' },
  { name: 'Deploy', state: 'running', detail: '21 of 33 resources', progress: 64 },
  { name: 'Outputs', state: 'pending', detail: 'waiting' }
];
---

<ConsoleFrame active="Organization/Projects" crumbs={['Projects', 'acme-project']}>
  <div class="rb-ship">
    <header class="rb-ship__head">
      <div>
        <h3 class="rb-ship__name">acme-project</h3>
        <p class="rb-ship__meta">
          <span class="rb-mono">github.com/acme/acme-project</span> · eu-west-1 · AWS account{' '}
          <span class="rb-mono">4128…9903</span> (acme-dev)
        </p>
      </div>
      <div class="rb-ship__actions">
        <span class="rb-btn">Settings</span>
        <span class="rb-btn rb-btn--primary">Deploy</span>
      </div>
    </header>

    <section class="rb-panel">
      <div class="rb-panel__head">Environments <small>2 environments · 1 preview</small></div>

      <div class="rb-env">
        <div class="rb-env__row">
          <span class="rb-env__name">production</span>
          <span class="rb-chip rb-chip--brand"><span class="rb-chip__dot rb-chip__dot--pulse"></span>Deploying</span>
          <span class="rb-env__meta">eu-west-1 · v41 → v42 · <span class="rb-mono">https://acme.com</span></span>
          <span class="rb-env__when">deploy #42 · 2m 31s elapsed</span>
        </div>
        <div class="rb-deploy">
          <p class="rb-deploy__trigger">
            Push to <span class="rb-mono">main</span> · <span class="rb-mono">c9d4e2f</span> orders: apply fulfillment
            migration · by matus
          </p>
          <ol class="rb-phases">
            {
              PHASES.map((phase) => (
                <li class:list={['rb-phase', `is-${phase.state}`]}>
                  <span class="rb-phase__mark" aria-hidden="true">
                    {phase.state === 'done' ? '✓' : phase.state === 'running' ? <i class="rb-phase__spin" /> : ''}
                  </span>
                  <span class="rb-phase__name">{phase.name}</span>
                  <span class="rb-phase__detail">{phase.detail}</span>
                  {phase.progress !== undefined && (
                    <span class="rb-phase__bar">
                      <i style={`width: ${phase.progress}%`} />
                    </span>
                  )}
                </li>
              ))
            }
          </ol>
          <p class="rb-deploy__note">
            Zero-downtime: new apiService instances pass their health checks before the old ones stop. Roll back to v41
            with one click.
          </p>
        </div>
      </div>

      <div class="rb-env">
        <div class="rb-env__row">
          <span class="rb-env__name">staging</span>
          <span class="rb-chip rb-chip--ok"><span class="rb-chip__dot"></span>Healthy</span>
          <span class="rb-env__meta">eu-west-1 · v42 · <span class="rb-mono">https://staging.acme.com</span></span>
          <span class="rb-env__when">deployed 41m ago · 3m 08s</span>
        </div>
      </div>
    </section>

    <section class="rb-panel rb-ship__prs">
      <div class="rb-panel__head">Pull request previews <small>one environment per open pull request</small></div>
      <div class="rb-env">
        <div class="rb-env__row">
          <span class="rb-env__name rb-mono">pr-128</span>
          <span class="rb-chip rb-chip--ok"><span class="rb-chip__dot"></span>Ready</span>
          <span class="rb-env__meta"
            >PR #128 · checkout: retry payment webhook · <span class="rb-mono">https://pr-128.acme-preview.com</span></span
          >
          <span class="rb-env__when">deleted when the PR closes</span>
        </div>
      </div>
    </section>

    <p class="rb-ship__runner">
      Builds run on a build runner inside your AWS account (<span class="rb-mono">c7a.2xlarge</span>). It keeps caches
      between runs and stops after 15 minutes idle.
    </p>
  </div>
</ConsoleFrame>

<style>
  .rb-ship {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rb-ship__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px 16px;
  }
  .rb-ship__name {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .rb-ship__meta {
    margin: 4px 0 0;
    color: var(--rb-muted);
    font-size: 13px;
  }
  .rb-ship__actions {
    display: flex;
    gap: 8px;
  }

  .rb-env + .rb-env {
    border-top: 1px solid var(--rb-line);
  }
  .rb-env__row {
    display: grid;
    grid-template-columns: 110px auto minmax(0, 1fr) auto;
    gap: 6px 14px;
    align-items: center;
    padding: 11px 14px;
  }
  .rb-env__name {
    font-size: 14px;
    font-weight: 600;
  }
  .rb-env__meta {
    overflow: hidden;
    color: var(--rb-text-2);
    font-size: 13px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rb-env__when {
    color: var(--rb-muted);
    font-family: var(--rb-mono);
    font-size: 13px;
    white-space: nowrap;
  }

  .rb-deploy {
    margin: 0 14px 14px;
    padding: 12px 14px;
    border: 1px solid var(--rb-line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.025);
  }
  .rb-deploy__trigger {
    margin: 0 0 10px;
    color: var(--rb-text-2);
    font-size: 13px;
  }
  .rb-phases {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rb-phase {
    display: grid;
    grid-template-columns: 18px 92px minmax(0, 1fr);
    gap: 4px 10px;
    align-items: center;
    font-size: 13px;
  }
  .rb-phase__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    color: var(--rb-brand);
  }
  .rb-phase.is-pending .rb-phase__mark::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--rb-faint);
  }
  .rb-phase__spin {
    width: 12px;
    height: 12px;
    border: 2px solid rgba(54, 190, 190, 0.25);
    border-top-color: var(--rb-brand);
    border-radius: 50%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .rb-phase__spin {
      animation: rb-spin 900ms linear infinite;
    }
  }
  @keyframes rb-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .rb-phase__name {
    font-weight: 500;
  }
  .rb-phase.is-pending .rb-phase__name,
  .rb-phase.is-pending .rb-phase__detail {
    color: var(--rb-faint);
  }
  .rb-phase__detail {
    color: var(--rb-muted);
    font-family: var(--rb-mono);
  }
  .rb-phase__bar {
    grid-column: 2 / -1;
    display: block;
    height: 4px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
  }
  .rb-phase__bar i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--rb-brand);
  }
  .rb-deploy__note {
    margin: 10px 0 0;
    color: var(--rb-muted);
    font-size: 13px;
  }
  .rb-ship__runner {
    margin: 0;
    color: var(--rb-muted);
    font-size: 13px;
  }

  @media (max-width: 720px) {
    .rb-env__row {
      grid-template-columns: auto auto;
      grid-auto-flow: row;
    }
    .rb-env__meta,
    .rb-env__when {
      grid-column: 1 / -1;
      white-space: normal;
    }
    .rb-phase {
      grid-template-columns: 18px minmax(0, 1fr);
    }
    .rb-phase__detail {
      grid-column: 2;
    }
    .rb-ship__prs,
    .rb-ship__runner {
      display: none;
    }
  }
</style>
