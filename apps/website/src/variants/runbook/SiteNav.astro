---
/** The runbook's top bar: logo, the three plain links, and the one place the demo appears. */
import Logo from '../../components/Logo.astro';
---

<header class="rb-nav">
  <a class="rb-nav__home" href="/" aria-label="Stacktape home"><Logo height={22} /></a>
  <nav class="rb-nav__links" aria-label="Site">
    <a class="rb-nav__link" href="https://docs.stacktape.com">Docs</a>
    <a class="rb-nav__link" href="https://github.com/stacktape/stacktape">GitHub</a>
    <a class="rb-nav__link rb-nav__link--signin" href="https://console.stacktape.com">Sign in</a>
    <a class="rb-nav__link rb-nav__demo" href="https://cal.com/stacktape/30min">
      <span class="rb-nav__demo-long">Book a demo</span><span class="rb-nav__demo-short">Demo</span>
    </a>
  </nav>
</header>
