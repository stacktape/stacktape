---
/**
 * Figure 3: what the deploy wired up for production. Metric tiles for apiService, one request
 * traced step by step, uptime from three regions, and the live log. All illustrative, all
 * internally consistent with the rest of the runbook.
 */
import ConsoleFrame from './ConsoleFrame.astro';

const TILES = [
  { label: 'Requests', value: '184', unit: 'req/s', points: '0,18 12,16 24,17 36,12 48,13 60,9 72,11 84,7 100,8' },
  { label: 'Latency p95', value: '212', unit: 'ms', points: '0,14 12,15 24,12 36,16 48,13 60,15 72,12 84,14 100,13' },
  { label: '5xx errors', value: '0.02', unit: '%', points: '0,20 12,20 24,19 36,21 48,20 60,20 72,19 84,20 100,20' },
  { label: 'Uptime · 30 days', value: '99.98', unit: '%', points: '0,8 12,8 24,8 36,8 48,8 60,8 72,9 84,8 100,8' }
];

/** One traced request: `GET /orders`, 212 ms end to end. Offsets and durations in milliseconds. */
const TRACE_TOTAL = 212;
const SPANS = [
  { name: 'GET /orders', who: 'apiService', start: 0, ms: 212, tone: 'compute' },
  { name: 'handler orders.list', who: 'apiService', start: 6, ms: 198, tone: 'compute' },
  { name: 'SELECT … FROM orders', who: 'mainDatabase', start: 24, ms: 48, tone: 'database' },
  { name: 'GET cart:u_4d1', who: 'cache', start: 74, ms: 2, tone: 'cache' },
  { name: 'POST /events', who: 'outbound HTTP', start: 120, ms: 31, tone: 'http' }
];
const pct = (ms: number) => `${(ms / TRACE_TOTAL) * 100}%`;

const REGIONS = ['Ireland (eu-west-1)', 'Virginia (us-east-1)', 'Singapore (ap-southeast-1)'];
const DAYS = Array.from({ length: 30 }, (_, index) => index);
/** The one short outage: the incident in figure 4, seen from every region. */
const INCIDENT_DAY = 24;

const LOGS = [
  { t: '14:21:07.118', who: 'apiService', level: 'INFO', text: 'GET /orders 200 · 212 ms' },
  { t: '14:21:07.402', who: 'worker', level: 'INFO', text: 'order ord_9f31 fulfillment_status=shipped' },
  { t: '14:21:08.011', who: 'apiService', level: 'INFO', text: 'GET /health 200 · 3 ms' },
  { t: '14:21:08.590', who: 'apiService', level: 'INFO', text: 'POST /orders/ord_9f32/events 202 · 31 ms' }
];
---

<ConsoleFrame
  active="Observability/Metrics"
  crumbs={['acme-project', 'production']}
  tabs={['Overview', 'Activity', 'Logs', 'Metrics', 'Costs', 'Configuration', 'Danger zone']}
  activeTab="Metrics"
>
  <div class="rb-watch">
    <div class="rb-watch__filters">
      <span class="rb-chip">apiService</span>
      <span class="rb-chip">last 1 hour</span>
      <span class="rb-watch__source">read from your own CloudWatch and X-Ray data</span>
    </div>

    <div class="rb-tiles">
      {
        TILES.map((tile) => (
          <div class="rb-tile">
            <span class="rb-tile__label">{tile.label}</span>
            <span class="rb-tile__value">
              {tile.value}
              <small>{tile.unit}</small>
            </span>
            <svg class="rb-tile__spark" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
              <polyline points={tile.points} fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </div>
        ))
      }
    </div>

    <div class="rb-watch__grid">
      <section class="rb-panel rb-trace">
        <div class="rb-panel__head">
          Trace · <span class="rb-mono">GET /orders</span>
          <small>212 ms · one request, step by step</small>
        </div>
        <div class="rb-panel__body">
          {
            SPANS.map((span) => (
              <div class="rb-span">
                <span class="rb-span__name">
                  <span class="rb-mono">{span.name}</span>
                  <span class="rb-span__who">{span.who}</span>
                </span>
                <span class="rb-span__track">
                  <i
                    class={`rb-span__bar rb-span__bar--${span.tone}`}
                    style={`left: ${pct(span.start)}; width: max(${pct(span.ms)}, 3px)`}
                  />
                </span>
                <span class="rb-span__ms">{span.ms} ms</span>
              </div>
            ))
          }
        </div>
      </section>

      <section class="rb-panel rb-uptime">
        <div class="rb-panel__head">Uptime · <span class="rb-mono">/health</span> <small>3 regions · 30 days</small></div>
        <div class="rb-panel__body">
          {
            REGIONS.map((region) => (
              <div class="rb-region">
                <span class="rb-region__name">{region}</span>
                <span class="rb-region__days" aria-hidden="true">
                  {DAYS.map((day) => (
                    <i class:list={{ 'is-down': day === INCIDENT_DAY }} />
                  ))}
                </span>
                <span class="rb-region__pct">99.98%</span>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <section class="rb-panel rb-logs">
      <div class="rb-panel__head">
        Logs <small><span class="rb-logs__live"><i></i>live tail</span> · production · all resources</small>
      </div>
      <div class="rb-logs__body">
        {
          LOGS.map((line) => (
            <div class="rb-log">
              <span class="rb-log__t">{line.t}</span>
              <span class="rb-log__who">{line.who}</span>
              <span class="rb-log__level">{line.level}</span>
              <span class="rb-log__text">{line.text}</span>
            </div>
          ))
        }
        <div class="rb-log rb-log--cursor" aria-hidden="true"><span class="rb-log__caret"></span></div>
      </div>
    </section>
  </div>
</ConsoleFrame>

<style>
  .rb-watch {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rb-watch__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .rb-watch__source {
    margin-left: auto;
    color: var(--rb-faint);
    font-size: 13px;
  }

  .rb-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .rb-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    border: 1px solid var(--rb-line);
    border-radius: 10px;
    background: var(--rb-panel);
  }
  .rb-tile__label {
    color: var(--rb-muted);
    font-size: 13px;
  }
  .rb-tile__value {
    font-family: var(--rb-mono);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .rb-tile__value small {
    margin-left: 4px;
    color: var(--rb-muted);
    font-size: 13px;
    font-weight: 400;
  }
  .rb-tile__spark {
    width: 100%;
    height: 28px;
    margin-top: 6px;
    color: var(--rb-brand);
  }

  .rb-watch__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 10px;
  }

  .rb-span {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr) 52px;
    gap: 10px;
    align-items: center;
    padding: 5px 0;
    font-size: 13px;
  }
  .rb-span + .rb-span {
    border-top: 1px solid var(--rb-line);
  }
  .rb-span__name {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }
  .rb-span__name .rb-mono {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rb-span__who {
    color: var(--rb-faint);
    font-size: 13px;
  }
  .rb-span__track {
    position: relative;
    display: block;
    height: 10px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.05);
  }
  .rb-span__bar {
    position: absolute;
    top: 0;
    height: 100%;
    border-radius: 3px;
    background: var(--rb-brand);
  }
  .rb-span__bar--database {
    background: var(--rb-blue);
  }
  .rb-span__bar--cache {
    background: var(--rb-red);
  }
  .rb-span__bar--http {
    background: var(--rb-amber);
  }
  .rb-span__ms {
    color: var(--rb-muted);
    font-family: var(--rb-mono);
    text-align: right;
  }

  .rb-region {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 10px;
    align-items: center;
    padding: 6px 0;
    font-size: 13px;
  }
  .rb-region + .rb-region {
    border-top: 1px solid var(--rb-line);
  }
  .rb-region__name {
    font-weight: 500;
  }
  .rb-region__pct {
    color: var(--rb-green);
    font-family: var(--rb-mono);
  }
  .rb-region__days {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(30, minmax(0, 1fr));
    gap: 2px;
  }
  .rb-region__days i {
    display: block;
    height: 12px;
    border-radius: 2px;
    background: rgba(76, 207, 143, 0.6);
  }
  .rb-region__days i.is-down {
    background: var(--rb-red);
  }

  .rb-logs__live {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--rb-green);
  }
  .rb-logs__live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .rb-logs__live i {
      animation: rb-pulse 1.4s ease-in-out infinite;
    }
  }
  .rb-logs__body {
    padding: 10px 14px;
    background: #101616;
    font-family: var(--rb-mono);
    font-size: 13px;
    line-height: 1.7;
  }
  .rb-log {
    display: grid;
    grid-template-columns: 96px 78px 42px minmax(0, 1fr);
    gap: 12px;
    white-space: nowrap;
  }
  .rb-log__t {
    color: var(--rb-faint);
  }
  .rb-log__who {
    color: var(--rb-brand);
  }
  .rb-log__level {
    color: var(--rb-muted);
  }
  .rb-log__text {
    overflow: hidden;
    color: var(--rb-text-2);
    text-overflow: ellipsis;
  }
  .rb-log__caret {
    display: inline-block;
    width: 7px;
    height: 14px;
    vertical-align: -2px;
    background: var(--rb-text-2);
  }
  @media (prefers-reduced-motion: no-preference) {
    .rb-log__caret {
      animation: rb-blink 1s steps(2, start) infinite;
    }
  }
  @keyframes rb-blink {
    to {
      visibility: hidden;
    }
  }

  @media (max-width: 900px) {
    .rb-watch__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .rb-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .rb-span {
      grid-template-columns: minmax(0, 1fr) 52px;
    }
    .rb-span__ms {
      grid-row: 1;
      grid-column: 2;
    }
    .rb-span__track {
      grid-row: 2;
      grid-column: 1 / -1;
    }
    .rb-uptime,
    .rb-logs,
    .rb-watch__source {
      display: none;
    }
  }
</style>
