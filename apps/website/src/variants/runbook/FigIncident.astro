---
/**
 * Figure 4: the incident page. The signals that opened it, the release that caused it, the
 * handoff for a coding agent, the switch for autonomous fixes shown off, and the timeline from
 * the deploy to "recovered".
 */
import ConsoleFrame from './ConsoleFrame.astro';

const TIMELINE = [
  { t: '14:02', text: 'Deploy v41 finished', sub: 'commit a1b2c3d — orders: add fulfillment status column', tone: '' },
  { t: '14:06', text: 'Incident opened', sub: 'Uptime check down · https://api.acme.com/health · 3 of 3 regions', tone: 'err' },
  { t: '14:07', text: 'Application error grouped', sub: 'PrismaClientKnownRequestError · apiService · 214 occurrences', tone: 'err' },
  { t: '14:09', text: 'Details copied for agent', sub: 'by matus', tone: '' },
  { t: '14:12', text: 'PR #131 opened by the agent', sub: 'orders: apply fulfillment migration — the migration was never applied. Approved by matus.', tone: '' },
  { t: '14:15', text: 'Deploy v42 finished through the pipeline', sub: 'production · 3m 08s', tone: '' },
  { t: '14:17', text: 'Resolved · recovered on its own signals', sub: '11 min from open to resolved', tone: 'ok' }
];
---

<ConsoleFrame
  active="Observability/Incidents"
  crumbs={['acme-project', 'production', 'Incidents', 'inc_8f2k']}
  sideScroll={120}
>
  <div class="rb-inc">
    <header class="rb-inc__head">
      <div class="rb-inc__title-block">
        <div class="rb-inc__chips">
          <span class="rb-chip rb-chip--err">Error</span>
          <span class="rb-chip rb-chip--ok"><span class="rb-chip__dot"></span>Resolved</span>
          <span class="rb-inc__id rb-mono">inc_8f2k · production</span>
        </div>
        <h3 class="rb-inc__title">apiService is down after deploy v41</h3>
        <p class="rb-inc__opened">
          Opened <strong>4m after the last deploy</strong> · <span class="rb-mono">v41</span> · commit{' '}
          <span class="rb-mono">a1b2c3d</span> — orders: add fulfillment status column · previous release{' '}
          <span class="rb-mono">v40</span> · config unchanged · <span class="rb-inc__link">what changed (3 commits)</span>
        </p>
      </div>
      <div class="rb-inc__actions">
        <span class="rb-btn rb-btn--primary">Copy details for agent</span>
        <span class="rb-btn">Acknowledge</span>
      </div>
    </header>

    <div class="rb-inc__grid">
      <div class="rb-inc__main">
        <section class="rb-panel">
          <div class="rb-panel__head">Signals <small>2 signals opened this incident</small></div>
          <div class="rb-signal">
            <span class="rb-signal__icon rb-signal__icon--err" aria-hidden="true"></span>
            <span class="rb-signal__text">
              <span class="rb-signal__name">Uptime check down</span>
              <span class="rb-signal__detail"><span class="rb-mono">https://api.acme.com/health</span> · 3 of 3 regions</span>
            </span>
          </div>
          <div class="rb-signal">
            <span class="rb-signal__icon rb-signal__icon--err" aria-hidden="true"></span>
            <span class="rb-signal__text">
              <span class="rb-signal__name">Application error</span>
              <span class="rb-signal__detail">
                <span class="rb-mono">PrismaClientKnownRequestError: column "fulfillment_status" does not exist</span> ·
                apiService · 214 occurrences
              </span>
            </span>
          </div>
        </section>

        <section class="rb-panel">
          <div class="rb-panel__head">Timeline</div>
          <ol class="rb-timeline">
            {
              TIMELINE.map((entry) => (
                <li class:list={['rb-tl', entry.tone && `rb-tl--${entry.tone}`]}>
                  <span class="rb-tl__t rb-mono">{entry.t}</span>
                  <span class="rb-tl__dot" aria-hidden="true" />
                  <span class="rb-tl__text">
                    <span class="rb-tl__name">{entry.text}</span>
                    <span class="rb-tl__sub">{entry.sub}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <aside class="rb-inc__aside">
        <section class="rb-panel">
          <div class="rb-panel__head">Handoff for your coding agent</div>
          <div class="rb-panel__body rb-handoff">
            <p>
              <span class="rb-btn rb-btn--primary">Copy details for agent</span>
            </p>
            <p class="rb-handoff__what">One bundle with the release diff, the evidence with stack frames, the timeline and scoped links, ending in a 4-step protocol:</p>
            <ol class="rb-handoff__steps rb-mono">
              <li>reproduce from the evidence</li>
              <li>fix on a branch, open a PR</li>
              <li>wait for review and the pipeline</li>
              <li>stacktape incidents:resolve --incidentId inc_8f2k</li>
            </ol>
            <div class="rb-handoff__switch">
              <span class="rb-switch" role="img" aria-label="Off"></span>
              <span class="rb-handoff__switch-text">
                <span>Let an agent fix and deploy on its own</span>
                <span class="rb-muted">Opt-in. Off by default.</span>
              </span>
            </div>
          </div>
        </section>

        <section class="rb-panel">
          <div class="rb-panel__head">Around this time <small>same stack</small></div>
          <ul class="rb-around">
            <li><span class="rb-mono">14:02</span> Deploy v41 finished, 4m before</li>
            <li><span class="rb-mono">14:05</span> Alarm apiService-5xx-rate started firing</li>
            <li><span class="rb-mono">14:06</span> mainDatabase healthy · CPU 12% · no restarts</li>
          </ul>
        </section>
      </aside>
    </div>
  </div>
</ConsoleFrame>

<style>
  .rb-inc {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rb-inc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px 16px;
  }
  .rb-inc__title-block {
    min-width: 0;
    max-width: 720px;
  }
  .rb-inc__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .rb-inc__id {
    color: var(--rb-muted);
    font-size: 13px;
  }
  .rb-inc__title {
    margin: 8px 0 0;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .rb-inc__opened {
    margin: 6px 0 0;
    color: var(--rb-text-2);
    font-size: 13px;
    line-height: 1.55;
  }
  .rb-inc__opened strong {
    color: var(--rb-text);
    font-weight: 600;
  }
  .rb-inc__link {
    color: var(--rb-brand);
  }
  .rb-inc__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .rb-inc__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 12px;
  }
  .rb-inc__main,
  .rb-inc__aside {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .rb-signal {
    display: grid;
    grid-template-columns: 10px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    padding: 10px 14px;
    font-size: 13px;
  }
  .rb-signal + .rb-signal {
    border-top: 1px solid var(--rb-line);
  }
  .rb-signal__icon {
    width: 10px;
    height: 10px;
    margin-top: 4px;
    border-radius: 50%;
  }
  .rb-signal__icon--err {
    background: var(--rb-red);
    box-shadow: 0 0 0 3px rgba(240, 116, 116, 0.2);
  }
  .rb-signal__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .rb-signal__name {
    font-weight: 600;
  }
  .rb-signal__detail {
    color: var(--rb-text-2);
    overflow-wrap: anywhere;
  }

  .rb-timeline {
    margin: 0;
    padding: 6px 14px 10px;
    list-style: none;
  }
  .rb-tl {
    position: relative;
    display: grid;
    grid-template-columns: 44px 10px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    padding: 6px 0;
    font-size: 13px;
  }
  .rb-tl__t {
    color: var(--rb-muted);
    line-height: 1.5;
  }
  .rb-tl__dot {
    position: relative;
    z-index: 1;
    width: 10px;
    height: 10px;
    margin-top: 5px;
    border: 2px solid var(--rb-faint);
    border-radius: 50%;
    background: var(--rb-panel);
  }
  .rb-tl--err .rb-tl__dot {
    border-color: var(--rb-red);
  }
  .rb-tl--ok .rb-tl__dot {
    border-color: var(--rb-green);
    background: var(--rb-green);
  }
  .rb-tl:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 20px;
    bottom: -8px;
    left: 58px;
    width: 2px;
    background: var(--rb-line);
  }
  .rb-tl__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .rb-tl__name {
    font-weight: 500;
  }
  .rb-tl--ok .rb-tl__name {
    color: var(--rb-green);
  }
  .rb-tl__sub {
    color: var(--rb-muted);
    overflow-wrap: anywhere;
  }

  .rb-handoff p {
    margin: 0;
  }
  .rb-handoff__what {
    margin-top: 10px !important;
    color: var(--rb-text-2);
    font-size: 13px;
  }
  .rb-handoff__steps {
    margin: 8px 0 0;
    padding: 0 0 0 20px;
    list-style: decimal;
    color: var(--rb-muted);
    font-size: 13px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .rb-handoff__switch {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--rb-line);
    font-size: 13px;
  }
  .rb-handoff__switch-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .rb-around {
    margin: 0;
    padding: 8px 14px 10px;
    list-style: none;
    color: var(--rb-text-2);
    font-size: 13px;
    line-height: 1.7;
  }
  .rb-around .rb-mono {
    margin-right: 8px;
    color: var(--rb-muted);
  }

  @media (max-width: 900px) {
    .rb-inc__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .rb-inc__actions .rb-btn:not(.rb-btn--primary),
    .rb-around,
    .rb-inc__aside .rb-panel:last-child {
      display: none;
    }
  }
</style>
