---
/**
 * Figure 1: the wizard's Review screen. The file Stacktape wrote and the architecture it
 * describes share one window; a draggable divider decides how much of each is visible. Under
 * them, the decisions made for the reader and the estimate. Wheel zoom on the diagram is gated
 * behind a click so the page keeps scrolling normally.
 */
import { ACME_CONFIG, ACME_DECIDED, ACME_ESTIMATE, ACME_YAML } from './acme';
import { highlightYaml } from './yaml-highlight';
import ReviewDiagram from './ReviewDiagram';

const file = highlightYaml(ACME_YAML);
const lineNumbers = Array.from({ length: file.lineCount }, (_, index) => index + 1);
const STEPS = ['Start', 'Analyze', 'Review', 'Deploy'];
---

<div class="rb-wiz">
  <div class="rb-wiz__bar">
    <span class="rb-wiz__lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="rb-wiz__url"><span class="rb-mono">localhost</span> · stacktape init</span>
    <ol class="rb-wiz__steps" aria-label="Wizard steps">
      {STEPS.map((step, index) => <li class:list={[{ 'is-done': index < 2, 'is-active': index === 2 }]}>{step}</li>)}
    </ol>
    <span class="rb-wiz__example">example project</span>
  </div>

  <div class="rb-wiz__head">
    <p class="rb-wiz__scan">Opened 41 files in 38s, all on this machine.</p>
    <h3 class="rb-wiz__title">Here's your app on AWS</h3>
    <p class="rb-wiz__summary">A Next.js app with a background worker, using a Postgres database and a Redis cache.</p>
  </div>

  <div class="rb-reveal" data-rb-reveal style="--reveal: 46%">
    <div class="rb-reveal__file">
      <div class="rb-pane__tab">
        <span class="rb-pane__name">stacktape.yml</span>
        <span class="rb-pane__hint">the file Stacktape will write</span>
      </div>
      <div class="rb-file__scroll">
        <div class="rb-file__gutter" aria-hidden="true">{lineNumbers.map((n) => <span>{n}</span>)}</div>
        <pre class="rb-file__code"><code set:html={file.html} /></pre>
      </div>
    </div>

    <div class="rb-reveal__diagram">
      <div class="rb-pane__tab rb-pane__tab--right">
        <span class="rb-pane__name">Architecture</span>
        <span class="rb-pane__hint">what AWS will run</span>
      </div>
      <div class="rb-reveal__canvas">
        <ReviewDiagram client:only="react" config={ACME_CONFIG} />
      </div>
      <button type="button" class="rb-reveal__gate" data-rb-gate>
        <span class="rb-reveal__gate-pill">Click to explore <span class="rb-reveal__gate-sub">· scroll zooms, drag pans</span></span>
      </button>
    </div>

    <div
      class="rb-reveal__handle"
      data-rb-handle
      role="slider"
      tabindex="0"
      aria-label="How much of the window shows the file; the rest shows the architecture"
      aria-valuemin="24"
      aria-valuemax="72"
      aria-valuenow="46"
      aria-valuetext="46% file, 54% architecture"
    >
      <span class="rb-reveal__grip" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
          <path
            d="M6 4 2.5 8 6 12M10 4l3.5 4L10 12"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>

  <div class="rb-wiz__below">
    <section class="rb-wiz__decided" aria-label="Decided for you">
      <h4 class="rb-wiz__h4">Decided for you <span class="rb-wiz__sub">change any of these; nothing is created yet</span></h4>
      <ul class="rb-wiz__list">
        {
          ACME_DECIDED.map((row) => (
            <li class="rb-wiz__row">
              <span class="rb-wiz__check" aria-hidden="true">✓</span>
              <span class="rb-wiz__row-text">
                <span class="rb-wiz__row-title">{row.title}</span>
                <span class="rb-wiz__row-note">{row.note}</span>
              </span>
              <span class="rb-btn rb-btn--ghost">Change</span>
            </li>
          ))
        }
      </ul>
    </section>
    <footer class="rb-wiz__foot">
      <p class="rb-wiz__estimate">
        <strong>{ACME_ESTIMATE.resources} AWS resources</strong> · about <strong>{ACME_ESTIMATE.monthly}/month</strong>
        <span class="rb-wiz__estimate-note">Nothing is created or billed until you deploy.</span>
      </p>
      <div class="rb-wiz__actions">
        <span class="rb-btn">Back</span>
        <span class="rb-btn rb-btn--primary">Ready to deploy →</span>
      </div>
    </footer>
  </div>
</div>

<style>
  .rb-wiz {
    display: flex;
    flex-direction: column;
  }

  /* Browser-tab bar */
  .rb-wiz__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--rb-line);
    background: rgba(255, 255, 255, 0.02);
    color: var(--rb-muted);
    font-size: 13px;
  }
  .rb-wiz__lights {
    display: inline-flex;
    gap: 6px;
  }
  .rb-wiz__lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
  }
  .rb-wiz__url {
    padding: 4px 10px;
    border: 1px solid var(--rb-line);
    border-radius: 6px;
    color: var(--rb-text-2);
  }
  .rb-wiz__steps {
    display: flex;
    gap: 4px;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
    counter-reset: wizstep;
  }
  .rb-wiz__steps li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    counter-increment: wizstep;
  }
  .rb-wiz__steps li::before {
    content: counter(wizstep);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-family: var(--rb-mono);
    font-size: 11px;
    line-height: 1;
  }
  .rb-wiz__steps li.is-done {
    color: var(--rb-brand);
  }
  .rb-wiz__steps li.is-done::before {
    content: '✓';
  }
  .rb-wiz__steps li.is-active {
    background: var(--rb-brand-soft);
    color: var(--rb-text);
  }
  .rb-wiz__steps li.is-active::before {
    border-color: var(--rb-brand);
    color: var(--rb-brand);
  }
  .rb-wiz__example {
    padding: 3px 8px;
    border: 1px dashed var(--rb-line-strong);
    border-radius: 999px;
    color: var(--rb-faint);
    font-family: var(--rb-mono);
    font-size: 13px;
  }

  /* Heading */
  .rb-wiz__head {
    padding: 18px 20px 14px;
  }
  .rb-wiz__scan {
    margin: 0 0 6px;
    color: var(--rb-brand);
    font-family: var(--rb-mono);
    font-size: 13px;
  }
  .rb-wiz__title {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .rb-wiz__summary {
    margin: 6px 0 0;
    color: var(--rb-text-2);
    font-size: 14.5px;
  }

  /* The reveal: the file on the left, clipped at the divider; the picture fills the rest */
  .rb-reveal {
    position: relative;
    height: 520px;
    overflow: hidden;
    border-top: 1px solid var(--rb-line);
    border-bottom: 1px solid var(--rb-line);
    user-select: none;
  }
  .rb-reveal__file {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    background: #101616;
    clip-path: inset(0 calc(100% - var(--reveal)) 0 0);
  }
  .rb-reveal__diagram {
    position: absolute;
    inset: 0 0 0 var(--reveal);
    z-index: 1;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1.3px) 0 0 / 18px 18px,
      #131a1a;
  }
  .rb-reveal__canvas {
    position: relative;
    flex: 1;
    min-height: 0;
  }
  .rb-reveal__canvas :global(.stp-diagram) {
    background: transparent;
  }

  .rb-pane__tab {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--rb-line);
    background: rgba(255, 255, 255, 0.025);
    white-space: nowrap;
  }
  .rb-pane__tab--right {
    justify-content: flex-end;
  }
  .rb-pane__name {
    color: var(--rb-text);
    font-family: var(--rb-mono);
    font-size: 13px;
    font-weight: 500;
  }
  .rb-pane__hint {
    color: var(--rb-faint);
    font-size: 13px;
  }

  /* File pane */
  .rb-file__scroll {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: auto;
    scrollbar-width: thin;
    user-select: text;
  }
  .rb-file__gutter {
    position: sticky;
    left: 0;
    flex: none;
    display: flex;
    flex-direction: column;
    padding: 12px 0;
    background: #101616;
    color: var(--rb-faint);
    font-family: var(--rb-mono);
    font-size: 13px;
    line-height: 1.6;
    text-align: right;
  }
  .rb-file__gutter span {
    padding: 0 12px 0 14px;
  }
  .rb-file__code {
    flex: 1;
    margin: 0;
    padding: 12px 16px 12px 4px;
    font-family: var(--rb-mono);
    font-size: 13px;
    line-height: 1.6;
    tab-size: 2;
  }

  /* Click-to-explore gate over the diagram */
  .rb-reveal__gate {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 0 14px;
    border: 0;
    background: transparent;
    color: var(--rb-text-2);
    font: inherit;
    cursor: pointer;
  }
  .rb-reveal__gate-pill {
    padding: 7px 12px;
    border: 1px solid var(--rb-line-strong);
    border-radius: 999px;
    background: rgba(15, 20, 20, 0.85);
    font-size: 13px;
    font-weight: 500;
    backdrop-filter: blur(6px);
  }
  .rb-reveal__gate-sub {
    color: var(--rb-muted);
    font-weight: 400;
  }
  .rb-reveal__gate:hover .rb-reveal__gate-pill,
  .rb-reveal__gate:focus-visible .rb-reveal__gate-pill {
    border-color: var(--rb-brand);
    color: var(--rb-text);
  }
  .rb-reveal.is-open .rb-reveal__gate {
    display: none;
  }

  /* Divider */
  .rb-reveal__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--reveal);
    z-index: 3;
    width: 2px;
    margin-left: -1px;
    background: rgba(255, 255, 255, 0.22);
    cursor: col-resize;
    touch-action: none;
  }
  .rb-reveal__handle::before {
    content: '';
    position: absolute;
    inset: 0 -12px;
  }
  .rb-reveal__grip {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 44px;
    border: 1px solid var(--rb-line-strong);
    border-radius: 999px;
    background: var(--rb-panel-2);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.45);
    color: var(--rb-text);
    transform: translate(-50%, -50%);
  }
  .rb-reveal__handle:hover,
  .rb-reveal__handle:focus-visible,
  .rb-reveal.is-dragging .rb-reveal__handle {
    background: var(--rb-brand);
  }
  .rb-reveal__handle:hover .rb-reveal__grip,
  .rb-reveal__handle:focus-visible .rb-reveal__grip,
  .rb-reveal.is-dragging .rb-reveal__grip {
    border-color: var(--rb-brand);
    color: var(--rb-brand);
  }
  @media (prefers-reduced-motion: no-preference) {
    .rb-reveal__handle,
    .rb-reveal__grip {
      transition:
        background 150ms ease,
        border-color 150ms ease,
        color 150ms ease;
    }
  }

  /* Below the window */
  .rb-wiz__below {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .rb-wiz__decided {
    padding: 16px 20px 6px;
  }
  .rb-wiz__h4 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 0 0 6px;
    font-size: 14px;
    font-weight: 600;
  }
  .rb-wiz__sub {
    color: var(--rb-muted);
    font-size: 13px;
    font-weight: 400;
  }
  .rb-wiz__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rb-wiz__row {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr) auto;
    gap: 2px 12px;
    align-items: center;
    padding: 9px 0;
    border-top: 1px solid var(--rb-line);
  }
  .rb-wiz__check {
    color: var(--rb-brand);
    font-size: 13px;
    text-align: center;
  }
  .rb-wiz__row-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .rb-wiz__row-title {
    font-size: 13.5px;
    font-weight: 500;
  }
  .rb-wiz__row-note {
    color: var(--rb-muted);
    font-size: 13px;
  }
  .rb-wiz__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    padding: 12px 20px 16px;
    border-top: 1px solid var(--rb-line);
    background: rgba(255, 255, 255, 0.02);
  }
  .rb-wiz__estimate {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 6px;
    margin: 0;
    color: var(--rb-text-2);
    font-size: 13.5px;
  }
  .rb-wiz__estimate strong {
    color: var(--rb-text);
    font-weight: 600;
  }
  .rb-wiz__estimate-note {
    flex-basis: 100%;
    color: var(--rb-muted);
    font-size: 13px;
  }
  .rb-wiz__actions {
    display: flex;
    gap: 8px;
  }

  /* Phones: stack the file over the picture, no divider */
  @media (max-width: 720px) {
    .rb-reveal {
      height: auto;
    }
    .rb-reveal__file,
    .rb-reveal__diagram {
      position: relative;
      inset: auto;
      clip-path: none;
    }
    .rb-reveal__file {
      height: 300px;
    }
    .rb-reveal__diagram {
      height: 340px;
      border-top: 1px solid var(--rb-line);
    }
    .rb-reveal__handle {
      display: none;
    }
    .rb-wiz__steps {
      display: none;
    }
    .rb-wiz__head,
    .rb-wiz__decided,
    .rb-wiz__foot {
      padding-right: 14px;
      padding-left: 14px;
    }
    .rb-wiz__row {
      grid-template-columns: 18px minmax(0, 1fr);
    }
    .rb-wiz__row .rb-btn {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>

<script>
  const reveals = document.querySelectorAll<HTMLElement>('[data-rb-reveal]');

  reveals.forEach((reveal) => {
    const handle = reveal.querySelector<HTMLElement>('[data-rb-handle]');
    const gate = reveal.querySelector<HTMLButtonElement>('[data-rb-gate]');
    const MIN = 24;
    const MAX = 72;
    const DEFAULT = 46;
    let value = DEFAULT;

    const apply = (next: number) => {
      value = Math.min(MAX, Math.max(MIN, next));
      const rounded = Math.round(value);
      reveal.style.setProperty('--reveal', `${value}%`);
      handle?.setAttribute('aria-valuenow', String(rounded));
      handle?.setAttribute('aria-valuetext', `${rounded}% file, ${100 - rounded}% architecture`);
    };

    if (handle) {
      const fromPointer = (clientX: number) => {
        const box = reveal.getBoundingClientRect();
        apply(((clientX - box.left) / box.width) * 100);
      };
      handle.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        handle.setPointerCapture(event.pointerId);
        reveal.classList.add('is-dragging');
        fromPointer(event.clientX);
      });
      handle.addEventListener('pointermove', (event) => {
        if (reveal.classList.contains('is-dragging')) fromPointer(event.clientX);
      });
      const release = (event: PointerEvent) => {
        if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
        reveal.classList.remove('is-dragging');
      };
      handle.addEventListener('pointerup', release);
      handle.addEventListener('pointercancel', release);
      handle.addEventListener('dblclick', () => apply(DEFAULT));
      handle.addEventListener('keydown', (event) => {
        const step = event.shiftKey ? 12 : 4;
        if (event.key === 'ArrowLeft') apply(value - step);
        else if (event.key === 'ArrowRight') apply(value + step);
        else if (event.key === 'Home') apply(MIN);
        else if (event.key === 'End') apply(MAX);
        else return;
        event.preventDefault();
      });
    }

    if (gate) {
      const close = () => reveal.classList.remove('is-open');
      gate.addEventListener('click', () => reveal.classList.add('is-open'));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') close();
      });
      document.addEventListener('pointerdown', (event) => {
        if (!reveal.contains(event.target as Node)) close();
      });
      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) close();
          });
        }).observe(reveal);
      }
    }
  });
</script>
