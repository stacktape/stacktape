---
/**
 * Screen 03: observability as the deploy wires it. Metric tiles, a trace waterfall, uptime by
 * region and a live log tail, all for apiService in production.
 */
import Frame from './Frame.astro';

// Sparkline points: fixed so the build is deterministic; the shape is illustrative.
const spark = (values: number[]) => {
  const max = Math.max(...values);
  const min = Math.min(...values);
  const span = max - min || 1;
  return values.map((v, i) => `${(i / (values.length - 1)) * 100},${30 - ((v - min) / span) * 26}`).join(' ');
};

const tiles = [
  { name: 'Requests', value: '184', unit: 'req/s', points: spark([120, 134, 141, 138, 152, 160, 171, 166, 175, 180, 178, 184]) },
  { name: 'Latency p95', value: '212', unit: 'ms', points: spark([230, 226, 240, 221, 218, 224, 215, 219, 210, 214, 209, 212]) },
  { name: 'Errors 5xx', value: '0.02', unit: '%', points: spark([0.03, 0.02, 0.02, 0.04, 0.02, 0.01, 0.02, 0.03, 0.02, 0.02, 0.01, 0.02]) }
];

const spans = [
  { name: 'GET /orders', kind: 'request', start: 0, length: 212, depth: 0 },
  { name: 'handler', kind: 'code', start: 6, length: 198, depth: 1 },
  { name: 'SELECT … FROM orders', kind: 'db', start: 14, length: 48, depth: 2 },
  { name: 'redis GET', kind: 'cache', start: 64, length: 2, depth: 2 },
  { name: 'POST /events', kind: 'http', start: 120, length: 31, depth: 2 }
];

const regions = [
  { name: 'Ireland', code: 'eu-west-1', up: '99.98%', latency: '41 ms' },
  { name: 'Virginia', code: 'us-east-1', up: '99.98%', latency: '118 ms' },
  { name: 'Singapore', code: 'ap-southeast-1', up: '99.98%', latency: '187 ms' }
];

const logs = [
  { t: '14:21:07.412', src: 'apiService', lvl: 'INFO', msg: 'GET /orders 200 · 212 ms · trace 7f3a91' },
  { t: '14:21:07.630', src: 'worker', lvl: 'INFO', msg: 'processed order_91Q3 · fulfillment=shipped' },
  { t: '14:21:08.014', src: 'apiService', lvl: 'INFO', msg: 'GET /orders/91Q3 200 · 38 ms' },
  { t: '14:21:08.201', src: 'apiService', lvl: 'WARN', msg: 'redis GET miss · orders:91Q3 (cold key)' },
  { t: '14:21:08.220', src: 'apiService', lvl: 'INFO', msg: 'POST /events 202 · 31 ms' }
];
---

<Frame
  crumbs={['acme-project', 'production']}
  tabs={['Logs', 'Metrics', 'Traces', 'Uptime', 'Synthetics', 'Error tracking', 'Incidents']}
  active="Metrics"
  label="Observability for apiService in production: metrics, a trace, uptime by region and live logs"
>
  <div class="cs-watch">
    <div class="cs-watch__bar">
      <span class="cs-watch__resource"><i class="cs-dot cs-dot--ok"></i>apiService <small>web-service</small></span>
      <span class="cs-watch__range">last 1 hour · read from your CloudWatch and X-Ray</span>
    </div>

    <div class="cs-tiles">
      {
        tiles.map((tile) => (
          <div class="cs-tile">
            <p class="cs-tile__name">{tile.name}</p>
            <p class="cs-tile__value">
              {tile.value} <small>{tile.unit}</small>
            </p>
            <svg class="cs-tile__spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
              <polyline points={tile.points} fill="none" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke" />
            </svg>
          </div>
        ))
      }
    </div>

    <div class="cs-watch__grid">
      <div class="cs-panel cs-trace">
        <p class="cs-panel__title">Trace <span class="cs-panel__title-sub">GET /orders · 212 ms</span></p>
        <ol class="cs-trace__rows">
          {
            spans.map((span) => (
              <li class="cs-trace__row" style={`--depth: ${span.depth}`}>
                <span class="cs-trace__name">{span.name}</span>
                <span class="cs-trace__track" aria-hidden="true">
                  <span
                    class:list={['cs-trace__bar', `cs-trace__bar--${span.kind}`]}
                    style={`left: ${(span.start / 212) * 100}%; width: ${Math.max((span.length / 212) * 100, 0.8)}%`}
                  />
                </span>
                <span class="cs-trace__ms">{span.length} ms</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="cs-panel cs-uptime">
        <p class="cs-panel__title">Uptime <span class="cs-panel__title-sub">https://api.acme.com/health</span></p>
        <p class="cs-uptime__total"><strong>99.98%</strong> over 30 days · 3 regions</p>
        <ul class="cs-uptime__rows">
          {
            regions.map((region) => (
              <li class="cs-uptime__row">
                <span class="cs-uptime__region">
                  {region.name} <small>{region.code}</small>
                </span>
                <span class="cs-uptime__ticks" aria-hidden="true">
                  {Array.from({ length: 30 }, (_, day) => (
                    <i class:list={[day === 22 && 'is-dip']} />
                  ))}
                </span>
                <span class="cs-uptime__up">{region.up}</span>
                <span class="cs-uptime__lat">{region.latency}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="cs-panel cs-logs">
      <p class="cs-panel__title">
        Logs <span class="cs-panel__title-sub">live tail</span>
        <span class="cs-chip cs-chip--ok cs-logs__live"><i class="cs-pulse" aria-hidden="true"></i>Live</span>
      </p>
      <ol class="cs-logs__rows">
        {
          logs.map((line, i) => (
            <li class:list={['cs-logs__row', i === logs.length - 1 && 'is-new']}>
              <span class="cs-logs__t">{line.t}</span>
              <span class="cs-logs__src">{line.src}</span>
              <span class:list={['cs-logs__lvl', line.lvl === 'WARN' && 'is-warn']}>{line.lvl}</span>
              <span class="cs-logs__msg">{line.msg}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Frame>
