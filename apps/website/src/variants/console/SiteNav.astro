---
/**
 * The real website chrome above the product-shaped shell. It is deliberately a plain marketing
 * nav — logo, Docs, GitHub, Sign in, Book a demo — so nobody mistakes the shell below for the app.
 */
import Logo from '../../components/Logo.astro';
---

<header class="cs-nav">
  <a class="cs-nav__home" href="/" aria-label="Stacktape home"><Logo height={22} /></a>
  <nav class="cs-nav__links" aria-label="Site">
    <a href="https://docs.stacktape.com">Docs</a>
    <a href="https://github.com/stacktape/stacktape">GitHub</a>
    <a href="https://console.stacktape.com">Sign in</a>
    <a class="cs-nav__demo" href="https://cal.com/stacktape/30min">Book a demo</a>
  </nav>
</header>
