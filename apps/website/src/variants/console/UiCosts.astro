---
/**
 * Screen 06: costs per resource straight from the AWS bill, and the budget.
 */
import Frame from './Frame.astro';

const rows = [
  { name: 'mainDatabase', type: 'relational-database', cost: 61.4 },
  { name: 'apiService', type: 'web-service', cost: 34.2 },
  { name: 'cache', type: 'redis-cluster', cost: 11.9 },
  { name: 'web', type: 'nextjs-web', cost: 3.8 },
  { name: 'worker', type: 'function', cost: 0.7 },
  { name: 'other', type: 'network, logs, WAF', cost: 0.9 }
];
const total = rows.reduce((sum, row) => sum + row.cost, 0);
const max = Math.max(...rows.map((row) => row.cost));
const money = (value: number) => `$${value.toFixed(2)}`;
---

<Frame
  crumbs={['acme-project', 'production']}
  tabs={['Overview', 'Activity', 'Logs', 'Metrics', 'Costs', 'Configuration', 'Danger zone']}
  active="Costs"
  label="Costs for production, per resource, with the budget"
>
  <div class="cs-costs">
    <div class="cs-costs__grid">
      <div class="cs-panel cs-costs__bars">
        <p class="cs-panel__title">
          Month to date <span class="cs-panel__title-sub">1–28 Sep · from your AWS bill</span>
          <span class="cs-costs__total">{money(total)}</span>
        </p>
        <ul class="cs-bars">
          {
            rows.map((row) => (
              <li class="cs-bars__row">
                <span class="cs-bars__name">
                  {row.name} <small>{row.type}</small>
                </span>
                <span class="cs-bars__track" aria-hidden="true">
                  <span class="cs-bars__bar" style={`width: ${(row.cost / max) * 100}%`} />
                </span>
                <span class="cs-bars__cost">{money(row.cost)}</span>
              </li>
            ))
          }
        </ul>
        <p class="cs-panel__foot">
          By environment: production {money(total)} · staging $41.20. AWS bills you directly; Stacktape adds no margin.
        </p>
      </div>

      <div class="cs-panel cs-budget">
        <p class="cs-panel__title">Budget <span class="cs-panel__title-sub">production</span></p>
        <p class="cs-budget__amount"><strong>$150</strong> per month</p>
        <div class="cs-budget__meter" aria-hidden="true">
          <span class="cs-budget__used" style="width: 75%"></span>
          <span class="cs-budget__alert" style="left: 80%"><i></i><b>alert at 80%</b></span>
        </div>
        <p class="cs-budget__now">{money(total)} used · 75%</p>
        <ul class="cs-budget__rules">
          <li><i class="cs-dot cs-dot--ok" aria-hidden="true"></i>Warn at 80% ($120) · Slack and email</li>
          <li><i class="cs-dot cs-dot--ok" aria-hidden="true"></i>Warn at 100% ($150)</li>
        </ul>
        <p class="cs-panel__foot">Set once. Warns before the bill does.</p>
      </div>
    </div>
  </div>
</Frame>
