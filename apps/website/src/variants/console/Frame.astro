---
/**
 * A Console window: a title strip with the breadcrumb and the "example project" tag, a row of the
 * real navigation labels with one active, and the content the screen puts inside it.
 */
type Props = {
  /** Breadcrumb segments, e.g. ['acme-project', 'production']. */
  crumbs: string[];
  /** The tab labels shown under the strip; `active` names the highlighted one. */
  tabs?: string[];
  active?: string;
  /** What the title strip says the window is: "Console" or the wizard's address. */
  app?: string;
  label: string;
  class?: string;
};

const { crumbs, tabs = [], active, app = 'Console', label, class: className } = Astro.props;
---

<figure class:list={['cs-frame', className]} aria-label={label}>
  <div class="cs-frame__strip">
    <span class="cs-frame__app">{app}</span>
    <span class="cs-frame__crumbs">
      {crumbs.map((crumb, i) => <span class:list={['cs-frame__crumb', i === crumbs.length - 1 && 'is-last']}>{crumb}</span>)}
    </span>
    <span class="cs-frame__example">example project</span>
  </div>
  {
    tabs.length > 0 && (
      <div class="cs-frame__tabs" role="presentation">
        {tabs.map((tab) => (
          <span class:list={['cs-frame__tab', tab === active && 'is-active']}>{tab}</span>
        ))}
      </div>
    )
  }
  <div class="cs-frame__body">
    <slot />
  </div>
</figure>
