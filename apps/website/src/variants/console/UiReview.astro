---
/**
 * Screen 01: the wizard's Review band. The file and the diagram of the same app share one window;
 * a draggable divider decides how much of each is visible. `client.ts` owns the divider.
 */
import Frame from './Frame.astro';
import ReviewDiagram from './ReviewDiagram';
import { ACME_CONFIG, ACME_YAML } from './data';
import { highlightYaml } from './yaml-highlight';

const yaml = highlightYaml(ACME_YAML);

const decided = [
  {
    title: 'Keeping the database reachable only from your private network',
    note: 'No public address. Adds one small keyless jump box so local tools and migrations can tunnel in.'
  },
  { title: 'Running two copies of apiService', note: 'One can fail without an interruption. Roughly doubles its cost.' },
  { title: 'Keeping a week of database backups', note: 'Point-in-time restore for the last 7 days.' },
  { title: 'Running prisma migrate deploy after every deploy', note: 'Found in package.json.' }
];
---

<Frame
  app="localhost:5678"
  crumbs={['npx stacktape init', 'acme-project']}
  tabs={['Start ✓', 'Analyze ✓', 'Review', 'Deploy']}
  active="Review"
  label="The wizard's Review screen: the configuration file and the architecture diagram of the same app"
  class="cs-frame--wizard"
>
  <div class="cs-review">
    <div class="cs-review__head">
      <div>
        <p class="cs-review__scan">Opened 41 files in 38s, all on this machine.</p>
        <p class="cs-review__title">Here's your app on AWS</p>
        <p class="cs-review__summary">A Next.js app with a background worker, using a Postgres database and a Redis cache.</p>
      </div>
      <div class="cs-review__estimate">
        <span class="cs-review__estimate-num">14</span> AWS resources
        <span class="cs-review__estimate-sep">·</span>
        <span class="cs-review__estimate-num">~$112</span>/month
      </div>
    </div>

    <div class="cs-reveal" data-reveal style="--reveal: 46%">
      <div class="cs-reveal__picture">
        <span class="cs-reveal__label cs-reveal__label--picture">Architecture</span>
        <ReviewDiagram client:only="react" config={ACME_CONFIG} />
      </div>
      <div class="cs-reveal__file">
        <span class="cs-reveal__label cs-reveal__label--file">stacktape.yml</span>
        <div class="cs-code">
          <div class="cs-code__gutter" aria-hidden="true">
            {Array.from({ length: yaml.lineCount }, (_, n) => <span>{n + 1}</span>)}
          </div>
          <pre class="cs-code__pre"><code set:html={yaml.html} /></pre>
        </div>
      </div>
      <div
        class="cs-reveal__handle"
        data-reveal-handle
        role="slider"
        tabindex="0"
        aria-label="How much of the file to show; the rest is the architecture diagram"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="46"
      >
        <span class="cs-reveal__grip" aria-hidden="true"><i></i><i></i></span>
      </div>
    </div>
    <p class="cs-reveal__hint">
      One app, two views: the file Stacktape wrote and the picture of what it builds.
      <span class="cs-reveal__drag">Drag the divider to compare them.</span>
    </p>

    <div class="cs-decided">
      <p class="cs-decided__title">Decided for you</p>
      <ul class="cs-decided__list">
        {
          decided.map((row) => (
            <li class="cs-decided__row">
              <i class="cs-dot cs-dot--ok" aria-hidden="true" />
              <div>
                <p class="cs-decided__what">{row.title}</p>
                <p class="cs-decided__note">{row.note}</p>
              </div>
              <span class="cs-btn cs-btn--ghost">Change</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="cs-review__foot">
      <p>Nothing is created or billed until you press Deploy. The next step names the target AWS account first.</p>
      <span class="cs-btn cs-btn--primary">Deploy</span>
    </div>
  </div>
</Frame>
