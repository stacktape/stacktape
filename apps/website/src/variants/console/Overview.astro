---
/**
 * The hero, drawn as the shell's Overview screen: the message on the left, the only CTA, and on
 * the right a project card so the first screen already shows the shape of the product.
 */
import CommandBox from './CommandBox.astro';
import { HEADLINE, SUBHEADLINE, TRUST_LINE } from './data';
---

<section class="cs-screen cs-overview" id="overview" data-screen="overview" aria-labelledby="overview-title">
  <div class="cs-overview__copy">
    <p class="cs-overview__eyebrow">Like a PaaS, but in your own AWS account</p>
    <h1 class="cs-overview__title" id="overview-title">{HEADLINE}</h1>
    <p class="cs-overview__sub">{SUBHEADLINE}</p>
    <CommandBox id="hero-cmd" class="cs-overview__cmd" />
    <p class="cs-overview__trust">{TRUST_LINE}</p>
  </div>

  <figure class="cs-card" aria-label="An example project as the Console shows it">
    <div class="cs-card__head">
      <div>
        <p class="cs-card__name">acme-project</p>
        <p class="cs-card__meta">acme/acme-project · eu-west-1</p>
      </div>
      <span class="cs-frame__example">example project</span>
    </div>
    <dl class="cs-card__rows">
      <div class="cs-card__row">
        <dt>Environments</dt>
        <dd>
          <span class="cs-env"><i class="cs-dot cs-dot--ok"></i>production <small>v42</small></span>
          <span class="cs-env"><i class="cs-dot cs-dot--ok"></i>staging <small>v42</small></span>
        </dd>
      </div>
      <div class="cs-card__row">
        <dt>Last deploy</dt>
        <dd>#42 · push to <code>main</code> · 3m 08s · zero downtime</dd>
      </div>
      <div class="cs-card__row">
        <dt>Uptime, 30 days</dt>
        <dd><strong>99.98%</strong> · checked from 3 regions</dd>
      </div>
      <div class="cs-card__row">
        <dt>Cost, month to date</dt>
        <dd>
          <strong>$112.90</strong> of $150 budget
          <span class="cs-meter" aria-hidden="true"><span style="width: 75%"></span></span>
        </dd>
      </div>
      <div class="cs-card__row">
        <dt>Incidents</dt>
        <dd><strong>0 open</strong> · last one resolved in 11 min</dd>
      </div>
      <div class="cs-card__row">
        <dt>Security</dt>
        <dd>27 of 30 checks passing · 3 guardrails on</dd>
      </div>
    </dl>
    <figcaption class="cs-card__caption">
      This is how the Console shows a project. The six screens below are the jobs behind each line.
    </figcaption>
  </figure>

  <a class="cs-overview__next" href="#designs">
    <span>Six jobs, one screen each. Scroll, or use the sidebar.</span>
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
      <path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</section>
