---
import CommandBox from './CommandBox.astro';
import { TRUST_LINE, VOICES } from './data';
---

<section class="cs-close" aria-labelledby="close-title">
  <h2 class="cs-close__title" id="close-title">That is the whole DevOps job.</h2>
  <p class="cs-close__sub">One command to start. Your own AWS account from the first deploy.</p>
  <CommandBox id="close-cmd" class="cs-close__cmd" />
  <p class="cs-close__trust">{TRUST_LINE}</p>
  <a class="cs-close__signin" href="https://console.stacktape.com">Sign in to the Console</a>
</section>

<section class="cs-voices" aria-label="What teams say">
  {
    VOICES.map((voice) => (
      <figure class="cs-voice">
        <blockquote>{voice.quote}</blockquote>
        <figcaption>
          <span class="cs-voice__name">{voice.name}</span>
          <span class="cs-voice__role">{voice.role}</span>
          <span class="cs-voice__fact">{voice.fact}</span>
        </figcaption>
      </figure>
    ))
  }
</section>
