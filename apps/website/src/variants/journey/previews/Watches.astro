---
/** 03 — three metric tiles, the trace waterfall for one request, and uptime by region. */
import Callout from '../Callout.astro';
import { METRICS, PROJECT, TRACE, UPTIME } from '../data';
import Window from '../Window.astro';
import { StatusBadge } from './ui';

const sparkline = (points: readonly number[]) => {
  const max = Math.max(...points);
  const min = Math.min(...points);
  const range = Math.max(1, max - min);
  return points
    .map((point, index) => {
      const x = (index / (points.length - 1)) * 100;
      const y = 30 - ((point - min) / range) * 24;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
};

const pct = (value: number) => `${((value / TRACE.total) * 100).toFixed(2)}%`;
---

<Window title={`Console · ${PROJECT.name} · <b>production</b>`}>
  <div class="jn-screen__head">
    <div class="jn-screen__heading">
      <h4 class="jn-screen__title">apiService</h4>
      <p class="jn-screen__sub">Metrics, traces and uptime · last hour</p>
    </div>
  </div>
  <Callout side="above" text="wired up by the deploy itself; nothing to install" />

  <div class="jn-tiles">
    {
      METRICS.map((metric) => (
        <div class="jn-tile">
          <p class="jn-tile__label">{metric.label}</p>
          <p class="jn-tile__value">
            {metric.value}
            <span class="jn-tile__unit">{metric.unit}</span>
          </p>
          <svg class="jn-spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
            <polyline points={sparkline(metric.points)} fill="none" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke" />
          </svg>
        </div>
      ))
    }
  </div>

  <div class="jn-panel">
    <div class="jn-panel__head">
      <h5 class="jn-panel__title">Trace</h5>
      <p class="jn-panel__meta"><span class="jn-mono">{TRACE.name}</span> · {TRACE.total} ms</p>
    </div>
    <ol class="jn-trace">
      {
        TRACE.spans.map((span) => (
          <li class={`jn-trace__row jn-trace__row--${span.kind}`}>
            <span class="jn-trace__name">{span.name}</span>
            <span class="jn-trace__lane">
              <span class="jn-trace__bar" style={`left: ${pct(span.start)}; width: ${pct(span.duration)}`} />
            </span>
            <span class="jn-trace__ms">{span.duration} ms</span>
          </li>
        ))
      }
    </ol>
    <Callout side="below" text="one request, step by step: the handler, the database, the cache, an outbound call" />
  </div>

  <div class="jn-panel" data-jn-phone="hide">
    <div class="jn-panel__head">
      <h5 class="jn-panel__title">Uptime</h5>
      <p class="jn-panel__meta"><span class="jn-mono">{UPTIME.url}</span> · {UPTIME.thirtyDay} over 30 days</p>
    </div>
    <ul class="jn-uptime">
      {
        UPTIME.regions.map((check) => (
          <li class="jn-uptime__row">
            <StatusBadge tone="success" dot>
              Up
            </StatusBadge>
            <span class="jn-uptime__region">{check.region}</span>
            <span class="jn-uptime__code jn-mono">{check.code}</span>
            <span class="jn-uptime__ms jn-mono">{check.latency}</span>
          </li>
        ))
      }
    </ul>
    <Callout side="below" text="checked from three regions, on a schedule you did not have to set" />
  </div>
</Window>
