---
/** 02 — the project screen: two environments, the deploy in progress, and a pull-request preview. */
import Callout from '../Callout.astro';
import { DEPLOY, ENVIRONMENTS, PROJECT, PULL_REQUEST } from '../data';
import Window from '../Window.astro';
import { StatusBadge } from './ui';
---

<Window title={`Console · <b>${PROJECT.name}</b>`}>
  <div class="jn-screen__head">
    <div class="jn-screen__heading">
      <h4 class="jn-screen__title">{PROJECT.name}</h4>
      <p class="jn-screen__sub">
        <span class="jn-mono">github.com/{PROJECT.repo}</span> · {PROJECT.region} · {PROJECT.summary}
      </p>
    </div>
  </div>

  <div class="jn-envs">
    {
      ENVIRONMENTS.map((env) => (
        <div class:list={['jn-env', env.status === 'deploying' && 'jn-env--deploying']} data-jn-phone={env.status === 'deploying' ? undefined : 'hide'}>
          <div class="jn-env__row">
            <span class="jn-env__name">{env.name}</span>
            {env.status === 'live' ? (
              <StatusBadge tone="success" dot>
                Live
              </StatusBadge>
            ) : (
              <StatusBadge tone="brand" dot>
                Deploying…
              </StatusBadge>
            )}
            <span class="jn-env__meta">
              {env.release} · {env.when}
            </span>
          </div>
          <p class="jn-env__url">{env.url}</p>
          {env.status === 'deploying' && (
            <div class="jn-progress" role="progressbar" aria-label="Deploy progress" aria-valuenow="21" aria-valuemin="0" aria-valuemax="33">
              <span class="jn-progress__bar" style="width: 64%" />
            </div>
          )}
        </div>
      ))
    }
  </div>
  <Callout side="below" text="a push to main deploys production, zero-downtime; a rollback is one click" />

  <div class="jn-panel jn-deploy" data-jn-phone="hide">
    <div class="jn-panel__head">
      <h5 class="jn-panel__title">Deploy {DEPLOY.number} · production</h5>
      <p class="jn-panel__meta">
        {DEPLOY.trigger} · <span class="jn-mono">{DEPLOY.commit}</span> {DEPLOY.message}
      </p>
    </div>
    <ol class="jn-phases">
      {
        DEPLOY.phases.map((phase) => (
          <li class={`jn-phase-row jn-phase-row--${phase.state}`}>
            <span class="jn-phase-row__mark" aria-hidden="true">
              {phase.state === 'done' && (
                <svg viewBox="0 0 12 12" width="10" height="10" fill="none">
                  <path d="m2.5 6.3 2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </span>
            <span class="jn-phase-row__name">{phase.name}</span>
            {'chips' in phase ? (
              <span class="jn-phase-row__chips">
                {phase.chips.map((chip) => (
                  <span class="jn-chip">{chip}</span>
                ))}
              </span>
            ) : (
              <span class="jn-phase-row__note">{phase.note}</span>
            )}
          </li>
        ))
      }
    </ol>
    <p class="jn-panel__foot">Builds run on a build runner inside your AWS account. It keeps caches between runs and stops after 15 minutes idle.</p>
  </div>

  <div class="jn-pr">
    <div class="jn-pr__row">
      <span class="jn-pr__num jn-mono">PR {PULL_REQUEST.number}</span>
      <span class="jn-pr__title">{PULL_REQUEST.title}</span>
      <span class="jn-pr__arrow" aria-hidden="true">→</span>
      <StatusBadge tone="success" dot>Preview</StatusBadge>
      <span class="jn-pr__url jn-mono">{PULL_REQUEST.url.replace('https://', '')}</span>
    </div>
    <Callout side="below" text="every pull request gets its own copy of the app, on its own URL" />
  </div>
</Window>
