---
/** 06 — per-resource cost bars from the AWS bill, and the budget. */
import Callout from '../Callout.astro';
import { BUDGET, COST_TOTAL, COSTS, PROJECT } from '../data';
import Window from '../Window.astro';

const largest = Math.max(...COSTS.map((cost) => cost.amount));
const money = (amount: number) => `$${amount.toFixed(2)}`;
const used = (COST_TOTAL / BUDGET.limit) * 100;
---

<Window title={`Console · ${PROJECT.name} · production · <b>costs</b>`}>
  <div class="jn-screen__head">
    <div class="jn-screen__heading">
      <h4 class="jn-screen__title">Cost by resource</h4>
      <p class="jn-screen__sub">production · month to date</p>
    </div>
    <p class="jn-cost__total">{money(COST_TOTAL)}</p>
  </div>

  <ul class="jn-bars" aria-label="Cost per resource">
    {
      COSTS.map((cost) => (
        <li class="jn-bar">
          <span class="jn-bar__name jn-mono">{cost.name}</span>
          <span class="jn-bar__lane">
            <span class="jn-bar__fill" style={`width: ${((cost.amount / largest) * 100).toFixed(1)}%`} />
          </span>
          <span class="jn-bar__amount jn-mono">{money(cost.amount)}</span>
        </li>
      ))
    }
  </ul>
  <Callout side="below" text="straight from your AWS bill; AWS bills you directly" />

  <div class="jn-panel jn-budget">
    <div class="jn-panel__head">
      <h5 class="jn-panel__title">Budget</h5>
      <p class="jn-panel__meta"><b class="jn-budget__limit">{money(BUDGET.limit)}</b> / month</p>
    </div>
    <div class="jn-budget__lane" role="img" aria-label={`${money(COST_TOTAL)} of ${money(BUDGET.limit)} used; alert at ${BUDGET.alertAt}%`}>
      <span class="jn-budget__fill" style={`width: ${used.toFixed(1)}%`}></span>
      <span class="jn-budget__mark" style={`left: ${BUDGET.alertAt}%`}></span>
    </div>
    <p class="jn-budget__legend">
      <span><b>{used.toFixed(0)}%</b> used</span>
      <span>alert at <b>{BUDGET.alertAt}%</b> ({money((BUDGET.limit * BUDGET.alertAt) / 100)})</span>
    </p>
    <Callout side="below" text="warns you in Slack, email or a webhook before a surprise" />
  </div>
</Window>
