---
/** 04 — the incident page, from the first signal to "recovered", with the opt-in switch off. */
import Callout from '../Callout.astro';
import { INCIDENT, PROJECT } from '../data';
import Window from '../Window.astro';
import { OptInSwitch, PreviewButton, StatusBadge } from './ui';

const { release } = INCIDENT;
---

<Window title={`Console · ${PROJECT.name} · incidents · <b>${INCIDENT.id}</b>`}>
  <div class="jn-inc__head">
    <p class="jn-inc__badges">
      <StatusBadge tone="success" dot>Resolved</StatusBadge>
      <StatusBadge tone="danger">Error</StatusBadge>
      <StatusBadge tone="neutral" caps={false}>production</StatusBadge>
      <span class="jn-inc__id jn-mono">{INCIDENT.id}</span>
    </p>
    <h4 class="jn-screen__title jn-inc__title">{INCIDENT.title}</h4>
  </div>

  <div class="jn-inc__release-wrap">
    <p class="jn-inc__release">
      <b>{release.opened}</b>
      <span class="jn-inc__sep" aria-hidden="true">·</span>
      <span class="jn-mono">{release.version}</span>
      <span class="jn-inc__sep" aria-hidden="true">·</span>
      <span class="jn-mono">{release.commit}</span> — {release.message}
      <span class="jn-inc__sep" aria-hidden="true">·</span>
      previous release <span class="jn-mono">{release.previous}</span>
      <span class="jn-inc__sep" aria-hidden="true">·</span>
      <span class="jn-inc__link">{release.changed}</span>
    </p>
    <Callout side="below" text="opened 4 minutes after deploy v41: the release is already in the picture" />
  </div>

  <ul class="jn-signals" aria-label="Signals" data-jn-phone="hide">
    {
      INCIDENT.signals.map((signal) => (
        <li class="jn-signal">
          <span class="jn-signal__kind">{signal.kind}</span>
          <span class="jn-signal__text">{signal.text}</span>
          <span class="jn-signal__meta">{signal.meta}</span>
        </li>
      ))
    }
  </ul>

  <div class="jn-inc__handoff">
    <PreviewButton variant="secondary" icon="copy">Copy details for agent</PreviewButton>
    <Callout side="right" text="one click gives your agent everything it needs" />
  </div>

  <ol class="jn-timeline" aria-label="Timeline">
    {
      INCIDENT.timeline.map((event) => (
        <li class={`jn-tl jn-tl--${event.tone}`}>
          <span class="jn-tl__time jn-mono">{event.time}</span>
          <span class="jn-tl__mark" aria-hidden="true" />
          <span class="jn-tl__text">{event.text}</span>
        </li>
      ))
    }
  </ol>
  <Callout side="below" class="jn-inc__recovered" text="recovered, verified by the same checks that opened it" />

  <div class="jn-optin">
    <OptInSwitch label={INCIDENT.optIn} />
    <span class="jn-optin__text">
      <span class="jn-optin__what">{INCIDENT.optIn}</span>
      <span class="jn-optin__state">Off</span>
    </span>
  </div>
</Window>
