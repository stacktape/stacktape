---
import { CommandBox } from './CommandBox';
import { CLOSING, LINKS, TRUST_LINE } from './data';
---

<section class="jn-section jn-closing" aria-labelledby="jn-closing-title">
  <div class="jn-container">
    <div class="jn-closing__plate">
      <p class="jn-label jn-label--brand">Six stops. One command.</p>
      <h2 class="jn-closing__title" id="jn-closing-title">{CLOSING}</h2>
      <CommandBox client:load label="Get started" />
      <p class="jn-trust">{TRUST_LINE}</p>
      <p class="jn-closing__signin">Already set up? <a href={LINKS.console}>Sign in to the Console</a></p>
    </div>
  </div>
</section>
