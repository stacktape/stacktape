---
import { ButtonLink } from '@stacktape/ui-react/button';
import Logo from '../../components/Logo.astro';
import { LINKS } from './data';
---

<header class="jn-nav">
  <div class="jn-container jn-nav__inner">
    <a class="jn-nav__logo" href="/" aria-label="Stacktape home"><Logo height={24} /></a>
    <nav aria-label="Primary">
      <ul class="jn-nav__links">
        <li><a class="jn-nav__link jn-nav__link--phone-optional" href={LINKS.docs}>Docs</a></li>
        <li><a class="jn-nav__link jn-nav__link--optional" href={LINKS.github}>GitHub</a></li>
        <li><a class="jn-nav__link" href={LINKS.console}>Sign in</a></li>
        <li>
          <ButtonLink className="jn-nav__demo" href={LINKS.demo} variant="secondary">Book a demo</ButtonLink>
        </li>
      </ul>
    </nav>
  </div>
</header>
