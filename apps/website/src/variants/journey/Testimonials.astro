---
import { TESTIMONIALS } from './data';
---

<section class="jn-section jn-voices" aria-labelledby="jn-voices-title">
  <div class="jn-container">
    <div class="jn-voices__head">
      <p class="jn-label jn-label--brand">Pinned to the table</p>
      <h2 class="jn-voices__title" id="jn-voices-title">From teams that run on it</h2>
    </div>
    <ul class="jn-cards">
      {
        TESTIMONIALS.map((item) => (
          <li class="jn-card">
            <span class="jn-card__pin" aria-hidden="true" />
            <blockquote class="jn-card__quote">
              <p>“{item.quote}”</p>
            </blockquote>
            <div class="jn-card__who">
              <span class="jn-card__name">{item.name}</span>
              <span class="jn-card__role">{item.role}</span>
              <span class="jn-card__fact">{item.fact}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
