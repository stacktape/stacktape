---
import { CommandBox } from './CommandBox';
import { EYEBROW, HEADLINE, SUBHEADLINE, TRUST_LINE } from './data';
---

<section class="jn-hero" aria-labelledby="jn-hero-title">
  <!-- The drafting table: a CSS 3D plane under the hero. Fog over its far edge keeps the headline on calm ground;
       its near edge dissolves into the flat table the journey is drawn on. -->
  <div class="jn-table" aria-hidden="true">
    <div class="jn-table__plane"></div>
  </div>

  <div class="jn-container jn-hero__inner">
    <p class="jn-eyebrow">{EYEBROW}</p>
    <h1 class="jn-hero__title" id="jn-hero-title">{HEADLINE}</h1>
    <p class="jn-hero__sub">{SUBHEADLINE}</p>
    <div class="jn-hero__cta">
      <CommandBox client:load label="Get started" />
    </div>
    <p class="jn-trust">{TRUST_LINE}</p>
  </div>
</section>
