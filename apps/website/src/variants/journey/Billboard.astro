---
/** A preview panel standing on an isometric base, casting a shadow onto the table. Rises into view on enter. */
type Props = { class?: string };

const { class: className } = Astro.props;
---

<div class:list={['jn-billboard', className]} data-jn-rise>
  <div class="jn-billboard__panel">
    <slot />
  </div>
  <div class="jn-billboard__base" aria-hidden="true">
    <svg viewBox="0 0 200 100" preserveAspectRatio="none"><polygon points="100,0 200,50 100,100 0,50"></polygon></svg>
  </div>
  <div class="jn-billboard__shadow" aria-hidden="true"></div>
</div>
