---
import { LINKS } from './data';
import TrCommandBox from './TrCommandBox.astro';
---

<section class="tr-closing" id="closing" aria-labelledby="closing-title">
  <div class="tr-wrap tr-closing__in">
    <div class="tr-closing__track" aria-hidden="true">
      <span class="tr-closing__marker"></span>
      <span class="tr-closing__line"></span>
    </div>
    <div class="tr-closing__card">
      <header class="tr-plate">
        <span class="tr-plate__no">00</span>
        <h2 class="tr-plate__name tr-plate__name--big" id="closing-title">Start here</h2>
        <p class="tr-plate__meta"><span class="tr-plate__line">Your line · Day 0</span></p>
      </header>
      <p class="tr-closing__lead">
        Run one command in your repository. Ten minutes later your app is on AWS, in your own account. The
        configuration is written for you, and every decision is on the table.
      </p>
      <TrCommandBox id="closing-cmd" />
      <div class="tr-closing__ctas">
        <a class="tr-btn tr-btn--ghost" href={LINKS.signUp}>Sign up</a>
        <a class="tr-btn tr-btn--ghost" href={LINKS.demo}>Book a demo</a>
      </div>
    </div>
  </div>
</section>
