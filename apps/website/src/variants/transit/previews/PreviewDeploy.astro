---
import TrWizard from '../TrWizard.astro';
---

<TrWizard band="Deploy">
  <p class="tr-deploy__target">
    Deploying to AWS account <span class="tr-mono">4128…9903</span> (<span class="tr-mono">acme-dev</span>) as <span
      class="tr-mono">matus</span>. 14 resources will be created. <strong>web</strong> and <strong>apiService</strong> get
    a public URL. Nothing else is reachable from the internet.
  </p>
  <p class="tr-deploy__cmd tr-mono">
    <span class="tr-deploy__prompt" aria-hidden="true">$</span> stacktape deploy --stage production --region eu-west-1
  </p>
  <ol class="tr-phases" aria-label="Deploy progress">
    <li class="tr-phase is-done">
      <span class="tr-phase__name">Initialize</span>
      <span class="tr-phase__detail">config compiled to CloudFormation</span>
      <span class="tr-phase__state">✓</span>
    </li>
    <li class="tr-phase is-done">
      <span class="tr-phase__name">Package</span>
      <span class="tr-phase__detail">
        <span class="tr-chip">web 41s</span>
        <span class="tr-chip">apiService 58s</span>
        <span class="tr-chip">worker 6s</span>
      </span>
      <span class="tr-phase__state">✓</span>
    </li>
    <li class="tr-phase is-active">
      <span class="tr-phase__name">Deploy</span>
      <span class="tr-phase__detail">
        <span class="tr-bar" aria-hidden="true"><span class="tr-bar__fill" style="--w: 91%"></span></span>
        30 of 33 resources
      </span>
      <span class="tr-phase__state tr-mono">30/33</span>
    </li>
    <li class="tr-phase">
      <span class="tr-phase__name">Outputs</span>
      <span class="tr-phase__detail">URLs and connection details</span>
      <span class="tr-phase__state">·</span>
    </li>
  </ol>
  <div class="tr-live">
    <div class="tr-live__head">
      <span class="tr-dot tr-dot--ok" aria-hidden="true"></span>
      <span class="tr-live__title">It's live</span>
      <span class="tr-live__meta">a minute later</span>
    </div>
    <ul class="tr-live__urls">
      <li><span class="tr-mono">https://acme.com</span><span class="tr-live__what">web</span></li>
      <li><span class="tr-mono">https://api.acme.com</span><span class="tr-live__what">apiService</span></li>
    </ul>
    <p class="tr-live__next">
      Where to go from here: open the project in the Console, connect the GitHub repository for push-to-deploy.
    </p>
  </div>
</TrWizard>
