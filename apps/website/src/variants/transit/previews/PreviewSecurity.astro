---
import TrFrame from '../TrFrame.astro';

const FAILING = [
  {
    where: 'mainDatabase · staging',
    what: 'backups retained 1 day',
    rule: 'Require recoverable data stores',
    action: 'Fix in config'
  },
  {
    where: 'apiService image',
    what: '2 critical CVEs in openssl 3.0.13',
    rule: 'Vulnerabilities',
    action: 'Fix PR opened'
  },
  {
    where: 'apiService · config',
    what: 'plaintext STRIPE_KEY',
    rule: 'Secrets',
    action: 'Convert to $Secret'
  }
];
const GUARDRAILS = ['Keep SQL private', 'Require WAF on load balancers', 'Require recoverable data stores'];
---

<TrFrame crumbs={['acme-project', 'Security']} active="Guardrails" group="Configuration">
  <div class="tr-tabs" aria-hidden="true">
    <span class="is-active">Overview</span><span>Vulnerabilities</span><span>Posture</span>
  </div>
  <div class="tr-posture">
    <div class="tr-posture__score">
      <span class="tr-posture__big">27<small>/30</small></span>
      <span class="tr-posture__label">posture checks passing</span>
      <span class="tr-bar tr-bar--thin" aria-hidden="true"><span class="tr-bar__fill" style="--w: 90%"></span></span>
    </div>
    <div class="tr-posture__scan">
      <span class="tr-posture__label">Images scanned in the pipeline</span>
      <span>SBOM per deploy · re-graded nightly</span>
      <span class="tr-ui__subtle">last: apiService, v42, 3 min ago</span>
    </div>
  </div>
  <ul class="tr-findings" aria-label="Failing checks">
    {
      FAILING.map((finding) => (
        <li class="tr-finding">
          <span class="tr-finding__mark" aria-hidden="true" />
          <span class="tr-finding__text">
            <span class="tr-finding__what">
              <span class="tr-mono">{finding.where}</span> · {finding.what}
            </span>
            <span class="tr-finding__rule">{finding.rule}</span>
          </span>
          <span class="tr-ui-btn tr-ui-btn--small">{finding.action}</span>
        </li>
      ))
    }
  </ul>
  <div class="tr-guardrails">
    <span class="tr-guardrails__label">Guardrails on · block the deploy before any change</span>
    <span class="tr-guardrails__chips">
      {
        GUARDRAILS.map((rule) => (
          <span class="tr-chip tr-chip--rule">
            <span class="tr-tick tr-tick--small" aria-hidden="true" />
            {rule}
          </span>
        ))
      }
    </span>
  </div>
</TrFrame>
