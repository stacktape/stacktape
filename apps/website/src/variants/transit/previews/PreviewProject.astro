---
import { RESOURCES } from '../data';
import TrFrame from '../TrFrame.astro';

const TABS = ['Overview', 'Activity', 'Logs', 'Metrics', 'Costs', 'Configuration', 'Danger zone'];
---

<TrFrame crumbs={['Projects', 'acme-project']} active="Projects" group="Organization">
  <div class="tr-ui__title-row">
    <h4 class="tr-ui__title">acme-project</h4>
    <span class="tr-ui__subtle tr-mono">acme/acme-project</span>
  </div>
  <div class="tr-stages">
    <div class="tr-stage is-ok">
      <span class="tr-stage__name">production</span>
      <span class="tr-stage__region tr-mono">eu-west-1</span>
      <span class="tr-stage__status"><span class="tr-dot tr-dot--ok" aria-hidden="true"></span>Updated 2 hours ago</span>
    </div>
    <div class="tr-stage is-deploying">
      <span class="tr-stage__name">staging</span>
      <span class="tr-stage__region tr-mono">eu-west-1</span>
      <span class="tr-stage__status"><span class="tr-spinner tr-spinner--small" aria-hidden="true"></span>Deploying…</span>
    </div>
  </div>
  <div class="tr-tabs" aria-hidden="true">
    {TABS.map((tab) => <span class={tab === 'Overview' ? 'is-active' : undefined}>{tab}</span>)}
  </div>
  <table class="tr-table">
    <thead>
      <tr><th>Resource</th><th>Type</th></tr>
    </thead>
    <tbody>
      {
        RESOURCES.map((resource) => (
          <tr>
            <td class="tr-mono">{resource.name}</td>
            <td>
              <span class="tr-table__stack">
                <span>{resource.label}</span>
                <span class="tr-ui__subtle">{resource.note}</span>
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</TrFrame>
