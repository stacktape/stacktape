---
import TrFrame from '../TrFrame.astro';
---

<TrFrame crumbs={['acme-project', 'Activity']} active="Activity" group="Organization">
  <ol class="tr-runs" aria-label="Recent deployments">
    <li class="tr-run">
      <span class="tr-run__trigger">
        <span class="tr-run__kind">push</span>
        <span class="tr-mono">main</span>
      </span>
      <span class="tr-run__arrow" aria-hidden="true">→</span>
      <span class="tr-run__target">
        <span class="tr-run__name">production · deploy #42</span>
        <span class="tr-run__meta tr-mono">3m 08s</span>
      </span>
      <span class="tr-status tr-status--ok">ok</span>
    </li>
    <li class="tr-run">
      <span class="tr-run__trigger">
        <span class="tr-run__kind">PR #128</span>
        <span class="tr-run__pr">checkout: retry payment webhook</span>
      </span>
      <span class="tr-run__arrow" aria-hidden="true">→</span>
      <span class="tr-run__target">
        <span class="tr-run__name">preview stage <span class="tr-mono">pr-128</span></span>
        <span class="tr-run__meta tr-mono">https://pr-128.acme-preview.com</span>
      </span>
      <span class="tr-status tr-status--live">live</span>
    </li>
  </ol>
  <div class="tr-runner">
    <span class="tr-runner__label">Build runner</span>
    <span class="tr-runner__facts">
      <span class="tr-mono">c7a.2xlarge</span>
      <span>8 vCPU / 16 GB</span>
      <span>eu-west-1, in your account</span>
      <span class="tr-runner__warm"><span class="tr-dot tr-dot--ok" aria-hidden="true"></span>warm · caches kept</span>
      <span>stops after 15 min idle</span>
    </span>
  </div>
  <p class="tr-ui__foot">Self-hosted GitHub Actions jobs can run on the same runner.</p>
</TrFrame>
