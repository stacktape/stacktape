---
import TrFrame from '../TrFrame.astro';

// Span offsets and widths are percentages of the 212 ms root span.
const SPANS = [
  { name: 'GET /orders', ms: 212, start: 0, kind: 'root' },
  { name: 'apiService handler', ms: 198, start: 6, kind: 'compute' },
  { name: 'SELECT … FROM orders', ms: 48, start: 12, kind: 'db' },
  { name: 'redis GET', ms: 2, start: 62, kind: 'cache' },
  { name: 'POST /events', ms: 31, start: 66, kind: 'http' }
];
const REGIONS = ['Ireland', 'Virginia', 'Singapore'];
---

<TrFrame crumbs={['acme-project', 'production', 'Traces']} active="Traces" group="Observability">
  <div class="tr-ui__title-row">
    <h4 class="tr-ui__title">apiService</h4>
    <span class="tr-ui__subtle tr-mono">production · Web Service</span>
  </div>
  <div class="tr-obs__grid">
    <div class="tr-metrics">
      <div class="tr-metric">
        <span class="tr-metric__label">requests</span>
        <span class="tr-metric__value">184<small>/s</small></span>
      </div>
      <div class="tr-metric">
        <span class="tr-metric__label">p95 latency</span>
        <span class="tr-metric__value">212<small>ms</small></span>
      </div>
      <div class="tr-metric">
        <span class="tr-metric__label">5xx rate</span>
        <span class="tr-metric__value">0.02<small>%</small></span>
      </div>
    </div>
    <div class="tr-trace">
      <div class="tr-trace__head">
        <span class="tr-mono">GET /orders</span>
        <span class="tr-ui__subtle">212 ms · 5 spans · OpenTelemetry</span>
      </div>
      <ol class="tr-trace__rows">
        {
          SPANS.map((span) => (
            <li class={`tr-span tr-span--${span.kind}`}>
              <span class="tr-span__name">{span.name}</span>
              <span class="tr-span__lane" aria-hidden="true">
                <span class="tr-span__bar" style={`--l: ${span.start}%; --w: ${Math.max(1.5, (span.ms / 212) * 100)}%`} />
              </span>
              <span class="tr-span__ms tr-mono">{span.ms} ms</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
  <div class="tr-uptime">
    <span class="tr-uptime__label">Uptime · <span class="tr-mono">https://api.acme.com/health</span></span>
    <span class="tr-uptime__regions">
      {
        REGIONS.map((region) => (
          <span class="tr-uptime__region">
            <span class="tr-dot tr-dot--ok" aria-hidden="true" />
            {region}
          </span>
        ))
      }
    </span>
    <span class="tr-uptime__value tr-mono">99.98% · 30 days</span>
  </div>
</TrFrame>
