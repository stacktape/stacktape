---
import { BUDGET, COST_TOTAL, COSTS } from '../data';
import TrFrame from '../TrFrame.astro';

const max = Math.max(...COSTS.map((c) => c.amount));
const money = (n: number) => `$${n.toFixed(2)}`;
const spent = (COST_TOTAL / BUDGET.limit) * 100;
---

<TrFrame crumbs={['acme-project', 'production', 'Costs']} active="Costs" group="Organization">
  <div class="tr-ui__title-row">
    <h4 class="tr-ui__title">Month to date</h4>
    <span class="tr-cost__total tr-mono">{money(COST_TOTAL)}</span>
  </div>
  <div class="tr-cost__grid">
    <ol class="tr-costs" aria-label="Cost per resource">
      {
        COSTS.map((cost) => (
          <li class="tr-cost">
            <span class="tr-cost__name tr-mono">{cost.name}</span>
            <span class="tr-cost__lane" aria-hidden="true">
              <span class="tr-cost__bar" style={`--w: ${Math.max(1.5, (cost.amount / max) * 100)}%`} />
            </span>
            <span class="tr-cost__amount tr-mono">{money(cost.amount)}</span>
          </li>
        ))
      }
    </ol>
    <div class="tr-budget">
      <div class="tr-budget__head">
        <span class="tr-budget__label">Budget</span>
        <span class="tr-mono">{money(COST_TOTAL)} of ${BUDGET.limit}</span>
      </div>
      <span class="tr-budget__lane" aria-hidden="true">
        <span class="tr-budget__fill" style={`--w: ${spent.toFixed(1)}%`}></span>
        <span class="tr-budget__mark" style={`--l: ${BUDGET.alertAt * 100}%`}></span>
      </span>
      <span class="tr-budget__foot">Alert at 80% ($120) to Slack · AWS bills you directly; Stacktape is a separate subscription</span>
    </div>
  </div>
</TrFrame>
