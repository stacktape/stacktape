---
import TrWizard from '../TrWizard.astro';
---

<TrWizard band="Start">
  <h4 class="tr-wiz__title">Put this project on AWS</h4>
  <p class="tr-wiz__repo">
    <span class="tr-mono">~/code/acme-project</span>
    <span class="tr-wiz__repo-sep" aria-hidden="true">·</span>
    <span class="tr-mono">acme/acme-project</span>
    <span class="tr-wiz__repo-sep" aria-hidden="true">·</span>
    <span class="tr-mono">main</span>
  </p>
  <ul class="tr-wiz__facts">
    <li>
      <span class="tr-tick" aria-hidden="true"></span>
      Reads the repository on this machine. Uses your coding agent (Claude Code, Codex) if one is installed, otherwise
      the built-in scanner. Nothing is sent to Stacktape.
    </li>
    <li>
      <span class="tr-tick" aria-hidden="true"></span>
      Nothing is created on AWS and nothing is billed until you press Deploy.
    </li>
  </ul>
  <div class="tr-wiz__actions">
    <span class="tr-ui-btn tr-ui-btn--primary">Analyze my project</span>
    <span class="tr-wiz__hint">You review everything it found before anything is created.</span>
  </div>
</TrWizard>
