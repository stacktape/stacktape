---
import { DiagramIsland } from '../DiagramIsland';
import { DECISIONS, GENERATED_YAML, SUMMARY_SENTENCE } from '../data';
import TrWizard from '../TrWizard.astro';

const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// A small YAML colouring: comments, keys and values. Output is set:html, so every piece is escaped first.
const yamlHtml = GENERATED_YAML.split('\n')
  .map((line) => {
    if (line.trim().startsWith('#')) return `<span class="y-c">${escape(line)}</span>`;
    const match = line.match(/^(\s*)(- )?([\w-]+):(.*)$/);
    if (!match) return escape(line);
    const [, indent, dash = '', key, rest] = match;
    return `${indent}${dash}<span class="y-k">${escape(key!)}</span>:<span class="y-v">${escape(rest!)}</span>`;
  })
  .join('\n');
---

<TrWizard band="Review">
  <h4 class="tr-wiz__title">Here's your app on AWS</h4>
  <p class="tr-wiz__summary">{SUMMARY_SENTENCE}</p>

  <div class="tr-review__top">
    <div class="tr-diagram-box">
      <DiagramIsland client:visible />
      <p class="tr-diagram-box__caption">Drawn before anything exists. Hover a resource to see why it is there.</p>
    </div>

    <section class="tr-decided" aria-label="Decided for you">
      <h5 class="tr-decided__title">Decided for you</h5>
      <ul class="tr-decided__list">
        {
          DECISIONS.map((decision) => (
            <li class="tr-decided__row">
              <span class="tr-tick" aria-hidden="true" />
              <span class="tr-decided__text">
                <span class="tr-decided__statement">{decision.statement}</span>
                <span class="tr-decided__detail">{decision.detail}</span>
              </span>
              <span class="tr-ui-btn tr-ui-btn--small">Change</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <div class="tr-review__grid">
    <div class="tr-file">
      <div class="tr-file__head">
        <span class="tr-mono">stacktape.yml</span>
        <span class="tr-file__tag">generated · 0 lines typed by you</span>
      </div>
      <pre class="tr-file__code"><code set:html={yamlHtml} /></pre>
      <p class="tr-file__foot">Written from what the wizard read. Edit it if you want to; you do not have to.</p>
    </div>
    <div class="tr-estimate">
      <span class="tr-estimate__label">Estimated monthly price</span>
      <span class="tr-estimate__value">~$112</span>
      <span class="tr-estimate__meta">14 AWS resources · standard size</span>
      <span class="tr-estimate__meta">AWS bills you directly. Nothing is created until you press Deploy.</span>
      <span class="tr-ui-btn tr-ui-btn--primary">Ready to deploy</span>
    </div>
  </div>
</TrWizard>
