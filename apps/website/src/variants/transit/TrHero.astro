---
import TrBoard from './TrBoard.astro';
import TrCommandBox from './TrCommandBox.astro';
import { DEPTH, LINKS } from './data';
---

<section class="tr-hero">
  <div class="tr-wrap tr-hero__grid">
    <div class="tr-hero__copy">
      <p class="tr-kicker">
        <span class="tr-kicker__seg tr-kicker__seg--l0">Line 0 · Day 0</span>
        <span class="tr-kicker__arrow" aria-hidden="true">→</span>
        <span class="tr-kicker__seg tr-kicker__seg--l1">Line 1 · Day 1</span>
      </p>
      <h1 class="tr-h1">AWS DevOps,<br />fully&nbsp;automated.</h1>
      <p class="tr-sub">
        Stacktape reads your code, writes the infrastructure config, and runs deploys and operations in your own AWS
        account.
      </p>
      <TrCommandBox id="hero-cmd" />
      <div class="tr-hero__ctas">
        <a class="tr-btn tr-btn--ghost" href={LINKS.signUp}>Sign up</a>
        <a class="tr-btn tr-btn--ghost" href={LINKS.demo}>Book a demo</a>
        <span class="tr-hero__note">Open source CLI (MIT). Console is the paid product.</span>
      </div>
    </div>
    <div class="tr-hero__board">
      <TrBoard />
    </div>
  </div>
  <div class="tr-wrap">
    <dl class="tr-depth" aria-label="What the generated infrastructure can include">
      {
        DEPTH.map((group) => (
          <div class="tr-depth__group">
            <dt>{group.label}</dt>
            {group.items.map((item) => (
              <dd>{item}</dd>
            ))}
          </div>
        ))
      }
    </dl>
  </div>
</section>
