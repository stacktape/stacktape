---
import { TESTIMONIALS } from './data';
---

<section class="tr-voices" aria-labelledby="voices-title">
  <div class="tr-wrap">
    <p class="tr-eyebrow">Customers</p>
    <h2 class="tr-h2" id="voices-title">Teams running on Stacktape.</h2>
    <div class="tr-posters">
      {
        TESTIMONIALS.map((item) => (
          <figure class="tr-poster">
            <blockquote class="tr-poster__quote">
              <p>{item.quote}</p>
            </blockquote>
            <figcaption class="tr-poster__by">
              <span class="tr-poster__name">{item.name}</span>
              <span class="tr-poster__role">
                {item.role}, <a href={item.url}>{item.company}</a>
              </span>
              <span class="tr-poster__facts">{item.facts}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
