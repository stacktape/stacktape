---
/**
 * The site nav on the ground, with the page's one decoration under it: a 2px green line. Under
 * 900px the links move into a panel behind a menu button; the primary action stays visible.
 */
import { ButtonLink } from '@stacktape/ui-react/button';
import Logo from '../../components/Logo.astro';
import { LINKS, NAV_LINKS } from './data';
---

<header class="su-nav" data-su-nav>
  <div class="su-container su-nav__inner">
    <a class="su-nav__logo" href="/" aria-label="Stacktape home"><Logo height={24} /></a>

    <nav class="su-nav__primary" aria-label="Primary">
      <ul class="su-nav__links">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a class="su-nav__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="su-nav__actions">
      <a class="su-nav__link su-nav__signin" href={LINKS.console}>Sign in</a>
      <ButtonLink className="su-nav__demo" href={LINKS.demo} variant="secondary">Book a demo</ButtonLink>
      <ButtonLink className="su-nav__start" href={LINKS.getStarted} variant="primary">Get started</ButtonLink>
      <button class="su-nav__menu" type="button" aria-expanded="false" aria-controls="su-nav-panel" data-su-menu>
        <span class="su-visually-hidden">Menu</span>
        <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
          <path class="su-nav__bar1" d="M3 6h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          <path class="su-nav__bar2" d="M3 10h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          <path class="su-nav__bar3" d="M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="su-nav__panel" id="su-nav-panel" hidden data-su-panel>
    <div class="su-container">
      <ul class="su-nav__panel-links">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} data-su-panel-link>
                {link.label}
              </a>
            </li>
          ))
        }
        <li><a href={LINKS.console} data-su-panel-link>Sign in</a></li>
        <li><a href={LINKS.demo} data-su-panel-link>Book a demo</a></li>
      </ul>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-su-nav]');
  const menu = document.querySelector<HTMLButtonElement>('[data-su-menu]');
  const panel = document.querySelector<HTMLElement>('[data-su-panel]');

  const setOpen = (open: boolean) => {
    if (!menu || !panel) return;
    menu.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    nav?.classList.toggle('is-open', open);
  };

  menu?.addEventListener('click', () => setOpen(menu.getAttribute('aria-expanded') !== 'true'));
  for (const link of document.querySelectorAll('[data-su-panel-link]')) {
    link.addEventListener('click', () => setOpen(false));
  }
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
