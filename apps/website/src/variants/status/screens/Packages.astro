---
/** 02 — the package phase of a deploy: two workloads built in parallel, one skipped because nothing changed. */
import { DEPLOY_COMMAND, PACKAGE, TERMINAL_TITLE } from '../data';
import Window from '../Window.astro';
---

<Window kind="terminal" title={TERMINAL_TITLE}>
  <div class="su-term">
    <p class="su-term__cmd"><span class="su-term__prompt">$</span> {DEPLOY_COMMAND}</p>

    <p class="su-term__phase su-term__phase--done">
      <i aria-hidden="true">✓</i>
      <span>Initialize</span>
      <span class="su-term__dim">2 s</span>
    </p>

    <p class="su-term__phase su-term__phase--done">
      <i aria-hidden="true">✓</i>
      <span>Package</span>
      <span class="su-term__dim">58 s</span>
    </p>

    <ul class="su-term__rows" aria-label="Packaged workloads">
      {
        PACKAGE.rows.map((row) => (
          <li class={row.skipped ? 'su-term__row su-term__row--skipped' : 'su-term__row'}>
            <i aria-hidden="true">{row.skipped ? '–' : '✓'}</i>
            <b>{row.name}</b>
            <span class="su-term__kind">{row.kind}</span>
            <span class="su-term__result">{row.result}</span>
            <span class="su-term__time">{row.time}</span>
          </li>
        ))
      }
    </ul>
    <p class="su-term__sum">{PACKAGE.summary}</p>

    <p class="su-term__phase su-term__phase--active">
      <i aria-hidden="true">●</i>
      <span>{PACKAGE.next}</span>
      <span class="su-term__dim">starting…</span>
    </p>
    <p class="su-term__phase su-term__phase--todo">
      <i aria-hidden="true"></i>
      <span>Outputs</span>
    </p>
  </div>
</Window>
