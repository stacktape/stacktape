---
/**
 * The document shell every page shares: html/body, the stylesheet, the SEO head and analytics.
 *
 * It deliberately owns nothing visual below <body>. Each page composes its own sections, loads its own
 * fonts through the `head` slot, and sets its own root class, so two homepage studies can look
 * completely different without touching this file.
 */
import PostHogAnalytics from '../components/PostHogAnalytics.astro';
import '../styles/global.css';

type Props = {
  title: string;
  description: string;
  /** Keep unfinished studies out of the index. The production homepage passes `false`. */
  noindex?: boolean;
  /** Class applied to <html>, for page-level theming hooks. */
  htmlClass?: string;
};

const { title, description, noindex = true, htmlClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://stacktape.com').href;
---

<!doctype html>
<html lang="en" class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Stacktape" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#161c1c" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <slot name="head" />
    <PostHogAnalytics />
  </head>
  <body>
    <slot />
  </body>
</html>
