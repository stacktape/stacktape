---
import { ButtonLink } from '@stacktape/ui-react/button';
import Logo from '../../brand/Logo.astro';

const links = [
  { label: 'Docs', href: 'https://docs.stacktape.com' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Benchmarks', href: '/benchmarks' },
  { label: 'Blog', href: '/blog' },
  { label: 'GitHub', href: 'https://github.com/stacktape/stacktape' }
];
const consoleHref = 'https://console.stacktape.com';
---

<header class="h1-header h1-wrap">
  <a class="h1-header__home" href="/d/h1" aria-label="Stacktape home"><Logo width={132} alt="" /></a>
  <nav class="h1-header__links" aria-label="Main">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <div class="h1-header__end">
    <a class="h1-header__console" href={consoleHref}>Console</a>
    <ButtonLink variant="primary" className="brand-button h1-header__start" href="#install">Get started</ButtonLink>
    <details class="h1-header__more">
      <summary aria-label="Menu">
        <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav aria-label="Main, compact">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href={consoleHref}>Console</a>
      </nav>
    </details>
  </div>
</header>

<style>
  /* The header sits on the hero's sky, so it has no bar of its own. */
  .h1-header {
    position: absolute;
    z-index: 3;
    inset-block-start: 0;
    inset-inline: 0;
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3.5rem);
    block-size: 4.5rem;
    font-size: var(--brand-type-sm);
  }

  .h1-header__home {
    display: flex;
    flex: none;
  }

  .h1-header__links {
    display: flex;
    gap: var(--brand-space-5);
  }

  .h1-header__links a,
  .h1-header__console {
    color: var(--brand-muted);
    text-decoration: none;
  }

  .h1-header__links a:hover,
  .h1-header__console:hover {
    color: var(--brand-text);
  }

  .h1-header__end {
    display: flex;
    align-items: center;
    gap: var(--brand-space-5);
    margin-inline-start: auto;
  }

  .h1-header__end :global(.h1-header__start) {
    --stp-control-height: 2.25rem;
  }

  /* Phones: a menu whose rows get a strip of tape on hover, like a selected row in the Console. */
  .h1-header__more {
    position: relative;
    display: none;
  }

  .h1-header__more > summary {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    aspect-ratio: 1;
    list-style: none;
    cursor: pointer;
    background: var(--brand-control);
    box-shadow: var(--brand-edge);
    border-radius: var(--brand-radius);
  }

  .h1-header__more > summary::-webkit-details-marker {
    display: none;
  }

  .h1-header__more > nav {
    position: absolute;
    inset: calc(100% + 0.5rem) 0 auto auto;
    display: flex;
    flex-direction: column;
    inline-size: 13rem;
    padding: 0.5rem;
    background: var(--brand-surface);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    box-shadow: var(--brand-shadow-menu);
  }

  .h1-header__more > nav a {
    position: relative;
    isolation: isolate;
    padding: 0.55rem 0.9rem;
    color: var(--brand-text);
    text-decoration: none;
  }

  .h1-header__more > nav a:hover::before {
    position: absolute;
    z-index: -1;
    inset: 0.15rem 0;
    content: '';
    background: var(--brand-control);
    clip-path: var(--brand-tape-clip);
  }

  @media (max-width: 60rem) {
    .h1-header__links,
    .h1-header__console {
      display: none;
    }

    .h1-header__more {
      display: block;
    }

    .h1-header__end {
      gap: var(--brand-space-3);
    }
  }
</style>
