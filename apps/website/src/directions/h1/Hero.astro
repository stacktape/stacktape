---
import { ButtonLink } from '@stacktape/ui-react/button';
import { CommandBox } from '../../brand/CommandBox';
import Tape from '../../brand/Tape.astro';
import sky from './sky.svg?raw';
import anchors from './world-labels.json';
import world from './world.svg?raw';

/** On phones the drawing's own labels are too small to read, so a few of them are set again as tape labels. */
const phoneTags = anchors.filter((anchor) => ['site', 'api', 'db', 'stage'].includes(anchor.id));
---

<section class="h1-hero" aria-labelledby="h1-title">
  <div class="h1-sky"><Fragment set:html={sky} /></div>
  <div class="h1-hero__copy h1-wrap">
    <h1 class="h1-title" id="h1-title"><span>AWS DevOps,</span> <em>fully automated.</em></h1>
    <p class="h1-sub">
      Stacktape's CLI and Console design, deploy, monitor and secure your app's infrastructure in your own AWS account.
    </p>
    <div class="h1-world" data-world>
      <div
        class="h1-world__art"
        role="img"
        aria-label="An app's AWS resources, an API, functions, Postgres, a queue, a worker, uploads and a Next.js site, standing on three stacked stages: production, staging and a pull request preview. A strip of teal tape holds the stack together."
      >
        <Fragment set:html={world} />
        <div class="h1-world__tags" aria-hidden="true">
          {
            phoneTags.map((tag) => (
              <Tape tone="gray" style={`left: ${tag.x}%; top: ${tag.y}%`}>
                {tag.label}
              </Tape>
            ))
          }
        </div>
      </div>
    </div>
    <div class="h1-start">
      <CommandBox client:load id="install" preselect={false} />
      <div class="h1-start__more">
        <ButtonLink variant="secondary" className="brand-button" href="https://docs.stacktape.com">Read the docs</ButtonLink>
        <p class="h1-own">
          Runs in your AWS account on standard CloudFormation. Stop using Stacktape and your app keeps running.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // The world leans a few pixels towards the pointer. Nothing moves on its own, and nothing moves with reduced motion.
  const world = document.querySelector<HTMLElement>('[data-world]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;
  if (world && !still && fine) {
    let frame = 0;
    window.addEventListener('pointermove', (event) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const x = event.clientX / window.innerWidth - 0.5;
        const y = event.clientY / window.innerHeight - 0.5;
        world.style.setProperty('--h1-lean-x', `${(x * -10).toFixed(1)}px`);
        world.style.setProperty('--h1-lean-y', `${(y * -6).toFixed(1)}px`);
      });
    });
  }
</script>
