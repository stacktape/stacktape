---
import type { ImageMetadata } from 'astro';

/** A product screenshot at two widths: the 1× file and the 2× capture. Plain <img>, so the build needs no Sharp. */
type Props = {
  small: ImageMetadata;
  large: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
  eager?: boolean;
};

const { small, large, alt, sizes, class: className, eager = false } = Astro.props;
---

<img
  class={className}
  src={small.src}
  srcset={`${small.src} ${small.width}w, ${large.src} ${large.width}w`}
  {sizes}
  width={small.width}
  height={small.height}
  {alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
