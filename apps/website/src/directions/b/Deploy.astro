---
import { Image } from 'astro:assets';
import Tape from '../../brand/Tape.astro';
import { bars, FIRST_RUN, runDate } from './bench';
import Race from './Race.astro';
import preview from './shots/deploys-preview-stage-tape-main.png';

const lambda = bars('lambda-deploy', 'handler', 'lambda-25');
const container = bars('container-deploy', 'code-change', 'container-node');
const push = bars('git-push', 'warm', 'container-node');
const pushPython = bars('git-push', 'warm', 'container-python');
const shared = bars('lambda-deploy', 'shared', 'lambda-5');
const pushDate = push.find((bar) => bar.tool === 'stacktape')?.date ?? FIRST_RUN.date;
const scale = Math.max(...[lambda, container, push, pushPython, shared].flat().map((bar) => bar.seconds));
/** How much faster the winner of a case we lose is, in seconds. */
const lead = (case_: typeof shared) => {
  const us = case_.find((bar) => bar.tool === 'stacktape')?.seconds ?? 0;
  return (us - case_[0].seconds).toFixed(1);
};
---

<div class="b-deploy">
  <div class="b-bench" data-races>
    <div class="b-bench__head">
      <p class="b-bench__run">
        Preliminary run, {runDate(FIRST_RUN.date)}. Seconds until the new code answers, lower is better.
      </p>
      <p class="b-bench__replay" data-replay hidden>
        Played at 10× speed. <button type="button">Run again</button>
      </p>
    </div>
    <div class="b-bench__races">
      <Race title="Lambda functions" detail="A code change to 25 functions" bars={lambda} scale={scale} />
      <Race
        title="Containers"
        detail="A code change to a Node.js service"
        note="* With code swap: opt-in, for changes to code only."
        bars={container}
        rename={{ stacktape: 'Stacktape*' }}
        scale={scale}
      />
      <Race
        title="Git push"
        detail="From git push until a Node.js service serves the change"
        note="Build machines already running."
        bars={push}
        scale={scale}
      />
    </div>
    <div class="b-bench__races b-bench__lose">
      <p class="b-bench__lose-label"><Tape tone="gray">Where we’re slower</Tape></p>
      <Race
        title="Git push, Python"
        detail={`Heroku is ${lead(pushPython)} s faster`}
        bars={pushPython}
        scale={scale}
      />
      <Race
        title="Shared code, 5 functions"
        detail={`CDK hotswap is ${lead(shared)} s faster`}
        bars={shared}
        scale={scale}
      />
    </div>
    <p class="b-bench__foot">
      Median of 5 to 10 runs. Command-line deploys ran on a dedicated EC2 c7i.2xlarge in eu-west-1; Stacktape’s Git push
      ran on its build runner on {runDate(pushDate)}.
      <a class="brand-link" href="/benchmarks">All results and how we measured</a>
    </p>
  </div>

  <div class="b-preview">
    <div class="b-preview__copy">
      <h3>A preview for every pull request</h3>
      <p>
        Open a pull request and it gets its own stage, <code>pr-421</code> here. Close it and the preview is deleted.
      </p>
      <a class="brand-link" href="https://docs.stacktape.com/ci-cd-and-gitops/gitops-with-console">Git deployments</a>
    </div>
    <div class="b-frame">
      <div class="b-frame__bar" aria-hidden="true">
        <span class="b-frame__dots"><i></i><i></i><i></i></span>
        <span class="b-frame__where">console.stacktape.com · storefront · pr-421</span>
      </div>
      <Image
        class="b-preview__shot"
        src={preview}
        alt="The storefront project in the Console with the pr-421 preview stage selected: healthy, deployed from feature/pr-421, with its requests and latency."
        widths={[800, 1440, 2160]}
        sizes="(min-width: 75rem) 52rem, 100vw"
        loading="lazy"
      />
    </div>
  </div>
</div>

<script is:inline>
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.classList.add('b-motion');
</script>

<script>
  for (const group of document.querySelectorAll<HTMLElement>('[data-races]')) {
    const races = Array.from(group.querySelectorAll<HTMLElement>('[data-race]'));
    const replay = group.querySelector<HTMLElement>('[data-replay]');
    const run = () => {
      for (const race of races) race.classList.remove('is-running');
      void group.offsetWidth;
      for (const race of races) race.classList.add('is-running');
    };
    if (!document.documentElement.classList.contains('b-motion')) continue;
    if (replay) {
      replay.hidden = false;
      replay.querySelector('button')?.addEventListener('click', run);
    }
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        run();
      },
      { threshold: 0.35 }
    );
    observer.observe(group);
  }
</script>

<style>
  .b-deploy {
    display: grid;
    gap: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .b-bench {
    display: grid;
    gap: var(--brand-space-6);
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-inset);
  }

  .b-bench__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--brand-space-3);
  }

  .b-bench__run {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  .b-bench__replay {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  .b-bench__replay[hidden] {
    display: none;
  }

  .b-bench__replay button {
    margin-left: var(--brand-space-2);
    padding: 0;
    border: 0;
    background: none;
    color: var(--brand-teal);
    font: inherit;
    cursor: pointer;
  }

  .b-bench__replay button:hover {
    color: var(--brand-text);
  }

  .b-bench__races {
    display: grid;
    gap: var(--brand-space-6);
  }

  .b-bench__lose {
    padding-top: var(--brand-space-6);
    border-top: 1px solid var(--brand-border);
  }

  .b-bench__foot {
    color: var(--brand-muted);
    font-size: var(--brand-type-xs);
  }

  .b-bench__foot a {
    margin-left: var(--brand-space-2);
  }

  .b-preview {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr);
    align-items: start;
    gap: var(--brand-space-6) clamp(2rem, 1rem + 3vw, 5rem);
  }

  .b-preview__copy {
    display: grid;
    justify-items: start;
    gap: var(--brand-space-3);
    padding-top: var(--brand-space-6);
    font-size: var(--brand-type-sm);
  }

  h3 {
    font: var(--brand-weight-heading) var(--brand-type-title) / 1.15 var(--brand-font-heading);
    letter-spacing: var(--brand-tracking-heading);
  }

  .b-preview__copy p {
    color: var(--brand-muted);
    font-size: var(--brand-type-base);
  }

  code {
    font-family: var(--brand-font-mono);
    font-size: 0.9em;
  }

  .b-preview__shot {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 64rem) {
    .b-preview {
      grid-template-columns: minmax(0, 1fr);
    }

    .b-preview__copy {
      padding-top: 0;
    }
  }
</style>
