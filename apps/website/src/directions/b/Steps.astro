---
import Deploy from './Deploy.astro';
import Incident from './Incident.astro';
import Step from './Step.astro';
import { STEPS } from './steps';

const DOCS: Record<string, { label: string; href: string }> = {
  design: { label: 'How init works', href: 'https://docs.stacktape.com/cli/init' },
  package: { label: 'Packaging', href: 'https://docs.stacktape.com/packaging/overview' },
  deploy: { label: 'Deploys and CI/CD', href: 'https://docs.stacktape.com/ci-cd-and-gitops/overview' },
  secure: { label: 'Guardrails', href: 'https://docs.stacktape.com/guardrails/overview' },
  monitor: { label: 'Observability', href: 'https://docs.stacktape.com/observability/overview' },
  incident: { label: 'Incidents', href: 'https://docs.stacktape.com/observability/incidents' },
  costs: { label: 'Costs', href: 'https://docs.stacktape.com/managing-costs/overview' },
  help: { label: 'Pricing', href: '/pricing' }
};

/** What goes in each grey block of the outline, and its final proportions. */
const OUTLINE: Record<string, { picture: string; ratio: string }> = {
  design: { picture: 'Init wizard: scan, then Review with diagram, costs and config', ratio: '16 / 8' },
  package: { picture: 'Packaging benchmark (25 functions) and the Build & package step', ratio: '16 / 6' },
  secure: { picture: 'Guardrails page and the access layer of the diagram', ratio: '16 / 8' },
  monitor: { picture: 'Error tracking, uptime checks and logs', ratio: '16 / 8' },
  costs: { picture: 'Costs by stage and resource, and a budget alert', ratio: '16 / 7' },
  help: { picture: 'The founders, with names and photos', ratio: '16 / 4' }
};
const pad = (index: number) => String(index + 1).padStart(2, '0');
---

<div class="b-steps" data-steps>
  <nav class="b-steps__rail" aria-label="Steps">
    <ol class="b-stepper">
      {
        STEPS.map((step, index) => (
          <li>
            <a class="b-stepper__item" href={`#${step.id}`} data-step-link={step.id}>
              <span class="b-stepper__num">{pad(index)}</span>
              <span class="b-stepper__name">
                <span class="b-stepper__tape">{step.name}</span>
              </span>
              <span class="b-stepper__when">{step.when}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="b-steps__body">
    {
      STEPS.map((step, index) => (
        <Step step={step} index={index} docs={DOCS[step.id]}>
          {step.id === 'deploy' ? (
            <Deploy />
          ) : step.id === 'incident' ? (
            <Incident />
          ) : (
            <div class="b-outline" style={`aspect-ratio: ${OUTLINE[step.id].ratio}`}>
              {OUTLINE[step.id].picture}
            </div>
          )}
        </Step>
      ))
    }
  </div>
</div>

<script>
  for (const steps of document.querySelectorAll<HTMLElement>('[data-steps]')) {
    const links = new Map(
      Array.from(steps.querySelectorAll<HTMLAnchorElement>('[data-step-link]')).map((link) => [
        link.dataset.stepLink,
        link
      ])
    );
    const sections = Array.from(steps.querySelectorAll<HTMLElement>('section[id]'));
    let frame = 0;
    /** The current step is the last one whose top has passed the middle of the window. */
    const update = () => {
      frame = 0;
      const middle = window.innerHeight / 2;
      const current = sections.findLast((section) => section.getBoundingClientRect().top < middle)?.id;
      for (const [key, link] of links) {
        if (key === current) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true }
    );
    update();
  }
</script>

<style>
  .b-steps {
    display: grid;
    grid-template-columns: minmax(14rem, 17rem) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 2.5vw, 4rem);
    width: var(--b-width);
    margin-inline: auto;
  }

  .b-steps__rail {
    padding-block: clamp(4rem, 2.5rem + 4vw, 8rem);
  }

  .b-steps__rail ol {
    position: sticky;
    top: calc(4.25rem + var(--brand-space-7));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .b-steps__rail .b-stepper__item {
    text-decoration: none;
  }

  .b-steps__body {
    min-width: 0;
  }

  .b-outline {
    display: grid;
    place-items: center;
    padding: var(--brand-space-5);
    border-radius: var(--brand-radius);
    background: var(--brand-surface);
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    text-align: center;
  }

  @media (max-width: 64rem) {
    .b-steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .b-steps__rail {
      display: none;
    }
  }
</style>
