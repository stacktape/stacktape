---
import { ButtonLink } from '@stacktape/ui-react/button';
import Logo from '../../brand/Logo.astro';

const LINKS = [
  { label: 'Docs', href: 'https://docs.stacktape.com' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Benchmarks', href: '/benchmarks' },
  { label: 'Blog', href: '/blog' },
  { label: 'GitHub', href: 'https://github.com/stacktape/stacktape' }
];
---

<header class="b-header">
  <div class="b-header__inner">
    <a class="b-header__logo" href="/" aria-label="Stacktape home"><Logo alt="" width={136} /></a>
    <nav class="b-header__nav" aria-label="Main">
      {LINKS.map((link) => <a class="brand-link brand-link--muted" href={link.href}>{link.label}</a>)}
    </nav>
    <div class="b-header__actions">
      <a class="brand-link brand-link--muted b-header__console" href="https://console.stacktape.com">Console</a>
      <ButtonLink variant="primary" className="brand-button" href="#install">Get started</ButtonLink>
      <details class="b-header__menu">
        <summary aria-label="Menu">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </summary>
        <div class="b-header__sheet">
          {LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href="https://console.stacktape.com">Console</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .b-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--brand-border);
    background: var(--brand-page);
  }

  .b-header__inner {
    display: flex;
    align-items: center;
    gap: var(--brand-space-7);
    width: var(--b-width);
    height: 4.25rem;
    margin-inline: auto;
  }

  .b-header__logo {
    display: flex;
    flex: none;
  }

  .b-header__nav {
    display: flex;
    gap: var(--brand-space-6);
    font-size: var(--brand-type-sm);
    font-weight: 500;
  }

  .b-header__nav .brand-link--muted,
  .b-header__console {
    color: var(--brand-muted);
  }

  .b-header__nav .brand-link--muted:hover,
  .b-header__console:hover {
    color: var(--brand-text);
    text-decoration-line: none;
  }

  .b-header__actions {
    display: flex;
    align-items: center;
    gap: var(--brand-space-5);
    margin-left: auto;
    font-size: var(--brand-type-sm);
    font-weight: 500;
  }

  .b-header__actions :global(.brand-button.stp-ui-button) {
    --stp-control-height: 2.5rem;
  }

  .b-header__menu {
    display: none;
    position: relative;
  }

  .b-header__menu summary {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    color: var(--brand-text);
    cursor: pointer;
    list-style: none;
  }

  .b-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .b-header__sheet {
    position: absolute;
    top: calc(100% + var(--brand-space-2));
    right: 0;
    display: grid;
    min-width: 12rem;
    padding: var(--brand-space-2);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-surface);
    box-shadow: var(--brand-shadow-menu);
  }

  .b-header__sheet a {
    padding: var(--brand-space-2) var(--brand-space-3);
    border-radius: var(--brand-radius-small);
    color: var(--brand-text);
  }

  .b-header__sheet a:hover {
    background: var(--brand-inset);
  }

  @media (max-width: 60rem) {
    .b-header__nav,
    .b-header__console {
      display: none;
    }

    .b-header__menu {
      display: block;
    }

    .b-header__actions {
      gap: var(--brand-space-3);
    }
  }
</style>
