---
import BrandHead from '../../brand/BrandHead.astro';
import '../../brand/controls.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Closing from './Closing.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Proof from './Proof.astro';
import Questions from './Questions.astro';
import Steps from './Steps.astro';
---

<BaseLayout
  title="Stacktape: AWS DevOps, fully automated"
  description="Your developers ship app code. Stacktape's CLI and Console build the AWS setup in your own account, deploy every push and tell you when something breaks."
  htmlClass="brand b-page"
>
  <BrandHead slot="head" />
  <script is:inline slot="head">
    if (matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.classList.add('b-motion');
  </script>
  <Header />
  <main>
    <Hero />
    <Proof />
    <Steps />
    <Questions />
    <Closing />
  </main>
  <Footer />
</BaseLayout>

<script>
  /*
   * The kit's command box preselects the visitor's installer. Until the installers are confirmed to ship v4
   * (launch item L5), this page keeps npx: the automatic switch is undone before it paints. A visitor's own
   * choice is left alone.
   */
  for (const box of document.querySelectorAll<HTMLElement>('.b-page astro-island:has(.brand-command)')) {
    let touched = false;
    const stop = () => {
      touched = true;
      observer.disconnect();
    };
    const observer = new MutationObserver(() => {
      const tabs = Array.from(box.querySelectorAll<HTMLElement>('.install-code__tabs [role="tab"]'));
      const npx = tabs.find((tab) => tab.textContent?.trim() === 'npx');
      if (touched || !npx || npx.getAttribute('aria-selected') === 'true') return;
      observer.disconnect();
      npx.click();
    });
    box.addEventListener('pointerdown', stop, { once: true });
    box.addEventListener('keydown', stop, { once: true });
    observer.observe(box, { subtree: true, childList: true, attributes: true, attributeFilter: ['aria-selected'] });
  }
</script>

<style is:global>
  .b-page {
    --b-width: min(90rem, 100% - 2 * clamp(1rem, 0.5rem + 2.5vw, 3rem));
    --b-type-hero: clamp(2.5rem, 1.4rem + 3.6vw, 5.25rem);
    scroll-padding-top: 5rem;
  }

  .b-page body {
    overflow-x: clip;
  }

  .b-page astro-island {
    display: contents;
  }
</style>
