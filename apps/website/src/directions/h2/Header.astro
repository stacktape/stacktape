---
import { ButtonLink } from '@stacktape/ui-react/button';
import Logo from '../../brand/Logo.astro';

const LINKS = [
  { label: 'Docs', href: 'https://docs.stacktape.com' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Benchmarks', href: '/benchmarks' },
  { label: 'Blog', href: '/blog' },
  { label: 'GitHub', href: 'https://github.com/stacktape/stacktape' }
];
---

<header class="h2-header">
  <div class="h2-container h2-header__bar">
    <a class="h2-header__home" href="/" aria-label="Stacktape home"><Logo alt="" width={124} /></a>
    <nav class="h2-header__nav" aria-label="Main">
      {
        LINKS.map((link) => (
          <a class="brand-link brand-link--muted" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="h2-header__actions">
      <a class="brand-link brand-link--muted h2-header__console" href="https://console.stacktape.com">Console</a>
      <ButtonLink variant="primary" className="brand-button" href="#install">Get started</ButtonLink>
      <details class="h2-header__menu">
        <summary aria-label="Menu">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </summary>
        <nav aria-label="Main">
          {
            [...LINKS, { label: 'Console', href: 'https://console.stacktape.com' }].map((link) => (
              <a href={link.href}>{link.label}</a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .h2-header {
    position: absolute;
    z-index: 3;
    inset: 0 0 auto;
  }

  .h2-header__bar {
    display: flex;
    align-items: center;
    gap: var(--brand-space-6);
    block-size: 4.5rem;
  }

  .h2-header__home {
    display: flex;
    flex: none;
  }

  .h2-header__nav {
    display: flex;
    gap: var(--brand-space-5);
    font-size: var(--brand-type-sm);
  }

  .h2-header__actions {
    display: flex;
    align-items: center;
    gap: var(--brand-space-5);
    margin-inline-start: auto;
    font-size: var(--brand-type-sm);
  }

  .h2-header__menu {
    display: none;
    position: relative;
  }

  .h2-header__menu summary {
    display: grid;
    place-items: center;
    inline-size: var(--brand-control-height);
    block-size: var(--brand-control-height);
    border-radius: var(--brand-radius);
    color: var(--brand-text);
    cursor: pointer;
    list-style: none;
  }

  .h2-header__menu summary::-webkit-details-marker {
    display: none;
  }

  /* A sheet the width of the page gutter to gutter, under the bar. */
  .h2-header__menu nav {
    position: fixed;
    inset: 4.5rem var(--h2-gutter) auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--brand-space-3);
    background: var(--brand-inset);
    border-radius: var(--brand-radius);
    outline: 1px solid var(--brand-border);
    box-shadow: var(--brand-shadow-menu);
  }

  .h2-header__menu nav a {
    padding: var(--brand-space-3);
    color: var(--brand-text);
    font-size: var(--brand-type-base);
    text-decoration: none;
    border-radius: var(--brand-radius-small);
  }

  .h2-header__menu nav a:hover {
    background: rgb(255 255 255 / 5%);
  }

  @media (max-width: 56rem) {
    .h2-header__nav,
    .h2-header__console {
      display: none;
    }

    .h2-header__menu {
      display: block;
    }

    .h2-header__actions {
      gap: var(--brand-space-2);
    }
  }
</style>
