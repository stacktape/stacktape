---
import { ButtonLink } from '@stacktape/ui-react/button';
import Logo from '../../brand/Logo.astro';

const links = [
  { label: 'Docs', href: 'https://docs.stacktape.com' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Benchmarks', href: '/benchmarks' },
  { label: 'Blog', href: '/blog' },
  { label: 'GitHub', href: 'https://github.com/stacktape/stacktape' }
] as const;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__home" href="/d/c" aria-label="Stacktape home"><Logo alt="" width={136} /></a>
    <nav class="site-header__nav" aria-label="Main">
      {links.map((link) => <a class="brand-link brand-link--muted" href={link.href}>{link.label}</a>)}
    </nav>
    <div class="site-header__actions">
      <a class="brand-link brand-link--muted site-header__console" href="https://console.stacktape.com">Console</a>
      <ButtonLink variant="primary" className="brand-button" href="#install">Get started</ButtonLink>
    </div>
    <details class="site-header__menu">
      <summary aria-label="Menu">
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav aria-label="Main">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href="https://console.stacktape.com">Console</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 10;
    inset-block-start: 0;
    border-block-end: 1px solid color-mix(in srgb, var(--brand-border), transparent 40%);
    background: color-mix(in srgb, var(--brand-page), transparent 8%);
    backdrop-filter: blur(10px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--brand-space-7);
    inline-size: var(--c-container);
    block-size: 4.25rem;
    margin-inline: auto;
  }

  .site-header__home {
    display: flex;
  }

  .site-header__nav {
    display: flex;
    gap: var(--brand-space-6);
    font-size: var(--brand-type-sm);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--brand-space-5);
    margin-inline-start: auto;
    font-size: var(--brand-type-sm);
  }

  .site-header__menu {
    display: none;
    position: relative;
  }

  .site-header__menu summary {
    display: grid;
    place-items: center;
    inline-size: var(--brand-control-height);
    block-size: var(--brand-control-height);
    border-radius: var(--brand-radius);
    color: var(--brand-text);
    list-style: none;
    cursor: pointer;
  }

  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__menu nav {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: calc(100% + var(--brand-space-2));
    display: grid;
    min-inline-size: 12rem;
    padding: var(--brand-space-2);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-surface);
    box-shadow: var(--brand-shadow-menu);
  }

  .site-header__menu nav a {
    padding: var(--brand-space-2) var(--brand-space-3);
    border-radius: var(--brand-radius-small);
    color: var(--brand-text);
    font-size: var(--brand-type-sm);
    text-decoration: none;
  }

  .site-header__menu nav a:hover {
    background: color-mix(in srgb, var(--brand-surface), var(--brand-text) 6%);
  }

  @media (max-width: 60rem) {
    .site-header__inner {
      gap: var(--brand-space-3);
    }

    .site-header__nav,
    .site-header__console {
      display: none;
    }

    .site-header__menu {
      display: block;
    }
  }
</style>
