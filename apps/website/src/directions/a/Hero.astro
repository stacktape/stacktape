---
import { ButtonLink } from '@stacktape/ui-react/button';
import { CommandBox } from '../../brand/CommandBox';
import consoleLarge from './shots/console-2880.webp';
import consoleSmall from './shots/console-1440.webp';
import reviewLarge from './shots/review-2880.webp';
import reviewSmall from './shots/review-1440.webp';
import scanLarge from './shots/scan-2880.webp';
import scanSmall from './shots/scan-1440.webp';

/** The three things the subheadline promises, each shown by the real product. Review is the first one shown. */
const steps = [
  {
    id: 'reads',
    short: 'Reads',
    rest: ' your repo',
    caption: 'The agent you already use reads the code on your machine. No source code goes to Stacktape.',
    alt: 'Stacktape init reading a Next.js project: the file tree on the left, the configuration being written on the right.',
    small: scanSmall,
    large: scanLarge
  },
  {
    id: 'designs',
    short: 'Designs',
    rest: ' the setup',
    caption: 'Every resource with its reason and monthly cost. Nothing is created until you confirm.',
    alt: 'The init wizard’s Review step: an architecture diagram, an estimate of $32 a month, and the generated stacktape.yml.',
    small: reviewSmall,
    large: reviewLarge
  },
  {
    id: 'runs',
    short: 'Runs it',
    rest: ' in your AWS account',
    caption: 'The Stacktape Console: stages, deploys and every resource of the app in your AWS account.',
    alt: 'The Stacktape Console showing the storefront project’s staging stage as an architecture diagram.',
    small: consoleSmall,
    large: consoleLarge
  }
];
const selected = 'designs';
---

<section class="a-hero" aria-labelledby="a-hero-title">
  <div class="a-container a-hero__top">
    <div class="a-hero__copy">
      <h1 id="a-hero-title">AWS DevOps,<br /> fully automated.</h1>
      <p class="a-hero__lead">
        Stacktape reads your repository, designs the infrastructure like a senior DevOps team would, and runs it in
        your own AWS account: deploys, monitoring, incidents, security and costs.
      </p>
    </div>
    <div class="a-hero__action">
      <CommandBox client:load id="install" label="Get started" preselect={false} />
      <div class="a-hero__next">
        <ButtonLink variant="secondary" className="brand-button" href="https://docs.stacktape.com">
          Read the docs
        </ButtonLink>
        <p class="a-hero__own">
          Runs in your AWS account as standard CloudFormation. Stop using Stacktape and your app keeps running.
        </p>
      </div>
    </div>
  </div>

  <div class="a-container a-hero__product" data-a-tabs>
    <div class="a-hero__bar">
      <div class="a-tabs" role="tablist" aria-label="What Stacktape does">
        {
          steps.map((step, index) => (
            <button
              class="a-tab"
              type="button"
              role="tab"
              id={`see-${step.id}`}
              aria-controls={`a-shot-${step.id}`}
              aria-selected={step.id === selected ? 'true' : 'false'}
              tabindex={step.id === selected ? 0 : -1}
              data-tab={step.id}
            >
              <span class="a-hero__tab-num" aria-hidden="true">
                {index + 1}
              </span>
              <span>
                {step.short}
                <span class="a-hero__tab-full">{step.rest}</span>
              </span>
            </button>
          ))
        }
      </div>
      {
        steps.map((step) => (
          <p class="a-hero__caption" data-panel={step.id} data-active={String(step.id === selected)}>
            {step.caption}
          </p>
        ))
      }
    </div>

    <div class="a-frame a-hero__frame">
      {
        steps.map((step) => (
          <img
            class="a-hero__shot"
            id={`a-shot-${step.id}`}
            role="tabpanel"
            aria-labelledby={`see-${step.id}`}
            data-panel={step.id}
            data-active={String(step.id === selected)}
            src={step.small.src}
            srcset={`${step.small.src} 1440w, ${step.large.src} 2880w`}
            sizes="(min-width: 95rem) 90rem, 94vw"
            width={step.small.width}
            height={step.small.height}
            alt={step.alt}
            fetchpriority={step.id === selected ? 'high' : 'auto'}
            decoding="async"
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import './tabs';
</script>

<style>
  .a-hero {
    padding-block-start: clamp(var(--brand-space-7), 6vw, 6.5rem);
  }

  .a-hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 38rem);
    align-items: end;
    gap: var(--brand-space-6) var(--brand-space-8);
  }

  h1 {
    font: var(--brand-weight-heading) var(--brand-type-display) / var(--brand-leading-heading)
      var(--brand-font-heading);
    letter-spacing: var(--brand-tracking-heading);
  }

  .a-hero__lead {
    max-inline-size: 40rem;
    margin-block-start: var(--brand-space-5);
    color: var(--brand-muted);
    font-size: 1.25rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .a-hero__action {
    display: grid;
    gap: var(--brand-space-3);
  }

  .a-hero__next {
    display: flex;
    align-items: center;
    gap: var(--brand-space-4);
  }

  .a-hero__next :global(.brand-button) {
    flex: none;
  }

  .a-hero__own {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    line-height: 1.45;
  }

  .a-hero__product {
    margin-block-start: clamp(var(--brand-space-7), 5vw, 4.5rem);
  }

  .a-hero__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--brand-space-3) var(--brand-space-6);
    margin-block-end: var(--brand-space-4);
  }

  .a-hero__tab-num {
    font-family: var(--brand-font-mono);
    font-size: var(--brand-type-xs);
    opacity: 0.7;
  }

  .a-hero__caption {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  .a-hero__frame {
    display: grid;
    box-shadow: var(--brand-shadow-menu);
  }

  .a-hero__caption[data-active='false'] {
    display: none;
  }

  .a-hero__shot {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 160ms ease,
      visibility 0s linear 160ms;
  }

  .a-hero__shot[data-active='true'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 160ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .a-hero__shot,
    .a-hero__shot[data-active='true'] {
      transition: none;
    }
  }

  @media (max-width: 64rem) {
    .a-hero__top {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .a-hero__action {
      max-inline-size: 40rem;
    }
  }

  @media (max-width: 40rem) {
    .a-hero__lead {
      font-size: var(--brand-type-lead);
    }

    .a-hero__next {
      flex-direction: column;
      align-items: flex-start;
    }

    .a-hero__tab-full {
      display: none;
    }

  }
</style>
