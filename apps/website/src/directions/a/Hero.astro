---
import { ButtonLink } from '@stacktape/ui-react/button';
import { CommandBox } from '../../brand/CommandBox';
import consoleLarge from './shots/console-2880.webp';
import consoleSmall from './shots/console-1440.webp';
import reviewLarge from './shots/review-2880.webp';
import reviewSmall from './shots/review-1440.webp';
import scanLarge from './shots/scan-2880.webp';
import scanSmall from './shots/scan-1440.webp';

/** The three things the subheadline promises, each shown by the real product. Review is the first one shown. */
const steps = [
  {
    id: 'reads',
    short: 'Reads',
    rest: ' your repo',
    caption: 'The agent you already use reads the code on your machine. No source code goes to Stacktape.',
    alt: 'Stacktape init reading a Next.js project: the file tree on the left, the configuration being written on the right.',
    small: scanSmall,
    large: scanLarge
  },
  {
    id: 'designs',
    short: 'Designs',
    rest: ' the setup',
    caption: 'Every resource with its reason and monthly cost. Nothing is created until you confirm.',
    alt: 'The init wizard’s Review step: an architecture diagram, an estimate of $32 a month, and the generated stacktape.yml.',
    small: reviewSmall,
    large: reviewLarge
  },
  {
    id: 'runs',
    short: 'Runs it',
    rest: ' in your AWS account',
    caption: 'The Stacktape Console: stages, deploys and every resource of the app in your AWS account.',
    alt: 'The Stacktape Console showing the storefront project’s staging stage as an architecture diagram.',
    small: consoleSmall,
    large: consoleLarge
  }
];
const selected = 'designs';
---

<section class="a-hero" aria-labelledby="a-hero-title">
  <div class="a-container a-hero__top">
    <div class="a-hero__copy">
      <h1 id="a-hero-title">AWS DevOps,<br /> fully automated.</h1>
      <p class="a-hero__lead">
        Stacktape reads your repository, designs the infrastructure like a senior DevOps team would, and runs it in
        your own AWS account: deploys, monitoring, incidents, security and costs.
      </p>
    </div>
    <div class="a-hero__action">
      <CommandBox client:load id="install" label="Get started" preselect={false} />
      <div class="a-hero__next">
        <ButtonLink variant="secondary" className="brand-button" href="https://docs.stacktape.com">
          Read the docs
        </ButtonLink>
        <p class="a-hero__own">
          Runs in your AWS account as standard CloudFormation. Stop using Stacktape and your app keeps running.
        </p>
      </div>
    </div>
  </div>

  <div class="a-container a-hero__product" data-a-steps>
    <div class="a-hero__bar">
      <div class="a-hero__tabs" role="tablist" aria-label="What Stacktape does">
        {
          steps.map((step, index) => (
            <button
              class="a-hero__tab"
              type="button"
              role="tab"
              id={`a-step-${step.id}`}
              aria-controls={`a-shot-${step.id}`}
              aria-selected={step.id === selected ? 'true' : 'false'}
              tabindex={step.id === selected ? 0 : -1}
              data-step={step.id}
            >
              <span class="a-hero__tab-num" aria-hidden="true">
                {index + 1}
              </span>
              <span>
                {step.short}
                <span class="a-hero__tab-full">{step.rest}</span>
              </span>
            </button>
          ))
        }
      </div>
      {
        steps.map((step) => (
          <p class="a-hero__caption" data-caption={step.id} hidden={step.id !== selected}>
            {step.caption}
          </p>
        ))
      }
    </div>

    <div class="a-hero__frame">
      {
        steps.map((step) => (
          <img
            class="a-hero__shot"
            id={`a-shot-${step.id}`}
            role="tabpanel"
            aria-labelledby={`a-step-${step.id}`}
            data-shot={step.id}
            data-active={step.id === selected ? 'true' : 'false'}
            src={step.small.src}
            srcset={`${step.small.src} 1440w, ${step.large.src} 2880w`}
            sizes="(min-width: 95rem) 90rem, 94vw"
            width={step.small.width}
            height={step.small.height}
            alt={step.alt}
            fetchpriority={step.id === selected ? 'high' : 'auto'}
            decoding="async"
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-a-steps]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const show = (tab: HTMLButtonElement) => {
      const id = tab.dataset.step;
      for (const other of tabs) {
        const active = other === tab;
        other.setAttribute('aria-selected', String(active));
        other.tabIndex = active ? 0 : -1;
      }
      for (const shot of root.querySelectorAll<HTMLElement>('[data-shot]')) {
        shot.dataset.active = String(shot.dataset.shot === id);
      }
      for (const caption of root.querySelectorAll<HTMLElement>('[data-caption]')) {
        caption.hidden = caption.dataset.caption !== id;
      }
    };
    const linked = tabs.find((tab) => `#see-${tab.dataset.step}` === window.location.hash);
    if (linked) show(linked);
    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => {
        show(tab);
        history.replaceState(null, '', `#see-${tab.dataset.step}`);
      });
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = tabs[(index + step + tabs.length) % tabs.length];
        next.focus();
        next.click();
      });
    }
  }
</script>

<style>
  .a-hero {
    padding-block-start: clamp(var(--brand-space-7), 6vw, 6.5rem);
  }

  .a-hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 38rem);
    align-items: end;
    gap: var(--brand-space-6) var(--brand-space-8);
  }

  h1 {
    font: var(--brand-weight-heading) var(--brand-type-display) / var(--brand-leading-heading)
      var(--brand-font-heading);
    letter-spacing: var(--brand-tracking-heading);
  }

  .a-hero__lead {
    max-inline-size: 40rem;
    margin-block-start: var(--brand-space-5);
    color: var(--brand-muted);
    font-size: 1.25rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .a-hero__action {
    display: grid;
    gap: var(--brand-space-3);
  }

  .a-hero__next {
    display: flex;
    align-items: center;
    gap: var(--brand-space-4);
  }

  .a-hero__next :global(.brand-button) {
    flex: none;
  }

  .a-hero__own {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    line-height: 1.45;
  }

  .a-hero__product {
    margin-block-start: clamp(var(--brand-space-7), 5vw, 4.5rem);
  }

  .a-hero__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--brand-space-3) var(--brand-space-6);
    margin-block-end: var(--brand-space-4);
  }

  .a-hero__tabs {
    display: flex;
    gap: var(--brand-space-2);
  }

  .a-hero__tab {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: var(--brand-space-2);
    padding: 0.45em 0.95em;
    border: 0;
    background: none;
    color: var(--brand-muted);
    font: var(--brand-weight-label) var(--brand-type-sm) / 1.2 var(--brand-font-body);
    cursor: pointer;
  }

  .a-hero__tab::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: '';
    clip-path: var(--brand-tape-clip);
  }

  .a-hero__tab:hover {
    color: var(--brand-text);
  }

  .a-hero__tab[aria-selected='true'] {
    color: var(--brand-on-teal);
  }

  .a-hero__tab[aria-selected='true']::before {
    background: var(--brand-primary);
    box-shadow: var(--brand-edge-primary);
  }

  .a-hero__tab-num {
    font-family: var(--brand-font-mono);
    font-size: var(--brand-type-xs);
    opacity: 0.7;
  }

  .a-hero__caption {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  .a-hero__frame {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-inset);
    box-shadow: var(--brand-shadow-menu);
  }

  .a-hero__shot {
    grid-area: 1 / 1;
    display: block;
    inline-size: 100%;
    block-size: auto;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 160ms ease,
      visibility 0s linear 160ms;
  }

  .a-hero__shot[data-active='true'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 160ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .a-hero__shot,
    .a-hero__shot[data-active='true'] {
      transition: none;
    }
  }

  @media (max-width: 64rem) {
    .a-hero__top {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .a-hero__action {
      max-inline-size: 40rem;
    }
  }

  @media (max-width: 40rem) {
    .a-hero__lead {
      font-size: var(--brand-type-lead);
    }

    .a-hero__next {
      flex-direction: column;
      align-items: flex-start;
    }

    .a-hero__tab-full {
      display: none;
    }

    .a-hero__tabs {
      margin-inline: calc(-1 * var(--a-gutter));
      padding-inline: var(--a-gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .a-hero__tab {
      flex: none;
    }
  }
</style>
