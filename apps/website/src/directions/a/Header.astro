---
import { ButtonLink } from '@stacktape/ui-react/button';
import Logo from '../../brand/Logo.astro';
import '../../brand/controls.css';

const links = [
  { label: 'Docs', href: 'https://docs.stacktape.com' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Benchmarks', href: '/benchmarks' },
  { label: 'Blog', href: '/blog' },
  { label: 'GitHub', href: 'https://github.com/stacktape/stacktape' }
];
const consoleLink = { label: 'Console', href: 'https://console.stacktape.com' };
---

<header class="a-header">
  <div class="a-header__bar a-container">
    <a class="a-header__home" href="/d/a" aria-label="Stacktape home">
      <Logo width={128} alt="" />
    </a>
    <nav class="a-header__nav" aria-label="Main">
      {
        links.map((link) => (
          <a class="brand-link brand-link--muted" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="a-header__actions">
      <a class="a-header__console brand-link brand-link--muted" href={consoleLink.href}>{consoleLink.label}</a>
      <ButtonLink variant="primary" className="brand-button a-header__start" href="#install">Get started</ButtonLink>
      <details class="a-header__menu">
        <summary aria-label="Menu">
          <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </summary>
        <nav class="a-header__sheet" aria-label="Main">
          {
            [...links, consoleLink].map((link) => (
              <a class="brand-link brand-link--muted" href={link.href}>
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .a-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--brand-border);
    background: var(--brand-page);
  }

  .a-header__bar {
    display: flex;
    align-items: center;
    gap: var(--brand-space-7);
    block-size: 4rem;
  }

  .a-header__home {
    display: flex;
    flex: none;
  }

  .a-header__nav {
    display: flex;
    gap: var(--brand-space-5);
    font-size: var(--brand-type-sm);
  }

  .a-header__actions {
    display: flex;
    align-items: center;
    gap: var(--brand-space-5);
    margin-inline-start: auto;
    font-size: var(--brand-type-sm);
  }

  .a-header__actions :global(.a-header__start) {
    --stp-control-height: 2.25rem;
    --stp-button-padding-x: var(--brand-space-4);
  }

  .a-header__menu {
    display: none;
    position: relative;
  }

  .a-header__menu summary {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: var(--brand-radius);
    background: var(--brand-control);
    box-shadow: var(--brand-edge);
    color: var(--brand-text);
    cursor: pointer;
    list-style: none;
  }

  .a-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .a-header__sheet {
    position: absolute;
    inset-block-start: calc(100% + var(--brand-space-2));
    inset-inline-end: 0;
    display: grid;
    min-inline-size: 12rem;
    padding: var(--brand-space-2);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-surface);
    box-shadow: var(--brand-shadow-menu);
  }

  .a-header__sheet a {
    padding: var(--brand-space-2) var(--brand-space-3);
    color: var(--brand-text);
  }

  @media (max-width: 60rem) {
    .a-header__nav,
    .a-header__console {
      display: none;
    }

    .a-header__menu {
      display: block;
    }

    .a-header__actions {
      gap: var(--brand-space-3);
    }
  }
</style>
