---
import { ButtonLink } from '@stacktape/ui-react/button';
import Tape from '../brand/Tape.astro';
import PlainPage from '../components/PlainPage.astro';

type Plan = { name: string; price: string; note: string; lines: string[]; action?: { label: string; href: string } };

/** Flexible: one rate for the whole month's managed AWS spend, picked by how large that spend is. */
const FLEXIBLE_BANDS = [
  { label: 'Up to $2,000', upTo: 2_000, rate: 25 },
  { label: 'Over $2,000, up to $5,000', upTo: 5_000, rate: 23 },
  { label: 'Over $5,000, up to $10,000', upTo: 10_000, rate: 21 },
  { label: 'Over $10,000, up to $25,000', upTo: 25_000, rate: 20 },
  { label: 'Over $25,000', upTo: Number.POSITIVE_INFINITY, rate: 19 }
] as const;

const flexibleRate = (spend: number) => FLEXIBLE_BANDS.find((band) => spend <= band.upTo)!.rate;
const dollars = (amount: number) => `$${amount.toLocaleString('en-US', { maximumFractionDigits: 0 })}`;

const FLEXIBLE_EXAMPLES = [500, 1_000, 3_000, 8_000].map((spend) => {
  const rate = flexibleRate(spend);
  return { spend: dollars(spend), rate, fee: dollars((spend * rate) / 100) };
});

const PLANS: Plan[] = [
  {
    name: 'Free',
    price: '$0',
    note: 'While managed AWS spend is up to $200 a month',
    lines: [
      'Every Console feature except single sign-on and SCIM',
      'Unlimited team members, deployments and stacks',
      'No credit card'
    ],
    action: {
      label: 'Create a free account',
      href: 'https://console.stacktape.com/sign-up?utm_source=website&utm_content=pricing'
    }
  },
  {
    name: 'Flexible',
    price: '19–25%',
    note: 'Of managed AWS spend. No spend limit.',
    lines: [
      'Everything in Free',
      'Single sign-on (SAML or OIDC) and SCIM provisioning',
      'A shared Slack channel with the founders',
      'Your feature requests come first'
    ]
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    note: 'For data residency',
    lines: [
      'A single-tenant Console in your own AWS account and region',
      'Single sign-on and SCIM provisioning',
      'Up to 24×7 premium support'
    ],
    action: { label: 'Book a call', href: 'https://cal.com/stacktape/30min' }
  }
];
---

<PlainPage
  wide
  title="Pricing"
  description="The Stacktape CLI is open source and free. The Console is free up to $200 a month of managed AWS spend, then a share of that spend. Never per seat."
  lead="The CLI is free. Use the Console free up to $200 a month in managed AWS spend, then pay a share of that spend."
>
  <section class="band" aria-labelledby="open-source">
    <div>
      <div class="band-heading">
        <h2 id="open-source">The Stacktape CLI</h2>
        <Tape>Open source (MIT)</Tape>
      </div>
      <p>
        Deploy, update, roll back and delete stacks, run dev mode, and read logs and secrets in your own AWS account
        with your own AWS credentials. No Stacktape service sits in the path of your deploys.
      </p>
    </div>
    <ButtonLink variant="secondary" className="brand-button" href="https://docs.stacktape.com/getting-started/open-source-cli">
      Use the CLI without an account
    </ButtonLink>
  </section>

  <h2 class="console-title">The Console</h2>
  <div class="plans">
    {
      PLANS.map((plan) => (
        <section class="plan">
          <h3>{plan.name}</h3>
          <p class="plan__price">{plan.price}</p>
          <p class="plan__note">{plan.note}</p>
          <ul>
            {plan.lines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
          {plan.action ? (
            <div class="plan__action">
              <ButtonLink variant={plan.name === 'Free' ? 'primary' : 'secondary'} className="brand-button" href={plan.action.href}>
                {plan.action.label}
              </ButtonLink>
            </div>
          ) : null}
        </section>
      ))
    }
  </div>

  <p class="prose">
    The Console adds deploy history, costs, alerts, error tracking, uptime checks, Git deployments and access control.
    Connect existing stacks with <code>stacktape connect</code> without redeploying.
  </p>

  <section class="details" aria-labelledby="flexible">
    <h2 id="flexible">What Flexible costs</h2>
    <p>
      Multiply the month's managed AWS spend by one rate for the whole amount. There are no seat, deployment or request
      fees. AWS bills you for the infrastructure separately.
    </p>

    <div class="tables">
      <table>
        <caption>Rate</caption>
        <thead>
          <tr><th scope="col">Monthly managed AWS spend</th><th scope="col">Rate</th></tr>
        </thead>
        <tbody>
          {
            FLEXIBLE_BANDS.map((band) => (
              <tr>
                <td>{band.label}</td>
                <td>{band.rate}%</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <table>
        <caption>Examples</caption>
        <thead>
          <tr><th scope="col">AWS spend</th><th scope="col">Stacktape fee</th></tr>
        </thead>
        <tbody>
          {
            FLEXIBLE_EXAMPLES.map((example) => (
              <tr>
                <td>{example.spend}</td>
                <td>{example.fee} ({example.rate}%)</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p>
      The Console shows what Flexible would cost you, in dollars, from your own costs. Large or unusual setups can ask
      for a custom price.
    </p>
  </section>

  <section class="details prose" aria-labelledby="free-limit">
    <h2 id="free-limit">When a Free organization passes $200</h2>
    <p>
      The first time an organization goes over the limit, deploys keep working for 7 days and Owners and Admins are told
      by email and in the Console. After those 7 days, new deploys pause until you upgrade or the next calendar month
      starts. This grace period happens once per organization; in a later month, deploys pause as soon as the limit is
      passed.
    </p>
    <p>
      A pause never touches running infrastructure. Deleting and rolling back stacks and the rest of the Console keep
      working, and upgrading lifts the pause at once.
    </p>
  </section>

  <section class="details prose" aria-labelledby="managed-spend">
    <h2 id="managed-spend">What counts as managed AWS spend</h2>
    <p>
      The AWS costs of the resources in Stacktape-managed stacks, summed over the AWS accounts connected to your
      organization. Other resources in those accounts don't count. Plans are chosen and changed in the <a
        href="https://console.stacktape.com">Console</a
      >. See the <a href="https://docs.stacktape.com/stacktape-console/billing-and-subscription">billing documentation</a
      > for the details.
    </p>
  </section>
</PlainPage>

<style>
  .band {
    display: flex;
    flex-wrap: wrap;
    column-gap: clamp(var(--brand-space-5), 5vw, var(--brand-space-8));
    align-items: center;
    row-gap: var(--brand-space-4);
    padding-block: var(--brand-space-5);
    border-block: 1px solid var(--brand-border);
  }

  .band-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--brand-space-2) var(--brand-space-4);
    margin-block-end: var(--brand-space-2);
  }

  .band h2 {
    margin: 0;
  }

  .band p {
    max-width: 62ch;
    margin: 0;
  }

  .console-title {
    margin-block-start: var(--brand-space-6);
  }

  .prose {
    max-width: 72ch;
  }

  .plans,
  .tables {
    display: grid;
    gap: var(--brand-space-4);
    margin-block: var(--brand-space-5);
  }

  .plans {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .plan {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: var(--brand-space-3);
    padding: var(--brand-space-5);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-surface);
  }

  .plan h3,
  .plan__price,
  .plan__note,
  .plan ul {
    margin: 0;
  }

  .plan h3 {
    font-size: var(--brand-type-base);
  }

  .plan__price {
    color: var(--brand-text);
    font: var(--brand-weight-heading) var(--brand-type-title) / var(--brand-leading-heading) var(--brand-font-heading);
    font-variant-numeric: tabular-nums;
  }

  .plan__note,
  .plan ul {
    font-size: var(--brand-type-sm);
  }

  .plan ul {
    padding-block-start: var(--brand-space-4);
    padding-inline-start: var(--brand-space-4);
    border-block-start: 1px solid var(--brand-border);
  }

  .plan li::marker {
    color: var(--brand-teal);
  }

  .plan__action {
    margin-block-start: var(--brand-space-2);
  }

  .details {
    margin-block-start: var(--brand-space-7);
  }

  .tables {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--brand-space-6);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    font-variant-numeric: tabular-nums;
  }

  caption,
  th {
    color: var(--brand-text);
    font-weight: var(--brand-weight-label);
  }

  caption {
    padding-block-end: var(--brand-space-2);
    text-align: start;
  }

  th,
  td {
    padding: var(--brand-space-2) var(--brand-space-3);
    border-block-end: 1px solid var(--brand-border);
    text-align: start;
  }

  th {
    background: var(--brand-surface);
  }

  td:last-child,
  th:last-child {
    text-align: end;
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    .plans,
    .tables {
      grid-template-columns: minmax(0, 1fr);
    }

    .plan {
      grid-row: auto;
      grid-template-rows: auto;
    }
  }
</style>
