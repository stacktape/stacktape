---
// concept: One vertical spine runs the page — in the hero it is a receipt printed by `stacktape init` (read, found, decided, priced, written), and below the fold the same line becomes the customer-journey timeline with ten product stations hanging off it.
// copy-angle: "AWS DevOps, fully automated." played straight and literal: the DevOps job is named as six verbs and each is shown being done by the product, with the agent/automation claim bounded by what stays in the developer's control (own account, changeable decisions, opt-in remediation).
import BaseLayout from '../layouts/BaseLayout.astro';
import Closing from '../variants/helix/Closing.astro';
import Footer from '../variants/helix/Footer.astro';
import Hero from '../variants/helix/Hero.astro';
import Journey from '../variants/helix/Journey.astro';
import Nav from '../variants/helix/Nav.astro';
import Testimonials from '../variants/helix/Testimonials.astro';
import '../variants/helix/helix.css';
---

<BaseLayout
  title="Stacktape — AWS DevOps, fully automated"
  description="Stacktape reads your repository, designs production-grade infrastructure and runs it in your own AWS account: deploys, previews, observability, incidents, security and costs."
  htmlClass="hx"
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,500..800&family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>
  <div class="hx-root">
    <Nav />
    <main>
      <Hero />
      <div class="hx-journey">
        <div class="hx-wrap">
          <div class="hx-journey__inner">
            <div class="hx-spine" aria-hidden="true"><span class="hx-spine__ink"></span></div>
            <Journey />
            <Testimonials />
            <Closing />
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  import '../variants/helix/motion';
</script>
