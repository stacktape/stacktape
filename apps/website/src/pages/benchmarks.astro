---
import Tape from '../brand/Tape.astro';
import PlainPage from '../components/PlainPage.astro';
import { BenchmarkTabs } from '../variants/readme/BenchmarkTabs';
import { BENCHMARKS } from '../variants/readme/benchmarks';
import '../styles/benchmark-tabs.css';

const [cliRun, pushRun] = BENCHMARKS.runs;
const shortDate = (date: string) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(
    new Date(date)
  );
---

<PlainPage
  wide
  title="Deploy benchmarks"
  description="Preliminary results: how long Stacktape, Serverless Framework, SST, AWS CDK, Heroku and Render take to package an application and to get a code change live."
  lead="We measured packaging and deploy times for Lambda backends and Node.js and Python container APIs across six tools."
>
  <div class="run-dates" slot="eyebrow">
    <Tape tone="gray">{BENCHMARKS.status}</Tape>
    <time datetime={cliRun.date}>{shortDate(cliRun.date)}</time>
    <span>Git push rerun <time datetime={pushRun.date}>{shortDate(pushRun.date)}</time></span>
  </div>

  <div class="benchmark-layout">
    <section class="benchmark-results" aria-label="Results" id="results">
      <BenchmarkTabs client:load data={BENCHMARKS} />
    </section>

    <aside class="run-details" aria-label="About these results">
      <p>
        Stacktape v4 was built from source for these runs. The released CLI may produce different results.
        The <a href={BENCHMARKS.source}>benchmark repository</a> includes every configuration and raw result.
      </p>
      {
        BENCHMARKS.runs.map((run) => (
          <section class="run">
            <h2>{run.label}</h2>
            <p>{run.what}</p>
            <ul>
              <li>{run.machine}</li>
              <li>Stacktape {run.stacktape}</li>
              <li>{run.competitors}</li>
            </ul>
            <p class="run-links">
              <a href={run.readme}>Method and caveats</a>
              <a href={run.files}>Raw results</a>
            </p>
          </section>
        ))
      }
    </aside>

    <section class="method" aria-labelledby="method">
      <h2 id="method">How we measured</h2>
      <ul>
        <li>
          The tests use a small online shop backend with 1, 5 or 25 Lambda functions, and Node.js and Python
          container APIs. Each tool gets the same application source and dependency lock files.
        </li>
        <li>
          We time each deploy until the changed code answers requests. We check that it serves the new revision,
          passes the application's business checks and leaves unchanged services on their old code.
        </li>
        <li>A bar is the median of ten valid runs unless the chart says otherwise. Hover a bar for its range.</li>
        <li>
          On 22 October we measured packaging, image size and command-line deploys for every tool in one
          session on a dedicated EC2 instance.
        </li>
        <li>
          On 23 October we reran Stacktape's Git push on the Console's c7a.2xlarge build runner in eu-west-1.
          The laptop's clock ran about 5% fast, so we corrected every result against AWS time.
        </li>
      </ul>

      <h2 id="reproduce">Run it yourself</h2>
      <p>
        Each test has a branch in the repository named <code>&lt;app&gt;/&lt;tool&gt;</code> with the tool's
        version, configuration and commands. Use a disposable AWS account. If you think a tool could be set up
        better, <a href={BENCHMARKS.issues}>open an issue</a> and we will rerun the affected tests.
      </p>
    </section>
  </div>
</PlainPage>

<style>
  .run-dates {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--brand-space-2) var(--brand-space-3);
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  .benchmark-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.32fr);
    gap: var(--brand-space-6) var(--brand-space-7);
    align-items: start;
  }

  .run-details {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  .run {
    padding-block: var(--brand-space-4);
    border-block-start: 1px solid var(--brand-border);
  }

  .run h2 {
    margin-block: 0 var(--brand-space-2);
    font-size: var(--brand-type-base);
  }

  .run ul {
    padding: 0;
    list-style: none;
  }

  .run-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--brand-space-2) var(--brand-space-4);
    margin: 0;
  }

  .method {
    max-width: 72ch;
  }

  @media (max-width: 56rem) {
    .benchmark-layout {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--brand-space-5);
    }

    .method h2:first-child {
      margin-block-start: 0;
    }
  }
</style>
