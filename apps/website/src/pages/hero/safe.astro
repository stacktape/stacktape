---
/**
 * Hero test page — "expert-grade, human-led", the most conservative claim.
 *
 * The automation here is the DevOps work rather than the decisions, and the fifth beat names no
 * actor at all: it shows the release, the trace and the config gathered in one view and leaves the
 * fixing to whoever is reading. Only the words and that beat differ from the other two versions.
 *
 * `noindex`, because three pages making three different promises about one product is a message
 * test, not a site.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HERO_COPY } from '../../sections/hero-lab/copy';
import HeroLabFooter from '../../sections/hero-lab/HeroLabFooter.astro';
import HeroLabNav from '../../sections/hero-lab/HeroLabNav.astro';
import HeroSection from '../../sections/hero-lab/HeroSection.astro';
import ProofStrip from '../../sections/hero-lab/ProofStrip.astro';
import '../../styles/hero-lab.css';

const copy = HERO_COPY.safe;
---

<BaseLayout title={copy.documentTitle} description={copy.metaDescription} font="geist" noindex>
  <div class="hl-page" id="top">
    <HeroLabNav />

    <main>
      <HeroSection variant="safe" />
      <ProofStrip />
    </main>

    <HeroLabFooter />
  </div>
</BaseLayout>
