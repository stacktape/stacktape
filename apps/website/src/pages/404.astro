---
/** The CDN serves this for any path that does not exist (see `errorDocument` in stacktape.yml). */
import { ButtonLink } from '@stacktape/ui-react/button';
import Tape from '../brand/Tape.astro';
import PlainPage from '../components/PlainPage.astro';
---

<PlainPage noindex title="Page not found" description="This page does not exist.">
  <Tape slot="eyebrow" tone="gray">404</Tape>
  <div class="recovery">
    <ButtonLink href="/" variant="primary" className="brand-button">Back to the homepage</ButtonLink>
    <a href="https://docs.stacktape.com">Docs</a>
    <a href="https://console.stacktape.com">Console</a>
  </div>
</PlainPage>

<style>
  .recovery {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--brand-space-4);
  }
</style>
