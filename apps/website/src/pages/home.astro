---
// concept: One command in the hero, then the six things Stacktape does, each a wide card on the Console's material with the real screen inside, joined by a route that draws itself with scroll across an isometric board from your repository to production.
// copy-angle: Name what Stacktape does in the third person, explain each step for a newcomer, say plainly what the reader does where they do anything, and let the screens carry ownership (the AWS account on every window) and control (the buttons that stay with the reader).
import BaseLayout from '../layouts/BaseLayout.astro';
import Board from '../variants/home/Board.astro';
import Closing from '../variants/home/Closing.astro';
import { HEADLINE, SUBHEADLINE } from '../variants/home/data';
import Footer from '../variants/home/Footer.astro';
import Hero from '../variants/home/Hero.astro';
import Moments from '../variants/home/Moments.astro';
import Nav from '../variants/home/Nav.astro';
import Testimonials from '../variants/home/Testimonials.astro';
import '../variants/home/home.css';
---

<BaseLayout title={`Stacktape — ${HEADLINE}`} description={SUBHEADLINE} htmlClass="hm-html">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('hm-js');
    </script>
  </Fragment>

  <div class="hm-root">
    <Nav />
    <main>
      <Board>
        <Hero />
        <Moments />
      </Board>
      <Closing />
      <Testimonials />
    </main>
    <Footer />
  </div>
</BaseLayout>
