---
// concept: Your whole infrastructure is one readable file. The page is a single tall editor showing stacktape.yml, written for you by the wizard, and the six things Stacktape does are inserted inline as comments at the lines they touch, the way review comments sit in a pull request.
// copy-angle: The page chrome is an editor's chrome and the marketing copy lives in the comments; as the story advances, small lens lines appear inside the file (a live URL, metrics, a lock, an incident, a price), so the file itself ends up telling the visitor what running on Stacktape is like.
import BaseLayout from '../layouts/BaseLayout.astro';
import Closing from '../variants/file/Closing.astro';
import { HEADLINE, SUBHEADLINE } from '../variants/file/data';
import Editor from '../variants/file/Editor.astro';
import Footer from '../variants/file/Footer.astro';
import Hero from '../variants/file/Hero.astro';
import Nav from '../variants/file/Nav.astro';
import Testimonials from '../variants/file/Testimonials.astro';
import '../variants/file/file.css';
---

<BaseLayout title={`Stacktape — ${HEADLINE}`} description={SUBHEADLINE} htmlClass="fl-html">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap"
    />
  </Fragment>

  <div class="fl-root">
    <Nav />
    <main>
      <div class="fl-container">
        <Hero />
        <Editor />
        <Closing />
      </div>
      <Testimonials />
    </main>
    <Footer />
  </div>
</BaseLayout>
