---
import { ButtonLink } from '@stacktape/ui-react/button';
import BrandHead from '../../brand/BrandHead.astro';
import { CommandBox } from '../../brand/CommandBox';
import Logo from '../../brand/Logo.astro';
import Tape from '../../brand/Tape.astro';
import '../../brand/controls.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Stacktape brand kit" description="The Stacktape website’s brand components." htmlClass="brand">
  <BrandHead slot="head" />
  <main class="kit">
    <header class="kit-header">
      <Logo />
      <h1>Website brand kit</h1>
    </header>

    <div class="specimens">
      <section class="specimen" aria-labelledby="logos">
        <h2 id="logos">Logo</h2>
        <div class="logo-samples">
          <Logo />
          <Logo variant="icon" width={48} />
          <Logo variant="icon" width={24} alt="" />
          <Logo variant="icon" width={16} alt="" />
        </div>
      </section>

      <section class="specimen" aria-labelledby="tape">
        <h2 id="tape">Tape</h2>
        <div class="tape-samples">
          <Tape>New in v4</Tape>
          <Tape variant="count">3</Tape>
          <Tape variant="marker">Deploys</Tape>
          <Tape variant="strip">Production</Tape>
        </div>
      </section>

      <section class="specimen" aria-labelledby="install">
        <h2 id="install">Install</h2>
        <CommandBox client:load />
      </section>

      <section class="specimen" aria-labelledby="controls">
        <h2 id="controls">Buttons and links</h2>
        <div class="control-samples">
          <ButtonLink variant="primary" className="brand-button" href="#install">Get started</ButtonLink>
          <ButtonLink variant="secondary" className="brand-button" href="https://docs.stacktape.com">Docs</ButtonLink>
          <a class="brand-link" href="/pricing">Pricing</a>
          <a class="brand-link brand-link--muted" href="https://console.stacktape.com">Console</a>
        </div>
      </section>

      <section class="specimen" aria-labelledby="type">
        <h2 id="type">Type</h2>
        <p class="type-display">AWS DevOps, fully automated.</p>
        <p class="type-lead">Deploy your apps and infrastructure to your own AWS account.</p>
        <code class="type-mono">npx stacktape init</code>
      </section>

      <section class="specimen" aria-labelledby="palette">
        <h2 id="palette">Palette</h2>
        <dl class="swatches">
          <div class="swatch swatch--page"><dt>Graphite</dt><dd>Page</dd></div>
          <div class="swatch swatch--surface"><dt>Slate</dt><dd>Surface</dd></div>
          <div class="swatch swatch--teal"><dt>Teal</dt><dd>Accent</dd></div>
          <div class="swatch swatch--primary"><dt>Primary</dt><dd>Logo and controls</dd></div>
        </dl>
      </section>
      <section class="specimen social" aria-labelledby="social">
        <h2 id="social">Social card</h2>
        <img src="/brand/open-graph.png" width="1200" height="630" alt="Stacktape wordmark on graphite" loading="lazy" />
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .kit {
    width: min(80rem, 100% - 2 * var(--brand-space-5));
    margin-inline: auto;
    padding-block: var(--brand-space-7) var(--brand-space-8);
  }

  .kit-header {
    display: grid;
    justify-items: start;
    gap: var(--brand-space-5);
    margin-bottom: var(--brand-space-6);
  }

  h1 {
    font: var(--brand-weight-heading) var(--brand-type-title) / var(--brand-leading-heading) var(--brand-font-heading);
    letter-spacing: var(--brand-tracking-heading);
  }

  h2 {
    font-size: var(--brand-type-sm);
    font-weight: var(--brand-weight-label);
    color: var(--brand-muted);
  }

  .specimens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--brand-space-6);
    row-gap: var(--brand-space-6);
  }

  .specimen {
    display: grid;
    align-content: start;
    gap: var(--brand-space-4);
    border-top: 1px solid var(--brand-border);
    padding-block-start: var(--brand-space-3);
  }

  .logo-samples,
  .tape-samples,
  .control-samples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--brand-space-3) var(--brand-space-5);
  }

  .control-samples {
    column-gap: var(--brand-space-3);
  }

  .logo-samples {
    min-block-size: 4.5rem;
  }

  .type-display {
    font: var(--brand-weight-heading) var(--brand-type-display) / var(--brand-leading-heading) var(--brand-font-heading);
    letter-spacing: var(--brand-tracking-heading);
    text-wrap: balance;
  }

  .type-lead {
    color: var(--brand-muted);
    font-size: var(--brand-type-lead);
  }

  .type-mono {
    font: var(--brand-type-sm) / var(--brand-leading-body) var(--brand-font-mono);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--brand-space-3);
  }

  .swatch {
    display: grid;
    align-content: end;
    min-block-size: 6.5rem;
    padding: var(--brand-space-3) var(--brand-space-4);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
  }

  .swatch dt {
    font-weight: var(--brand-weight-label);
  }

  .swatch dd {
    font-size: var(--brand-type-sm);
  }

  .swatch--page {
    background: var(--brand-page);
  }

  .swatch--surface {
    background: var(--brand-surface);
  }

  .swatch--teal {
    background: var(--brand-teal);
    color: var(--brand-page);
  }

  .swatch--primary {
    background: var(--brand-primary);
    color: var(--brand-on-teal);
  }

  .social {
    grid-column: 1 / -1;
  }

  .social img {
    width: min(100%, 600px);
    height: auto;
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
  }

  @media (max-width: 48rem) {
    .kit {
      padding-block-start: var(--brand-space-5);
    }

    .kit-header {
      gap: var(--brand-space-4);
    }

    .logo-samples {
      min-block-size: auto;
    }

    .specimens {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
