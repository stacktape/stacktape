---
import BrandHead from '../../brand/BrandHead.astro';
import { home } from '../../home/home';
import { hasReviewParts, reviewHeroes, reviewStructures } from '../../home/review';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../brand/controls.css';

const groups = [
  { name: 'structure', label: 'Page structure', options: reviewStructures },
  { name: 'hero', label: 'Hero', options: reviewHeroes }
] as const;

const initialStructure = reviewStructures.find(({ id }) => id === home.structure) ?? reviewStructures[0];
const initialHero = reviewHeroes.find(({ id }) => id === home.hero) ?? reviewHeroes[0];
const initial = { structure: initialStructure.id, hero: initialHero.id };
---

<BaseLayout title="Home page previews" description="Pick a page structure and a hero to review." htmlClass="brand">
  <BrandHead slot="head" />
  <main>
    <h1>Home page previews</h1>
    {
      hasReviewParts ? (
        <form id="home-mix">
          {groups.map(({ name, label, options }) => (
            <fieldset>
              <legend>{label}</legend>
              <div class="options">
                {options.map(({ id, title, line }) => (
                  <label class="option">
                    <input type="radio" name={name} value={id} checked={id === initial[name]} />
                    <span>
                      <strong>{title}</strong>
                      <span class="line">{line}</span>
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
          <a id="open-combination" class="brand-link" href={`/d/${initial.structure}/${initial.hero}`}>
            Open combination
          </a>
        </form>
      ) : (
        <p>Previews appear here as builders register page structures and heroes.</p>
      )
    }
  </main>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#home-mix');
  const link = document.querySelector<HTMLAnchorElement>('#open-combination');
  if (form && link) {
    const updateLink = () => {
      const selections = new FormData(form);
      link.href = `/d/${selections.get('structure')}/${selections.get('hero')}`;
    };
    form.addEventListener('change', updateLink);
    window.addEventListener('pageshow', updateLink);
  }
</script>

<style>
  main {
    width: min(75rem, 100% - 2 * var(--brand-space-5));
    margin-inline: auto;
    padding-block: var(--brand-space-7);
  }

  fieldset {
    min-inline-size: 0;
    margin-block: var(--brand-space-5);
    padding: 0;
    border: 0;
  }

  legend {
    margin-block-end: var(--brand-space-3);
    font-weight: var(--brand-weight-label);
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--brand-space-3);
  }

  .option {
    display: flex;
    align-items: start;
    gap: var(--brand-space-2);
    max-inline-size: 22rem;
    padding: var(--brand-space-3);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    cursor: pointer;
  }

  .option:has(:checked) {
    border-color: var(--brand-teal);
  }

  input {
    margin-block-start: 0.3em;
    accent-color: var(--brand-teal);
  }

  .line {
    display: block;
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }
</style>
