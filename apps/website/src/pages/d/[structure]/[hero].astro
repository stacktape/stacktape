---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BrandHead from '../../../brand/BrandHead.astro';
import SiteHeader from '../../../brand/SiteHeader.astro';
import { hasReviewParts, reviewHeroes, reviewStructures } from '../../../home/review';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => {
  if (!hasReviewParts) return [];
  return reviewStructures.flatMap((structure) =>
    reviewHeroes.map((hero) => ({
      params: { structure: structure.id, hero: hero.id },
      props: { structure, hero }
    }))
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { structure, hero } = Astro.props;
const [Structure, Hero] = await Promise.all([structure.load?.(), hero.load?.()]);
---

{
  Structure ? (
    <Structure>
      <Fragment slot="hero">{Hero && <Hero />}</Fragment>
    </Structure>
  ) : (
    <BaseLayout title={hero.title} description={hero.line} htmlClass="brand">
      <BrandHead slot="head" />
      <SiteHeader homeHref="/d/mix" startHref="#install" />
      <main>{Hero && <Hero />}</main>
    </BaseLayout>
  )
}
