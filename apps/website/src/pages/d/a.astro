---
import BrandHead from '../../brand/BrandHead.astro';
import Closing from '../../directions/a/Closing.astro';
import Customers from '../../directions/a/Customers.astro';
import Deploys from '../../directions/a/Deploys.astro';
import Footer from '../../directions/a/Footer.astro';
import Header from '../../directions/a/Header.astro';
import Hero from '../../directions/a/Hero.astro';
import Incidents from '../../directions/a/Incidents.astro';
import OutlineCapability from '../../directions/a/OutlineCapability.astro';
import Proof from '../../directions/a/Proof.astro';
import '../../directions/a/page.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Stacktape: AWS DevOps, fully automated"
  description="Stacktape reads your repository, designs the infrastructure and runs it in your own AWS account."
  htmlClass="brand direction-a"
>
  <BrandHead slot="head" />
  <Header />
  <main>
    <Hero />
    <Proof />
    <OutlineCapability
      id="designs"
      index={1}
      name="Designs"
      title="Reads your repo and proposes the AWS setup."
      line="You don't have to know AWS to start. Every resource shows why it's there, the line of code behind it and its estimated monthly cost."
      picture="Init wizard: Decided for you and the config editor"
      flip
    />
    <OutlineCapability
      id="packages"
      index={2}
      name="Packages"
      title="25 Lambda functions packaged in 3.8 seconds."
      line="CDK takes 17.6 s for the same functions. Python, Java, Go, Ruby, .NET and Rust build without a Dockerfile."
      source={{ label: 'Empty build cache · preliminary run, 22 Oct 2026', href: '/benchmarks' }}
      picture="Deployment in progress, packaging step"
    />
    <Deploys />
    <OutlineCapability
      id="monitors"
      index={4}
      name="Monitors"
      title="Monitoring comes with the stack."
      line="No second vendor to buy and wire up. Logs, metrics and error tracking are on for every stack. Tracing, uptime checks and scripted browser tests are added in the same config."
      picture="Error tracking and uptime checks"
    />
    <OutlineCapability
      id="secures"
      index={5}
      name="Secures"
      title="Least access by default. Rules checked before deploy."
      line="Each workload gets only the access it connects to. Guardrails stop a public database or a wrong region before anything changes."
      picture="Guardrails and the diagram's access layer"
      flip
    />
    <Incidents />
    <OutlineCapability
      id="costs"
      index={7}
      name="Costs"
      title="See what every stage costs."
      line="Your AWS spend per project, stage and resource, updated daily. Budgets alert on actual and forecast spend."
      picture="Costs by stage and resource, a budget"
      flip
    />
    <OutlineCapability
      id="help"
      index={8}
      name="Expert help"
      title="Questions go to the engineers who build it."
      line="On Flexible, your team gets a shared Slack channel with the founders."
      picture="The founders, photographed"
    />
    <Customers />
    <Closing />
  </main>
  <Footer />
</BaseLayout>
