---
// concept: What a first week with Stacktape looks like, told as one thread of events in the tools a team already uses — the terminal, the wizard, GitHub, the Console, Slack. The six things Stacktape does are the big events; the visitor's own actions are the short ones.
// copy-angle: The headline states the promise; the thread proves it on one app, hour by hour, in the tools the reader already has open, so a developer recognises their own workflow and a CTO sees that it fits the process they already run.
import BaseLayout from '../layouts/BaseLayout.astro';
import Closing from '../variants/thread/Closing.astro';
import { HEADLINE, SUBHEADLINE } from '../variants/thread/data';
import Footer from '../variants/thread/Footer.astro';
import Hero from '../variants/thread/Hero.astro';
import Nav from '../variants/thread/Nav.astro';
import Testimonials from '../variants/thread/Testimonials.astro';
import Thread from '../variants/thread/Thread.astro';
import '../variants/thread/thread.css';
---

<BaseLayout title={`Stacktape — ${HEADLINE}`} description={SUBHEADLINE} htmlClass="th-html">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=Source+Code+Pro:wght@400;500&display=swap"
    />
    <script is:inline>
      // Set before the body parses so the terminal's output can be hidden until it types itself,
      // and only when the visitor has not asked for reduced motion.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('th-typing');
      }
    </script>
  </Fragment>

  <div class="th-root">
    <Nav />
    <main>
      <Hero />
      <Thread />
      <Closing />
      <Testimonials />
    </main>
    <Footer />
  </div>
</BaseLayout>
