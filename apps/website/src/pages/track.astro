---
// concept: Two tracks on a drafting table at night. A narrow left track holds the only four things the visitor ever does; a wide right track holds the six things Stacktape does, each a Console-material surface with its screen inside. One route line runs from the command box down the left track to "running in production", drawing itself as you scroll.
import BaseLayout from '../layouts/BaseLayout.astro';
import Closing from '../variants/track/Closing.astro';
import { HEADLINE, SUBHEADLINE } from '../variants/track/data';
import Footer from '../variants/track/Footer.astro';
import Hero from '../variants/track/Hero.astro';
import Journey from '../variants/track/Journey.astro';
import Nav from '../variants/track/Nav.astro';
import Testimonials from '../variants/track/Testimonials.astro';
import '../variants/track/track.css';
---

<BaseLayout title={`Stacktape — ${HEADLINE}`} description={SUBHEADLINE} htmlClass="tk-html">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.add('tk-js');
    </script>
  </Fragment>

  <div class="tk-root">
    <Nav />
    <main>
      <div class="tk-board" data-tk-board>
        <svg class="tk-route" aria-hidden="true" focusable="false">
          <path class="tk-route__plan" d=""></path>
          <path class="tk-route__glow" d=""></path>
          <path class="tk-route__line" d=""></path>
        </svg>
        <Hero />
        <Journey />
      </div>
      <Closing />
      <Testimonials />
    </main>
    <Footer />
  </div>
</BaseLayout>
