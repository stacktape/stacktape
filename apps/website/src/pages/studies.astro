---
/**
 * The entry to every homepage study, by round. The README concept from round 7 is the homepage itself
 * (`/`); the rest stay here for comparison.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';

const roundSeven = [
  {
    href: '/',
    name: 'Readme (the homepage)',
    summary:
      'The homepage as the repository README: repo header, a markdown document with the real cover as its hero image, an About sidebar with license, release and pricing.'
  },
  {
    href: '/hire',
    name: 'Hire',
    summary:
      'A job posting for the Senior DevOps Engineer you were about to hire; every responsibility is struck through and handled by Stacktape. Apply with one command.'
  },
  {
    href: '/session',
    name: 'Session',
    summary:
      'One terminal session, all monospace: the prompt types npx stacktape init and the page is the transcript that follows, windows opening inline across the week.'
  },
  {
    href: '/status',
    name: 'Status',
    summary:
      'A status page: all systems operational, seven components with 90-day bars, current activity (the cover), one incident in history, resolved in 11 minutes.'
  }
];

const roundSix = [
  {
    href: '/stack',
    name: 'Stack',
    summary:
      'Deck evolved: a normal hero with the Console + terminal cover, then seven full-viewport cards that pile up as you scroll; passed cards stay as numbered edges. Warm dark, copper numbers.'
  },
  {
    href: '/sheet',
    name: 'Sheet',
    summary:
      'Light: warm paper with the isometric grid as texture, the seven things as numbered line items with a sticky index, dark product windows sitting on the paper.'
  },
  {
    href: '/lens',
    name: 'Lens',
    summary:
      'Centred hero over the cover; then one product window pinned on the right that crossfades to each chapter as the seven chapters scroll past on the left.'
  }
];

const roundFive = [
  {
    href: '/deck',
    name: 'Deck',
    summary:
      'Novel: a deck of full-viewport cards that pile up as you scroll; passed cards stay as thin edges, amber tabs mark where you decided.'
  },
  {
    href: '/thread',
    name: 'Thread',
    summary:
      'Novel: a first week with Stacktape as one thread of events across the terminal, the wizard, GitHub, the Console and Slack.'
  },
  {
    href: '/file',
    name: 'File',
    summary:
      'Novel: the page is one tall editor showing stacktape.yml; the six things are review comments pinned to the lines they touch.'
  },
  {
    href: '/track',
    name: 'Track',
    summary:
      'Two tracks: the four things you do on a narrow left track, the six things Stacktape does on wide surfaces on the right; one route line on an isometric board.'
  },
  {
    href: '/zigzag',
    name: 'Zigzag',
    summary:
      'One column, one line: straight where Stacktape carries on alone, bending out at 45° to a gold interchange wherever you make a decision.'
  },
  {
    href: '/stage',
    name: 'Stage',
    summary:
      'Novel: one architecture diagram stays pinned as a stage and changes chapter by chapter, from the first command to the monthly bill.'
  },
  {
    href: '/keys',
    name: 'Keys',
    summary:
      'Novel, 3D: six full-height stages on a perspective floor, screens that stand up as you arrive, and a physical keycap wherever you decide.'
  }
];

const roundThree = [
  {
    href: '/home',
    name: 'Home',
    summary: "Round 4: the story told from the visitor's side, with your app travelling across the board from repository to production."
  },
  {
    href: '/journey',
    name: 'Journey',
    summary: "Plane's drafting-table journey carrying duet's six jobs: the combination asked for in round 3."
  }
];

const roundTwo = [
  {
    href: '/duet',
    name: 'Duet',
    summary: 'Two tracks: what you do on the left, the six things Stacktape does on the right, each with a big UI recreation.'
  },
  {
    href: '/rail',
    name: 'Rail',
    summary: 'The split rail from round 1, re-cut around the six meta-features with a checklist of your part.'
  },
  {
    href: '/runbook',
    name: 'Runbook',
    summary: 'A numbered runbook where every step is already done: contents in the hero, wide figures with captions.'
  },
  {
    href: '/console',
    name: 'Console',
    summary: 'A product-shaped page: a Console-like shell whose sidebar is the six meta-features.'
  }
];

const roundOne = [
  { href: '/helix', name: 'Helix', summary: 'Receipt spine timeline.' },
  { href: '/loop', name: 'Loop', summary: 'Poster typography, sticky window.' },
  { href: '/plane', name: 'Plane', summary: 'Isometric drafting table.' },
  { href: '/split', name: 'Split', summary: 'You / Stacktape ledger.' },
  { href: '/transit', name: 'Transit', summary: 'Ops board and transit map.' }
];
---

<BaseLayout title="Stacktape homepage studies" description="Homepage directions for stacktape.com.">
  <main style="max-width: 720px; margin: 0 auto; padding: 72px 24px; font-family: system-ui, sans-serif;">
    <Logo height={28} />
    <h1 style="font-size: 1.6rem; margin: 32px 0 8px;">Homepage studies</h1>
    <p style="color: var(--stp-text-muted); margin: 0 0 24px;">
      The README concept from round 7 is the homepage at <a href="/" style="color: var(--stp-color-brand);">/</a>. The
      other round 7 concepts, each a different idea of what the page is, and the earlier rounds are below.
    </p>
    <ol style="list-style: none; padding: 0; margin: 0 0 40px; display: grid; gap: 14px;">
      {
        roundSeven.map((study) => (
          <li>
            <a
              href={study.href}
              style="display: block; padding: 18px 20px; border: 1px solid var(--stp-border-subtle); border-radius: 8px; color: inherit; text-decoration: none; background: var(--stp-surface-element);"
            >
              <strong style="display: block; font-size: 1.05rem; margin-bottom: 4px;">{study.name}</strong>
              <span style="color: var(--stp-text-muted); font-size: 0.95rem;">{study.summary}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <h2 style="font-size: 1.1rem; margin: 0 0 12px; color: var(--stp-text-muted);">Round 6</h2>
    <ol style="list-style: none; padding: 0; margin: 0 0 40px; display: grid; gap: 14px;">
      {
        roundSix.map((study) => (
          <li>
            <a
              href={study.href}
              style="display: block; padding: 18px 20px; border: 1px solid var(--stp-border-subtle); border-radius: 8px; color: inherit; text-decoration: none; background: var(--stp-surface-element);"
            >
              <strong style="display: block; font-size: 1.05rem; margin-bottom: 4px;">{study.name}</strong>
              <span style="color: var(--stp-text-muted); font-size: 0.95rem;">{study.summary}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <h2 style="font-size: 1.1rem; margin: 0 0 12px; color: var(--stp-text-muted);">Round 5</h2>
    <ol style="list-style: none; padding: 0; margin: 0 0 40px; display: grid; gap: 14px;">
      {
        roundFive.map((study) => (
          <li>
            <a
              href={study.href}
              style="display: block; padding: 18px 20px; border: 1px solid var(--stp-border-subtle); border-radius: 8px; color: inherit; text-decoration: none; background: var(--stp-surface-element);"
            >
              <strong style="display: block; font-size: 1.05rem; margin-bottom: 4px;">{study.name}</strong>
              <span style="color: var(--stp-text-muted); font-size: 0.95rem;">{study.summary}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <h2 style="font-size: 1.1rem; margin: 0 0 12px; color: var(--stp-text-muted);">Round 4</h2>
    <ol style="list-style: none; padding: 0; margin: 0 0 40px; display: grid; gap: 14px;">
      {
        roundThree.map((study) => (
          <li>
            <a
              href={study.href}
              style="display: block; padding: 18px 20px; border: 1px solid var(--stp-border-subtle); border-radius: 8px; color: inherit; text-decoration: none; background: var(--stp-surface-element);"
            >
              <strong style="display: block; font-size: 1.05rem; margin-bottom: 4px;">{study.name}</strong>
              <span style="color: var(--stp-text-muted); font-size: 0.95rem;">{study.summary}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <h2 style="font-size: 1.1rem; margin: 0 0 12px; color: var(--stp-text-muted);">Round 2</h2>
    <ul style="list-style: none; padding: 0; margin: 0 0 32px; display: flex; flex-wrap: wrap; gap: 10px;">
      {
        roundTwo.map((study) => (
          <li>
            <a href={study.href} title={study.summary} style="display: inline-block; padding: 8px 14px; border: 1px solid var(--stp-border-subtle); border-radius: 999px; color: var(--stp-text-muted); text-decoration: none; font-size: 0.9rem;">{study.name}</a>
          </li>
        ))
      }
    </ul>
    <h2 style="font-size: 1.1rem; margin: 0 0 12px; color: var(--stp-text-muted);">Round 1</h2>
    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px;">
      {
        roundOne.map((study) => (
          <li>
            <a
              href={study.href}
              title={study.summary}
              style="display: inline-block; padding: 8px 14px; border: 1px solid var(--stp-border-subtle); border-radius: 999px; color: var(--stp-text-muted); text-decoration: none; font-size: 0.9rem;"
            >
              {study.name}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
