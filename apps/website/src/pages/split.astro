---
// concept: One persistent vertical split — what you do on the left, what Stacktape does on the right — with the customer journey running down the seam as a ledger of paired moments and running counters for both sides.
// copy-angle: Direction A made structural; the automation claim is played hard through itemised evidence in the right column, while every deploy and fix visibly waits for a human merge or approval and the remediation switch stays off.
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCta from '../variants/split/ClosingCta.astro';
import ColumnHeaders from '../variants/split/ColumnHeaders.astro';
import { HEADLINE } from '../variants/split/data';
import Hero from '../variants/split/Hero.astro';
import Journey from '../variants/split/Journey.astro';
import SiteFooter from '../variants/split/SiteFooter.astro';
import SiteNav from '../variants/split/SiteNav.astro';
import Testimonials from '../variants/split/Testimonials.astro';
import '../variants/split/split.css';
---

<BaseLayout
  title={`Stacktape — ${HEADLINE}`}
  description="Stacktape reads your repository, designs production-grade infrastructure, and deploys and operates it in your own AWS account. From the first deploy to a production incident, your developers stay in control."
  htmlClass="sp-html"
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,400..600,50;1,9..144,400..600,50&family=Manrope:wght@400;500;600&family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('sp-js');
    </script>
  </Fragment>
  <div class="sp-root">
    <SiteNav />
    <ColumnHeaders />
    <main>
      <Hero />
      <Journey />
      <Testimonials />
      <ClosingCta />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
