---
// concept: One picture of your app, from the first command to the monthly bill. The architecture diagram of acme-project stays pinned on the right as a stage; each of the six surfaces scrolling past on the left changes what the stage shows, so the visitor watches the whole DevOps job happen to one app.
// copy-angle: The headline states the promise, the six surfaces name what Stacktape does in the third person, and the stage proves each one on the same model; the visitor's own actions are marked only by the pointer resting on the control they press.
import BaseLayout from '../layouts/BaseLayout.astro';
import { HEADLINE, SUBHEADLINE } from '../variants/stage/data';
import Footer from '../variants/stage/Footer.astro';
import Journey from '../variants/stage/Journey.astro';
import Nav from '../variants/stage/Nav.astro';
import Testimonials from '../variants/stage/Testimonials.astro';
import '../variants/stage/stage.css';
---

<BaseLayout title={`Stacktape — ${HEADLINE}`} description={SUBHEADLINE} htmlClass="sg-html">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
    />
  </Fragment>

  <div class="sg-root">
    <Nav />
    <main>
      <Journey />
      <Testimonials />
    </main>
    <Footer />
  </div>
</BaseLayout>
