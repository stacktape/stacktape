---
import PlainPage from '../components/PlainPage.astro';
import privacy from '../content/legal/privacy-policy.html?raw';
import terms from '../content/legal/terms-of-use.html?raw';

export const getStaticPaths = () => [
  {
    params: { legal: 'privacy-policy' },
    props: {
      title: 'Privacy policy',
      description:
        'What the Stacktape CLI sends, what a connected Console stores, what stays in your AWS account, which providers we use and how to request deletion.',
      body: privacy
    }
  },
  {
    params: { legal: 'terms-of-use' },
    props: {
      title: 'Terms of use',
      description:
        'The Stacktape CLI is covered by its MIT license. These terms cover the hosted Stacktape Console: accounts, plans, fees, acceptable use and cancelling.',
      body: terms
    }
  }
];

const { title, description, body } = Astro.props;
---

<PlainPage {title} {description}>
  <Fragment set:html={body} />
</PlainPage>
