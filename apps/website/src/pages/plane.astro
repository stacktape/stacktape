---
// concept: A drafting table — an isometric dotted ground plane on which the real architecture diagram is drawn in the hero, and a path runs from "your repository" to "production" with a standing product-preview billboard at every station.
// copy-angle: "AWS DevOps, fully automated": the automation claim is stated plainly in the headline and then proven stop by stop, with the wizard's read→found→decided→drew trail making the generated configuration visible, and agent remediation shown as an opt-in switch that is off.
import BaseLayout from '../layouts/BaseLayout.astro';
import Closing from '../variants/plane/Closing.astro';
import Footer from '../variants/plane/Footer.astro';
import Hero from '../variants/plane/Hero.astro';
import Journey from '../variants/plane/Journey.astro';
import Nav from '../variants/plane/Nav.astro';
import Testimonials from '../variants/plane/Testimonials.astro';
import '../variants/plane/plane.css';
---

<BaseLayout
  title="Stacktape — AWS DevOps, fully automated"
  description="Stacktape reads your repository, designs production-grade AWS infrastructure and runs deployments and operations in your own AWS account."
>
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
    />
  </Fragment>
  <script is:inline>
    document.documentElement.classList.add('pl-js');
  </script>
  <div class="pl-root">
    <Nav />
    <main>
      <Hero />
      <Journey />
      <Testimonials />
      <Closing />
    </main>
    <Footer />
  </div>
</BaseLayout>
