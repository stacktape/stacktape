---
// concept: A centered, confident hero over a faint infrastructure-grid backdrop, with the copyable command as the visual anchor and a slim animated "day 0 → day 1" flow strip beneath it.
// copy-angle: Lead with "AWS DevOps, fully automated" stated plainly; play the AI agent boldly but honestly — a single line that it can auto-resolve incidents, framed as opt-in ("you stay in control").
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import { CtaCommand } from '../../components/CtaCommand';
import { getSnippet } from '../../lib/snippets/snippets';

const snippet = await getSnippet('nextjs-postgres');
---

<BaseLayout
  title="Stacktape — AWS DevOps, fully automated"
  description="Describe your application in one config file. Stacktape compiles it to CloudFormation, deploys it into your own AWS account, and runs the ops: observability, CI/CD, costs, and incident resolution."
  font="geist"
  noindex
>
  <div class="page">
    <header class="nav">
      <a class="brand" href="/" aria-label="Stacktape home">
        <Logo height={26} />
      </a>
      <nav class="nav-links" aria-label="Main">
        <a href="https://docs.stacktape.com">Docs</a>
        <a href="https://github.com/stacktape/stacktape">GitHub</a>
        <a href="https://console.stacktape.com/sign-up" class="nav-cta">Sign up</a>
      </nav>
    </header>

    <section class="hero">
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>

      <p class="eyebrow">
        <span class="pulse-dot" aria-hidden="true"></span>
        Your AWS account. Plain CloudFormation. No lock-in.
      </p>

      <h1 class="headline">
        AWS DevOps, <span class="accent">fully automated</span>.
      </h1>

      <p class="sub">
        Describe your application in one config file — Stacktape's AI wizard writes it for you, compiles it to
        CloudFormation, and deploys it into your own AWS account. Then it runs the ops: metrics, traces, logs, CI/CD,
        costs, and incidents — with an agent that can resolve them when you let it.
      </p>

      <div class="cta-row">
        <div class="command-wrap">
          <CtaCommand client:visible defaultMethod="npx" className="cta-command" />
        </div>
        <div class="secondary-col">
          <a class="btn-primary" href="https://console.stacktape.com/sign-up">Deploy in Console</a>
          <a class="btn-ghost" href="https://cal.com/stacktape/30min">Book a demo</a>
        </div>
      </div>

      <p class="fine-print">
        Open-source CLI · Runs in <em>your</em> AWS account · The agent is opt-in — you approve every fix.
      </p>

      <div class="flow" aria-label="How Stacktape works">
        <div class="flow-step">
          <span class="flow-num">01</span>
          <div class="flow-body">
            <h3>Configure</h3>
            <p><code>npx stacktape init</code> reads your repo and generates the config.</p>
          </div>
        </div>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <div class="flow-step">
          <span class="flow-num">02</span>
          <div class="flow-body">
            <h3>Deploy</h3>
            <p>Compiled to CloudFormation. VPCs, private services, GPU &amp; Spot if you need them.</p>
          </div>
        </div>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <div class="flow-step">
          <span class="flow-num">03</span>
          <div class="flow-body">
            <h3>Operate</h3>
            <p>Observability, CI/CD, costs, RBAC &amp; guardrails — and incidents an agent can fix.</p>
          </div>
        </div>
      </div>

      <details class="peek">
        <summary>See what the config looks like</summary>
        <div class="peek-code" data-code>
          <Fragment set:html={snippet.typescript?.html ?? snippet.yaml.html} />
        </div>
      </details>
    </section>
  </div>
</BaseLayout>

<style>
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
  position: relative;
}

/* ---------- nav ---------- */
.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22px 0;
  position: relative;
  z-index: 2;
}
.nav-links {
  display: flex;
  align-items: center;
  gap: 26px;
  font-size: 14px;
}
.nav-links a {
  color: var(--stp-text-muted);
  text-decoration: none;
  transition: color var(--stp-motion-duration-fast) var(--stp-motion-easing);
}
.nav-links a:hover {
  color: var(--stp-text-primary);
}
.nav-cta {
  padding: 7px 16px;
  border: 1px solid var(--stp-border-subtle);
  border-radius: var(--stp-radius-medium);
  background: var(--stp-surface-element);
  color: var(--stp-text-primary) !important;
}
.nav-cta:hover {
  border-color: var(--stp-color-brand);
}

/* ---------- hero ---------- */
.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 72px 0 64px;
  position: relative;
  z-index: 1;
}

.grid-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--stp-border-subtle) 1px, transparent 1px),
    linear-gradient(90deg, var(--stp-border-subtle) 1px, transparent 1px);
  background-size: 56px 56px;
  opacity: 0.28;
  -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 32%, #000 20%, transparent 75%);
  mask-image: radial-gradient(ellipse 75% 60% at 50% 32%, #000 20%, transparent 75%);
  pointer-events: none;
}

.glow {
  position: absolute;
  top: -160px;
  left: 50%;
  transform: translateX(-50%);
  width: 900px;
  height: 480px;
  background: radial-gradient(ellipse at center, rgba(54, 190, 190, 0.14), transparent 65%);
  pointer-events: none;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-size: 13px;
  letter-spacing: 0.02em;
  color: var(--stp-text-secondary);
  background: rgba(54, 190, 190, 0.07);
  border: 1px solid rgba(54, 190, 190, 0.22);
  border-radius: 999px;
  padding: 6px 16px;
  margin-bottom: 30px;
}
.pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--stp-color-brand);
  box-shadow: 0 0 0 0 rgba(54, 190, 190, 0.5);
  animation: pulse 2.4s infinite;
}
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(54, 190, 190, 0.45); }
  70% { box-shadow: 0 0 0 8px rgba(54, 190, 190, 0); }
  100% { box-shadow: 0 0 0 0 rgba(54, 190, 190, 0); }
}

.headline {
  font-size: clamp(44px, 6vw, 76px);
  line-height: 1.04;
  font-weight: 600;
  letter-spacing: -0.03em;
  color: var(--stp-text-primary);
  margin: 0 0 26px;
  max-width: 850px;
}
.accent {
  color: var(--stp-color-brand);
}

.sub {
  font-size: 19px;
  line-height: 1.65;
  color: var(--stp-text-muted);
  max-width: 680px;
  margin: 0 0 40px;
}

/* ---------- CTAs ---------- */
.cta-row {
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 18px;
  flex-wrap: wrap;
  width: 100%;
}
.command-wrap {
  flex: 0 1 560px;
  min-width: 320px;
  display: flex;
}
:global(.cta-command) {
  width: 100%;
}
.secondary-col {
  display: flex;
  gap: 12px;
  align-items: stretch;
}
.btn-primary {
  display: inline-flex;
  align-items: center;
  padding: 0 26px;
  border-radius: var(--stp-radius-large);
  background: var(--stp-color-brand);
  color: rgb(10, 26, 26);
  font-weight: 600;
  font-size: 15px;
  text-decoration: none;
  transition: filter var(--stp-motion-duration-fast) var(--stp-motion-easing);
}
.btn-primary:hover {
  filter: brightness(1.1);
}
.btn-ghost {
  display: inline-flex;
  align-items: center;
  padding: 0 26px;
  border-radius: var(--stp-radius-large);
  border: 1px solid var(--stp-border-subtle);
  background: var(--stp-surface-element);
  color: var(--stp-text-primary);
  font-size: 15px;
  text-decoration: none;
  transition: border-color var(--stp-motion-duration-fast) var(--stp-motion-easing);
}
.btn-ghost:hover {
  border-color: var(--stp-color-brand);
}

.fine-print {
  margin: 22px 0 0;
  font-size: 13.5px;
  color: var(--stp-text-faint);
}
.fine-print em {
  color: var(--stp-text-subtle);
  font-style: normal;
}

/* ---------- flow strip ---------- */
.flow {
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 14px;
  margin-top: 64px;
  width: 100%;
  flex-wrap: wrap;
}
.flow-step {
  flex: 1 1 240px;
  max-width: 330px;
  text-align: left;
  background: var(--stp-surface-element);
  border: 1px solid var(--stp-border-subtle);
  border-radius: var(--stp-radius-large);
  padding: 20px 22px;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
}
.flow-num {
  font-family: var(--font-geist-mono);
  font-size: 12px;
  color: var(--stp-color-brand);
  letter-spacing: 0.08em;
}
.flow-body h3 {
  margin: 8px 0 6px;
  font-size: 16px;
  color: var(--stp-text-primary);
  font-weight: 600;
}
.flow-body p {
  margin: 0;
  font-size: 13.5px;
  line-height: 1.55;
  color: var(--stp-text-muted);
}
.flow-body code {
  font-family: var(--font-geist-mono);
  font-size: 12px;
  color: var(--stp-text-secondary);
  background: var(--stp-surface-input);
  padding: 1px 5px;
  border-radius: var(--stp-radius-small);
}
.flow-arrow {
  align-self: center;
  color: var(--stp-color-brand);
  font-size: 20px;
  opacity: 0.7;
}
@media (max-width: 900px) {
  .flow-arrow { display: none; }
  .flow-step { flex: 1 1 100%; max-width: 480px; }
}

/* ---------- config peek ---------- */
.peek {
  margin-top: 34px;
  width: 100%;
  max-width: 760px;
  border: 1px solid var(--stp-border-subtle);
  border-radius: var(--stp-radius-large);
  background: var(--stp-surface-element);
  overflow: hidden;
  text-align: left;
}
.peek summary {
  cursor: pointer;
  list-style: none;
  padding: 13px 20px;
  font-size: 13.5px;
  color: var(--stp-text-secondary);
  user-select: none;
}
.peek summary::-webkit-details-marker { display: none; }
.peek summary::before {
  content: "▸ ";
  color: var(--stp-color-brand);
}
.peek[open] summary::before { content: "▾ "; }
.peek-code {
  border-top: 1px solid var(--stp-border-subtle);
  background: var(--stp-surface-input);
  padding: 18px 20px;
  overflow-x: auto;
  max-height: 340px;
  font-size: 13px;
  line-height: 1.6;
}
.peek-code :global(pre) {
  margin: 0;
}

@media (prefers-reduced-motion: reduce) {
  .pulse-dot { animation: none; }
}
</style>
