---
// concept: Blueprint hero — the real isometric architecture diagram (VPC, private subnets, Aurora, Fargate, Lambda, CDN) dominates the right two-thirds inside a drafting-table panel with a faint grid; the copy sits top-left like a title block on an engineering drawing.
// copy-angle: Conservative, enterprise-depth — "AWS DevOps, automated. Not simplified.": the automation claim stated plainly, then immediately backed by the seriousness of what gets built; the AI-fix story is a footnote, human approval is foregrounded.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import { CtaCommand } from '../../components/CtaCommand';
import DiagramIsland from '../../surfaces/InitWizardRun/DiagramIsland.tsx';
import { ACME_DIAGRAM_CONFIG } from '../../surfaces/InitWizardRun/acme-config.ts';

const specs = [
  ['Network', 'VPC across two availability zones, private subnets, bastion on demand'],
  ['Compute', 'Fargate services, Lambda functions, GPU and Spot batch jobs'],
  ['Data', 'Aurora PostgreSQL, Redis, S3 — encrypted, backed up, reachable only from inside'],
  ['Access', 'Least-privilege IAM per resource, SSO and roles for people'],
  ['Output', 'Plain CloudFormation in your account — read it, diff it, keep it']
];
---

<BaseLayout
  title="AWS DevOps, automated. Not simplified. — Stacktape"
  description="Stacktape generates the AWS architecture a senior team would design — private networking, least-privilege IAM, managed data — from your repository, deploys it into your own account as plain CloudFormation, and runs it."
  font="geist"
  noindex
>
  <header class="nav">
    <a href="/" aria-label="Stacktape home"><Logo height={22} /></a>
    <nav>
      <a href="https://docs.stacktape.com">Docs</a>
      <a href="https://github.com/stacktape/stacktape">GitHub</a>
      <a class="nav-cta" href="https://console.stacktape.com/sign-up">Sign up</a>
    </nav>
  </header>

  <main class="hero">
    <div class="copy">
      <p class="eyebrow">Sheet 01 · Infrastructure, generated</p>
      <h1>AWS DevOps, automated.<br /><span class="muted">Not simplified.</span></h1>
      <p class="sub">
        Real VPCs and private subnets. Least-privilege IAM. Load balancers, Aurora, queues, GPU jobs. The architecture
        a senior team would design — generated from your repository, deployed into your own AWS account as plain
        CloudFormation, then operated for you: pipelines, monitoring, alarms, incidents. Every decision explained.
        Every change yours to approve.
      </p>

      <div class="ctas">
        <CtaCommand client:visible defaultMethod="npx" />
        <div class="ctas-row">
          <a class="btn-primary" href="https://console.stacktape.com/sign-up">Sign up</a>
          <a class="btn-quiet" href="https://cal.com/stacktape/30min">Book a demo <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <dl class="specs">
        {specs.map(([k, v], i) => (
          <div class="spec" style={`--i: ${i}`}>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <section class="sheet" aria-label="The generated AWS architecture for acme-project, drawn as an isometric diagram">
      <div class="sheet-head">
        <p class="sheet-title">acme-project <span class="dim">/ production / eu-west-1</span></p>
        <p class="sheet-meta">33 CloudFormation resources · drawn by the wizard from the repository</p>
      </div>
      <div class="canvas">
        <DiagramIsland client:only="react" config={ACME_DIAGRAM_CONFIG} ariaLabel="Isometric diagram of the generated architecture: a VPC with public and private subnets, a Next.js site behind a CDN, a Fargate API, a Lambda worker, Aurora PostgreSQL, Redis and a web application firewall" />
      </div>
      <ul class="stamps" aria-label="Properties of the generated architecture">
        <li style="--i: 0">2 availability zones</li>
        <li style="--i: 1">private subnets</li>
        <li style="--i: 2">least-privilege IAM</li>
        <li style="--i: 3">encrypted at rest</li>
        <li style="--i: 4">plain CloudFormation</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  :root {
    --ink: var(--stp-text-primary);
    --ink-2: rgb(196, 204, 204);
    --ink-3: rgb(138, 148, 148);
    --line: rgba(255, 255, 255, 0.07);
    --brand: var(--stp-color-brand);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1320px;
    margin: 0 auto;
    padding: 22px 28px;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .nav a {
    color: var(--ink-2);
    font-size: 0.92rem;
    text-decoration: none;
  }
  .nav a:hover {
    color: var(--ink);
  }
  .nav-cta {
    padding: 8px 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    color: var(--ink) !important;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(360px, 0.78fr) minmax(0, 1.22fr);
    gap: 48px;
    align-items: start;
    max-width: 1320px;
    margin: 0 auto;
    padding: 40px 28px 100px;
  }
  .copy {
    padding-top: 22px;
  }
  .eyebrow {
    margin: 0 0 18px;
    color: var(--brand);
    font-family: var(--font-geist-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 3.9vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: var(--ink);
  }
  .muted {
    color: var(--ink-3);
  }
  .sub {
    margin: 22px 0 0;
    color: var(--ink-2);
    font-size: 1.02rem;
    line-height: 1.62;
  }
  .ctas {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    margin-top: 30px;
  }
  .ctas-row {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .btn-primary {
    padding: 12px 22px;
    border-radius: 10px;
    background: var(--brand);
    color: rgb(8, 20, 20);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 8px 28px rgba(54, 190, 190, 0.26);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 34px rgba(54, 190, 190, 0.34);
  }
  .btn-quiet {
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }
  .btn-quiet:hover {
    color: var(--ink);
  }

  .specs {
    margin: 36px 0 0;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }
  .spec {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr);
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .spec dt {
    color: var(--ink-3);
    font-family: var(--font-geist-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-top: 3px;
  }
  .spec dd {
    margin: 0;
    color: var(--ink-2);
  }

  /* ── The drawing sheet ────────────────────────────────────────────── */
  .sheet {
    position: relative;
    padding: 20px 22px 18px;
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.015)),
      var(--stp-surface-page);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 30px 80px rgba(0, 0, 0, 0.45),
      0 0 140px rgba(54, 190, 190, 0.07);
    overflow: hidden;
  }
  .sheet::before {
    /* Drafting-paper grid, kept far below the diagram's own contrast. */
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(70% 70% at 50% 50%, #000 40%, transparent 100%);
    mask-image: radial-gradient(70% 70% at 50% 50%, #000 40%, transparent 100%);
    pointer-events: none;
  }
  .sheet-head {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .sheet-title {
    flex: none;
    margin: 0;
    font-family: var(--font-geist-mono);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }
  .dim {
    color: var(--ink-3);
    font-weight: 400;
  }
  .sheet-meta {
    margin: 0;
    color: var(--ink-3);
    font-size: 0.8rem;
  }
  .canvas {
    /* client:only renders nothing on the server; the sheet must not collapse before hydration. */
    position: relative;
    height: clamp(24rem, 40vw, 34rem);
    margin-top: 8px;
  }
  .stamps {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 6px 0 0;
    padding: 12px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .stamps li {
    padding: 5px 10px;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px rgba(54, 190, 190, 0.35);
    color: var(--brand);
    font-family: var(--font-geist-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sheet {
      opacity: 0;
      transform: translateY(10px);
      animation: arrive 700ms cubic-bezier(0.2, 0.8, 0.2, 1) 200ms forwards;
    }
    .stamps li {
      opacity: 0;
      animation: arrive 420ms ease forwards;
      animation-delay: calc(1400ms + var(--i) * 140ms);
    }
    .spec {
      opacity: 0;
      animation: arrive 420ms ease forwards;
      animation-delay: calc(600ms + var(--i) * 90ms);
    }
  }
  @keyframes arrive {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1040px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
