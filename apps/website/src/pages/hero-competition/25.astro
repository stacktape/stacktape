</style>

<script>
// Commands map for CLI switch
  const commands: Record<string, string> = {
    npx: 'npx stacktape init',
    macos: 'curl -L https://installs.stacktape.com/macos.sh | sh',
    linux: 'curl -L https://installs.stacktape.com/linux.sh | sh',
    win: 'iwr https://installs.stacktape.com/windows.ps1 -useb | iex'
  };

  // CLI Tabs Handling
  const cliTabButtons = document.querySelectorAll<HTMLButtonElement>('.cli-tab-btn');
  const cliText = document.getElementById('cli-command-text');
  const copyBtn = document.getElementById('copy-btn');
  const copyLabel = document.getElementById('copy-label');

  let currentCmd = 'npx stacktape init';

  cliTabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-cmd') || 'npx';
      cliTabButtons.forEach((b) => b.classList.remove('active', 'text-emerald-400', 'bg-white/10'));
      btn.classList.add('active', 'text-emerald-400', 'bg-white/10');
      
      currentCmd = commands[type] || commands.npx;
      if (cliText) {
        cliText.textContent = currentCmd;
      }
    });
  });

  // Copy Button Handling
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(currentCmd);
        if (copyLabel) copyLabel.textContent = 'Copied!';
        copyBtn.classList.add('bg-emerald-500/20', 'border-emerald-500/40', 'text-emerald-300');
        
        setTimeout(() => {
          if (copyLabel) copyLabel.textContent = 'Copy';
          copyBtn.classList.remove('bg-emerald-500/20', 'border-emerald-500/40', 'text-emerald-300');
        }, 2000);
      } catch (e) {
        if (copyLabel) copyLabel.textContent = 'Copied!';
      }
    });
  }

  // Interactive Engine Stage Selector Handling
  const stageButtons = document.querySelectorAll<HTMLButtonElement>('.stage-nav-btn');
  const panels = [
    document.getElementById('panel-stage-0'),
    document.getElementById('panel-stage-1'),
    document.getElementById('panel-stage-2')
  ];

  function setStage(index: number) {
    stageButtons.forEach((b, idx) => {
      if (idx === index) {
        b.classList.add('active');
        b.classList.remove('text-slate-400');
      } else {
        b.classList.remove('active');
        b.classList.add('text-slate-400');
      }
    });

    panels.forEach((p, idx) => {
      if (p) {
        if (idx === index) {
          p.classList.remove('hidden');
          p.classList.add('block');
        } else {
          p.classList.add('hidden');
          p.classList.remove('block');
        }
      }
    });
  }

  stageButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const stageIdx = parseInt(btn.getAttribute('data-stage') || '0', 10);
      setStage(stageIdx);
    });
  });

  // Action link trigger inside Stage 0
  const nextStageTrigger = document.querySelector('[data-action="next-stage"]');
  if (nextStageTrigger) {
    nextStageTrigger.addEventListener('click', () => {
      setStage(1);
    });
  }

  // Auto-Fix Button Interaction Simulation
  const applyFixBtn = document.getElementById('apply-fix-btn');
  const actionBox = document.getElementById('agent-action-box');
  if (applyFixBtn && actionBox) {
    applyFixBtn.addEventListener('click', () => {
      actionBox.innerHTML = `
        <div class="w-full p-2.5 rounded bg-emerald-950/40 border border-emerald-500/30 text-emerald-300 text-xs font-mono flex items-center justify-between animate-fadeIn">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Fix applied &amp; deployed: Pool scaled, 0 errors.
          </span>
          <span class="text-emerald-400 text-[10px]">Healthy</span>
        </div>
      `;
    });
  }
</script>
