<script>
  /*
   * The rail reads left to right on its own, one station at a time, so the eye is walked through the
   * lifecycle instead of being handed seven cards at once. Pointing at a station takes over; moving
   * away hands it back. With reduced motion the walk never starts and the drafted fix — the end of
   * the story and the point of the section — is the one that stays lit.
   */
  const track = document.getElementById('rail-track');

  if (track) {
    const stations = Array.from(track.querySelectorAll('.station'));
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const light = (index: number) => {
      stations.forEach((station, position) => station.classList.toggle('is-active', position === index));
    };

    if (prefersReduced.matches) {
      light(stations.length - 2);
    } else {
      let current = 0;
      let held = false;

      light(current);

      window.setInterval(() => {
        if (held || document.visibilityState !== 'visible') return;
        current = (current + 1) % stations.length;
        light(current);
      }, 2400);

      stations.forEach((station, position) => {
        station.addEventListener('pointerenter', () => {
          held = true;
          current = position;
          light(position);
        });
      });

      track.addEventListener('pointerleave', () => {
        held = false;
      });
    }
  }
</script>
