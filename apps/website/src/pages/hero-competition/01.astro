---
// concept: An editorial split headline (huge type left, argument + CTAs right) sitting above one full-width "architecture desk" — a wide panel where the isometric diagram of a real generated stack is framed by a Day 0 → Day 1 status ribbon, with the copyable install command docked to its bottom edge like a console footer.
// copy-angle: Name the automation plainly and play the AI agent with confident specificity — "it sees everything, so it fixes things better" — grounded immediately by the opt-in gate ("nothing ships without your approval"), positioned as earned capability rather than magic.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import DiagramIsland from '../../surfaces/InitWizardRun/DiagramIsland.tsx';
import { ACME_DIAGRAM_CONFIG } from '../../surfaces/InitWizardRun/acme-config.ts';
---

<BaseLayout
  title="Stacktape — AWS DevOps, fully automated"
  description="Describe your application in one config file. Stacktape compiles it to CloudFormation, deploys it into your own AWS account, and runs the ops — observability, CI/CD, costs, incidents."
  font="geist"
  noindex
>
  <nav class="nav">
    <a class="nav-brand" href="/" aria-label="Stacktape home">
      <Logo height={26} />
    </a>
    <div class="nav-links">
      <a href="https://docs.stacktape.com" class="nav-link">Docs</a>
      <a href="https://github.com/stacktape/stacktape" class="nav-link">GitHub</a>
      <a href="https://cal.com/stacktape/30min" class="nav-link nav-link-ghost">Book a demo</a>
      <a href="https://console.stacktape.com/sign-up" class="nav-link nav-link-cta">Sign up</a>
    </div>
  </nav>

  <header class="hero">
    <div class="hero-grid">
      <div class="hero-left">
        <p class="kicker">
          <span class="kicker-dot" aria-hidden="true"></span>
          Open-source infra framework · your AWS account
        </p>
        <h1 class="headline">
          AWS DevOps,<br />
          <span class="headline-em">fully automated.</span>
        </h1>
      </div>

      <div class="hero-right">
        <p class="sub">
          One config file describes your whole application. Stacktape compiles it to CloudFormation, deploys it, and
          then runs the day-to-day — metrics, traces, logs, CI/CD, costs — with the discipline of a good DevOps
          team, on tap.
        </p>
        <p class="sub sub-agent">
          When something breaks, an agent can resolve the incident. It has the whole picture — your infrastructure,
          your releases, your observability — so its fixes land far more often. Nothing ships without your approval.
        </p>

        <div class="cta-row">
          <a href="https://console.stacktape.com/sign-up" class="btn btn-primary">Deploy in Console</a>
          <a href="https://cal.com/stacktape/30min" class="btn btn-secondary">Book a demo</a>
        </div>
      </div>
    </div>

    <figure class="desk" aria-label="Isometric architecture diagram of a stack generated by Stacktape">
      <div class="desk-ribbon" aria-hidden="true">
        <span class="ribbon-step ribbon-done">
          <span class="ribbon-tick">✓</span> Day 0 · config generated
        </span>
        <span class="ribbon-line"></span>
        <span class="ribbon-step ribbon-done">
          <span class="ribbon-tick">✓</span> compiled to CloudFormation
        </span>
        <span class="ribbon-line"></span>
        <span class="ribbon-step ribbon-live">
          <span class="ribbon-pulse"></span> Day 1 · deployed, observed, on budget
        </span>
      </div>

      <div class="desk-stage">
        <DiagramIsland
          client:only="react"
          config={ACME_DIAGRAM_CONFIG}
          ariaLabel="Architecture diagram of an application stack generated by Stacktape"
        />
      </div>

      <figcaption class="desk-caption">
        Generated from a single config file · editable, versioned, yours — plain CloudFormation underneath
      </figcaption>
    </figure>

    <div class="command-dock" data-command-dock>
      <div class="dock-tabs" role="tablist" aria-label="Installation method">
        <button class="dock-tab is-active" role="tab" aria-selected="true" data-method="npx">npx</button>
        <button class="dock-tab" role="tab" aria-selected="false" data-method="macos">macOS</button>
        <button class="dock-tab" role="tab" aria-selected="false" data-method="linux">Linux</button>
        <button class="dock-tab" role="tab" aria-selected="false" data-method="windows">Windows</button>
      </div>
      <div class="dock-body">
        <span class="dock-prompt" aria-hidden="true">$</span>
        <code class="dock-command" data-command-text>npx stacktape init</code>
        <button class="dock-copy" data-copy-button aria-label="Copy command">
          <span class="dock-copy-label">Copy</span>
        </button>
      </div>
      <p class="dock-hint">Opens the AI wizard — it reads your repo and writes your Stacktape config.</p>
    </div>
  </header>
</BaseLayout>

<style>
:global(html),
:global(body) {
  background: var(--stp-surface-page);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1200px;
  margin: 0 auto;
  padding: 22px 32px;
}

.nav-brand {
  display: flex;
  align-items: center;
  text-decoration: none;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 6px;
}

.nav-link {
  font-family: var(--font-geist);
  font-size: 13.5px;
  color: var(--stp-text-muted);
  text-decoration: none;
  padding: 7px 12px;
  border-radius: var(--stp-radius-medium);
  transition: color var(--stp-motion-duration-fast) var(--stp-motion-easing),
    background-color var(--stp-motion-duration-fast) var(--stp-motion-easing);
}

.nav-link:hover {
  color: var(--stp-text-primary);
  background: var(--stp-surface-element);
}

.nav-link-ghost {
  color: var(--stp-text-primary);
}

.nav-link-cta {
  color: var(--stp-color-brand);
  border: 1px solid rgb(54, 190, 190, 0.28);
  background: rgb(54, 190, 190, 0.07);
  margin-left: 8px;
}

.nav-link-cta:hover {
  background: rgb(54, 190, 190, 0.14);
  color: var(--stp-color-brand);
}

.hero {
  max-width: 1200px;
  margin: 0 auto;
  padding: 72px 32px 96px;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  gap: 64px;
  align-items: start;
}

.kicker {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-geist-mono);
  font-size: 12px;
  letter-spacing: 0.04em;
  color: var(--stp-text-faint);
  margin: 0 0 28px;
}

.kicker-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--stp-color-brand);
  box-shadow: 0 0 10px rgba(54, 190, 190, 0.8);
}

.headline {
  font-family: var(--font-geist);
  font-weight: 560;
  font-size: clamp(46px, 5.6vw, 74px);
  line-height: 1.02;
  letter-spacing: -0.035em;
  color: var(--stp-text-primary);
  margin: 0;
}

.headline-em {
  color: var(--stp-color-brand);
}

.hero-right {
  padding-top: 12px;
}

.sub {
  font-family: var(--font-geist);
  font-size: 16.5px;
  line-height: 1.65;
  color: var(--stp-text-muted);
  margin: 0 0 18px;
}

.sub-agent {
  padding-left: 16px;
  border-left: 2px solid rgba(54, 190, 190, 0.35);
  color: var(--stp-text-subtle);
  font-size: 15.5px;
}

.cta-row {
  display: flex;
  gap: 12px;
  margin-top: 28px;
  flex-wrap: wrap;
}

.btn {
  font-family: var(--font-geist);
  font-size: 14.5px;
  font-weight: 500;
  text-decoration: none;
  padding: 11px 22px;
  border-radius: var(--stp-radius-large);
  transition: transform var(--stp-motion-duration-fast) var(--stp-motion-easing),
    box-shadow var(--stp-motion-duration-fast) var(--stp-motion-easing),
    background-color var(--stp-motion-duration-fast) var(--stp-motion-easing);
}

.btn-primary {
  color: #0b1a1a;
  background: var(--stp-color-brand);
}

.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 24px rgba(54, 190, 190, 0.25);
}

.btn-secondary {
  color: var(--stp-text-primary);
  background: var(--stp-surface-element);
  border: 1px solid var(--stp-border-subtle);
}

.btn-secondary:hover {
  background: rgb(44, 51, 51);
}

.desk {
  margin: 72px 0 0;
  border: 1px solid var(--stp-border-subtle);
  border-radius: var(--stp-radius-large);
  background:
    radial-gradient(120% 90% at 50% 0%, rgba(54, 190, 190, 0.06), transparent 55%),
    var(--stp-surface-element);
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
  overflow: hidden;
}

.desk-ribbon {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 13px 22px;
  border-bottom: 1px solid var(--stp-border-subtle);
  font-family: var(--font-geist-mono);
  font-size: 12px;
  color: var(--stp-text-faint);
  white-space: nowrap;
  overflow: hidden;
}

.ribbon-step {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.ribbon-tick {
  color: var(--stp-status-success);
  font-size: 11px;
}

.ribbon-done {
  color: var(--stp-text-subtle);
}

.ribbon-live {
  color: var(--stp-color-brand);
}

.ribbon-pulse {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--stp-color-brand);
  animation: pulse 2.4s var(--stp-motion-easing) infinite;
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(54, 190, 190, 0.5); }
  50% { box-shadow: 0 0 0 6px rgba(54, 190, 190, 0); }
}

.ribbon-line {
  flex: 1 1 auto;
  min-width: 24px;
  height: 1px;
  background: linear-gradient(90deg, rgba(54, 190, 190, 0.4), var(--stp-border-subtle));
}

.desk-stage {
  height: 430px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px 24px;
}

.desk-caption {
  padding: 12px 22px;
  border-top: 1px solid var(--stp-border-subtle);
  font-family: var(--font-geist);
  font-size: 12.5px;
  color: var(--stp-text-faint);
  text-align: center;
}

.command-dock {
  margin: 20px auto 0;
  max-width: 640px;
  border: 1px solid var(--stp-border-subtle);
  border-radius: var(--stp-radius-large);
  background: var(--stp-surface-input);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
}

.dock-tabs {
  display: flex;
  gap: 2px;
  padding: 6px 8px 0;
  border-bottom: 1px solid var(--stp-border-subtle);
}

.dock-tab {
  appearance: none;
  background: none;
  border: none;
  cursor: pointer;
  font-family: var(--font-geist-mono);
  font-size: 11.5px;
  color: var(--stp-text-faint);
  padding: 7px 12px 9px;
  border-bottom: 2px solid transparent;
  transition: color var(--stp-motion-duration-fast) var(--stp-motion-easing);
}

.dock-tab:hover {
  color: var(--stp-text-muted);
}

.dock-tab.is-active {
  color: var(--stp-color-brand);
  border-bottom-color: var(--stp-color-brand);
}

.dock-body {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 15px 16px;
}

.dock-prompt {
  color: var(--stp-color-brand);
  font-family: var(--font-geist-mono);
  font-size: 14px;
}

.dock-command {
  flex: 1;
  font-family: var(--font-geist-mono);
  font-size: 14px;
  color: var(--stp-text-primary);
  overflow-x: auto;
  white-space: nowrap;
}

.dock-copy {
  appearance: none;
  cursor: pointer;
  flex-shrink: 0;
  background: var(--stp-surface-element);
  border: 1px solid var(--stp-border-subtle);
  border-radius: var(--stp-radius-medium);
  color: var(--stp-text-muted);
  font-family: var(--font-geist);
  font-size: 12px;
  padding: 6px 12px;
  transition: color var(--stp-motion-duration-fast) var(--stp-motion-easing),
    border-color var(--stp-motion-duration-fast) var(--stp-motion-easing);
}

.dock-copy:hover {
  color: var(--stp-color-brand);
  border-color: rgba(54, 190, 190, 0.4);
}

.dock-copy.is-copied {
  color: var(--stp-status-success);
  border-color: rgba(24, 153, 144, 0.5);
}

.dock-hint {
  margin: 0;
  padding: 0 16px 13px;
  font-family: var(--font-geist);
  font-size: 12px;
  color: var(--stp-text-faint);
}

@media (max-width: 1024px) {
  .hero-grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .desk-stage {
    height: 340px;
  }
}

@media (max-width: 900px) {
  .hero {
    padding-top: 48px;
  }

  .desk-ribbon {
    flex-wrap: wrap;
    white-space: normal;
    row-gap: 8px;
  }

  .ribbon-line {
    display: none;
  }

  .desk-stage {
    height: 280px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ribbon-pulse {
    animation: none;
  }

  .btn,
  .nav-link,
  .dock-tab,
  .dock-copy {
    transition: none;
  }
}
</style>

<script>
  const commands = {
    npx: 'npx stacktape init',
    macos: 'curl -L https://installs.stacktape.com/macos.sh | sh',
    linux: 'curl -L https://installs.stacktape.com/linux.sh | sh',
    windows: 'iwr https://installs.stacktape.com/windows.ps1 -useb | iex'
  } as const;

  type InstallMethod = keyof typeof commands;

  const isInstallMethod = (value: string | undefined): value is InstallMethod =>
    value !== undefined && value in commands;

  const hints = {
    npx: 'Opens the AI wizard — it reads your repo and writes your Stacktape config.',
    macos: 'Installs the CLI, then run: stacktape init',
    linux: 'Installs the CLI, then run: stacktape init',
    windows: 'Installs the CLI, then run: stacktape init'
  };

  const dock = document.querySelector<HTMLElement>('[data-command-dock]');

  if (dock) {
    const tabs = Array.from(dock.querySelectorAll<HTMLButtonElement>('[data-method]'));
    const textEl = dock.querySelector<HTMLElement>('[data-command-text]');
    const hintEl = dock.querySelector<HTMLElement>('.dock-hint');
    const copyBtn = dock.querySelector<HTMLButtonElement>('[data-copy-button]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        const method = tab.dataset.method;
        if (isInstallMethod(method) && textEl) textEl.textContent = commands[method];
        if (isInstallMethod(method) && hintEl) hintEl.textContent = hints[method];
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const label = copyBtn.querySelector<HTMLElement>('.dock-copy-label');
        const selectedMethod = dock.querySelector<HTMLElement>('.dock-tab.is-active')?.dataset.method;
        const method = isInstallMethod(selectedMethod) ? selectedMethod : 'npx';
        try {
          await navigator.clipboard.writeText(commands[method]);
          copyBtn.classList.add('is-copied');
          if (label) label.textContent = 'Copied';
          setTimeout(() => {
            copyBtn.classList.remove('is-copied');
            if (label) label.textContent = 'Copy';
          }, 1600);
        } catch {
          /* clipboard unavailable — leave button unchanged */
        }
      });
    }
  }
</script>
