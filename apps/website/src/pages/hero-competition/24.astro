---
// concept: A full-width operations roster turns the hero into a live shift board, with every AWS DevOps discipline visibly staffed by automation beneath an oversized headline.
// copy-angle: Present Stacktape as one automated system covering the whole DevOps function, use enterprise depth as proof, and keep automatic incident resolution as an explicit opt-in footnote instead of the lead claim.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import { CtaCommand } from '../../components/CtaCommand';
---

<BaseLayout
  title="Stacktape — Every AWS DevOps discipline, automated"
  description="Turn your application into production-ready AWS infrastructure, delivery and operations with Stacktape."
  font="geist"
  noindex
>
  <div class="page">
    <nav class="nav" aria-label="Primary navigation">
      <a class="nav__logo" href="/" aria-label="Stacktape home">
        <Logo height={27} />
      </a>

      <div class="nav__links">
        <a href="https://docs.stacktape.com">Docs</a>
        <a href="https://github.com/stacktape/stacktape">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path
              fill="currentColor"
              d="M10 .9a9.3 9.3 0 0 0-2.94 18.13c.47.08.64-.2.64-.45v-1.8c-2.62.57-3.17-1.11-3.17-1.11-.43-1.1-1.05-1.4-1.05-1.4-.86-.59.06-.58.06-.58.95.07 1.45.98 1.45.98.85 1.45 2.22 1.03 2.76.79.09-.61.33-1.03.6-1.27-2.09-.24-4.29-1.05-4.29-4.65 0-1.03.37-1.87.97-2.53-.1-.24-.42-1.2.09-2.5 0 0 .79-.26 2.56.96A8.9 8.9 0 0 1 10 5.16a8.9 8.9 0 0 1 2.33.31c1.77-1.22 2.56-.97 2.56-.97.51 1.3.19 2.27.09 2.51.6.66.97 1.5.97 2.53 0 3.61-2.2 4.4-4.3 4.64.34.3.64.87.64 1.75v2.65c0 .25.17.54.65.45A9.3 9.3 0 0 0 10 .9Z"
            >
            </path>
          </svg>
          GitHub
        </a>
      </div>

      <a class="nav__signup" href="https://console.stacktape.com/sign-up">
        Sign up
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3.5 8h8.5M8.5 4.5 12 8l-3.5 3.5"></path>
        </svg>
      </a>
    </nav>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__eyebrow">
          <span class="eyebrow__signal" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>AWS DevOps / automated end to end</span>
          <span class="eyebrow__rule" aria-hidden="true"></span>
          <span class="eyebrow__meta">Open-source framework · Managed Console</span>
        </div>

        <h1 id="hero-title">
          <span>Every AWS DevOps discipline.</span>
          <span class="headline-accent">One automated system.</span>
        </h1>

        <div class="hero__intro">
          <div class="intro__copy">
            <p>
              Stacktape turns your repository into production AWS, deploys it through plain CloudFormation, and keeps
              architecture, delivery, observability, governance and incidents in one connected operating context.
            </p>
            <div class="ownership">
              <span aria-hidden="true"></span>
              Your infrastructure stays in your AWS account.
            </div>
          </div>

          <div class="hero__actions">
            <span class="actions__label">Start with your repository</span>
            <CtaCommand
              client:visible
              defaultMethod="npx"
              className="hero-command"
            />
            <div class="actions__secondary">
              <a class="button-secondary" href="https://console.stacktape.com/sign-up">
                Deploy in Console
              </a>
              <a class="text-link" href="https://cal.com/stacktape/30min">
                Book a demo
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M3.5 8h8.5M8.5 4.5 12 8l-3.5 3.5"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <section class="roster" aria-labelledby="roster-title">
          <div class="roster__rail" aria-hidden="true">
            <span>STP / AWS</span>
            <strong>Automation roster</strong>
            <span class="rail__status"><i></i> Ready</span>
          </div>

          <div class="roster__body">
            <header class="roster__header">
              <div>
                <span class="roster__serial">OPERATING FUNCTION / 01</span>
                <h2 id="roster-title">The infrastructure work is already assigned.</h2>
              </div>
              <div class="roster__account">
                <span>Workload destination</span>
                <strong><i aria-hidden="true"></i>Your AWS account</strong>
              </div>
            </header>

            <div class="roster__columns" aria-hidden="true">
              <span>Discipline</span>
              <span>Automated work</span>
              <span>Depth when needed</span>
              <span>Stacktape</span>
            </div>

            <ol class="roster__rows">
              <li
                class="roster-row"
                style="--row-accent: var(--stp-aws-category-network); --row-order: 1;"
              >
                <div class="discipline">
                  <span class="discipline__number">01</span>
                  <span class="discipline__icon icon-network" aria-hidden="true">
                    <i></i><i></i><i></i>
                  </span>
                  <strong>Architecture</strong>
                </div>
                <p>Maps application requirements to a production AWS architecture.</p>
                <div class="depth">
                  <span>VPCs</span>
                  <span>private services</span>
                  <span>bastions</span>
                  <span>GPU / Spot</span>
                </div>
                <span class="state"><i aria-hidden="true"></i>Designs</span>
              </li>

              <li
                class="roster-row"
                style="--row-accent: var(--stp-aws-category-storage); --row-order: 2;"
              >
                <div class="discipline">
                  <span class="discipline__number">02</span>
                  <span class="discipline__icon icon-stack" aria-hidden="true">
                    <i></i><i></i><i></i>
                  </span>
                  <strong>Infrastructure</strong>
                </div>
                <p>Compiles the stack and deploys it directly into your account.</p>
                <div class="depth">
                  <span>CloudFormation</span>
                  <span>CDK constructs</span>
                  <span>raw CFN</span>
                </div>
                <span class="state"><i aria-hidden="true"></i>Deploys</span>
              </li>

              <li
                class="roster-row"
                style="--row-accent: var(--stp-aws-category-integration); --row-order: 3;"
              >
                <div class="discipline">
                  <span class="discipline__number">03</span>
                  <span class="discipline__icon icon-delivery" aria-hidden="true">
                    <i></i><i></i><i></i>
                  </span>
                  <strong>CI/CD</strong>
                </div>
                <p>Builds and promotes releases across every application stage.</p>
                <div class="depth">
                  <span>GitHub Actions</span>
                  <span>EC2 runners</span>
                  <span>guardrails</span>
                </div>
                <span class="state"><i aria-hidden="true"></i>Delivers</span>
              </li>

              <li
                class="roster-row"
                style="--row-accent: var(--stp-aws-category-compute); --row-order: 4;"
              >
                <div class="discipline">
                  <span class="discipline__number">04</span>
                  <span class="discipline__icon icon-observe" aria-hidden="true">
                    <i></i><i></i><i></i><i></i>
                  </span>
                  <strong>Observability</strong>
                </div>
                <p>Connects each release to metrics, traces, logs and alarms.</p>
                <div class="depth">
                  <span>full-stack signals</span>
                  <span>release context</span>
                  <span>costs</span>
                </div>
                <span class="state"><i aria-hidden="true"></i>Observes</span>
              </li>

              <li
                class="roster-row"
                style="--row-accent: var(--stp-aws-category-security); --row-order: 5;"
              >
                <div class="discipline">
                  <span class="discipline__number">05</span>
                  <span class="discipline__icon icon-control" aria-hidden="true">
                    <i></i>
                  </span>
                  <strong>Governance</strong>
                </div>
                <p>Applies access, policy and spend controls across the team.</p>
                <div class="depth">
                  <span>RBAC</span>
                  <span>SSO</span>
                  <span>budgets</span>
                  <span>audit</span>
                </div>
                <span class="state"><i aria-hidden="true"></i>Governs</span>
              </li>

              <li
                class="roster-row roster-row--agent"
                style="--row-accent: var(--stp-color-brand); --row-order: 6;"
              >
                <div class="discipline">
                  <span class="discipline__number">06</span>
                  <span class="discipline__icon icon-incident" aria-hidden="true">
                    <i></i><i></i>
                  </span>
                  <strong>Incidents</strong>
                </div>
                <p>Correlates failures with releases and the full runtime picture.</p>
                <div class="depth">
                  <span>agent context</span>
                  <span>fix + redeploy</span>
                </div>
                <span class="state state--optional"><i aria-hidden="true"></i>Can resolve*</span>
              </li>
            </ol>

            <footer class="roster__footer">
              <span class="footer__label">Built for long-term fit</span>
              <div class="adoption-proof">
                <div>
                  <span>Adopt</span>
                  <strong>Bring existing infrastructure</strong>
                </div>
                <div>
                  <span>Extend</span>
                  <strong>Use CDK or raw CloudFormation</strong>
                </div>
                <div>
                  <span>Own</span>
                  <strong>Keep plain CloudFormation in your account</strong>
                </div>
              </div>
            </footer>
          </div>
        </section>

        <p class="agent-note">
          <span>*</span>
          Automatic incident resolution is opt-in and stays off until your team enables it.
        </p>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 86% 9%, rgba(54, 190, 190, 0.11), transparent 25rem),
    radial-gradient(circle at 12% 62%, rgba(77, 115, 244, 0.055), transparent 30rem),
    var(--stp-surface-page);
}

.page::before {
  position: absolute;
  inset: 0;
  z-index: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: linear-gradient(to bottom, black, transparent 72%);
  content: '';
  pointer-events: none;
}

.page::after {
  position: absolute;
  top: 4rem;
  right: -14rem;
  width: 38rem;
  height: 38rem;
  border: 1px solid rgba(54, 190, 190, 0.08);
  border-radius: 50%;
  box-shadow:
    0 0 0 5rem rgba(54, 190, 190, 0.016),
    0 0 0 10rem rgba(54, 190, 190, 0.01);
  content: '';
  pointer-events: none;
}

.nav,
.hero {
  position: relative;
  z-index: 1;
  width: min(100% - 64px, 1480px);
  margin-inline: auto;
}

.nav {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  height: 84px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.075);
}

.nav__logo {
  display: inline-flex;
  width: fit-content;
}

.nav__links {
  display: flex;
  align-items: center;
  gap: 28px;
  color: var(--stp-text-muted);
  font-size: 0.84rem;
  font-weight: 500;
}

.nav__links a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  transition: color var(--stp-motion-duration-fast) var(--stp-motion-easing);
}

.nav__links a:hover {
  color: var(--stp-text-primary);
}

.nav__links svg {
  width: 15px;
  height: 15px;
}

.nav__signup {
  display: inline-flex;
  justify-self: end;
  align-items: center;
  gap: 8px;
  padding: 9px 14px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--stp-radius-medium);
  background: rgba(255, 255, 255, 0.045);
  color: var(--stp-text-primary);
  font-size: 0.82rem;
  font-weight: 600;
  transition:
    border-color var(--stp-motion-duration-fast) var(--stp-motion-easing),
    background var(--stp-motion-duration-fast) var(--stp-motion-easing);
}

.nav__signup:hover {
  border-color: rgba(54, 190, 190, 0.38);
  background: rgba(54, 190, 190, 0.09);
}

.nav__signup svg,
.text-link svg {
  width: 15px;
  height: 15px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.4;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.hero {
  padding: 54px 0 70px;
}

.hero__eyebrow {
  display: flex;
  align-items: center;
  gap: 13px;
  color: var(--stp-text-muted);
  font-family: var(--font-geist-mono);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.11em;
  text-transform: uppercase;
  animation: enter 650ms 80ms both;
}

.eyebrow__signal {
  display: inline-flex;
  align-items: flex-end;
  gap: 2px;
  width: 14px;
  height: 10px;
}

.eyebrow__signal i {
  width: 2px;
  border-radius: 1px;
  background: var(--stp-color-brand);
}

.eyebrow__signal i:nth-child(1) {
  height: 4px;
}

.eyebrow__signal i:nth-child(2) {
  height: 9px;
}

.eyebrow__signal i:nth-child(3) {
  height: 6px;
}

.eyebrow__rule {
  width: 44px;
  height: 1px;
  background: rgba(255, 255, 255, 0.15);
}

.eyebrow__meta {
  color: var(--stp-text-faint);
}

h1 {
  max-width: 1380px;
  margin: 31px 0 38px;
  color: var(--stp-text-primary);
  font-size: clamp(3.9rem, 6.55vw, 6.75rem);
  font-weight: 500;
  letter-spacing: -0.064em;
  line-height: 0.93;
}

h1 > span {
  display: block;
  animation: enter 750ms both;
}

h1 > span:first-child {
  animation-delay: 130ms;
}

h1 > span:last-child {
  animation-delay: 210ms;
}

.headline-accent {
  width: fit-content;
  padding-right: 0.07em;
  background: linear-gradient(
    105deg,
    #f0f5f4 0%,
    #a5ded5 42%,
    var(--stp-color-brand) 78%,
    #4aa6dc 115%
  );
  background-clip: text;
  color: transparent;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero__intro {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(390px, 0.85fr);
  gap: clamp(50px, 9vw, 150px);
  align-items: start;
  padding: 0 0 52px clamp(0px, 8.2vw, 124px);
}

.intro__copy {
  max-width: 700px;
  animation: enter 700ms 290ms both;
}

.intro__copy p {
  margin: 0;
  color: var(--stp-text-muted);
  font-size: clamp(1.05rem, 1.35vw, 1.26rem);
  letter-spacing: -0.018em;
  line-height: 1.58;
}

.ownership {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 20px;
  color: rgba(255, 255, 255, 0.72);
  font-family: var(--font-geist-mono);
  font-size: 0.72rem;
  letter-spacing: 0.035em;
}

.ownership > span {
  width: 7px;
  height: 7px;
  border: 1px solid rgba(54, 190, 190, 0.7);
  border-radius: 50%;
  background: rgba(54, 190, 190, 0.2);
  box-shadow: 0 0 14px rgba(54, 190, 190, 0.35);
}

.hero__actions {
  min-width: 0;
  animation: enter 700ms 350ms both;
}

.actions__label {
  display: block;
  margin-bottom: 13px;
  color: var(--stp-text-faint);
  font-family: var(--font-geist-mono);
  font-size: 0.67rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

:global(.hero-command.cta-command) {
  display: flex;
  width: 100%;
}

:global(.hero-command .cta-command__row) {
  width: 100%;
  min-height: 50px;
  border-radius: var(--stp-radius-medium);
  background: rgba(6, 11, 11, 0.76);
  box-shadow:
    inset 0 0 0 1px rgba(54, 190, 190, 0.34),
    0 12px 36px rgba(0, 0, 0, 0.2);
}

:global(.hero-command .cta-command__code) {
  flex: 1;
  font-size: 0.82rem;
}

:global(.hero-command .cta-command__methods) {
  background: rgba(5, 10, 10, 0.42);
}

.actions__secondary {
  display: flex;
  align-items: center;
  gap: 22px;
  margin-top: 17px;
}

.button-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38px;
  padding: 0 15px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: var(--stp-radius-medium);
  background: rgba(255, 255, 255, 0.045);
  color: var(--stp-text-primary);
  font-size: 0.78rem;
  font-weight: 600;
  transition:
    border-color var(--stp-motion-duration-fast) var(--stp-motion-easing),
    background var(--stp-motion-duration-fast) var(--stp-motion-easing);
}

.button-secondary:hover {
  border-color: rgba(255, 255, 255, 0.24);
  background: rgba(255, 255, 255, 0.075);
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--stp-text-muted);
  font-size: 0.79rem;
  font-weight: 600;
  transition: color var(--stp-motion-duration-fast) var(--stp-motion-easing);
}

.text-link:hover {
  color: var(--stp-text-primary);
}

.roster {
  position: relative;
  display: grid;
  grid-template-columns: 48px minmax(0, 1fr);
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 12px;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.025), transparent 34%),
    rgba(17, 23, 23, 0.9);
  box-shadow:
    0 30px 90px rgba(0, 0, 0, 0.25),
    inset 0 1px rgba(255, 255, 255, 0.025);
  animation: enter 760ms 420ms both;
  isolation: isolate;
}

.roster::after {
  position: absolute;
  z-index: 2;
  top: 0;
  bottom: 0;
  left: -30%;
  width: 22%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(54, 190, 190, 0.035),
    transparent
  );
  content: '';
  pointer-events: none;
  animation: scan 9s 2s infinite linear;
}

.roster__rail {
  display: flex;
  z-index: 3;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 17px 0 19px;
  border-right: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(7, 12, 12, 0.42);
  color: var(--stp-text-faint);
  font-family: var(--font-geist-mono);
  font-size: 0.56rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.roster__rail > span:first-child,
.roster__rail strong {
  writing-mode: vertical-rl;
  transform: rotate(180deg);
}

.roster__rail strong {
  color: rgba(255, 255, 255, 0.55);
  font-weight: 600;
  letter-spacing: 0.16em;
}

.rail__status {
  display: flex;
  align-items: center;
  gap: 5px;
  writing-mode: vertical-rl;
}

.rail__status i {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--stp-color-brand);
  box-shadow: 0 0 8px rgba(54, 190, 190, 0.65);
}

.roster__body {
  min-width: 0;
}

.roster__header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 32px;
  min-height: 120px;
  padding: 27px 30px 25px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.075);
}

.roster__serial,
.roster__account > span,
.footer__label {
  color: var(--stp-text-faint);
  font-family: var(--font-geist-mono);
  font-size: 0.61rem;
  font-weight: 600;
  letter-spacing: 0.115em;
  text-transform: uppercase;
}

.roster__header h2 {
  margin: 12px 0 0;
  color: rgba(255, 255, 255, 0.85);
  font-size: clamp(1.35rem, 2vw, 1.8rem);
  font-weight: 500;
  letter-spacing: -0.035em;
}

.roster__account {
  flex: none;
  text-align: right;
}

.roster__account strong {
  display: flex;
  align-items: center;
  justify-content: end;
  gap: 8px;
  margin-top: 9px;
  color: rgba(255, 255, 255, 0.72);
  font-family: var(--font-geist-mono);
  font-size: 0.72rem;
  font-weight: 500;
}

.roster__account strong i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--stp-color-brand);
  box-shadow: 0 0 12px rgba(54, 190, 190, 0.5);
}

.roster__columns,
.roster-row {
  display: grid;
  grid-template-columns:
    minmax(190px, 1.1fr)
    minmax(270px, 1.75fr)
    minmax(250px, 1.5fr)
    minmax(112px, 0.65fr);
  column-gap: 24px;
  align-items: center;
}

.roster__columns {
  min-height: 36px;
  padding: 0 30px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.055);
  color: rgba(255, 255, 255, 0.27);
  font-family: var(--font-geist-mono);
  font-size: 0.55rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.roster__rows {
  margin: 0;
  padding: 0;
  list-style: none;
}

.roster-row {
  position: relative;
  min-height: 71px;
  padding: 12px 30px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.055);
  background: linear-gradient(90deg, color-mix(in srgb, var(--row-accent) 2%, transparent), transparent 34%);
  animation: row-enter 520ms both;
  animation-delay: calc(470ms + var(--row-order) * 55ms);
  transition: background var(--stp-motion-duration-fast) var(--stp-motion-easing);
}

.roster-row::before {
  position: absolute;
  top: 18px;
  bottom: 18px;
  left: 0;
  width: 2px;
  border-radius: 0 2px 2px 0;
  background: var(--row-accent);
  box-shadow: 0 0 13px color-mix(in srgb, var(--row-accent) 45%, transparent);
  content: '';
  opacity: 0.72;
}

.roster-row:hover {
