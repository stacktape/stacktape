---
// concept: Purely typographic, command-first hero — a three-line headline whose last line IS the install command, typed live in monospace with a cursor; no product window, no illustration, just scale, rhythm and one line of code you can copy.
// copy-angle: Developer-direct and plainly bold — "AWS DevOps, automated." with the promise carried by the command itself; the agent story is one clause ("an agent can work while you sleep"), the control story is the closing line ("nothing is created until you say so").
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';

const commands = [
  { id: 'npx', label: 'npx', text: 'npx stacktape init' },
  { id: 'macos', label: 'macOS', text: 'curl -L https://installs.stacktape.com/macos.sh | sh' },
  { id: 'linux', label: 'Linux', text: 'curl -L https://installs.stacktape.com/linux.sh | sh' },
  { id: 'windows', label: 'Windows', text: 'iwr https://installs.stacktape.com/windows.ps1 -useb | iex' }
];
---

<BaseLayout
  title="AWS DevOps, automated. — Stacktape"
  description="One command. The wizard reads your repository, writes the infrastructure, shows you the architecture and the price, and deploys into your own AWS account when you say so."
  font="geist"
  noindex
>
  <header class="nav">
    <a href="/" aria-label="Stacktape home"><Logo height={22} /></a>
    <nav>
      <a href="https://docs.stacktape.com">Docs</a>
      <a href="https://github.com/stacktape/stacktape">GitHub</a>
      <a class="nav-cta" href="https://console.stacktape.com/sign-up">Sign up</a>
    </nav>
  </header>

  <main class="hero">
    <h1>
      <span class="l1">AWS DevOps,</span>
      <span class="l2">automated.</span>
      <span class="l3">
        <span class="prompt" aria-hidden="true">$</span>
        <span class="cmd" id="cmd" data-text={commands[0].text}>{commands[0].text}</span>
        <span class="cursor" aria-hidden="true"></span>
        <button class="copy" id="copy" type="button" aria-label="Copy the command">
          <span class="copy-label">copy</span>
        </button>
      </span>
    </h1>

    <div class="methods" role="group" aria-label="Installation method">
      {commands.map((c, i) => (
        <button type="button" class={`method${i === 0 ? ' is-active' : ''}`} data-text={c.text} data-id={c.id}>{c.label}</button>
      ))}
    </div>

    <p class="sub">
      The wizard reads your repository and writes the infrastructure. One deploy later it is running in your own AWS
      account — pipelines, preview environments, metrics, traces, alarms, and incidents an agent can work while you
      sleep. Nothing is created until you say so.
    </p>

    <div class="ctas">
      <a class="btn-primary" href="https://console.stacktape.com/sign-up">Sign up</a>
      <a class="btn-quiet" href="https://cal.com/stacktape/30min">Book a demo <span aria-hidden="true">→</span></a>
    </div>

    <ol class="steps" aria-label="What the command does">
      <li><span class="n">01</span>reads your repo</li>
      <li><span class="n">02</span>shows the architecture and the monthly price</li>
      <li><span class="n">03</span>deploys — plain CloudFormation, your account — when you say so</li>
    </ol>
  </main>
</BaseLayout>

<style>
  :root {
    --ink: var(--stp-text-primary);
    --ink-2: rgb(196, 204, 204);
    --ink-3: rgb(138, 148, 148);
    --line: rgba(255, 255, 255, 0.08);
    --brand: var(--stp-color-brand);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px 28px;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .nav a {
    color: var(--ink-2);
    font-size: 0.92rem;
    text-decoration: none;
  }
  .nav a:hover {
    color: var(--ink);
  }
  .nav-cta {
    padding: 8px 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    color: var(--ink) !important;
  }

  .hero {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 96px 28px 120px;
  }
  .hero::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 70%;
    background: radial-gradient(50% 60% at 18% 30%, rgba(54, 190, 190, 0.1), transparent 70%);
    pointer-events: none;
  }

  h1 {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.04em;
    margin: 0;
    font-size: clamp(3.6rem, 8.6vw, 7.2rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.96;
    color: var(--ink);
  }
  .l2 {
    color: var(--ink-3);
  }
  .l3 {
    display: flex;
    align-items: center;
    gap: 0.22em;
    margin-top: 0.22em;
    font-family: var(--font-geist-mono);
    font-size: 0.5em;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .l3::-webkit-scrollbar {
    display: none;
  }
  .prompt {
    color: var(--brand);
  }
  .cmd {
    color: var(--ink);
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    background: var(--brand);
    animation: blink 1.1s steps(2, start) infinite;
  }
  @keyframes blink {
    to {
      visibility: hidden;
    }
  }
  .copy {
    margin-left: 0.5em;
    padding: 0.28em 0.6em;
    border: 0;
    border-radius: 0.35em;
    background: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    color: var(--ink-2);
    font: inherit;
    font-size: 0.34em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease;
  }
  .copy:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--ink);
  }
  .copy.is-done {
    color: var(--brand);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) 45%, transparent);
  }

  .methods {
    position: relative;
    display: flex;
    gap: 4px;
    margin-top: 26px;
  }
  .method {
    padding: 6px 12px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--ink-3);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease;
  }
  .method:hover {
    color: var(--ink);
  }
  .method.is-active {
    background: rgba(255, 255, 255, 0.07);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    color: var(--ink);
  }

  .sub {
    position: relative;
    max-width: 58ch;
    margin: 40px 0 0;
    color: var(--ink-2);
    font-size: 1.16rem;
    line-height: 1.6;
  }
  .ctas {
    position: relative;
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 32px;
  }
  .btn-primary {
    padding: 12px 22px;
    border-radius: 10px;
    background: var(--brand);
    color: rgb(8, 20, 20);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 8px 28px rgba(54, 190, 190, 0.26);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 34px rgba(54, 190, 190, 0.34);
  }
  .btn-quiet {
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }
  .btn-quiet:hover {
    color: var(--ink);
  }

  .steps {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 36px;
    margin: 72px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    color: var(--ink-3);
    font-size: 0.9rem;
  }
  .steps li {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .n {
    color: var(--brand);
    font-family: var(--font-geist-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .l1,
    .l2,
    .l3,
    .methods,
    .sub,
    .ctas,
    .steps {
      opacity: 0;
      transform: translateY(10px);
      animation: arrive 620ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }
    .l2 {
      animation-delay: 120ms;
    }
    .l3 {
      animation-delay: 260ms;
    }
    .methods {
      animation-delay: 700ms;
    }
    .sub {
      animation-delay: 820ms;
    }
    .ctas {
      animation-delay: 940ms;
    }
    .steps {
      animation-delay: 1100ms;
    }
  }
  @keyframes arrive {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  @media (max-width: 700px) {
    .hero {
      padding-top: 56px;
    }
    .l3 {
      font-size: 0.42em;
    }
  }
</style>

<script>
  const cmd = document.getElementById('cmd') as HTMLElement;
  const copy = document.getElementById('copy') as HTMLButtonElement;
  const methods = Array.from(document.querySelectorAll<HTMLButtonElement>('.method'));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let typing = 0;

  // Types a command into the headline, one character per tick; instant when motion is reduced.
  const type = (text: string) => {
    typing += 1;
    const run = typing;
    if (reduced) {
      cmd.textContent = text;
      return;
    }
    cmd.textContent = '';
    let i = 0;
    const tick = () => {
      if (run !== typing) return;
      i += 1;
      cmd.textContent = text.slice(0, i);
      if (i < text.length) window.setTimeout(tick, 34 + Math.random() * 40);
    };
    window.setTimeout(tick, 380);
  };

  type(cmd.dataset.text ?? '');

  for (const button of methods) {
    button.addEventListener('click', () => {
      for (const other of methods) other.classList.toggle('is-active', other === button);
      const text = button.dataset.text ?? '';
      cmd.dataset.text = text;
      type(text);
    });
  }

  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(cmd.dataset.text ?? cmd.textContent ?? '');
      copy.classList.add('is-done');
      copy.querySelector('.copy-label')!.textContent = 'copied';
      window.setTimeout(() => {
        copy.classList.remove('is-done');
        copy.querySelector('.copy-label')!.textContent = 'copy';
      }, 1600);
    } catch {
      copy.querySelector('.copy-label')!.textContent = 'select';
    }
  });
</script>
