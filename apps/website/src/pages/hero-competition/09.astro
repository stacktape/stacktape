---
// concept: The workspace — one application window with three panes: the file top-left, the deploy running in a terminal below it, and the architecture filling the right; the controls sit in the title bar, hovering a resource lights its node, and the terminal shows the file becoming a running stage.
// copy-angle: "One file. The whole DevOps job." with the proof points named: the fastest packaging pipeline, built-in CI/CD faster than CodeBuild, monitoring from day one, incidents that arrive with the fix; the account and the exit stated last.
// direction: fits
// round: 6
import { ButtonLink } from '@stacktape/ui-react/button';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import { CtaCommand } from '../../components/CtaCommand';
import { DeployTerminal } from '../../surfaces/DeployTerminal';
import DeskControls from '../../surfaces/HeroDesk/DeskControls.astro';
import DeskEditor from '../../surfaces/HeroDesk/DeskEditor.astro';
import DeskLinks from '../../surfaces/HeroDesk/DeskLinks.astro';
import DeskDiagram from '../../surfaces/HeroDesk/DeskDiagram';
import { deskDiagramProps, loadDeskProjects } from '../../surfaces/HeroDesk/desk-data';

const projects = await loadDeskProjects(['fullstack', 'nextjs', 'container', 'serverless', 'worker', 'agent']);
const first = projects[0];
if (!first) throw new Error('No projects to show.');
const diagram = deskDiagramProps(projects);
---

<BaseLayout
  title="AWS DevOps, fully automated. One file, the whole job — Stacktape"
  description="Describe your app in one file. Stacktape turns it into production-grade AWS and keeps it running: the fastest packaging pipeline on AWS, built-in CI/CD 2–5× faster than CodeBuild, monitoring and alarms from day one, and incidents that arrive with the fix already written."
  font="geist"
  noindex
>
  <header class="nav">
    <a href="/" aria-label="Stacktape home"><Logo height={22} /></a>
    <nav class="nav__links">
      <ButtonLink variant="plain" href="https://docs.stacktape.com">Docs</ButtonLink>
      <ButtonLink variant="secondary" href="https://github.com/stacktape/stacktape">GitHub</ButtonLink>
    </nav>
  </header>

  <main class="hero">
    <div class="copy">
      <p class="kicker"><span class="kicker__file">stacktape.yml</span> One file. The whole DevOps job.</p>
      <h1>AWS DevOps,<br />fully automated.</h1>
      <p class="lede">
        Describe your app in one file. Stacktape turns it into production-grade AWS and keeps it running: the fastest
        packaging pipeline on AWS, built-in CI/CD 2–5× faster than CodeBuild, monitoring and alarms wired from day one,
        and incidents that arrive with the fix already written.
      </p>
      <div class="cta">
        <CtaCommand client:visible defaultMethod="npx" />
        <ButtonLink variant="secondary" className="cta__demo" href="https://cal.com/stacktape/30min">Book a demo</ButtonLink>
      </div>
      <p class="note">Your own AWS account. Extend, override or eject anytime.</p>
    </div>

    <section class="ide surface-frame" id="desk" aria-label="The configuration, its deploy, and the architecture it deploys">
      <div class="surface-frame__bar ide__bar">
        <span class="surface-frame__lights" aria-hidden="true">
          <span style="background: #ff5f57"></span>
          <span style="background: #febc2e"></span>
          <span style="background: #28c840"></span>
        </span>
        <DeskControls projects={projects} class="ide__controls" />
      </div>
      <div class="ide__body">
        <div class="ide__file">
          <DeskEditor projects={projects} chrome="pane" />
        </div>
        <div class="ide__terminal">
          <div class="ide__terminal-bar">
            <span class="ide__terminal-title">terminal</span>
            <span class="ide__terminal-meta">stacktape deploy</span>
          </div>
          <div class="ide__terminal-body">
            <DeployTerminal className="ide__deploy" />
          </div>
        </div>
        <div class="ide__main">
          <div class="ide__canvas" data-desk-diagram>
            <DeskDiagram client:only="react" configs={diagram.configs} labels={diagram.labels} initialProject={first.id} />
          </div>
        </div>
      </div>
      <DeskLinks />
    </section>
  </main>
</BaseLayout>

<style>
  :root {
    --ink: var(--stp-text-primary);
    --ink-2: rgb(200, 208, 208);
    --ink-3: var(--stp-text-muted);
    --line: var(--stp-border-subtle);
    --brand: var(--stp-color-brand);
    --panel: rgb(28, 33, 33);
    --paper: rgb(24, 29, 29);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1400px;
    margin: 0 auto;
    padding: 18px 28px;
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(340px, 0.62fr) minmax(0, 1.38fr);
    gap: 48px;
    align-items: center;
    max-width: 1440px;
    margin: 0 auto;
    padding: 24px 28px 96px;
    overflow-x: clip;
  }

  /* ── Copy ─────────────────────────────────────────────────────────────── */
  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: var(--ink-2);
    font-size: 0.86rem;
    font-weight: 500;
  }
  .kicker__file {
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(54, 190, 190, 0.1);
    box-shadow: inset 0 0 0 1px rgba(54, 190, 190, 0.3);
    color: var(--brand);
    font-family: var(--font-geist-mono);
    font-size: 0.74rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.3rem, 3.2vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--ink);
  }
  .lede {
    margin: 22px 0 0;
    max-width: 52ch;
    color: var(--ink-3);
    font-size: 1.04rem;
    line-height: 1.6;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 12px 14px;
    margin-top: 30px;
  }
  .cta :global(.cta__demo) {
    --stp-control-height: 46px;
    --stp-button-padding-x: 18px;
  }
  .note {
    margin: 14px 0 0;
    color: var(--stp-text-subtle);
    font-size: 0.84rem;
  }

  /* ── The window, three panes ──────────────────────────────────────────── */
  .ide {
    position: relative;
    display: flex;
    flex-direction: column;
    height: clamp(600px, 48vw, 700px);
    background: var(--panel);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }
  .ide__bar {
    gap: 14px;
    padding-right: 10px;
  }
  .ide__controls {
    flex: 1;
    min-width: 0;
  }
  .ide__body {
    display: grid;
    flex: 1;
    grid-template-columns: minmax(300px, 42%) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) 190px;
    min-height: 0;
  }
  .ide__file {
    grid-column: 1;
    grid-row: 1;
    min-height: 0;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .ide__file > :global(.desk-editor) {
    height: 100%;
  }
  .ide__terminal {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-right: 1px solid var(--line);
    background: rgb(20, 25, 25);
  }
  .ide__terminal-bar {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    padding: 7px 14px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-geist-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stp-text-faint);
  }
  .ide__terminal-meta {
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-3);
  }
  .ide__terminal-body {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  /* The deploy surface brings its own window chrome; inside this window only its transcript is wanted. */
  .ide__terminal-body :global(.surface-frame) {
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .ide__terminal-body :global(.surface-frame__bar) {
    display: none;
  }
  .ide__terminal-body :global(.surface-frame__body) {
    background: transparent;
    font-size: 0.76rem;
  }
  .ide__main {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    display: flex;
    min-width: 0;
    background:
      radial-gradient(rgba(255, 255, 255, 0.075) 1px, transparent 1.3px) 0 0 / 16px 16px,
      var(--paper);
  }
  .ide__canvas {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  /* ── Motion ───────────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .copy,
    .ide {
      opacity: 0;
      transform: translateY(8px);
      animation: arrive 620ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }
    .ide {
      animation-delay: 160ms;
    }
  }
  @keyframes arrive {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ── Narrower ─────────────────────────────────────────────────────────── */
  @media (max-width: 1180px) {
    .hero {
      grid-template-columns: minmax(300px, 0.66fr) minmax(0, 1.34fr);
      gap: 32px;
    }
    .ide__body {
      grid-template-columns: minmax(280px, 46%) minmax(0, 1fr);
    }
  }
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .cta {
      flex-wrap: wrap;
    }
    .ide {
      height: auto;
    }
    .ide__body {
      grid-template-columns: 1fr;
      grid-template-rows: 380px 180px 420px;
    }
    .ide__file,
    .ide__terminal {
      border-right: 0;
    }
    .ide__terminal {
      grid-row: 2;
      border-bottom: 1px solid var(--line);
    }
    .ide__main {
      grid-column: 1;
      grid-row: 3;
    }
  }
</style>

<script>
  import { mountDesk } from '../../surfaces/HeroDesk/desk-client';

  const desk = document.getElementById('desk');
  if (desk) mountDesk(desk, { attract: true, wires: 'hover', direction: 'horizontal' });
</script>
