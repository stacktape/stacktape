</style>

<script>
const root = document.querySelector('[data-command-root]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll('.command-tab'));
    const text = root.querySelector('[data-command-text]');
    const hint = root.querySelector('[data-command-hint]');
    const hints: Record<string, string> = {
      'npx stacktape init':
        'Runs the AI wizard on localhost — it reads your repo and generates your stack. No install needed.',
      'curl -L https://installs.stacktape.com/macos.sh | sh':
        'Installs the Stacktape CLI. Then run: stacktape init',
      'curl -L https://installs.stacktape.com/linux.sh | sh':
        'Installs the Stacktape CLI. Then run: stacktape init',
      'iwr https://installs.stacktape.com/windows.ps1 -useb | iex':
        'Installs the Stacktape CLI. Then run: stacktape init',
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        const cmd = tab.getAttribute('data-cmd') || '';
        if (text) text.textContent = cmd;
        if (hint) hint.textContent = hints[cmd] || '';
      });
    });

    const copyBtn = root.querySelector('[data-copy]');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const cmd = text ? text.textContent : '';
        try {
          await navigator.clipboard.writeText(cmd || '');
        } catch {
          const ta = document.createElement('textarea');
          ta.value = cmd || '';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        copyBtn.classList.add('is-copied');
        const label = copyBtn.querySelector('[data-copy-label]');
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          if (label) label.textContent = 'Copy';
        }, 1800);
      });
    }
  }
</script>
