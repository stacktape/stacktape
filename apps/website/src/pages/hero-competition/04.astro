</style>

<script>
// Interactive Command Switcher
  const commandMap: Record<string, string> = {
    npx: 'npx stacktape init',
    macos: 'curl -L https://installs.stacktape.com/macos.sh | sh',
    linux: 'curl -L https://installs.stacktape.com/linux.sh | sh',
    windows: 'iwr https://installs.stacktape.com/windows.ps1 -useb | iex'
  };

  const commandTextEl = document.getElementById('hero-command-text');
  const copyBtn = document.getElementById('btn-copy-command');
  const cmdTabs = document.querySelectorAll('.cmd-tab');

  cmdTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      cmdTabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const cmdType = tab.getAttribute('data-cmd-type') || 'npx';
      if (commandTextEl && commandMap[cmdType]) {
        commandTextEl.textContent = commandMap[cmdType];
      }
    });
  });

  // Clipboard Copy Action
  if (copyBtn && commandTextEl) {
    copyBtn.addEventListener('click', async () => {
      const textToCopy = commandTextEl.textContent || 'npx stacktape init';
      try {
        await navigator.clipboard.writeText(textToCopy);
        copyBtn.classList.add('copied');
        const copyLabel = copyBtn.querySelector('.copy-text');
        if (copyLabel) copyLabel.textContent = 'Copied!';
        
        setTimeout(() => {
          copyBtn.classList.remove('copied');
          if (copyLabel) copyLabel.textContent = 'Copy';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy: ', err);
      }
    });
  }

  // Interactive DevOps Cockpit Stage Navigation
  const stageNavBtns = document.querySelectorAll('.stage-nav-btn');
  const stageViews = document.querySelectorAll('.cockpit-stage-view');

  stageNavBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetStage = btn.getAttribute('data-stage');
      if (!targetStage) return;

      // Update Nav Buttons
      stageNavBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      // Update Stage Views
      stageViews.forEach(view => {
        view.classList.remove('active');
      });

      const targetView = document.getElementById(`stage-${targetStage}`);
      if (targetView) {
        targetView.classList.add('active');
      }
    });
  });
</script>
