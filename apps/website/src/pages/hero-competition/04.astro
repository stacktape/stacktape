---
// concept: An interactive dual-plane "Engineering Cockpit" featuring an animated end-to-end DevOps pipeline visualizer, real-time CloudFormation synthesis inspector, and contextual AI incident triage console.
// copy-angle: An authoritative "AWS DevOps, fully automated" stance built for modern engineering teams—combining turnkey Day-0 synthesis and Day-1 production observability with transparent, opt-in AI self-healing and zero AWS lock-in.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
---

<BaseLayout
  title="Stacktape — AWS DevOps, Fully Automated"
  description="Describe your app in simple config. Stacktape compiles to CloudFormation, deploys to your AWS account, and automates Day-2 ops with built-in observability and opt-in AI incident resolution."
  font="geist"
  noindex
>
  <div class="hero-page-wrapper">
    <!-- Ambient background illumination -->
    <div class="glow-orb glow-top-center" aria-hidden="true"></div>
    <div class="glow-orb glow-top-left" aria-hidden="true"></div>
    <div class="glow-orb glow-top-right" aria-hidden="true"></div>
    <div class="bg-grid-pattern" aria-hidden="true"></div>

    <!-- Navigation -->
    <header class="hero-nav">
      <div class="nav-container">
        <a href="https://stacktape.com" class="nav-brand" aria-label="Stacktape Home">
          <Logo height={26} class="brand-logo" />
        </a>

        <nav class="nav-links" aria-label="Primary navigation">
          <a href="https://docs.stacktape.com" class="nav-link" target="_blank" rel="noopener noreferrer">Docs</a>
          <a
            href="https://docs.stacktape.com/overview/features"
            class="nav-link"
            target="_blank"
            rel="noopener noreferrer"
          >Features</a>
          <a
            href="https://docs.stacktape.com/resources/compute"
            class="nav-link"
            target="_blank"
            rel="noopener noreferrer"
          >Architecture</a>
          <a
            href="https://github.com/stacktape/stacktape"
            class="nav-link nav-github"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="icon-gh" viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            <span>GitHub</span>
            <span class="gh-stars">★ 2.4k</span>
          </a>
        </nav>

        <div class="nav-actions">
          <a href="https://cal.com/stacktape/30min" class="btn-ghost" target="_blank" rel="noopener noreferrer"
          >Book Demo</a>
          <a
            href="https://console.stacktape.com/sign-up"
            class="btn-nav-primary"
            target="_blank"
            rel="noopener noreferrer"
          >Sign Up</a>
        </div>
      </div>
    </header>

    <!-- Main Hero Section -->
    <main class="hero-main">
      <!-- Header Copy & Authority Positioning -->
      <div class="hero-header">
        <div class="hero-badge-row">
          <div class="hero-badge">
            <span class="status-pulse"></span>
            <span class="badge-tag">DevOps Engine 2.0</span>
            <span class="badge-separator">/</span>
            <span class="badge-text">100% In Your AWS Account</span>
          </div>
        </div>

        <h1 class="hero-title">
          AWS DevOps, <br class="title-break-desktop" />
          <span class="gradient-text">fully automated.</span>
        </h1>

        <p class="hero-subtitle">
          Stacktape replaces weeks of complex Terraform scripts with one simple config. Generate infrastructure with AI,
          compile to raw CloudFormation, and run production with integrated telemetry and opt-in AI self-healing.
        </p>

        <!-- Command Switcher & Primary Action Hub -->
        <div class="hero-cta-hub">
          <div class="cta-command-container">
            <div class="command-tabs" role="tablist" aria-label="Installation Method">
              <button class="cmd-tab active" data-cmd-type="npx" role="tab" aria-selected="true">
                <span class="cmd-tab-label">npx (recommended)</span>
              </button>
              <button class="cmd-tab" data-cmd-type="macos" role="tab" aria-selected="false">
                <span class="cmd-tab-label">macOS</span>
              </button>
              <button class="cmd-tab" data-cmd-type="linux" role="tab" aria-selected="false">
                <span class="cmd-tab-label">Linux</span>
              </button>
              <button class="cmd-tab" data-cmd-type="windows" role="tab" aria-selected="false">
                <span class="cmd-tab-label">Windows</span>
              </button>
            </div>

            <div class="command-box">
              <div class="command-prompt">
                <span class="prompt-symbol">$</span>
                <code class="command-string" id="hero-command-text">npx stacktape init</code>
              </div>
              <button class="btn-copy" id="btn-copy-command" aria-label="Copy command to clipboard">
                <svg
                  class="icon-copy"
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <svg
                  class="icon-check"
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="copy-text">Copy</span>
              </button>
            </div>
          </div>

          <div class="cta-actions-row">
            <a
              href="https://console.stacktape.com/sign-up"
              class="btn-hero-primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Start Free in Console</span>
              <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
            <a
              href="https://cal.com/stacktape/30min"
              class="btn-hero-secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                viewBox="0 0 20 20"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <rect x="3" y="4" width="14" height="13" rx="2"></rect>
                <path d="M3 8h14M7 2v4M13 2v4"></path>
              </svg>
              <span>Book Architecture Demo</span>
            </a>
          </div>

          <!-- Trust Guarantees -->
          <div class="hero-guarantees">
            <span class="guarantee-item">
              <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor">
                <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z" />
              </svg>
              No DevOps Headcount Required
            </span>
            <span class="guarantee-bullet">•</span>
            <span class="guarantee-item">
              <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor">
                <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z" />
              </svg>
              Deploys Native CloudFormation
            </span>
            <span class="guarantee-bullet">•</span>
            <span class="guarantee-item">
              <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor">
                <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z" />
              </svg>
              Zero Vendor Lock-In
            </span>
          </div>
        </div>
      </div>

      <!-- Interactive DevOps Cockpit Centerpiece -->
      <section class="cockpit-section" aria-label="Interactive DevOps Cockpit">
        <div class="cockpit-card">
          <!-- Cockpit Window Header & Workflow Stage Controller -->
          <div class="cockpit-topbar">
            <div class="cockpit-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>

            <div class="cockpit-workflow-nav" role="tablist" aria-label="DevOps Lifecycle Stages">
              <button class="stage-nav-btn active" data-stage="day0-arch" role="tab" aria-selected="true">
                <span class="stage-step-num">01</span>
                <span class="stage-step-title">Day 0: AI Synthesis & Topology</span>
                <span class="stage-step-badge">Wizard</span>
              </button>

              <button class="stage-nav-btn" data-stage="day0-cfn" role="tab" aria-selected="false">
                <span class="stage-step-num">02</span>
                <span class="stage-step-title">Day 0: CloudFormation Synthesis</span>
                <span class="stage-step-badge">Zero Lock-In</span>
              </button>

              <button class="stage-nav-btn" data-stage="day1-ops" role="tab" aria-selected="false">
                <span class="stage-step-num">03</span>
                <span class="stage-step-title">Day 1: Telemetry & AI Self-Healing</span>
                <span class="stage-step-badge highlight-brand">Live Ops</span>
              </button>
            </div>

            <div class="cockpit-account-indicator">
              <span class="indicator-led"></span>
              <span class="indicator-text">AWS: Production-us-east-1</span>
            </div>
          </div>

          <!-- Stage 1 View: AI Synthesis & Interactive Architecture Topology -->
          <div class="cockpit-stage-view active" id="stage-day0-arch">
            <div class="stage-split-grid">
              <!-- Left: AI Code Synthesis Panel -->
              <div class="view-panel panel-code">
                <div class="panel-header">
                  <div class="panel-file-info">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" class="file-icon">
                      <path d="M3.75 1.5a.75.75 0 00-.75.75v11.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75V6h-3.75A1.75 1.75 0 017.5 4.25V1.5H3.75zm5.25.56v2.19c0 .138.112.25.25.25h2.19L9 2.06zM2.25 2.25C2.25 1.007 3.257 0 4.5 0h4.636a2.25 2.25 0 011.591.659l3.114 3.114a2.25 2.25 0 01.659 1.591V13.75A2.25 2.25 0 0112.25 16H3.75A2.25 2.25 0 011.5 13.75V2.25z" />
                    </svg>
                    <span class="file-name">stacktape.ts</span>
                    <span class="file-tag">Auto-generated via repo analysis</span>
                  </div>
                  <div class="code-badge">TypeScript Safe</div>
                </div>

                <div class="code-viewport">
                  <pre class="code-block"><code><span class="token-keyword">import</span> &#123; defineConfig &#125; <span class="token-keyword">from</span> <span class="token-string">'stacktape'</span>;

<span class="token-keyword">export default</span> <span class="token-function">defineConfig</span>(&#123;
  serviceName: <span class="token-string">'core-api-production'</span>,
  resources: &#123;
    <span class="token-comment">// Private VPC & Multi-AZ Subnets configured automatically</span>
    webService: &#123;
      type: <span class="token-string">'web-service'</span>,
      properties: &#123;
        src: <span class="token-string">'./apps/api'</span>,
        packaging: &#123; type: <span class="token-string">'dockerfile'</span> &#125;,
        cpu: <span class="token-number">2</span>,
        memory: <span class="token-number">4096</span>,
        scaling: &#123; min: <span class="token-number">2</span>, max: <span class="token-number">12</span>, targetCpuUtilization: <span class="token-number">70</span> &#125;,
        connectTo: [<span class="token-string">'database'</span>, <span class="token-string">'cache'</span>],
        cors: <span class="token-boolean">true</span>
      &#125;
    &#125;,
    database: &#123;
      type: <span class="token-string">'relational-database'</span>,
      properties: &#123;
        engine: <span class="token-string">'postgres'</span>,
        version: <span class="token-string">'16.1'</span>,
        storageSize: <span class="token-number">100</span>,
        backups: &#123; retentionDays: <span class="token-number">30</span> &#125;
      &#125;
    &#125;,
    cache: &#123;
      type: <span class="token-string">'redis-cluster'</span>,
      properties: &#123; nodeType: <span class="token-string">'cache.t4g.medium'</span> &#125;
    &#125;
  &#125;
&#125;);</code></pre>
                </div>

                <div class="panel-footer-stats">
                  <div class="stat-pill"><span class="stat-dot green"></span> Auto-VPC: 3 Subnets</div>
                  <div class="stat-pill"><span class="stat-dot green"></span> Zero Secrets Leak</div>
                  <div class="stat-pill"><span class="stat-dot green"></span> Least-Privilege IAM</div>
                </div>
              </div>

              <!-- Right: Live Interactive Architecture Topology -->
              <div class="view-panel panel-topology">
                <div class="panel-header">
                  <span class="topology-title">Synthesized AWS Architecture Topology</span>
                  <div class="live-pill"><span class="live-blink"></span> Synthesized in 1.4s</div>
                </div>

                <div class="topology-canvas">
                  <!-- Flow Lines SVG -->
                  <svg class="topology-routes" viewBox="0 0 480 320" fill="none" preserveAspectRatio="none">
                    <path class="route-line flow-active" d="M240,45 L240,100" />
                    <path class="route-line flow-active" d="M240,140 L130,210" />
                    <path class="route-line flow-active" d="M240,140 L350,210" />
                    <path class="route-line flow-active" d="M130,250 L240,290" />
                    <circle cx="240" cy="70" r="3" class="flow-particle p1" />
                    <circle cx="185" cy="175" r="3" class="flow-particle p2" />
                    <circle cx="295" cy="175" r="3" class="flow-particle p3" />
                  </svg>

                  <!-- Node 1: Edge & Route53 / CloudFront -->
                  <div class="arch-node node-edge" style="top: 15px; left: 50%; transform: translateX(-50%);">
                    <div class="node-icon bg-purple">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.4z" />
                      </svg>
                    </div>
                    <div class="node-details">
                      <span class="node-name">CloudFront CDN & WAF</span>
                      <span class="node-meta">SSL Auto-provisioned • Global Edge</span>
                    </div>
                  </div>

                  <!-- Node 2: ALB & Container Service -->
                  <div class="arch-node node-compute" style="top: 105px; left: 50%; transform: translateX(-50%);">
                    <div class="node-icon bg-brand">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z" />
                      </svg>
                    </div>
                    <div class="node-details">
                      <span class="node-name">AWS Fargate • Autoscaling</span>
                      <span class="node-meta">2 → 12 Instances • Private Subnet</span>
                    </div>
                    <span class="node-badge-health">Healthy</span>
                  </div>

                  <!-- Node 3: PostgreSQL Database -->
                  <div class="arch-node node-db" style="top: 200px; left: 15px;">
                    <div class="node-icon bg-blue">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                        <path d="M12 2C6.48 2 2 4.02 2 6.5v11C2 19.98 6.48 22 12 22s10-2.02 10-4.5v-11C22 4.02 17.52 2 12 2zm0 3c3.86 0 7 1.12 7 2.5S15.86 10 12 10s-7-1.12-7-2.5S8.14 5 12 5zm0 14.5c-3.86 0-7-1.12-7-2.5v-2.32c1.86 1.15 4.3 1.82 7 1.82s5.14-.67 7-1.82V17c0 1.38-3.14 2.5-7 2.5zm0-5c-3.86 0-7-1.12-7-2.5v-2.32c1.86 1.15 4.3 1.82 7 1.82s5.14-.67 7-1.82V12c0 1.38-3.14 2.5-7 2.5z" />
                      </svg>
                    </div>
                    <div class="node-details">
                      <span class="node-name">Aurora PostgreSQL 16</span>
                      <span class="node-meta">Multi-AZ • Auto-backup</span>
                    </div>
                  </div>

                  <!-- Node 4: Redis Cache -->
                  <div class="arch-node node-cache" style="top: 200px; right: 15px;">
                    <div class="node-icon bg-red">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                        <path d="M19 4H5c-1.11 0-2 .9-2 2v12c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-7 2c2.76 0 5 2.24 5 5s-2.24 5-5 5-5-2.24-5-5 2.24-5 5-5z" />
                      </svg>
                    </div>
                    <div class="node-details">
                      <span class="node-name">ElastiCache Redis</span>
                      <span class="node-meta">Sub-millisecond latency</span>
                    </div>
                  </div>
                </div>

                <!-- Security & Governance Callout -->
                <div class="topology-footer">
                  <div class="vpc-boundary-tag">
                    <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                      <path d="M8.5 1.75a.75.75 0 00-1 0L2.75 6.25a.75.75 0 000 1.06L7.5 11.75a.75.75 0 001 0l4.75-4.44a.75.75 0 000-1.06L8.5 1.75z" />
                    </svg>
                    <span>Isolated VPC & NAT Gateways • SOC2 / HIPAA Ready Architecture</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Stage 2 View: Native CloudFormation Synthesis (Zero Lock-in) -->
          <div class="cockpit-stage-view" id="stage-day0-cfn">
            <div class="cfn-diff-container">
              <div class="cfn-overview-bar">
                <div class="cfn-metric">
                  <span class="cfn-metric-value">1</span>
                  <span class="cfn-metric-label">Stacktape File (35 lines)</span>
                </div>
                <div class="cfn-arrow-icon">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </div>
                <div class="cfn-metric highlight">
                  <span class="cfn-metric-value">1,480+</span>
                  <span class="cfn-metric-label">Lines of CloudFormation</span>
                </div>
                <div class="cfn-escape-notice">
                  <span class="escape-icon">🔓</span>
                  <span>100% Native AWS CloudFormation. Zero Proprietary Lock-In. Escape Anytime.</span>
                </div>
              </div>

              <div class="cfn-columns">
                <div class="cfn-col">
                  <div class="col-header">
                    <span>What Stacktape Synthesizes For You</span>
                    <span class="col-pill">Automated</span>
                  </div>
                  <ul class="cfn-feature-list">
                    <li>
                      <span class="check">✓</span> <strong>VPC & Subnet Topology:</strong> 3 Availability Zones,
                      Public/Private subnets, Internet & NAT Gateways.
                    </li>
                    <li>
                      <span class="check">✓</span> <strong>Security Groups:</strong> Strict ingress/egress rules,
                      inter-service least-privilege binding.
                    </li>
                    <li>
                      <span class="check">✓</span> <strong>IAM Roles & Policies:</strong> Micro-scoped task roles
                      without wildcard permissions.
                    </li>
                    <li>
                      <span class="check">✓</span> <strong>Auto-Scaling Policies:</strong> Step scaling triggers for
                      target CPU/Memory metrics.
                    </li>
                    <li>
                      <span class="check">✓</span> <strong>CloudWatch & Alarms:</strong> Automated logging groups,
                      retention lifecycles, and metric alerts.
                    </li>
                    <li>
                      <span class="check">✓</span> <strong>Escape Hatches:</strong> Drop down to raw CFN overrides or
                      AWS CDK constructs whenever needed.
                    </li>
                  </ul>
                </div>

                <div class="cfn-col cfn-raw-preview">
                  <div class="col-header">
                    <span>Compiled AWS CloudFormation (Snippet)</span>
                    <span class="col-badge">template.json</span>
                  </div>
                  <pre class="cfn-code"><code>&#123;
  <span class="token-string">"AWSTemplateFormatVersion"</span>: <span class="token-string">"2010-09-09"</span>,
  <span class="token-string">"Description"</span>: <span class="token-string">"Compiled by Stacktape. Production Ready."</span>,
  <span class="token-string">"Resources"</span>: &#123;
    <span class="token-string">"WebServiceTaskDefinition"</span>: &#123;
      <span class="token-string">"Type"</span>: <span class="token-string">"AWS::ECS::TaskDefinition"</span>,
      <span class="token-string">"Properties"</span>: &#123;
        <span class="token-string">"RequiresCompatibilities"</span>: [<span class="token-string">"FARGATE"</span>],
        <span class="token-string">"Cpu"</span>: <span class="token-string">"2048"</span>,
        <span class="token-string">"Memory"</span>: <span class="token-string">"4096"</span>,
        <span class="token-string">"NetworkMode"</span>: <span class="token-string">"awsvpc"</span>,
        <span class="token-string">"ExecutionRoleArn"</span>: &#123; <span class="token-string">"Fn::GetAtt"</span>: [<span class="token-string">"ECSTaskExecutionRole"</span>, <span class="token-string">"Arn"</span>] &#125;
      &#125;
    &#125;,
