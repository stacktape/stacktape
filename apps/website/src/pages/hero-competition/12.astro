---
// concept: An asymmetric two-column hero — copy anchored left against a wide horizon rule, with a self-built "operational ledger" panel on the right: a live-ish terminal that types the init command, compiles to CloudFormation, deploys, then flips into an incident being auto-resolved, framed by a thin vertical day 0 → day 1 spine.
// copy-angle: Headline names the automation plainly ("AWS DevOps, fully automated"), with the AI agent played as a confident but explicitly opt-in capability — presented as "the fix runs only when you approve it," backed by the honest context argument (Stacktape owns the whole picture).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
---

<BaseLayout
  title="Stacktape — AWS DevOps, fully automated"
  description="Describe your application in one config file. Stacktape compiles it to CloudFormation, deploys it into your own AWS account, and runs the ops: observability, CI/CD, cost and incident response. No DevOps team required."
  font="geist"
  noindex
>
  <nav>
    <div class="nav-inner">
      <a href="/" class="brand"><Logo height={26} /></a>
      <div class="nav-links">
        <a href="https://docs.stacktape.com">Docs</a>
        <a href="https://github.com/stacktape/stacktape">GitHub</a>
        <a href="https://console.stacktape.com/sign-up" class="nav-cta">Sign up</a>
      </div>
    </div>
  </nav>

  <main class="hero">
    <div class="grid">
      <!-- LEFT: copy column -->
      <section class="copy">
        <p class="kicker">Infrastructure &amp; DevOps platform for AWS</p>
        <h1>
          AWS DevOps,<br />
          <span class="accent">fully automated.</span>
        </h1>
        <p class="sub">
          Describe your application in a single config file. Stacktape generates the infrastructure, compiles it to
          plain CloudFormation, deploys it into
          <em>your own AWS account</em>, and then runs the day-to-day ops for you — observability, CI/CD, costs,
          governance, and incident response.
        </p>
        <p class="sub sub-second">
          It's the work a good DevOps team would do. Done continuously, in your account, without hiring one.
        </p>

        <!-- Primary CTA: copyable command with platform switcher -->
        <div class="cta-block">
          <div class="cta-tabs" role="tablist" aria-label="Installation method">
            <button
              class="cta-tab is-active"
              role="tab"
              aria-selected="true"
              data-cmd="npx stacktape init"
              data-label="npx (Node 18+)"
            >
              npx
            </button>
            <button
              class="cta-tab"
              role="tab"
              aria-selected="false"
              data-cmd="curl -L https://installs.stacktape.com/macos.sh | sh"
              data-label="macOS script"
            >
              macOS
            </button>
            <button
              class="cta-tab"
              role="tab"
              aria-selected="false"
              data-cmd="curl -L https://installs.stacktape.com/linux.sh | sh"
              data-label="Linux script"
            >
              Linux
            </button>
            <button
              class="cta-tab"
              role="tab"
              aria-selected="false"
              data-cmd="iwr https://installs.stacktape.com/windows.ps1 -useb | iex"
              data-label="Windows script"
            >
              Windows
            </button>
          </div>
          <div class="cmd-row">
            <span class="cmd-prompt" aria-hidden="true">$</span>
            <code class="cmd" id="cmd-text">npx stacktape init</code>
            <button class="copy-btn" id="copy-btn" aria-label="Copy command">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span id="copy-label">Copy</span>
            </button>
          </div>
          <p class="cta-note" id="cta-note">
            Opens a local wizard that reads your repo and generates the config. The install scripts finish by telling
            you to run <code>stacktape init</code>.
          </p>
        </div>

        <div class="secondary-row">
          <a class="btn btn-secondary" href="https://console.stacktape.com/sign-up">Deploy in Console<span
              class="btn-arrow"
            >→</span></a>
          <a class="btn btn-ghost" href="https://cal.com/stacktape/30min">Book a demo</a>
        </div>

        <ul class="proof">
          <li>VPCs, private-only services, bastions, GPU &amp; Spot</li>
          <li>RBAC, SSO, guardrails, budgets, audit log</li>
          <li>Plain CloudFormation out — no lock-in, ever</li>
        </ul>
      </section>

      <!-- RIGHT: operational ledger -->
      <section class="panel-wrap" aria-label="Stacktape in operation">
        <div class="spine" aria-hidden="true">
          <span class="spine-label">day 0</span>
          <span class="spine-line"></span>
          <span class="spine-label">day 1</span>
        </div>

        <div class="panel">
          <div class="panel-bar">
            <span class="panel-dot dot-r"></span><span class="panel-dot dot-y"></span><span
              class="panel-dot dot-g"
            ></span>
            <span class="panel-title">stacktape — acme-api</span>
            <span class="panel-badge" id="phase-badge">day 0</span>
          </div>
          <div class="panel-body" id="ledger"></div>
        </div>

        <div class="panel-foot">
          <div class="agent-card">
            <div class="agent-head">
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8">
                </path>
                <circle cx="12" cy="12" r="3.2"></circle>
              </svg>
              <strong>Autonomous incident resolution</strong>
              <span class="optin">opt-in</span>
            </div>
            <p>
              Because Stacktape manages your AWS and sees the full observability picture, it can hand an agent exactly
              the right context and tools to fix a failure and deploy the fix. Off by default — nothing runs without
              your approval.
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
:global(body) {
  background: var(--stp-surface-page);
  color: var(--stp-text-primary);
}
.hero {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px 90px;
}
.grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
  gap: 64px;
  align-items: start;
  padding-top: 72px;
}
@media (max-width: 980px) {
  .grid { grid-template-columns: 1fr; gap: 48px; }
  .hero { padding: 0 24px 64px; }
  .spine { display: none; }
}

/* nav */
nav { border-bottom: 1px solid var(--stp-border-subtle); }
.nav-inner {
  max-width: 1200px; margin: 0 auto; padding: 18px 40px;
  display: flex; align-items: center; justify-content: space-between;
}
.nav-links { display: flex; align-items: center; gap: 28px; }
.nav-links a {
  color: var(--stp-text-muted); text-decoration: none; font-size: 14px;
  transition: color var(--stp-motion-duration-fast) var(--stp-motion-easing);
}
.nav-links a:hover { color: var(--stp-text-primary); }
.nav-cta {
  border: 1px solid var(--stp-border-subtle);
  padding: 6px 14px; border-radius: var(--stp-radius-medium);
  color: var(--stp-text-primary) !important;
  background: var(--stp-surface-element);
}
.nav-cta:hover { border-color: var(--stp-color-brand); }
@media (max-width: 980px) { .nav-inner { padding: 16px 24px; } }

/* copy column */
.kicker {
  font-family: var(--font-geist-mono), monospace;
  font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--stp-color-brand); margin: 0 0 22px;
}
h1 {
  font-size: clamp(40px, 4.6vw, 58px);
  line-height: 1.04; font-weight: 600; letter-spacing: -0.025em;
  color: var(--stp-text-headline); margin: 0 0 24px;
}
.accent { color: var(--stp-color-brand); }
.sub {
  font-size: 17px; line-height: 1.6; color: var(--stp-text-muted);
  margin: 0 0 8px; max-width: 54ch;
}
.sub em { color: var(--stp-text-primary); font-style: normal; font-weight: 500; }
.sub-second { margin-bottom: 36px; }

/* CTA block */
.cta-block { margin-bottom: 26px; max-width: 560px; }
.cta-tabs { display: flex; gap: 2px; margin-bottom: -1px; position: relative; z-index: 2; }
.cta-tab {
  background: var(--stp-surface-input);
  color: var(--stp-text-faint);
  border: 1px solid var(--stp-border-subtle);
  border-bottom: none;
  border-radius: var(--stp-radius-medium) var(--stp-radius-medium) 0 0;
  padding: 7px 14px; font-size: 13px; cursor: pointer;
  font-family: var(--font-geist-mono), monospace;
}
.cta-tab.is-active {
  background: var(--stp-surface-element);
  color: var(--stp-color-brand);
  border-color: var(--stp-border-subtle);
}
.cmd-row {
  display: flex; align-items: center; gap: 12px;
  background: var(--stp-surface-input);
  border: 1px solid var(--stp-border-subtle);
  border-radius: var(--stp-radius-medium);
  padding: 14px 16px;
  box-shadow: 0 12px 34px rgba(0, 0, 0, 0.35);
}
.cmd-row:focus-within { border-color: var(--stp-field-focus-border); }
.cmd-prompt { color: var(--stp-color-brand); font-family: var(--font-geist-mono), monospace; font-size: 14px; }
.cmd {
  flex: 1; font-family: var(--font-geist-mono), monospace; font-size: 14.5px;
  color: var(--stp-text-primary); white-space: nowrap; overflow-x: auto;
  scrollbar-width: none;
}
.cmd::-webkit-scrollbar { display: none; }
.copy-btn {
  display: inline-flex; align-items: center; gap: 7px; flex-shrink: 0;
  background: var(--stp-interactive-primary);
  color: rgba(255, 255, 255, 0.92);
  border: 1px solid var(--stp-interactive-primary-light);
  border-radius: var(--stp-radius-small);
  padding: 7px 13px; font-size: 12.5px; cursor: pointer;
  font-family: var(--font-geist), sans-serif;
  transition: background var(--stp-motion-duration-fast) var(--stp-motion-easing);
}
.copy-btn:hover { background: var(--stp-interactive-primary-light); }
.copy-btn.copied { background: var(--stp-status-success); border-color: var(--stp-status-success); }
.cta-note {
  font-size: 12.5px; color: var(--stp-text-faint); margin: 10px 2px 0; line-height: 1.5;
}
.cta-note code { font-family: var(--font-geist-mono), monospace; color: var(--stp-text-subtle); }

.secondary-row { display: flex; gap: 12px; margin-bottom: 40px; flex-wrap: wrap; }
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 11px 20px; border-radius: var(--stp-radius-medium);
  font-size: 14.5px; text-decoration: none; font-weight: 500;
  transition: border-color var(--stp-motion-duration-fast) var(--stp-motion-easing),
    background var(--stp-motion-duration-fast) var(--stp-motion-easing);
}
.btn-secondary {
  background: var(--stp-surface-element);
  border: 1px solid var(--stp-border-subtle);
  color: var(--stp-text-primary);
}
.btn-secondary:hover { border-color: var(--stp-color-brand); }
.btn-arrow { color: var(--stp-color-brand); }
.btn-ghost {
  border: 1px solid transparent; color: var(--stp-text-muted);
}
.btn-ghost:hover { color: var(--stp-text-primary); }

.proof {
  list-style: none; margin: 0; padding: 0;
  border-top: 1px solid var(--stp-border-subtle);
  padding-top: 18px; display: flex; flex-direction: column; gap: 9px;
}
.proof li {
  font-size: 13px; color: var(--stp-text-subtle); display: flex; align-items: center; gap: 10px;
}
.proof li::before {
  content: ""; width: 5px; height: 5px; border-radius: 50%;
  background: var(--stp-color-brand); flex-shrink: 0; opacity: 0.8;
}

/* right panel */
.panel-wrap { position: relative; padding-left: 54px; }
.spine {
  position: absolute; left: 0; top: 0; bottom: 0; width: 54px;
  display: flex; flex-direction: column; align-items: center; gap: 10px;
}
.spine-label {
  font-family: var(--font-geist-mono), monospace; font-size: 10.5px;
  letter-spacing: 0.12em; color: var(--stp-text-faint); text-transform: uppercase;
  writing-mode: horizontal-tb;
}
.spine-line {
  flex: 1; width: 1px;
  background: linear-gradient(to bottom, var(--stp-color-brand), var(--stp-border-subtle) 70%, var(--stp-border-subtle));
}
.panel {
  background: var(--stp-surface-element);
  border: 1px solid var(--stp-border-subtle);
  border-radius: var(--stp-radius-large);
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4), 0 2px 0 rgba(255, 255, 255, 0.02) inset;
}
.panel-bar {
  display: flex; align-items: center; gap: 7px;
  padding: 11px 14px; border-bottom: 1px solid var(--stp-border-subtle);
  background: var(--stp-surface-modal);
}
.panel-dot { width: 10px; height: 10px; border-radius: 50%; opacity: 0.65; }
.dot-r { background: var(--stp-status-error); }
.dot-y { background: #e0b14c; }
.dot-g { background: var(--stp-status-success); }
.panel-title {
  flex: 1; text-align: center; font-family: var(--font-geist-mono), monospace;
  font-size: 12px; color: var(--stp-text-subtle);
}
.panel-badge {
  font-family: var(--font-geist-mono), monospace; font-size: 10.5px;
  color: var(--stp-color-brand); border: 1px solid rgba(54, 190, 190, 0.35);
  padding: 2px 8px; border-radius: 99px; letter-spacing: 0.08em;
}
.panel-body {
  font-family: var(--font-geist-mono), monospace; font-size: 12.5px;
  line-height: 1.75; padding: 16px 18px; min-height: 330px;
  color: var(--stp-text-muted);
  display: flex; flex-direction: column; gap: 2px;
}
.ledger-line { white-space: pre-wrap; word-break: break-word; }
.ledger-line .t { color: var(--stp-text-faint); }
.ledger-line .ok { color: var(--stp-status-success); }
.ledger-line .err { color: var(--stp-status-error); }
.ledger-line .brand { color: var(--stp-color-brand); }
.ledger-line .warn { color: #e0b14c; }
.cursor {
  display: inline-block; width: 7px; height: 14px; vertical-align: -2px;
  background: var(--stp-color-brand); animation: blink 1.1s steps(1) infinite;
}
@keyframes blink { 50% { opacity: 0; } }

.panel-foot { margin-top: 16px; }
.agent-card {
  background: linear-gradient(160deg, rgba(54, 190, 190, 0.07), rgba(54, 190, 190, 0.015));
  border: 1px solid rgba(54, 190, 190, 0.22);
  border-radius: var(--stp-radius-large);
  padding: 16px 18px;
}
.agent-head { display: flex; align-items: center; gap: 9px; margin-bottom: 8px; color: var(--stp-color-brand); }
.agent-head strong { color: var(--stp-text-primary); font-size: 14px; font-weight: 600; }
.optin {
  font-family: var(--font-geist-mono), monospace; font-size: 10px;
  text-transform: uppercase; letter-spacing: 0.1em;
  border: 1px solid rgba(54, 190, 190, 0.4); color: var(--stp-color-brand);
  padding: 1.5px 7px; border-radius: 99px; margin-left: auto;
}
.agent-card p { margin: 0; font-size: 13px; line-height: 1.6; color: var(--stp-text-muted); }

@media (prefers-reduced-motion: reduce) {
  .cursor { animation: none; }
}
</style>

<script>
// ---------- CTA switcher + copy ----------
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.cta-tab'));
  const cmdText = document.getElementById('cmd-text') as HTMLElement;
  const ctaNote = document.getElementById('cta-note') as HTMLElement;
  const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
  const copyLabel = document.getElementById('copy-label') as HTMLElement;

  const notes: Record<string, string> = {
    npx: 'Opens a local wizard that reads your repo and generates the config. The install scripts finish by telling you to run <code>stacktape init</code>.',
    macos: 'Installs the CLI. Then run <code>stacktape init</code> to start the wizard.',
    linux: 'Installs the CLI. Then run <code>stacktape init</code> to start the wizard.',
    windows: 'Installs the CLI. Then run <code>stacktape init</code> to start the wizard.'
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('is-active');
      tab.setAttribute('aria-selected', 'true');
      cmdText.textContent = tab.dataset.cmd ?? '';
      const label = tab.dataset.label?.split(' ')[0]?.toLowerCase();
      const noteKey = tab.textContent?.trim().toLowerCase().startsWith('npx') ? 'npx' : label;
      ctaNote.innerHTML = (noteKey && notes[noteKey]) || notes.npx;
    });
  });

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(cmdText.textContent ?? '');
    } catch {
      const ta = document.createElement('textarea');
      ta.value = cmdText.textContent ?? '';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
    copyBtn.classList.add('copied');
    copyLabel.textContent = 'Copied';
    setTimeout(() => {
      copyBtn.classList.remove('copied');
      copyLabel.textContent = 'Copy';
    }, 1800);
  });

  // ---------- Ledger animation ----------
  const ledger = document.getElementById('ledger') as HTMLElement;
  const badge = document.getElementById('phase-badge') as HTMLElement;

  const script: Array<{ phase: string; cls: string; text: string }> = [
    { phase: 'day 0', cls: 't', text: '$ npx stacktape init' },
    { phase: 'day 0', cls: 'brand', text: '⣿ wizard  analyzing repository… 14 files, nextjs + postgres detected' },
    { phase: 'day 0', cls: '', text: '  generated  stacktape.config.ts  (review & edit anytime)' },
    { phase: 'day 0', cls: 't', text: '$ stacktape deploy --stage prod' },
    { phase: 'day 0', cls: '', text: '  compiling → CloudFormation  ·  vpc, alb, lambda, rds, bucket' },
    { phase: 'day 0', cls: '', text: '  deploying into your AWS account  ·  us-east-1' },
    { phase: 'day 0', cls: 'ok', text: '✔ deployed  api.stacktape.app  ·  3m 42s' },
    { phase: 'day 1', cls: 't', text: '— 6 weeks later —' },
    { phase: 'day 1', cls: 'err', text: '✖ alarm  api p99 latency 2.4s  ·  correlated with release v1.8.3' },
    { phase: 'day 1', cls: 'warn', text: '  root cause  n+1 query introduced in migrations/0042' },
    { phase: 'day 1', cls: 'brand', text: '⣿ agent  fix prepared — awaiting your approval' },
    { phase: 'day 1', cls: 'ok', text: '✔ approved → fixed → v1.8.4 deployed  ·  p99 96ms' },
    { phase: 'day 1', cls: '', text: '  nobody was paged. nothing was guessed.' }
  ];

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let phaseBadgeSet = '';

  function lineNode(entry: { phase: string; cls: string; text: string }) {
    const div = document.createElement('div');
    div.className = 'ledger-line ' + (entry.cls || '');
    div.innerHTML = entry.text.replace(/&/g, '&amp;').replace(/</g, '&lt;');
    return div;
  }

  function setBadge(phase: string) {
    if (phase !== phaseBadgeSet) {
      phaseBadgeSet = phase;
      badge.textContent = phase;
    }
  }

  const cursor = document.createElement('span');
  cursor.className = 'cursor';

  function run() {
    ledger.innerHTML = '';
    ledger.appendChild(cursor);
    phaseBadgeSet = '';
    let i = 0;

    function next() {
      if (i >= script.length) {
        setTimeout(run, 7000);
        return;
      }
      const entry = script[i++];
      setBadge(entry.phase);
      const node = lineNode(entry);
      ledger.insertBefore(node, cursor);
      ledger.scrollTop = ledger.scrollHeight;
      setTimeout(next, reduced ? 300 : 900 + Math.random() * 700);
    }
    next();
  }

  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => { if (e.isIntersecting) { run(); io.disconnect(); } }),
      { threshold: 0.2 }
    );
    io.observe(ledger);
  } else {
    run();
  }
</script>
