/* ── responsive ──────────────────────────────────────────────────────────── */
@media (max-width: 1079px) {
  .sys { grid-template-columns: 30px minmax(0, 1fr); }
  .sys__annot {
    grid-column: 1 / -1;
    position: static;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 2px 14px 14px;
  }
  .annot__chip { position: static; flex: 1 1 150px; }
  .bus, .bus__dot, .annot__cap { display: none; }
}
@media (max-width: 640px) {
  .strip { grid-template-columns: minmax(0, 1fr); }
  .cell + .cell { border-left: 0; border-top: 1px solid rgba(255, 255, 255, 0.07); }
  .hero__inner { padding-left: 20px; padding-right: 20px; }
  .nav__inner { padding-left: 20px; padding-right: 20px; }
}

/* ── motion ──────────────────────────────────────────────────────────────── */
@keyframes stp-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(54, 190, 190, 0.45); }
  55% { box-shadow: 0 0 0 6px rgba(54, 190, 190, 0); }
}
@keyframes stp-bus {
  from { top: 0; }
  to { top: calc(100% - 6px); }
}
@keyframes stp-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}
@keyframes stp-grow {
  from { width: 0; }
}
@keyframes stp-rise {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: none; }
}
.reveal { animation: stp-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both; }
.reveal--1 { animation-delay: 0.06s; }
.reveal--2 { animation-delay: 0.12s; }
.reveal--3 { animation-delay: 0.18s; }
.reveal--4 { animation-delay: 0.24s; }
.reveal--5 { animation-delay: 0.22s; }

@media (prefers-reduced-motion: reduce) {
  .eyebrow__dot, .view__live, .bus__dot, .stage__dot { animation: none; }
  .bar__fill { animation: none; }
  .reveal { animation: none; }
}
</style>

<script>
// Install-method switcher + copy button.
  const cta = document.querySelector('[data-cta]');
  if (cta) {
    const METHODS = {
      npx: 'npx stacktape init',
      macos: 'curl -L https://installs.stacktape.com/macos.sh | sh',
      linux: 'curl -L https://installs.stacktape.com/linux.sh | sh',
      windows: 'iwr https://installs.stacktape.com/windows.ps1 -useb | iex'
    } as const;
    type InstallMethod = keyof typeof METHODS;
    const isInstallMethod = (value: string | undefined): value is InstallMethod =>
      value !== undefined && value in METHODS;
    const HINTS = {
      npx: 'Runs the AI setup wizard straight from the registry — nothing to install.',
      macos: 'Installs the CLI — it finishes by running stacktape init for you.',
      linux: 'Installs the CLI — it finishes by running stacktape init for you.',
      windows: 'Installs the CLI — it finishes by running stacktape init for you.'
    };
    const codeEl = cta.querySelector<HTMLElement>('[data-cmd-code]');
    const hintEl = cta.querySelector<HTMLElement>('[data-cmd-hint]');
    const copyBtn = cta.querySelector<HTMLButtonElement>('[data-cmd-copy]');
    const copyLabel = cta.querySelector<HTMLElement>('[data-cmd-copy-label]');
    const methodButtons = Array.from(cta.querySelectorAll<HTMLButtonElement>('[data-method]'));
    let current: InstallMethod = 'npx';
    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    const setMethod = (id: InstallMethod) => {
      current = id;
      if (codeEl) codeEl.textContent = METHODS[id];
      if (hintEl) hintEl.textContent = HINTS[id];
      copyBtn?.classList.remove('is-copied');
      if (copyLabel) copyLabel.textContent = 'Copy';
      copyBtn?.setAttribute('aria-label', `Copy ${METHODS[id]}`);
      for (const button of methodButtons) {
        const active = button.dataset.method === id;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      }
    };

    for (const button of methodButtons) {
      button.addEventListener('click', () => {
        if (isInstallMethod(button.dataset.method)) setMethod(button.dataset.method);
      });
    }

    copyBtn?.addEventListener('click', async () => {
      if (!navigator.clipboard) return;
      try {
        await navigator.clipboard.writeText(METHODS[current]);
      } catch {
        return;
      }
      copyBtn.classList.add('is-copied');
      if (copyLabel) copyLabel.textContent = 'Copied';
      copyBtn.setAttribute('aria-label', 'Command copied');
      if (resetTimer) clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        copyBtn.classList.remove('is-copied');
        if (copyLabel) copyLabel.textContent = 'Copy';
        copyBtn.setAttribute('aria-label', `Copy ${METHODS[current]}`);
      }, 1600);
    });
  }

  // Keep schema hover popups inside the code pane and the viewport.
  const pane = document.querySelector<HTMLElement>('[data-code-pane]');
  if (pane) {
    const measure = (hover: HTMLElement) => {
      const popup = hover.querySelector<HTMLElement>('.stp-hover-popup');
      if (!popup) return;
      popup.style.removeProperty('--stp-hover-shift');
      hover.removeAttribute('data-stp-hover-above');
      const anchor = hover.getBoundingClientRect();
      const rect = popup.getBoundingClientRect();
      const paneRect = pane.getBoundingClientRect();
      const margin = 12;
      const overflowRight = rect.right - (window.innerWidth - margin);
      const maxShift = Math.max(0, anchor.left - margin);
      if (overflowRight > 0) {
        popup.style.setProperty('--stp-hover-shift', `${-Math.min(overflowRight, maxShift)}px`);
      }
      const fitsBelow = rect.bottom <= paneRect.bottom - margin;
      const fitsAbove = anchor.top - paneRect.top >= rect.height + margin;
      if (!fitsBelow && fitsAbove) hover.setAttribute('data-stp-hover-above', 'true');
    };
    const onEnter = (event: Event) => {
      const target = event.target;
      const hover = target instanceof Element ? target.closest<HTMLElement>('.stp-hover') : null;
      if (hover && pane.contains(hover)) measure(hover);
    };
    pane.addEventListener('pointerenter', onEnter, true);
    pane.addEventListener('focusin', onEnter);
  }
</script>
