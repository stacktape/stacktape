<script>
  /*
   * The install-method switcher and the copy button — the only interactive part of the hero.
   *
   * It never creates elements, only swaps text and classes, so Astro's scoped styles (which are
   * applied at build time to the markup above) keep applying. The server already rendered the
   * default method's command, so the CTA is correct and copyable-by-hand before this runs.
   */
  const root = document.querySelector<HTMLElement>('[data-cmd]');

  if (root) {
    const code = root.querySelector<HTMLElement>('[data-cmd-code]');
    const note = root.querySelector<HTMLElement>('[data-cmd-note]');
    const copyButton = root.querySelector<HTMLButtonElement>('[data-cmd-copy]');
    const copyLabel = root.querySelector<HTMLElement>('[data-cmd-copy-label]');
    const methods = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-method]'));

    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    const select = (chosen: HTMLButtonElement) => {
      const command = chosen.getAttribute('data-command') ?? '';

      for (const method of methods) {
        const isActive = method === chosen;
        method.classList.toggle('is-active', isActive);
        method.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      }

      if (code) code.textContent = command;
      if (note) note.textContent = chosen.getAttribute('data-note') ?? '';
      copyButton?.setAttribute('aria-label', `Copy ${command}`);

      // Switching methods mid-confirmation must not leave a stale "Copied" against a new command.
      clearTimeout(resetTimer);
      root.classList.remove('is-copied');
      if (copyLabel) copyLabel.textContent = 'Copy';
    };

    for (const method of methods) {
      method.addEventListener('click', () => select(method));
    }

    copyButton?.addEventListener('click', async () => {
      const command = code?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(command);
      } catch {
        // Clipboard access is denied in insecure or embedded contexts. The command is selectable
        // text either way, so there is nothing to recover — just don't claim it was copied.
        return;
      }

      root.classList.add('is-copied');
      if (copyLabel) copyLabel.textContent = 'Copied';
      copyButton.setAttribute('aria-label', 'Command copied');

      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        root.classList.remove('is-copied');
        if (copyLabel) copyLabel.textContent = 'Copy';
        copyButton.setAttribute('aria-label', `Copy ${command}`);
      }, 1600);
    });
  }
</script>
