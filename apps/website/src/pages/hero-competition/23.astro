---
// concept: Centered statement hero whose visual is a real-looking "Senior DevOps Engineer" job posting; as the page loads, every responsibility is struck through and replaced by the Stacktape feature that now does it, ending with "Position closed."
// copy-angle: Bold — "AWS DevOps, fully automated." stated flat; the AI-fix line is played confidently but leaves the last word with the user ("if you let it").
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import { CtaCommand } from '../../components/CtaCommand';

const duties = [
  { task: 'Design the VPC, subnets, security groups and load balancers', now: 'Generated by the wizard, from your repo' },
  { task: 'Write and maintain the infrastructure-as-code', now: 'One file — written for you, readable by you' },
  { task: 'Build the CI/CD pipeline and per-branch preview environments', now: 'Built in — a stage per pull request' },
  { task: 'Instrument metrics, logs, traces and alarms', now: 'Wired on the first deploy' },
  { task: 'Be on call for production incidents at 3 a.m.', now: 'An agent investigates — and can fix it, if you let it' },
  { task: 'Keep IAM least-privilege and services private', now: 'The default, not a project' },
  { task: 'Track and reduce the AWS bill', now: 'Cost per resource, no markup — AWS bills you' }
];
---

<BaseLayout
  title="AWS DevOps, fully automated — Stacktape"
  description="An AI wizard writes your AWS infrastructure, one command deploys it into your own account, and everything a DevOps team would run — pipelines, monitoring, incidents, cost — is automated."
  font="geist"
  noindex
>
  <header class="nav">
    <a href="/" aria-label="Stacktape home"><Logo height={22} /></a>
    <nav>
      <a href="https://docs.stacktape.com">Docs</a>
      <a href="https://github.com/stacktape/stacktape">GitHub</a>
      <a class="nav-cta" href="https://console.stacktape.com/sign-up">Sign up</a>
    </nav>
  </header>

  <main class="hero">
    <p class="eyebrow">Infrastructure platform for AWS</p>
    <h1>AWS DevOps,<br />fully automated.</h1>
    <p class="sub">
      An AI wizard reads your repository and writes the infrastructure. One command deploys it into your own AWS
      account — pipelines, monitoring, alarms and incident response already wired. Your developers ship. Stacktape
      does the DevOps.
    </p>

    <div class="ctas">
      <CtaCommand client:visible defaultMethod="npx" />
      <div class="ctas-secondary">
        <a class="btn-primary" href="https://console.stacktape.com/sign-up">Sign up</a>
        <a class="btn-quiet" href="https://cal.com/stacktape/30min">Book a demo <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <section class="posting" aria-label="A DevOps job description, with every duty now handled by Stacktape">
      <div class="posting-head">
        <div>
          <p class="posting-title">Senior DevOps Engineer — AWS</p>
          <p class="posting-meta">Full-time · Remote · Reports to CTO</p>
        </div>
        <span class="posting-pill">Still unfilled</span>
      </div>

      <p class="posting-section">Responsibilities</p>
      <ol class="duties">
        {duties.map((d, i) => (
          <li style={`--i: ${i}`}>
            <span class="task">
              {d.task}
              <span class="strike" aria-hidden="true"></span>
            </span>
            <span class="now">{d.now}</span>
          </li>
        ))}
      </ol>

      <p class="posting-section">Requirements</p>
      <p class="reqs">
        <span class="task">
          5+ years of AWS. Terraform or CDK. Kubernetes. Comfortable with pager duty.
          <span class="strike" aria-hidden="true"></span>
        </span>
        <span class="now">Not required. Developers are enough.</span>
      </p>

      <p class="closed"><span class="tick" aria-hidden="true">✓</span> Position closed. The role is now software — running in your AWS account, as plain CloudFormation you can read.</p>
    </section>
  </main>
</BaseLayout>

<style>
  :root {
    --ink: var(--stp-text-primary);
    --ink-2: rgb(196, 204, 204);
    --ink-3: rgb(140, 150, 150);
    --line: rgba(255, 255, 255, 0.07);
    --brand: var(--stp-color-brand);
  }

  /* ── Nav ─────────────────────────────────────────────────────────── */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1160px;
    margin: 0 auto;
    padding: 22px 28px;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .nav a {
    color: var(--ink-2);
    font-size: 0.92rem;
    text-decoration: none;
    transition: color 150ms ease;
  }
  .nav a:hover {
    color: var(--ink);
  }
  .nav-cta {
    padding: 8px 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    color: var(--ink) !important;
  }

  /* ── Hero ────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    max-width: 1160px;
    margin: 0 auto;
    padding: 64px 28px 120px;
    text-align: center;
  }
  .hero::before {
    /* One soft light behind the headline; the only decoration on the page. */
    content: '';
    position: absolute;
    inset: -80px 0 auto;
    height: 560px;
    background: radial-gradient(60% 55% at 50% 0%, rgba(54, 190, 190, 0.13), transparent 70%);
    pointer-events: none;
  }
  .eyebrow {
    margin: 0 0 22px;
    color: var(--brand);
    font-family: var(--font-geist-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h1 {
    position: relative;
    margin: 0 auto;
    max-width: 14ch;
    font-size: clamp(3.4rem, 7.2vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
    color: var(--ink);
  }
  .sub {
    position: relative;
    max-width: 58ch;
    margin: 28px auto 0;
    color: var(--ink-2);
    font-size: 1.14rem;
    line-height: 1.6;
  }

  /* ── CTAs ────────────────────────────────────────────────────────── */
  .ctas {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin-top: 40px;
  }
  .ctas :global(.cta-command) {
    align-items: center;
  }
  .ctas-secondary {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .btn-primary {
    padding: 12px 22px;
    border-radius: 10px;
    background: var(--brand);
    color: rgb(8, 20, 20);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 8px 28px rgba(54, 190, 190, 0.28);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 34px rgba(54, 190, 190, 0.36);
  }
  .btn-quiet {
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }
  .btn-quiet:hover {
    color: var(--ink);
  }

  /* ── The job posting ────────────────────────────────────────────── */
  .posting {
    position: relative;
    max-width: 760px;
    margin: 88px auto 0;
    padding: 30px 34px 28px;
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.02)),
      var(--stp-surface-page);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 30px 80px rgba(0, 0, 0, 0.45);
    text-align: left;
  }
  .posting-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }
  .posting-title {
    margin: 0;
    font-size: 1.22rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .posting-meta {
    margin: 6px 0 0;
    color: var(--ink-3);
    font-size: 0.88rem;
  }
  .posting-pill {
    flex: none;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(240, 180, 60, 0.12);
    color: rgb(240, 190, 90);
    font-family: var(--font-geist-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }
  .posting-section {
    margin: 22px 0 10px;
    color: var(--ink-3);
    font-family: var(--font-geist-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .duties {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .duties li,
  .reqs {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 18px;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .reqs {
    margin: 0;
    border-bottom: 0;
  }
  .task {
    position: relative;
    color: var(--ink-2);
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .strike {
    position: absolute;
    left: -2px;
    right: -2px;
    top: 52%;
    height: 2px;
    background: var(--brand);
    border-radius: 2px;
    transform: scaleX(1);
    transform-origin: left center;
  }
  .now {
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .now::before {
    content: '→ ';
    color: var(--brand);
  }
  .closed {
    margin: 22px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .tick {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--brand);
    color: rgb(8, 20, 20);
    font-size: 0.72rem;
    font-weight: 700;
    vertical-align: -3px;
  }

  /* ── Motion: the posting is complete at rest; only animate when allowed ── */
  @media (prefers-reduced-motion: no-preference) {
    .duties li .task,
    .reqs .task {
      color: var(--ink);
    }
    .duties li .strike,
    .reqs .strike {
      transform: scaleX(0);
      animation: strike 520ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
      animation-delay: calc(1100ms + var(--i, 7) * 380ms);
    }
    .duties li .task {
      animation: dim 520ms ease forwards;
      animation-delay: calc(1100ms + var(--i, 7) * 380ms);
    }
    .reqs .task {
      animation: dim 520ms ease forwards;
      animation-delay: calc(1100ms + 7 * 380ms);
    }
    .duties li .now,
    .reqs .now {
      opacity: 0;
      transform: translateX(6px);
      animation: arrive 480ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
      animation-delay: calc(1300ms + var(--i, 7) * 380ms);
    }
    .closed {
      opacity: 0;
      animation: arrive 600ms ease forwards;
      animation-delay: 4600ms;
    }
    .duties li,
    .reqs,
    .posting-head,
    .posting-section {
      opacity: 0;
      animation: arrive 500ms ease forwards;
      animation-delay: calc(400ms + var(--i, 0) * 60ms);
    }
  }
  @keyframes strike {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes dim {
    to {
      color: var(--ink-3);
    }
  }
  @keyframes arrive {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .duties li,
    .reqs {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .posting {
      padding: 24px 22px;
    }
  }
</style>
