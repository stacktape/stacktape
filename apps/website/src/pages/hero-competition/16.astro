<script>
const boundary = document.querySelector('[data-agent-boundary]');

  if (boundary) {
    const buttons = boundary.querySelectorAll('[data-agent-mode]');
    const title = boundary.querySelector('[data-decision-title]');
    const copy = boundary.querySelector('[data-decision-copy]');
    const footer = boundary.querySelector('[data-boundary-footer]');

    const setAgentMode = (mode) => {
      const isAuto = mode === 'auto';

      buttons.forEach((button) => {
        const isActive = button.getAttribute('data-agent-mode') === mode;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });

      boundary.classList.toggle('is-auto', isAuto);

      if (title) {
        title.textContent = isAuto ? 'Allowed to resolve and deploy' : 'Prepared for your review';
      }

      if (copy) {
        copy.textContent = isAuto
          ? 'Autonomous action happens only after you explicitly opt in.'
          : 'The agent proposes the change. You decide when it deploys.';
      }

      if (footer) {
        footer.textContent = isAuto ? 'Opt-in boundary · autonomous resolution' : 'Default boundary · review first';
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        setAgentMode(button.getAttribute('data-agent-mode') || 'review');
      });
    });
  }
</script>
