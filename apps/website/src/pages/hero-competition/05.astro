---
// concept: An authoritative asymmetric command hub featuring a multi-stage "Autonomous DevOps Lifecycle Simulator" that interactively demonstrates AI repository scanning, zero-lock-in CloudFormation synthesis, high-speed CI/CD runners, and telemetry-guided incident resolution.
// copy-angle: Pragmatic, enterprise-grade "AWS DevOps, fully automated" stance that appeals to both fast-moving developers and CTOs—showcasing full infrastructure autonomy with transparent CloudFormation escape hatches and opt-in AI agent remediation grounded in complete observability.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
---

<BaseLayout
  title="Stacktape — AWS DevOps, Fully Automated"
  description="From AI-generated infrastructure to automated production CI/CD and telemetry-guided incident resolution. Deploy production-grade AWS in your own account with zero DevOps headcount and zero lock-in."
  font="geist"
  noindex
>
  <!-- Global Navigation -->
  <header class="site-header">
    <div class="nav-container">
      <a href="/" class="brand-link" aria-label="Stacktape Home">
        <Logo height={24} />
      </a>

      <nav class="desktop-nav" aria-label="Main Navigation">
        <a href="https://docs.stacktape.com" class="nav-item" target="_blank" rel="noopener noreferrer">Docs</a>
        <a href="#how-it-works" class="nav-item">How It Works</a>
        <a href="#architecture" class="nav-item">Architecture</a>
        <a href="https://cal.com/stacktape/30min" class="nav-item" target="_blank" rel="noopener noreferrer"
        >Book Demo</a>
      </nav>

      <div class="header-actions">
        <a
          href="https://github.com/stacktape/stacktape"
          class="github-button"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Star Stacktape on GitHub"
        >
          <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          <span class="gh-label">GitHub</span>
          <span class="gh-badge">Star</span>
        </a>

        <a href="https://console.stacktape.com/sign-in" class="nav-item login-link">Sign In</a>
        <a href="https://console.stacktape.com/sign-up" class="cta-nav-button">Get Started</a>
      </div>
    </div>
  </header>

  <main class="hero-section">
    <!-- Ambient Background Glow -->
    <div class="hero-ambient" aria-hidden="true">
      <div class="ambient-glow ambient-glow-top"></div>
      <div class="ambient-glow ambient-glow-bottom"></div>
      <div class="ambient-grid"></div>
    </div>

    <div class="hero-content">
      <!-- Authority Eyebrow -->
      <div class="hero-eyebrow-container">
        <div class="hero-eyebrow">
          <span class="eyebrow-pulse" aria-hidden="true"></span>
          <span class="eyebrow-text">AWS DevOps, Fully Automated · Zero Headcount Needed</span>
        </div>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-heading">
        AWS DevOps, <br class="heading-break" />
        <span class="brand-gradient-text">fully automated.</span>
      </h1>

      <!-- Value Proposition Copy -->
      <p class="hero-subheading">
        Give your engineering team the velocity and depth of an elite AWS platform department. Stacktape analyzes your
        repository, configures production-grade VPC architectures with zero lock-in, runs blazing CI/CD pipelines, and
        resolves production incidents with telemetry-guided, opt-in AI.
      </p>

      <!-- Primary Action Row -->
      <div class="hero-cta-group">
        <!-- Interactive Install & Init Switcher -->
        <div class="cli-command-box" id="cliCommandBox">
          <div class="cli-command-top">
            <span class="cli-prompt" aria-hidden="true">$</span>
            <code class="cli-code" id="cliCodeDisplay">npx stacktape init</code>
            <button
              type="button"
              class="cli-copy-btn"
              id="cliCopyBtn"
              aria-label="Copy install command to clipboard"
            >
              <svg class="copy-icon" viewBox="0 0 14 14" width="13" height="13" fill="none" aria-hidden="true">
                <rect x="4.75" y="1.75" width="7.5" height="7.5" rx="1.6" stroke="currentColor" strokeWidth="1.2" />
                <path
                  d="M9.25 12.25h-6a1.5 1.5 0 0 1-1.5-1.5v-6"
                  stroke="currentColor"
                  strokeWidth="1.2"
                  strokeLinecap="round"
                />
              </svg>
              <svg class="check-icon" viewBox="0 0 14 14" width="13" height="13" fill="none" aria-hidden="true">
                <path
                  d="M2.75 7.5 5.75 10.5 11.25 4"
                  stroke="currentColor"
                  strokeWidth="1.6"
                  strokeLinecap="round"
                  strokeLinejoin="round"
                />
              </svg>
              <span class="copy-text" id="cliCopyText">Copy</span>
            </button>
          </div>

          <!-- Method Switcher Pills -->
          <div class="cli-methods-bar" role="tablist" aria-label="Installation Method Switcher">
            <button
              type="button"
              class="method-btn is-active"
              role="tab"
              aria-selected="true"
              data-cmd="npx stacktape init"
              data-platform="npx"
            >
              npx (Quickstart)
            </button>
            <button
              type="button"
              class="method-btn"
              role="tab"
              aria-selected="false"
              data-cmd="curl -L https://installs.stacktape.com/macos.sh | sh"
              data-platform="mac"
            >
              macOS
            </button>
            <button
              type="button"
              class="method-btn"
              role="tab"
              aria-selected="false"
              data-cmd="curl -L https://installs.stacktape.com/linux.sh | sh"
              data-platform="linux"
            >
              Linux
            </button>
            <button
              type="button"
              class="method-btn"
              role="tab"
              aria-selected="false"
              data-cmd="iwr https://installs.stacktape.com/windows.ps1 -useb | iex"
              data-platform="win"
            >
              Windows
            </button>
          </div>
        </div>

        <!-- Secondary & Tertiary Direct Actions -->
        <div class="secondary-cta-stack">
          <a href="https://console.stacktape.com/sign-up" class="primary-action-btn">
            <span>Deploy in Console</span>
            <svg
              viewBox="0 0 16 16"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              aria-hidden="true"
            >
              <path d="M3.3 8h9.4M8.7 3.3 13.4 8l-4.7 4.7" strokeLinecap="round" strokeLinejoin="round" />
            </svg>
          </a>
          <a
            href="https://cal.com/stacktape/30min"
            class="secondary-action-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              viewBox="0 0 16 16"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              strokeWidth="1.5"
              aria-hidden="true"
            >
              <rect x="2" y="3" width="12" height="11" rx="2" />
              <path d="M2 7h12M5 1.5v3M11 1.5v3" strokeLinecap="round" />
            </svg>
            <span>Book 30-min Technical Demo</span>
          </a>
        </div>
      </div>

      <!-- Trust and Architecture Proof Pillars -->
      <div class="proof-strip">
        <div class="proof-pill">
          <svg
            viewBox="0 0 16 16"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            strokeWidth="1.6"
            class="proof-icon"
            aria-hidden="true"
          >
            <path d="M8 1.5l5.5 3v5c0 3.5-3.5 5.5-5.5 6-2-.5-5.5-2.5-5.5-6v-5l5.5-3z" />
            <path d="m5.5 8 2 2 3.5-3.5" strokeLinecap="round" strokeLinejoin="round" />
          </svg>
          <span>100% In Your AWS Account</span>
        </div>
        <div class="proof-pill">
          <svg
            viewBox="0 0 16 16"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            strokeWidth="1.6"
            class="proof-icon"
            aria-hidden="true"
          >
            <path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h7" strokeLinecap="round" />
          </svg>
          <span>Plain CloudFormation Output</span>
        </div>
        <div class="proof-pill">
          <svg
            viewBox="0 0 16 16"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            strokeWidth="1.6"
            class="proof-icon"
            aria-hidden="true"
          >
            <circle cx="8" cy="8" r="6" />
            <path d="M8 5v3l2 2" strokeLinecap="round" />
          </svg>
          <span>2–5× Faster CI/CD Runners</span>
        </div>
        <div class="proof-pill">
          <svg
            viewBox="0 0 16 16"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            strokeWidth="1.6"
            class="proof-icon"
            aria-hidden="true"
          >
            <path d="M12 2H4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z" />
            <path d="m6 8 4-4M6 12l4-4" strokeLinecap="round" />
          </svg>
          <span>Zero Vendor Lock-in</span>
        </div>
      </div>

      <!-- Interactive "Autonomous DevOps Engine" Workbench -->
      <section class="engine-deck" id="engineDeck" aria-label="DevOps Autopilot Interactive Simulator">
        <!-- Deck Header & Stage Switcher Tabs -->
        <div class="deck-header">
          <div class="deck-meta">
            <span class="deck-badge">LIFECYCLE SIMULATOR</span>
            <span class="deck-caption">Interact with Stacktape's automated pipeline:</span>
          </div>

          <div class="deck-tabs" role="tablist">
            <button
              type="button"
              class="deck-tab is-active"
              role="tab"
              aria-selected="true"
              aria-controls="panel-day0"
              id="tab-day0"
              data-tab="day0"
            >
              <span class="tab-index">01</span>
              <div class="tab-text">
                <span class="tab-title">Day 0: AI Synthesis</span>
                <span class="tab-sub">Repo Scan → CloudFormation</span>
              </div>
            </button>

            <button
              type="button"
              class="deck-tab"
              role="tab"
              aria-selected="false"
              aria-controls="panel-day1"
              id="tab-day1"
              data-tab="day1"
            >
              <span class="tab-index">02</span>
              <div class="tab-text">
                <span class="tab-title">Day 1: Deploy & CI/CD</span>
                <span class="tab-sub">EC2 Runners · 4.0s Redeploy</span>
              </div>
            </button>

            <button
              type="button"
              class="deck-tab"
              role="tab"
              aria-selected="false"
              aria-controls="panel-incident"
              id="tab-incident"
              data-tab="incident"
            >
              <span class="tab-index">03</span>
              <div class="tab-text">
                <span class="tab-title">Autonomous SRE</span>
                <span class="tab-sub">Full Observability + AI Auto-Fix</span>
              </div>
            </button>
          </div>
        </div>

        <!-- Workbench Body: Panels -->
        <div class="deck-viewport">
          <!-- PANEL 1: DAY 0 AI SYNTHESIS -->
          <div class="deck-panel is-active" id="panel-day0" role="tabpanel" aria-labelledby="tab-day0">
            <div class="panel-grid-split">
              <!-- Left: Synthesized Stacktape Config with Escape Hatch -->
              <div class="sub-card code-view-card">
                <div class="card-bar">
                  <div class="traffic-lights" aria-hidden="true">
                    <span class="tl-dot tl-red"></span>
                    <span class="tl-dot tl-yellow"></span>
                    <span class="tl-dot tl-green"></span>
                  </div>
                  <span class="card-tab-title">stacktape.yml</span>
                  <div class="card-status-pill">
                    <span class="status-indicator-green"></span> AI Generated from Repository
                  </div>
                </div>

                <div class="card-body code-body">
                  <pre class="code-pre"><code><span class="c-key">resources</span>:
  <span class="c-res">web</span>:
    <span class="c-prop">type</span>: <span class="c-val">nextjs-web</span>
    <span class="c-prop">properties</span>:
      <span class="c-prop">appDirectory</span>: <span class="c-str">./web</span>
      <span class="c-prop">connectTo</span>: [<span class="c-str">'apiService'</span>]

  <span class="c-res">apiService</span>:
    <span class="c-prop">type</span>: <span class="c-val">web-service</span>
    <span class="c-prop">properties</span>:
      <span class="c-prop">packaging</span>:
        <span class="c-prop">type</span>: <span class="c-val">custom-dockerfile</span>
        <span class="c-prop">properties</span>: &#123; <span class="c-prop">dockerfilePath</span>: <span class="c-str">'./api/Dockerfile'</span> &#125;
      <span class="c-prop">resources</span>: &#123; <span class="c-prop">cpu</span>: <span class="c-num">0.5</span>, <span class="c-prop">memory</span>: <span class="c-num">1024</span> &#125;
      <span class="c-prop">scaling</span>: &#123; <span class="c-prop">minInstances</span>: <span class="c-num">2</span>, <span class="c-prop">maxInstances</span>: <span class="c-num">6</span> &#125;
      <span class="c-prop">connectTo</span>: [<span class="c-str">'mainDatabase'</span>, <span class="c-str">'cache'</span>]

  <span class="c-res">mainDatabase</span>:
    <span class="c-prop">type</span>: <span class="c-val">relational-database</span>
    <span class="c-prop">properties</span>:
      <span class="c-prop">engine</span>:
        <span class="c-prop">type</span>: <span class="c-val">aurora-postgresql</span>
        <span class="c-prop">properties</span>: &#123; <span class="c-prop">version</span>: <span class="c-str">'16.4'</span>, <span class="c-prop">port</span>: <span class="c-num">5432</span> &#125;
      <span class="c-prop">accessibility</span>: &#123; <span class="c-prop">accessibilityMode</span>: <span class="c-str">'vpc'</span> &#125;

  <span class="c-res">cache</span>:
    <span class="c-prop">type</span>: <span class="c-val">redis-cluster</span>
    <span class="c-prop">properties</span>:
      <span class="c-prop">engine</span>: &#123; <span class="c-prop">type</span>: <span class="c-val">redis7</span> &#125;
      <span class="c-prop">instanceSize</span>: <span class="c-str">'cache.t3.micro'</span></code></pre>
                </div>

                <div class="card-footer-info">
                  <span class="cf-sync-badge">
                    <svg
                      viewBox="0 0 16 16"
                      width="12"
                      height="12"
                      fill="none"
                      stroke="currentColor"
                      strokeWidth="1.5"
                      aria-hidden="true"
                    >
                      <path d="M2 8a6 6 0 1 1 1.76 4.24M2 12V8h4" strokeLinecap="round" strokeLinejoin="round" />
                    </svg>
                    Compiles to 33 native CloudFormation resources
                  </span>
                  <span class="escape-hatch-note">CDK Constructs & Raw CFN Escape Hatches Supported</span>
                </div>
              </div>

              <!-- Right: Synthesized Enterprise Architecture Topology -->
              <div class="sub-card topology-card">
                <div class="card-bar">
                  <span class="card-tab-title">Enterprise VPC Topology (Deployed in your AWS)</span>
                  <span class="region-badge">eu-west-1 · production</span>
                </div>

                <div class="topology-body">
                  <!-- VPC Boundary -->
                  <div class="topo-vpc-boundary">
                    <div class="topo-vpc-label">
                      <span class="vpc-tag">Isolated Custom VPC (10.0.0.0/16)</span>
                      <span class="nat-tag">Multi-AZ Nat Gateways · IAM Least Privilege</span>
                    </div>

                    <!-- Public Tier -->
                    <div class="topo-tier public-tier">
                      <div class="tier-label">Public Subnets & Ingress</div>
                      <div class="tier-items">
                        <div class="topo-node edge-node">
                          <span class="node-icon icon-purple">⚡</span>
                          <div class="node-info">
                            <span class="node-name">CloudFront CDN + WAF</span>
                            <span class="node-desc">SSL/TLS Ingress & DDoS Protection</span>
                          </div>
                        </div>
                        <div class="topo-node compute-node">
                          <span class="node-icon icon-orange">▲</span>
                          <div class="node-info">
                            <span class="node-name">web (Next.js SSR)</span>
                            <span class="node-desc">Server Lambda + S3 Assets</span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Private Tier -->
                    <div class="topo-tier private-tier">
                      <div class="tier-label">Private Subnets (Zero Public Access)</div>
                      <div class="tier-items">
                        <div class="topo-node compute-node">
                          <span class="node-icon icon-orange">⚙</span>
                          <div class="node-info">
                            <span class="node-name">apiService (ECS Fargate)</span>
                            <span class="node-desc">2–6 Autoscale Instances</span>
                          </div>
                        </div>
                        <div class="topo-node compute-node">
                          <span class="node-icon icon-green">λ</span>
                          <div class="node-info">
                            <span class="node-name">worker (Lambda Buildpack)</span>
                            <span class="node-desc">Async SQS Task Processing</span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Isolated Data Tier -->
                    <div class="topo-tier data-tier">
                      <div class="tier-label">Private Data Tier</div>
                      <div class="tier-items">
                        <div class="topo-node db-node">
                          <span class="node-icon icon-blue">🗄</span>
                          <div class="node-info">
                            <span class="node-name">mainDatabase (Aurora Postgres 16)</span>
                            <span class="node-desc">Encrypted at rest · Automated Backups</span>
                          </div>
                        </div>
                        <div class="topo-node db-node">
                          <span class="node-icon icon-teal">⚡</span>
                          <div class="node-info">
                            <span class="node-name">cache (Redis 7 Cluster)</span>
                            <span class="node-desc">In-memory caching</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="card-footer-info topology-footer">
                  <span>No shared multi-tenant proxy. Deployed strictly into your AWS account.</span>
                </div>
              </div>
            </div>
          </div>

          <!-- PANEL 2: DAY 1 DEPLOY & CI/CD -->
          <div class="deck-panel" id="panel-day1" role="tabpanel" aria-labelledby="tab-day1">
            <div class="panel-grid-split">
              <!-- Left: Live Deploy Terminal Simulation -->
              <div class="sub-card terminal-card">
                <div class="card-bar">
                  <div class="traffic-lights" aria-hidden="true">
                    <span class="tl-dot tl-red"></span>
                    <span class="tl-dot tl-yellow"></span>
                    <span class="tl-dot tl-green"></span>
                  </div>
                  <span class="card-tab-title">stacktape deploy — production</span>
                  <span class="elapsed-badge">3m 02s</span>
                </div>

                <div class="card-body terminal-body">
                  <div class="term-line prompt-line">
                    <span class="term-prompt">$</span> stacktape deploy --stage production --region eu-west-1
                  </div>
                  <div class="term-status-box">
                    <span class="term-tag-deploying">DEPLOYING</span>
                    <span class="term-proj">acme-app</span>
                    <span class="term-arrow">→</span>
                    <span class="term-stage">production</span>
                    <span class="term-reg">eu-west-1</span>
                  </div>

                  <!-- Phase List -->
                  <div class="term-phases">
                    <div class="phase-row is-done">
                      <span class="phase-glyph">✓</span> Initialize config validation
                    </div>
                    <div class="phase-row is-done">
                      <span class="phase-glyph">✓</span> Package container & buildpacks
                    </div>
                    <div class="phase-row is-running">
                      <span class="phase-glyph">⠿</span> Deploying via CloudFormation <span class="change-count"
                      >+33 create</span>
                    </div>
                  </div>

                  <!-- Discrete Resource Meter -->
                  <div class="term-meter-row">
                    <div class="meter-bar" aria-label="30 of 33 resources deployed">
                      <div class="meter-fill" style="width: 91%;"></div>
                    </div>
                    <div class="meter-meta">
                      <span class="meter-pct">91%</span>
                      <span class="meter-counts">(30/33 resources created)</span>
                    </div>
                  </div>

                  <!-- Live Resource Detail Rows -->
                  <ul class="term-res-list">
                    <li class="term-res is-created">
                      <span class="glyph">✓</span> web · Next.js CDN & SSR Lambda <span class="state">created</span>
                    </li>
                    <li class="term-res is-created">
                      <span class="glyph">✓</span> apiService · Fargate Container Service <span class="state"
                      >created</span>
                    </li>
                    <li class="term-res is-created">
                      <span class="glyph">✓</span> worker · Lambda Event Consumer <span class="state">created</span>
                    </li>
                    <li class="term-res is-created">
                      <span class="glyph">✓</span> cache · Redis 7 Cluster <span class="state">created</span>
                    </li>
                    <li class="term-res is-creating">
                      <span class="glyph spin">⠿</span> mainDatabase · Aurora PostgreSQL 16 <span
                        class="state creating"
                      >creating…</span>
                    </li>
                  </ul>

                  <!-- Incremental Redeploy Note -->
                  <div class="term-fast-redeploy">
                    <div class="redeploy-header">
                      <span class="bolt-icon">⚡</span>
                      <span>Next deploy with only code changes: <strong>4.0s</strong> (skips CloudFormation
                        rebuild)</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Right: Dedicated EC2 GitHub Actions CI/CD Pipeline -->
              <div class="sub-card cicd-card">
                <div class="card-bar">
                  <span class="card-tab-title">Automated CI/CD Pipeline</span>
                  <span class="runner-badge">EC2 Dedicated Runner</span>
                </div>

                <div class="cicd-body">
                  <div class="cicd-flow-list">
                    <div class="cicd-step-item is-done">
                      <div class="step-marker">✓</div>
                      <div class="step-content">
                        <div class="step-title-row">
                          <span class="step-name">Pull Request #128 opened</span>
                          <span class="step-time">by dana</span>
                        </div>
                        <span class="step-detail">feat: checkout payment flow</span>
                      </div>
                    </div>

                    <div class="cicd-step-item is-done">
                      <div class="step-marker">✓</div>
                      <div class="step-content">
                        <div class="step-title-row">
                          <span class="step-name">Build on Dedicated EC2 Runner</span>
                          <span class="step-time">1m 42s</span>
                        </div>
                        <span class="step-detail">Docker layer cache hit · 2–5× faster than CodeBuild</span>
                      </div>
                    </div>

                    <div class="cicd-step-item is-done">
                      <div class="step-marker">✓</div>
