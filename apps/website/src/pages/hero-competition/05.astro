</style>

<script>
// Interactive CLI Platform Switcher
  const cliCodeDisplay = document.getElementById('cliCodeDisplay');
  const cliCopyBtn = document.getElementById('cliCopyBtn');
  const cliCopyText = document.getElementById('cliCopyText');
  const methodButtons = document.querySelectorAll('.method-btn');

  let currentCommand = 'npx stacktape init';

  methodButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      methodButtons.forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');

      const cmd = btn.getAttribute('data-cmd');
      if (cmd && cliCodeDisplay) {
        currentCommand = cmd;
        cliCodeDisplay.textContent = cmd;
      }
    });
  });

  // Copy to Clipboard Interaction
  if (cliCopyBtn) {
    cliCopyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(currentCommand);
        cliCopyBtn.classList.add('is-copied');
        if (cliCopyText) cliCopyText.textContent = 'Copied!';

        setTimeout(() => {
          cliCopyBtn.classList.remove('is-copied');
          if (cliCopyText) cliCopyText.textContent = 'Copy';
        }, 2000);
      } catch (err) {
        // Fallback or ignore in restricted iframe
      }
    });
  }

  // Interactive Deck Tabs Switching
  const deckTabs = document.querySelectorAll('.deck-tab');
  const deckPanels = document.querySelectorAll('.deck-panel');

  deckTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-tab');

      deckTabs.forEach((t) => {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });

      deckPanels.forEach((p) => {
        p.classList.remove('is-active');
      });

      tab.classList.add('is-active');
      tab.setAttribute('aria-selected', 'true');

      const targetPanel = document.getElementById(`panel-${targetId}`);
      if (targetPanel) {
        targetPanel.classList.add('is-active');
      }
    });
  });

  // Interactive AI SRE Remediation Simulation
  const btnApproveFix = document.getElementById('btnApproveFix');
  const approveBtnText = document.getElementById('approveBtnText');
  const fixSuccessBanner = document.getElementById('fixSuccessBanner');
  const agentActionContainer = document.getElementById('agentActionContainer');

  if (btnApproveFix) {
    btnApproveFix.addEventListener('click', () => {
      if (approveBtnText) approveBtnText.textContent = 'Applying RDS Proxy Patch…';
      btnApproveFix.setAttribute('disabled', 'true');

      setTimeout(() => {
        if (agentActionContainer) agentActionContainer.style.display = 'none';
        if (fixSuccessBanner) fixSuccessBanner.style.display = 'flex';
      }, 1200);
    });
  }
</script>
