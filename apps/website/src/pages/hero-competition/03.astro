</style>

<script>
const METHODS = {
    npx: 'npx stacktape init',
    macos: 'curl -L https://installs.stacktape.com/macos.sh | sh',
    linux: 'curl -L https://installs.stacktape.com/linux.sh | sh',
    windows: 'iwr https://installs.stacktape.com/windows.ps1 -useb | iex'
  };

  const root = document.querySelector('[data-cta]');
  if (root) {
    const codeEl = root.querySelector('[data-cta-code]');
    const labelEl = root.querySelector('[data-cta-copy-label]');
    const copyBtn = root.querySelector('[data-cta-copy]');
    const methodBtns = Array.from(root.querySelectorAll('[data-method]'));
    let currentMethod = 'npx';
    let resetTimer;

    const render = () => {
      codeEl.textContent = METHODS[currentMethod];
      copyBtn.setAttribute('aria-label', `Copy ${METHODS[currentMethod]}`);
    };

    methodBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentMethod = btn.dataset.method;
        methodBtns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
        render();
      });
    });

    copyBtn.addEventListener('click', async () => {
      const ok = await copyToClipboard(METHODS[currentMethod]);
      if (!ok) return;
      copyBtn.classList.add('is-copied');
      labelEl.textContent = 'Copied';
      copyBtn.setAttribute('aria-label', 'Command copied');
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        copyBtn.classList.remove('is-copied');
        labelEl.textContent = 'Copy';
        copyBtn.setAttribute('aria-label', `Copy ${METHODS[currentMethod]}`);
      }, 1600);
    });
  }

  async function copyToClipboard(text) {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // fall through to the legacy path
      }
    }
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.opacity = '0';
    document.body.appendChild(area);
    area.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    area.remove();
    return ok;
  }
</script>
