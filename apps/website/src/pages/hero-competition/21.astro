---
// concept: A split-screen command center pairs a direct automation headline with a circular repository-to-recovery operating loop.
// copy-angle: Lead with fully automated AWS DevOps, prove the complete lifecycle, and frame agentic incident resolution as powerful but explicitly opt-in.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import { CtaCommand } from '../../components/CtaCommand';
---

<BaseLayout
  title="AWS DevOps, fully automated | Stacktape"
  description="Turn a repository into AWS infrastructure, deployment, observability, and incident response—all in your own AWS account."
  font="geist"
  noindex
>
  <div class="competition-page">
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>

    <header class="site-nav">
      <div class="nav-rail">
        <a class="brand-link" href="/" aria-label="Stacktape home">
          <Logo height={25} />
        </a>

        <nav class="nav-links" aria-label="Primary navigation">
          <a href="https://docs.stacktape.com">Docs</a>
          <a href="https://github.com/stacktape/stacktape">GitHub</a>
          <a href="https://cal.com/stacktape/30min">Book a demo</a>
        </nav>

        <a class="nav-cta" href="https://console.stacktape.com/sign-up">
          Sign up
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3.5 8h9M8.5 4l4 4-4 4"></path>
          </svg>
        </a>
      </div>
    </header>

    <main class="hero">
      <section class="hero-copy" aria-labelledby="hero-title">
        <div class="eyebrow">
          <span class="eyebrow-mark" aria-hidden="true">
            <span></span>
          </span>
          From repository to recovery
        </div>

        <h1 id="hero-title" class="hero-title">
          AWS DevOps.<br />
          <span>Fully automated.</span>
        </h1>

        <p class="hero-lede">
          Stacktape reads your repository, generates the infrastructure config, and deploys it to your AWS account.
          CI/CD, observability, costs, and incidents stay connected after launch—one system for the full DevOps loop.
        </p>

        <div class="proof-row" aria-label="Platform foundations">
          <span>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="m3.2 8.2 3 3.1 6.7-7"></path>
            </svg>
            Your AWS account
          </span>
          <span>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="m3.2 8.2 3 3.1 6.7-7"></path>
            </svg>
            CloudFormation output
          </span>
          <span>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="m3.2 8.2 3 3.1 6.7-7"></path>
            </svg>
            CDK + raw CFN escape hatches
          </span>
        </div>

        <div class="start-block">
          <p class="start-label">
            <span>Start from your repository</span>
            <span class="start-time">Local AI wizard</span>
          </p>
          <CtaCommand client:visible defaultMethod="npx" className="hero-command" />
        </div>

        <div class="hero-actions">
          <a class="console-action" href="https://console.stacktape.com/sign-up">
            Sign up for Console
            <svg viewBox="0 0 18 18" aria-hidden="true">
              <path d="M4 9h10M10 5l4 4-4 4"></path>
            </svg>
          </a>
          <a class="demo-action" href="https://cal.com/stacktape/30min">
            Book a demo
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="agent-note">
          <span class="agent-shield" aria-hidden="true">
            <svg viewBox="0 0 20 20">
              <path d="M10 2.1 16 4.4v4.8c0 4-2.3 6.8-6 8.7-3.7-1.9-6-4.7-6-8.7V4.4L10 2.1Z"></path>
              <path d="m7.1 10 1.8 1.8 4-4.2"></path>
            </svg>
          </span>
          <p>
            <strong>Autofix, on your terms.</strong>
            Stacktape can give an agent the infrastructure, release, trace, metric, and log context it needs. Review the
            fix—or opt in to resolve and deploy.
          </p>
        </div>
      </section>

      <aside class="visual-wrap" aria-label="Stacktape connects configuration, deployment, operations, and resolution">
        <div class="system-visual" aria-hidden="true">
          <div class="visual-topbar">
            <div class="visual-title">
              <span class="visual-logo">
                <svg viewBox="0 0 18 18">
                  <path d="M3 9.2 8.8 3l1 5.1L15 6.4l-4.2 8.1-.7-4.7L3 12.1Z"></path>
                </svg>
              </span>
              <span>
                <small>STACKTAPE</small>
                <strong>Operating loop</strong>
              </span>
            </div>

            <div class="context-status">
              <span></span>
              Continuous context
            </div>
          </div>

          <div class="loop-stage">
            <svg class="orbit-lines" viewBox="0 0 600 470" preserveAspectRatio="none">
              <defs>
                <linearGradient id="loop-gradient" x1="50" y1="40" x2="550" y2="430">
                  <stop offset="0" stop-color="#36bebe" stop-opacity=".2"></stop>
                  <stop offset=".45" stop-color="#69e4ce" stop-opacity=".8"></stop>
                  <stop offset="1" stop-color="#4d73f4" stop-opacity=".24"></stop>
                </linearGradient>
                <filter id="loop-glow" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="3"></feGaussianBlur>
                </filter>
              </defs>
              <path
                class="orbit-glow"
                d="M300 47C438 47 548 126 548 234c0 109-108 189-248 189S52 343 52 234C52 126 162 47 300 47Z"
              >
              </path>
              <path
                class="orbit-track"
                d="M300 47C438 47 548 126 548 234c0 109-108 189-248 189S52 343 52 234C52 126 162 47 300 47Z"
              >
              </path>
              <path
                class="orbit-flow"
                d="M300 47C438 47 548 126 548 234c0 109-108 189-248 189S52 343 52 234C52 126 162 47 300 47Z"
              >
              </path>
            </svg>

            <span class="orbit-arrow arrow-one">›</span>
            <span class="orbit-arrow arrow-two">›</span>
            <span class="orbit-arrow arrow-three">›</span>
            <span class="orbit-arrow arrow-four">›</span>

            <article class="loop-node node-configure">
              <div class="node-heading">
                <span class="node-icon configure-icon">
                  <svg viewBox="0 0 18 18">
                    <path d="M6.1 3.5H3.8v11h2.3M11.9 3.5h2.3v11h-2.3M7.2 6.3l3.5 2.6-3.5 2.7"></path>
                  </svg>
                </span>
                <span class="step-number">01 · Configure</span>
                <span class="step-check">✓</span>
              </div>
              <strong>Repository understood</strong>
              <span class="node-caption">AI-generated infrastructure config</span>
            </article>

            <article class="loop-node node-deploy">
              <div class="node-heading">
                <span class="node-icon deploy-icon">
                  <svg viewBox="0 0 18 18">
                    <path d="m9 2.8 6 3.1-6 3.2-6-3.2 6-3.1Z"></path>
                    <path d="m3 9.2 6 3.1 6-3.1M3 12.4l6 3 6-3"></path>
                  </svg>
                </span>
                <span class="step-number">02 · Deploy</span>
                <span class="step-check">✓</span>
              </div>
              <strong>CloudFormation applied</strong>
              <span class="node-caption">Deployed into your AWS account</span>
            </article>

            <article class="loop-node node-observe">
              <div class="node-heading">
                <span class="node-icon observe-icon">
                  <svg viewBox="0 0 18 18">
                    <path d="M2.5 10.7h2.2l1.5-5.3 2.4 8.1 2-6.2 1.3 3.4h3.6"></path>
                  </svg>
                </span>
                <span class="step-number">03 · Observe</span>
                <span class="step-check live-check"></span>
              </div>
              <strong>Signals connected</strong>
              <span class="node-caption">Metrics · traces · logs · costs</span>
              <svg class="mini-chart" viewBox="0 0 150 24" preserveAspectRatio="none">
                <path class="chart-fill" d="M0 21 17 18 31 19 45 12 60 15 75 7 92 10 107 4 124 8 138 3 150 5V24H0Z">
                </path>
                <path class="chart-line" d="M0 21 17 18 31 19 45 12 60 15 75 7 92 10 107 4 124 8 138 3 150 5"></path>
              </svg>
            </article>

            <article class="loop-node node-resolve">
              <div class="node-heading">
                <span class="node-icon resolve-icon">
                  <svg viewBox="0 0 18 18">
                    <path d="m9 2 .9 3.2a4 4 0 0 0 2.8 2.8l3.3 1-3.3.9a4 4 0 0 0-2.8 2.8L9 16l-.9-3.3a4 4 0 0 0-2.8-2.8L2 9l3.3-1a4 4 0 0 0 2.8-2.8L9 2Z">
                    </path>
                  </svg>
                </span>
                <span class="step-number">04 · Resolve</span>
                <span class="opt-in">Opt-in</span>
              </div>
              <strong>Incident fix prepared</strong>
              <span class="node-caption">Full context assembled for an agent</span>
              <span class="preview-action">Review &amp; deploy <b>→</b></span>
            </article>

            <section class="aws-core">
              <div class="core-heading">
                <span>
                  <small>Your AWS account</small>
                  <strong>Production</strong>
                </span>
                <span class="managed-badge">
                  <i></i>
                  Managed
                </span>
              </div>

              <div class="core-resources">
                <span class="resource-line"></span>

                <div class="resource">
                  <span class="resource-icon network-resource">
                    <svg viewBox="0 0 22 22">
                      <circle cx="11" cy="11" r="7.5"></circle>
                      <path d="M3.7 11h14.6M11 3.5c2 2.2 3.1 4.7 3.1 7.5S13 16.3 11 18.5C9 16.3 7.9 13.8 7.9 11S9 5.7 11 3.5Z">
                      </path>
                    </svg>
                  </span>
                  <span>Edge</span>
                </div>

                <div class="resource">
                  <span class="resource-icon compute-resource">
                    <svg viewBox="0 0 22 22">
                      <path d="m11 3 7 4v8l-7 4-7-4V7l7-4Z"></path>
                      <path d="m4 7 7 4 7-4M11 11v8"></path>
                    </svg>
                  </span>
                  <span>App</span>
                </div>

                <div class="resource">
                  <span class="resource-icon database-resource">
                    <svg viewBox="0 0 22 22">
                      <ellipse cx="11" cy="5.8" rx="6.6" ry="2.8"></ellipse>
                      <path d="M4.4 5.8v10.3c0 1.6 3 2.9 6.6 2.9s6.6-1.3 6.6-2.9V5.8M4.4 11c0 1.6 3 2.9 6.6 2.9s6.6-1.3 6.6-2.9">
                      </path>
                    </svg>
                  </span>
                  <span>Data</span>
                </div>
              </div>

              <div class="core-footer">
                <span>
                  <i>✓</i>
                  Deployment complete
                </span>
                <span>CloudFormation stack</span>
              </div>
            </section>
          </div>

          <div class="capability-bar">
            <div class="capability network-capability">
              <span></span>
              <p><small>Network</small>VPC · private</p>
            </div>
            <div class="capability governance-capability">
              <span></span>
              <p><small>Governance</small>RBAC · SSO</p>
            </div>
            <div class="capability compute-capability">
              <span></span>
              <p><small>Compute</small>GPU · Spot</p>
            </div>
            <div class="capability control-capability">
              <span></span>
              <p><small>Control</small>CDK · raw CFN</p>
            </div>
          </div>
        </div>
      </aside>
    </main>
  </div>
</BaseLayout>

<style>
.competition-page {
  --page-deep: #0d1212;
  --panel: rgba(27, 35, 35, 0.84);
  --panel-bright: rgba(37, 47, 47, 0.92);
  --hairline: rgba(255, 255, 255, 0.085);
  position: relative;
  min-height: 100svh;
  overflow-x: clip;
  isolation: isolate;
  background:
    radial-gradient(circle at 79% 48%, rgba(54, 190, 190, 0.075), transparent 29rem),
    radial-gradient(circle at 13% 83%, rgba(77, 115, 244, 0.035), transparent 25rem),
    linear-gradient(180deg, #151b1b 0%, var(--page-deep) 100%);
}

.competition-page::before {
  position: absolute;
  z-index: -3;
  inset: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.026) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.026) 1px, transparent 1px);
  background-size: 64px 64px;
  content: '';
  opacity: 0.34;
  -webkit-mask-image: linear-gradient(to bottom, black, transparent 80%);
  mask-image: linear-gradient(to bottom, black, transparent 80%);
}

.ambient {
  position: absolute;
  z-index: -2;
  border-radius: 999px;
  pointer-events: none;
  filter: blur(2px);
}

.ambient-one {
  top: 4rem;
  right: -16rem;
  width: 41rem;
  height: 41rem;
  border: 1px solid rgba(54, 190, 190, 0.08);
  box-shadow:
    0 0 9rem rgba(54, 190, 190, 0.07),
    inset 0 0 8rem rgba(54, 190, 190, 0.025);
}

.ambient-two {
  bottom: -20rem;
  left: -15rem;
  width: 34rem;
  height: 34rem;
  border: 1px solid rgba(77, 115, 244, 0.055);
}

.site-nav {
  position: relative;
  z-index: 10;
  border-bottom: 1px solid rgba(255, 255, 255, 0.055);
  background: rgba(15, 20, 20, 0.3);
  backdrop-filter: blur(16px);
}

.nav-rail {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  width: min(calc(100% - 48px), 1320px);
  height: 78px;
  margin: 0 auto;
}

.brand-link {
  display: inline-flex;
  align-items: center;
}

.nav-links {
  display: flex;
  justify-self: center;
  align-items: center;
  gap: 2rem;
}

.nav-links a {
  color: var(--stp-text-muted);
  font-size: 0.84rem;
  font-weight: 500;
  transition: color var(--stp-motion-duration-fast) var(--stp-motion-easing);
}

.nav-links a:hover {
  color: var(--stp-text-primary);
}

.nav-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.62rem 0.95rem;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 0.65rem;
  background: rgba(255, 255, 255, 0.045);
  color: var(--stp-text-primary);
  font-size: 0.82rem;
  font-weight: 600;
  transition:
    border-color var(--stp-motion-duration-fast) var(--stp-motion-easing),
    background var(--stp-motion-duration-fast) var(--stp-motion-easing);
}

.nav-cta:hover {
  border-color: rgba(54, 190, 190, 0.34);
  background: rgba(54, 190, 190, 0.08);
}

.nav-cta svg {
  width: 15px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.45;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.hero {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(460px, 1.08fr);
  align-items: center;
  gap: clamp(2.25rem, 5vw, 5.5rem);
  width: min(calc(100% - 48px), 1320px);
  min-height: calc(100svh - 78px);
  margin: 0 auto;
  padding: clamp(3.4rem, 6.5vh, 6rem) 0;
}

.hero-copy {
  min-width: 0;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  margin-bottom: 1.45rem;
  color: #87dbce;
  font-family: var(--font-geist-mono);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.eyebrow-mark {
  display: grid;
  width: 1.2rem;
  height: 1.2rem;
  place-items: center;
  border: 1px solid rgba(54, 190, 190, 0.3);
  border-radius: 50%;
  background: rgba(54, 190, 190, 0.07);
}

.eyebrow-mark span {
  width: 0.35rem;
  height: 0.35rem;
  border-radius: 50%;
  background: var(--stp-color-brand);
  box-shadow: 0 0 0.7rem rgba(54, 190, 190, 0.75);
}

.hero-title {
  max-width: 760px;
  margin: 0;
  color: rgba(255, 255, 255, 0.94);
  font-size: clamp(3.45rem, 5.9vw, 5.65rem);
  font-weight: 610;
  letter-spacing: -0.068em;
  line-height: 0.94;
  text-wrap: balance;
}

.hero-title span {
  background: linear-gradient(105deg, #d7fffa 0%, #72dfce 38%, #36bebe 68%, #6e9cff 112%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-lede {
  max-width: 39rem;
  margin: 1.7rem 0 0;
  color: rgba(255, 255, 255, 0.61);
  font-size: clamp(1rem, 1.25vw, 1.14rem);
  line-height: 1.68;
  text-wrap: pretty;
}

.proof-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem 1rem;
  margin-top: 1.45rem;
}

.proof-row span {
  display: inline-flex;
  align-items: center;
  gap: 0.42rem;
  color: rgba(255, 255, 255, 0.53);
  font-size: 0.76rem;
  white-space: nowrap;
}

.proof-row svg {
  width: 13px;
  fill: none;
  stroke: var(--stp-color-brand);
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.start-block {
  max-width: 36rem;
  margin-top: 2rem;
}

.start-label {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin: 0 0 0.65rem;
  color: rgba(255, 255, 255, 0.64);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.015em;
}

.start-time {
  color: rgba(255, 255, 255, 0.34);
  font-family: var(--font-geist-mono);
  font-size: 0.67rem;
  font-weight: 500;
}

:global(.hero-command.cta-command) {
  width: 100%;
  gap: 0.72rem;
}

:global(.hero-command .cta-command__row) {
  width: 100%;
  min-height: 3.55rem;
  padding: 0.72rem 0.75rem 0.72rem 1rem;
  border-radius: 0.85rem;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent),
    rgba(7, 12, 12, 0.78);
  box-shadow:
    inset 0 0 0 1px rgba(54, 190, 190, 0.32),
    0 0 0 4px rgba(54, 190, 190, 0.055),
    0 1rem 3rem rgba(0, 0, 0, 0.24);
}

:global(.hero-command .cta-command__row:hover) {
  box-shadow:
    inset 0 0 0 1px rgba(54, 190, 190, 0.48),
    0 0 0 5px rgba(54, 190, 190, 0.08),
    0 1rem 3rem rgba(0, 0, 0, 0.28);
}

:global(.hero-command .cta-command__code) {
  flex: 1;
  font-size: 0.83rem;
}

:global(.hero-command .cta-command__copy) {
  min-height: 2.15rem;
  border-radius: 0.58rem;
  background: rgba(255, 255, 255, 0.065);
}

:global(.hero-command .cta-command__methods) {
  flex-wrap: wrap;
  border-radius: 0.6rem;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
  margin-top: 1.35rem;
}

.console-action,
.demo-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.75rem;
  border-radius: 0.68rem;
  font-size: 0.81rem;
  font-weight: 620;
  transition:
    transform var(--stp-motion-duration-fast) var(--stp-motion-easing),
    border-color var(--stp-motion-duration-fast) var(--stp-motion-easing),
    background var(--stp-motion-duration-fast) var(--stp-motion-easing);
}

.console-action {
  gap: 0.62rem;
  padding: 0.7rem 1rem;
  border: 1px solid rgba(115, 231, 211, 0.2);
  background: #55cdbb;
  box-shadow: 0 0.7rem 1.8rem rgba(54, 190, 190, 0.12);
  color: #071312;
}

.console-action svg {
  width: 16px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.demo-action {
  gap: 0.45rem;
  padding: 0.7rem 0.9rem;
  border: 1px solid rgba(255, 255, 255, 0.095);
  background: rgba(255, 255, 255, 0.035);
  color: rgba(255, 255, 255, 0.72);
}

.console-action:hover,
.demo-action:hover {
  transform: translateY(-1px);
}

.console-action:hover {
  background: #6ed8c8;
}

.demo-action:hover {
  border-color: rgba(255, 255, 255, 0.17);
  background: rgba(255, 255, 255, 0.06);
}

.agent-note {
  display: flex;
  gap: 0.72rem;
  max-width: 38rem;
  margin-top: 1.5rem;
  padding-top: 1.05rem;
  border-top: 1px solid rgba(255, 255, 255, 0.065);
}

.agent-shield {
  display: grid;
  flex: none;
  width: 1.9rem;
  height: 1.9rem;
  place-items: center;
  border: 1px solid rgba(110, 156, 255, 0.2);
  border-radius: 0.58rem;
  background: rgba(77, 115, 244, 0.075);
  color: #87a8ff;
}

.agent-shield svg {
  width: 16px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.3;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.agent-note p {
  margin: 0;
  color: rgba(255, 255, 255, 0.42);
  font-size: 0.73rem;
  line-height: 1.55;
}

.agent-note strong {
  color: rgba(255, 255, 255, 0.69);
  font-weight: 620;
}

.visual-wrap {
  min-width: 0;
}

.system-visual {
  position: relative;
  display: grid;
  grid-template-rows: 58px minmax(0, 1fr) 62px;
  width: min(100%, 640px);
  height: clamp(570px, 44vw, 640px);
  margin-left: auto;
  overflow: hidden;
  border: 1px solid var(--hairline);
  border-radius: 1.65rem;
  background:
    radial-gradient(circle at 50% 45%, rgba(54, 190, 190, 0.07), transparent 32%),
    linear-gradient(145deg, rgba(33, 43, 43, 0.94), rgba(16, 22, 22, 0.96));
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.045),
    0 2.5rem 7rem rgba(0, 0, 0, 0.38),
    0 0 6rem rgba(54, 190, 190, 0.035);
  container-type: inline-size;
}

.system-visual::before {
  position: absolute;
  inset: 0;
