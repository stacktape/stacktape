</style>

<script>
  /*
   * The YAML pane scrolls, so it would clip the schema popups the build emitted. This lifts each
   * popup out of the pane by fixing it to the viewport and placing it from the hovered key's
   * rectangle. The popup still shows and hides by CSS `:hover` / `:focus-within`; this only decides
   * where. Measured on `pointerenter` / `focusin`, when the popup already has a box.
   */
  const pane = document.getElementById('yaml-pane') as HTMLElement | null;

  if (pane) {
    pane.classList.add('has-portal');
    const margin = 12;

    const place = (hover: HTMLElement): void => {
      const popup = hover.querySelector<HTMLElement>('.stp-hover-popup');
      if (!popup) return;

      // Reset first, so a previous placement does not feed into this measurement.
      popup.style.removeProperty('--stp-portal-x');
      popup.style.removeProperty('--stp-portal-y');

      const anchor = hover.getBoundingClientRect();
      const box = popup.getBoundingClientRect();

      let x = anchor.left;
      if (x + box.width > window.innerWidth - margin) {
        x = Math.max(margin, window.innerWidth - margin - box.width);
      }

      let y = anchor.bottom + 6;
      const roomBelow = window.innerHeight - margin - y;
      if (box.height > roomBelow && anchor.top - 6 - box.height >= margin) {
        y = anchor.top - 6 - box.height;
      }

      popup.style.setProperty('--stp-portal-x', `${Math.round(x)}px`);
      popup.style.setProperty('--stp-portal-y', `${Math.round(y)}px`);
    };

    const onEnter = (event: Event): void => {
      const target = event.target as HTMLElement | null;
      const hover = target?.closest<HTMLElement>('.stp-hover');
      if (hover && pane.contains(hover)) place(hover);
    };

    // Capture, because `pointerenter` does not bubble and there is one listener for every key.
    pane.addEventListener('pointerenter', onEnter, true);
    pane.addEventListener('focusin', onEnter);
  }
</script>
