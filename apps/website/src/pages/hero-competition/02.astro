<script>
// Interactive Tab Controller for DevOps Autopilot Engine Showcase
  function initAutopilotDeck() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.deck-tab');
    const panels = document.querySelectorAll<HTMLElement>('.viewport-panel');
    const titleText = document.getElementById('deck-title-text');

    const titleMap: Record<string, string> = {
      wizard: 'npx stacktape init — Repository Architecture Synthesis',
      arch: 'stacktape deploy — AWS Native Topology & Isolation Engine',
      cicd: 'stacktape console — Real-time CI/CD & CloudWatch Traces',
      remediation: 'stacktape ai-agent — Anomaly Correlation & ChangeSet Proposal'
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        if (!target) return;

        // Update active tab button state
        tabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        // Update active viewport panel
        panels.forEach((p) => {
          if (p.getAttribute('data-panel') === target) {
            p.classList.add('is-visible');
          } else {
            p.classList.remove('is-visible');
          }
        });

        // Update title bar label
        if (titleText && titleMap[target]) {
          titleText.textContent = titleMap[target];
        }
      });
    });

    // Interactive Demo Button for AI Remediation
    const fixBtn = document.getElementById('btn-fix-demo');
    if (fixBtn) {
      fixBtn.addEventListener('click', () => {
        fixBtn.innerHTML = '<span class="btn-check">✓</span><span>CloudFormation Stack Updating...</span>';
        fixBtn.style.background = 'var(--stp-color-brand)';
        setTimeout(() => {
          fixBtn.innerHTML = '<span class="btn-check">✓</span><span>Remediated & Verified (100% Healthy)</span>';
          fixBtn.style.background = '#10b981';
        }, 1800);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAutopilotDeck);
  } else {
    initAutopilotDeck();
  }
</script>
