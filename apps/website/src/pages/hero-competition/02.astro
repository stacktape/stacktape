---
// concept: A centered high-authority command hero with a four-pillar interactive "DevOps Autopilot Deck" that visualizes repository analysis, live AWS architecture topology, telemetry-driven AI self-healing, and zero-lock-in CloudFormation synthesis.
// copy-angle: Uncompromising "AWS DevOps, fully automated" stance tailored for growing teams and engineering leaders—highlighting enterprise-grade AWS depth, zero DevOps headcount, and opt-in AI incident resolution backed by full observability.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import { CtaCommand } from '../../components/CtaCommand.tsx';
---

<BaseLayout
  title="Stacktape — AWS DevOps, Fully Automated"
  description="An AI wizard configures your AWS infrastructure in minutes. One command deploys it into your own AWS account with automated CI/CD, full observability, and opt-in AI incident remediation."
  font="geist"
  noindex
>
  <!-- Background Ambience & Subtle Technical Grid -->
  <div class="bg-scene" aria-hidden="true">
    <div class="scene-glow scene-glow--left"></div>
    <div class="scene-glow scene-glow--right"></div>
    <div class="scene-grid"></div>
    <div class="scene-radial-fade"></div>
  </div>

  <div class="page-container">
    <!-- Top Navigation Bar -->
    <header class="nav-bar">
      <div class="nav-inner">
        <!-- Logo & Platform Badge -->
        <div class="nav-brand-wrap">
          <a href="/" class="nav-brand" aria-label="Stacktape homepage">
            <Logo height={24} />
          </a>
          <span class="nav-badge">
            <span class="nav-badge__dot"></span>
            AWS Native · v2.0
          </span>
        </div>

        <!-- Navigation Links -->
        <nav class="nav-links" aria-label="Primary Navigation">
          <a href="https://docs.stacktape.com" target="_blank" rel="noopener noreferrer" class="nav-link">
            Documentation
            <svg class="nav-link-icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path
                d="M3.5 8.5L8.5 3.5M8.5 3.5H4.5M8.5 3.5V7.5"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
          <a
            href="https://docs.stacktape.com/resources/overview/"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link"
          >
            Supported Resources
          </a>
          <a
            href="https://github.com/stacktape/stacktape"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link nav-link--github"
          >
            <svg class="nav-gh-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8a8.013 8.013 0 005.47 7.59c.4.08.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            <span>GitHub</span>
          </a>
        </nav>

        <!-- Nav Action CTAs -->
        <div class="nav-actions">
          <a href="https://cal.com/stacktape/30min" target="_blank" rel="noopener noreferrer" class="nav-btn-secondary">
            Book Demo
          </a>
          <a href="https://console.stacktape.com/sign-up" class="nav-btn-primary">
            Deploy in Console
          </a>
        </div>
      </div>
    </header>

    <!-- Main Hero Container -->
    <main class="hero-main">
      <!-- Centered Value Proposition -->
      <div class="hero-header">
        <!-- Eyebrow Pill -->
        <div class="hero-pill-wrap">
          <div class="hero-pill">
            <span class="hero-pill__pulse"></span>
            <span class="hero-pill__text">Autonomous AWS Infrastructure Platform</span>
            <span class="hero-pill__divider">·</span>
            <span class="hero-pill__highlight">100% In Your AWS Account</span>
          </div>
        </div>

        <!-- Headline -->
        <h1 class="hero-title">
          AWS DevOps,<br />
          <span class="hero-title__highlight">fully automated.</span>
        </h1>

        <!-- Subheading -->
        <p class="hero-subheading">
          An AI wizard reads your repository and writes production-grade AWS infrastructure. One command deploys it to
          your own AWS account—with automated CI/CD, full-spectrum observability, and intelligent incident
          auto-remediation built in.
        </p>

        <!-- Command Switcher & Primary CTAs -->
        <div class="hero-cta-group">
          <div class="hero-command-card">
            <div class="command-card-header">
              <span class="command-label">Get started in 60 seconds</span>
              <span class="command-meta">No AWS expertise required</span>
            </div>
            <CtaCommand client:visible defaultMethod="npx" className="hero-cta-component" />
          </div>

          <div class="hero-action-buttons">
            <a href="https://console.stacktape.com/sign-up" class="cta-btn-primary">
              <span>Deploy from Browser</span>
              <svg class="cta-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M6 12L10 8L6 4"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
            <a
              href="https://cal.com/stacktape/30min"
              target="_blank"
              rel="noopener noreferrer"
              class="cta-btn-secondary"
            >
              <svg class="cta-cal-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <rect x="2" y="3" width="12" height="11" rx="2" stroke="currentColor" stroke-width="1.3" />
                <path d="M2 7H14M5 1.5V4M11 1.5V4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
              </svg>
              <span>Book 30-min Technical Demo</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Interactive DevOps Autopilot Engine Showcase -->
      <section class="autopilot-deck" aria-label="Interactive Stacktape DevOps Autopilot Showcase">
        <!-- Showcase Navigation Tabs -->
        <div class="deck-tabs site-well" role="tablist" aria-label="Engine capabilities">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-wizard"
            id="tab-wizard"
            class="deck-tab is-active"
            data-tab="wizard"
          >
            <span class="tab-step">01</span>
            <span class="tab-title">AI Repo Wizard</span>
            <span class="tab-badge">Day 0</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-arch"
            id="tab-arch"
            class="deck-tab"
            data-tab="arch"
          >
            <span class="tab-step">02</span>
            <span class="tab-title">Enterprise Architecture</span>
            <span class="tab-badge">Native AWS</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-cicd"
            id="tab-cicd"
            class="deck-tab"
            data-tab="cicd"
          >
            <span class="tab-step">03</span>
            <span class="tab-title">CI/CD & Observability</span>
            <span class="tab-badge">Day 1 Ops</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-remediation"
            id="tab-remediation"
            class="deck-tab"
            data-tab="remediation"
          >
            <span class="tab-step">04</span>
            <span class="tab-title">AI Incident Auto-Fix</span>
            <span class="tab-badge tab-badge--ai">Opt-in</span>
          </button>
        </div>

        <!-- Showcase Screen Surfaces -->
        <div class="deck-screen site-panel">
          <!-- Window Titlebar -->
          <div class="deck-titlebar">
            <div class="deck-traffic-lights" aria-hidden="true">
              <span class="tl-dot tl-dot--red"></span>
              <span class="tl-dot tl-dot--yellow"></span>
              <span class="tl-dot tl-dot--green"></span>
            </div>
            <div class="deck-screen-title" id="deck-view-title">
              <span class="view-status-indicator"></span>
              <span id="deck-title-text">npx stacktape init — Repository Architecture Synthesis</span>
            </div>
            <div class="deck-screen-tags">
              <span class="screen-pill">CloudFormation Native</span>
              <span class="screen-pill screen-pill--accent">Zero Lock-in</span>
            </div>
          </div>

          <!-- Tab Content Panels -->
          <div class="deck-viewport">
            <!-- Panel 1: AI Wizard Analysis -->
            <div
              id="panel-wizard"
              role="tabpanel"
              aria-labelledby="tab-wizard"
              class="viewport-panel is-visible"
              data-panel="wizard"
            >
              <div class="wizard-grid">
                <!-- Left: Interactive Repo Scanner Simulation -->
                <div class="wizard-console">
                  <div class="console-subbar">
                    <span class="console-subbar__path">~/projects/saas-core</span>
                    <span class="console-subbar__status">AI Analysis Complete</span>
                  </div>
                  <div class="wizard-log">
                    <div class="log-row">
                      <span class="log-dim">$</span> <span class="log-cmd">npx stacktape init</span>
                    </div>
                    <div class="log-row log-info">
                      <span class="log-icon">⚡</span> Inspecting repository structure and dependencies...
                    </div>
                    <div class="log-row log-item">
                      <span class="log-check">✓</span> Detected Next.js 15 Web Frontend (App Router, Server
                      Components)
                    </div>
                    <div class="log-row log-item">
                      <span class="log-check">✓</span> Detected Node.js API Service with Fastify & Prisma ORM
                    </div>
                    <div class="log-row log-item">
                      <span class="log-check">✓</span> Detected PostgreSQL schema requirements & Redis queue worker
                    </div>
                    <div class="log-row log-highlight">
                      <span class="log-icon">✨</span> Generated optimal AWS architecture with zero boilerplate:
                    </div>

                    <div class="synthesized-tree">
                      <div class="tree-node">
                        <span class="tree-glyph">├──</span> <strong>vpc:</strong> multi-az, private-isolated
                        subnets, nat gateway
                      </div>
                      <div class="tree-node">
                        <span class="tree-glyph">├──</span> <strong>web:</strong> global edge cdn + serverless
                        fargate
                      </div>
                      <div class="tree-node">
                        <span class="tree-glyph">├──</span> <strong>database:</strong> aurora serverless v2
                        postgres (auto-scaling)
                      </div>
                      <div class="tree-node">
                        <span class="tree-glyph">├──</span> <strong>cache:</strong> redis cluster with in-transit
                        encryption
                      </div>
                      <div class="tree-node">
                        <span class="tree-glyph">└──</span> <strong>telemetry:</strong> otel traces, cloudwatch
                        logs, anomaly alarms
                      </div>
                    </div>

                    <div class="log-row log-ready">
                      <span class="log-icon">🚀</span> Compiling directly to pure AWS CloudFormation template...
                    </div>
                  </div>
                </div>

                <!-- Right: Generated Config Inspector -->
                <div class="wizard-code-preview">
                  <div class="code-preview-header">
                    <div class="file-tab is-active">
                      <svg class="file-icon" viewBox="0 0 14 14" fill="currentColor">
                        <path d="M2 1.5A1.5 1.5 0 013.5 0h4.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 01.439 1.061V12.5A1.5 1.5 0 0110.5 14h-7A1.5 1.5 0 012 12.5v-11z" />
                      </svg>
                      stacktape.ts
                    </div>
                    <span class="file-meta">TypeScript Type-Checked Config</span>
                  </div>
                  <pre class="code-block"><code><span class="c-kw">import</span> &#123; defineConfig &#125; <span class="c-kw">from</span> <span class="c-str">'stacktape'</span>;

<span class="c-kw">export default</span> defineConfig(&#123;
  serviceName: <span class="c-str">'saas-platform'</span>,
  resources: &#123;
    <span class="c-comment">// Auto-configured VPC, isolated subnets & security groups</span>
    primaryVpc: &#123; type: <span class="c-str">'vpc'</span>, multiAz: <span class="c-bool">true</span> &#125;,

    <span class="c-comment">// Auto-scaling container with HTTPS & least-privilege IAM</span>
    apiService: &#123;
      type: <span class="c-str">'web-service'</span>,
      properties: &#123;
        container: &#123; directory: <span class="c-str">'./apps/api'</span> &#125;,
        connectTo: [<span class="c-str">'mainDatabase'</span>, <span class="c-str">'redisCache'</span>]
      &#125;
    &#125;,

    <span class="c-comment">// Managed Aurora PostgreSQL with automatic daily backups</span>
    mainDatabase: &#123;
      type: <span class="c-str">'aurora-postgres'</span>,
      properties: &#123; minCapacity: <span class="c-num">0.5</span>, maxCapacity: <span class="c-num">16</span> &#125;
    &#125;
  &#125;
&#125;);</code></pre>
                </div>
              </div>
            </div>

            <!-- Panel 2: Enterprise Architecture Visualizer -->
            <div
              id="panel-arch"
              role="tabpanel"
              aria-labelledby="tab-arch"
              class="viewport-panel"
              data-panel="arch"
            >
              <div class="arch-canvas">
                <div class="arch-toolbar">
                  <span class="arch-pill">Target: AWS Account #4920-1823-9012 (us-east-1)</span>
                  <span class="arch-pill arch-pill--sec">VPC Isolation · 0 Public DB Ports</span>
                  <span class="arch-pill arch-pill--cfn">CloudFormation Native</span>
                </div>

                <!-- Interactive Architecture Diagram Representation -->
                <div class="arch-diagram-grid">
                  <!-- Layer 1: Edge & Ingress -->
                  <div class="arch-box arch-box--edge">
                    <div class="box-head">
                      <span class="box-dot box-dot--purple"></span>
                      <span class="box-name">AWS Edge & Ingress</span>
                    </div>
                    <div class="box-items">
                      <div class="arch-chip"><span class="chip-icon">🌐</span> CloudFront CDN</div>
                      <div class="arch-chip"><span class="chip-icon">🔒</span> AWS WAF + SSL</div>
                      <div class="arch-chip"><span class="chip-icon">⚖️</span> App Load Balancer</div>
                    </div>
                  </div>

                  <!-- Layer 2: Private Compute Cluster -->
                  <div class="arch-box arch-box--compute">
                    <div class="box-head">
                      <span class="box-dot box-dot--orange"></span>
                      <span class="box-name">Private Compute (VPC Subnets)</span>
                    </div>
                    <div class="box-items">
                      <div class="arch-chip"><span class="chip-icon">⚡</span> ECS Fargate API (Auto-scale 2-20)</div>
                      <div class="arch-chip"><span class="chip-icon">λ</span> Background Lambdas (ARM64)</div>
                      <div class="arch-chip"><span class="chip-icon">⚙️</span> Async SQS Queue Workers</div>
                    </div>
                  </div>

                  <!-- Layer 3: Persistence & Storage -->
                  <div class="arch-box arch-box--storage">
                    <div class="box-head">
                      <span class="box-dot box-dot--blue"></span>
                      <span class="box-name">Data & Persistence</span>
                    </div>
                    <div class="box-items">
                      <div class="arch-chip"><span class="chip-icon">🐘</span> Aurora Serverless PostgreSQL</div>
                      <div class="arch-chip"><span class="chip-icon">⚡</span> ElastiCache Redis Cluster</div>
                      <div class="arch-chip"><span class="chip-icon">🪣</span> S3 Private Assets (Encrypted)</div>
                    </div>
                  </div>

                  <!-- Layer 4: Governance & Security -->
                  <div class="arch-box arch-box--security">
                    <div class="box-head">
                      <span class="box-dot box-dot--green"></span>
                      <span class="box-name">Security & Zero-Lockin Guarantee</span>
                    </div>
                    <div class="box-items">
                      <div class="arch-chip"><span class="chip-icon">🛡️</span> IAM Least-Privilege Roles</div>
                      <div class="arch-chip"><span class="chip-icon">📜</span> Pure CloudFormation Stacks</div>
                      <div class="arch-chip"><span class="chip-icon">🔑</span> AWS Secrets Manager</div>
                    </div>
                  </div>
                </div>

                <div class="arch-footer">
                  <span class="arch-note">
                    <svg class="note-icon" viewBox="0 0 14 14" fill="none">
                      <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                    Need CDK or custom CloudFormation? Stacktape offers native raw CFN & CDK construct escape hatches.
                  </span>
                </div>
              </div>
            </div>

            <!-- Panel 3: CI/CD & Observability -->
            <div
              id="panel-cicd"
              role="tabpanel"
              aria-labelledby="tab-cicd"
              class="viewport-panel"
              data-panel="cicd"
            >
              <div class="cicd-grid">
                <!-- Left: Real-time Stages & Git Flow -->
                <div class="cicd-stages-card">
                  <div class="card-caption">Staging & Production Pipelines</div>
                  <div class="stage-entry stage-entry--prod">
                    <div class="stage-info">
                      <span class="stage-status-pulse"></span>
                      <span class="stage-name">production</span>
                      <span class="stage-branch">main · 4m ago</span>
                    </div>
                    <div class="stage-metrics-summary">
                      <span class="metric-tag">4 Containers</span>
                      <span class="metric-tag">p99: 38ms</span>
                      <span class="metric-tag metric-tag--success">100% Health</span>
                    </div>
                  </div>

                  <div class="stage-entry stage-entry--pr">
                    <div class="stage-info">
                      <span class="stage-status-deploying"></span>
                      <span class="stage-name">pr-142-payments</span>
                      <span class="stage-branch">feat/stripe-v2 · Deploying...</span>
                    </div>
                    <div class="stage-metrics-summary">
                      <span class="metric-tag metric-tag--deploy">Preview Environment</span>
                      <span class="metric-tag">Auto-tear-down</span>
                    </div>
                  </div>

                  <div class="runner-badge">
                    <span class="runner-icon">🏎️</span>
                    <span>Self-Hosted EC2 GitHub Runner: <strong>3.2x faster builds, 80% cheaper</strong></span>
                  </div>
                </div>

                <!-- Right: Telemetry & Tracing Waterfall -->
                <div class="telemetry-card">
                  <div class="card-caption">Distributed Trace Waterfall (Live CloudWatch)</div>
                  <div class="trace-waterfall">
                    <div class="trace-row">
                      <div class="trace-label">GET /api/checkout/session</div>
                      <div class="trace-bar-wrap">
                        <div class="trace-bar trace-bar--api" style="width: 85%;">42ms</div>
                      </div>
                    </div>
                    <div class="trace-row trace-row--sub">
                      <div class="trace-label">↳ auth.verifySession (JWT)</div>
                      <div class="trace-bar-wrap">
                        <div class="trace-bar trace-bar--auth" style="width: 25%; margin-left: 5%;">3.8ms</div>
                      </div>
                    </div>
                    <div class="trace-row trace-row--sub">
                      <div class="trace-label">↳ prisma.user.findUnique</div>
                      <div class="trace-bar-wrap">
                        <div class="trace-bar trace-bar--db" style="width: 32%; margin-left: 30%;">5.2ms</div>
                      </div>
                    </div>
                    <div class="trace-row trace-row--sub">
                      <div class="trace-label">↳ redis.hget (cached_tenant)</div>
                      <div class="trace-bar-wrap">
                        <div class="trace-bar trace-bar--redis" style="width: 14%; margin-left: 62%;">1.1ms</div>
                      </div>
                    </div>
                  </div>
                  <div class="telemetry-footer">
                    <span class="tel-stat">Metrics: <strong>Real-time</strong></span>
                    <span class="tel-stat">Logs: <strong>Zero config</strong></span>
                    <span class="tel-stat">Alarms: <strong>Pre-wired</strong></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Panel 4: AI Incident Auto-Fix -->
            <div
              id="panel-remediation"
              role="tabpanel"
              aria-labelledby="tab-remediation"
              class="viewport-panel"
              data-panel="remediation"
            >
              <div class="remediation-grid">
                <!-- Incident Summary -->
                <div class="incident-card">
                  <div class="incident-header">
                    <span class="incident-pill incident-pill--danger">CRITICAL ISSUE DETECTED</span>
                    <span class="incident-time">2 mins ago · production</span>
                  </div>
                  <h4 class="incident-title">Database Connection Pool Exhaustion</h4>
                  <p class="incident-desc">
                    ECS task cluster reached 100% max_connections under traffic burst. Correlated with deployment <code
                    >sha-81f2a</code>.
                  </p>

                  <div class="agent-context-box">
                    <div class="context-head">
                      <span class="context-icon">🧠</span>
                      <strong>Autonomous AI Agent Context</strong>
                      <span class="context-badge">Full Observability Feed</span>
                    </div>
                    <ul class="context-list">
                      <li>✓ Stacktape provides agent with exact CloudWatch metrics & RDS logs</li>
                      <li>✓ Agent reads schema & infrastructure configuration in <code>stacktape.ts</code></li>
                      <li>✓ Agent formulates non-breaking fix & generates targeted pull request</li>
                    </ul>
                  </div>
                </div>

                <!-- Proposed AI Resolution -->
                <div class="solution-card">
                  <div class="solution-head">
                    <span class="solution-pill">PROPOSED REMEDIATION</span>
                    <span class="solution-action">Human-in-the-loop: Ready</span>
                  </div>

                  <div class="diff-block">
                    <div class="diff-header">stacktape.ts (Patch proposed by Claude)</div>
                    <pre class="diff-code"><code>  mainDatabase: &#123;
    type: 'aurora-postgres',
    properties: &#123;
<span class="diff-del">-     maxCapacity: 2,</span>
<span class="diff-add">+     maxCapacity: 8,</span>
<span class="diff-add">+     enableRdsProxy: true, // Connection pooling buffer</span>
    &#125;
  &#125;</code></pre>
                  </div>

                  <div class="solution-actions">
                    <button type="button" class="btn-approve" id="btn-fix-demo">
                      <span class="btn-check">✓</span>
                      <span>Approve & Deploy Fix to AWS</span>
                    </button>
                    <span class="approval-note">1-click rollout via CloudFormation ChangeSet</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Authority & Architectural Depth Proof Grid -->
      <section class="proof-matrix" aria-label="Enterprise AWS Capabilities">
        <div class="matrix-card">
          <div class="matrix-icon matrix-icon--account">
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M10 2a8 8 0 100 16 8 8 0 000-16zM4 10a6 6 0 1112 0 6 6 0 01-12 0z"
                clip-rule="evenodd"
              />
              <path d="M10 6a1 1 0 011 1v2.586l1.707 1.707a1 1 0 01-1.414 1.414l-2-2A1 1 0 019 9.586V7a1 1 0 011-1z" />
            </svg>
          </div>
          <h3 class="matrix-title">100% In Your AWS Account</h3>
          <p class="matrix-desc">
            Stacktape compiles directly to native CloudFormation and provisions into your existing AWS account. Zero
            proprietary runtime proxies, zero vendor markup, and complete data sovereignty.
          </p>
          <span class="matrix-foot">Standard AWS Pricing · Zero Markup</span>
        </div>

        <div class="matrix-card">
          <div class="matrix-icon matrix-icon--depth">
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
