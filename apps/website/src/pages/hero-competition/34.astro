---
// concept: Day 1 first — a full-width headline band (eyebrow, headline, narrow subheadline, the command CTA and Book a demo on one row) above a full-width Console browser window that shows one production incident of acme-project from every side: the issue inbox with the agent's proposed fix, the release it followed, the worker metrics with the error spike and the request trace — no config editor, no isometric diagram.
// copy-angle: Argues from operations instead of provisioning — "AWS DevOps, automated. The deploy is the easy part." — plays the agent boldly (the incident arrives matched to the release, traces attached, fix proposed) and gates it visibly (a person approves what ships, unattended fixes are opt-in); enterprise proof is observability depth rather than architecture, and day 0 gets exactly one line.
// direction: rejects
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import { CtaCommand } from '../../components/CtaCommand';
import { BrowserFrame } from '../../surfaces/frames/BrowserFrame';
import { Chevron, ConsoleNav } from '../../surfaces/StageOverview/ConsoleNav';
import { IssuesInbox } from '../../surfaces/IssuesInbox/IssuesInbox';
import { MetricsPanel } from '../../surfaces/MetricsPanel';
import { TraceWaterfall } from '../../surfaces/TraceWaterfall';
import { ORG_NAME, PROJECT_NAME, REGION } from '../../surfaces/story';

/* The CTO's checklist, one line each. Architecture is proof here, not the argument. */
const proof = [
  'Your AWS account, plain CloudFormation',
  'VPC, private subnets, least-privilege IAM',
  'Fargate, Lambda, Aurora, Redis, GPU jobs',
  'SSO, RBAC, budgets, guardrails, audit',
  'CDK and raw CloudFormation escape hatches'
];

/* The address pill names a place inside the Console. It is a picture, not a link. */
const frameUrl = `${PROJECT_NAME} / production / issues`;
---

<BaseLayout
  title="AWS DevOps, automated. The deploy is the easy part. — Stacktape"
  description="Stacktape generates the infrastructure config from your repository, deploys it into your own AWS account and then runs it: metrics, traces, logs, alarms, and incidents matched to the release that introduced them, with a fix proposed for a person to approve."
  font="geist"
  noindex
>
  <header class="nav">
    <a href="/" aria-label="Stacktape home"><Logo height={22} /></a>
    <nav>
      <a href="https://docs.stacktape.com">Docs</a>
      <a href="https://github.com/stacktape/stacktape">GitHub</a>
      <a class="nav-cta" href="https://cal.com/stacktape/30min">Book a demo</a>
    </nav>
  </header>

  <main>
    <section class="band">
      <p class="eyebrow">AWS · from the first deploy to the next incident</p>
      <h1>AWS DevOps, automated.<br /><span class="muted">The deploy is the easy part.</span></h1>
      <p class="sub">
        One command reads your repository, writes the infrastructure config and deploys it into your own AWS account.
        Then Stacktape runs it: metrics, traces, logs and alarms are built in, and a failure arrives as an incident
        already matched to the release that introduced it, with the traces attached and a fix proposed.
        <b>You approve what ships. Unattended fixes are opt-in.</b>
      </p>

      <div class="ctas">
        <CtaCommand client:visible defaultMethod="npx" />
        <a class="btn-quiet" href="https://cal.com/stacktape/30min">Book a demo <span aria-hidden="true">→</span></a>
      </div>

      <ul class="proof" aria-label="What gets built, and how it is governed">
        {proof.map((item, i) => <li style={`--i: ${i}`}>{item}</li>)}
      </ul>
    </section>

    <section class="stage" aria-label="The Console, on one production incident of acme-project">
      <div class="stage-head">
        <p class="stage-title">Day 1 <span class="dim">/ {PROJECT_NAME} / production</span></p>
        <p class="stage-meta">One incident, seen from the issue, the release, the metrics and the trace.</p>
      </div>

      <div class="shell-wrap">
        <BrowserFrame url={frameUrl}>
          <div class="shell">
            <header class="console__topbar">
              <span class="console__brand">
                <svg aria-hidden="true" class="mark" fill="none" height="20" viewBox="0 0 42 49" width="18">
                  <path
                    d="M41.7636 14.3985L37.4928 37.8262L13.8142 45.812C13.4647 45.934 13.0741 45.8036 12.8578 45.5013L0.253235 27.8495C0.22812 27.8199 0.203008 27.7825 0.182777 27.7487C0.0662745 27.5725 0 27.3625 0 27.1356C0 27.0813 0.0041868 27.0264 0.0125582 26.9721L1.89613 26.3378L25.0633 18.5204L40.5867 13.2822C41.2355 13.0624 41.8927 13.6839 41.7636 14.3985Z"
                    fill="url(#stp-34-mark-a)"></path>
                  <path
                    d="M25.0635 18.5195L1.89626 26.3376L0.0126953 26.9719C0.0378096 26.7999 0.099898 26.6442 0.191286 26.5054C0.195472 26.5011 0.199656 26.4927 0.208028 26.4842L0.345457 26.3242L22.2235 0.728862C22.6183 0.266567 23.3669 0.548453 23.4255 1.1827L25.0635 18.5195Z"
                    fill="url(#stp-34-mark-b)"></path>
                  <path
                    d="M37.493 37.8262L29.4369 48.1848C29.0434 48.7662 28.1616 48.4928 28.0891 47.7669L27.4473 41.2145L37.493 37.8262Z"
                    fill="url(#stp-34-mark-c)"></path>
                  <defs>
                    <linearGradient gradientUnits="userSpaceOnUse" id="stp-34-mark-a" x1="20.3" x2="22" y1="9.9" y2="42.3">
                      <stop stop-color="#70C8B6"></stop>
                      <stop offset="1" stop-color="#0097A1"></stop>
                    </linearGradient>
                    <linearGradient gradientUnits="userSpaceOnUse" id="stp-34-mark-b" x1="10.6" x2="12.6" y1="-2" y2="23.3">
                      <stop stop-color="#70C8B6"></stop>
                      <stop offset="1" stop-color="#0097A1"></stop>
                    </linearGradient>
                    <linearGradient gradientUnits="userSpaceOnUse" id="stp-34-mark-c" x1="33.3" x2="32.7" y1="47" y2="40.6">
                      <stop stop-color="#70C8B6"></stop>
                      <stop offset="1" stop-color="#0097A1"></stop>
                    </linearGradient>
                  </defs>
                </svg>
                <span class="console__wordmark">Stacktape</span>
              </span>

              <span class="console__crumbs">
                <span class="console__crumb">{ORG_NAME}<Chevron /></span>
                <span class="console__crumb-sep">/</span>
                <span class="console__crumb">{PROJECT_NAME}<Chevron /></span>
                <span class="console__crumb-sep">/</span>
                <span class="console__crumb is-current">production<Chevron /></span>
              </span>

              <span class="console__topbar-actions">
                <span class="console__topbar-item region">{REGION}</span>
                <span class="console__topbar-item">Help<Chevron /></span>
                <span class="console__topbar-item">JD<Chevron /></span>
              </span>
            </header>

            <div class="shell-body">
              <ConsoleNav />

              <div class="ops">
                <section class="incident" aria-label="Incident summary">
                  <div class="incident-main">
                    <p class="incident-status">
                      <span class="pulse" aria-hidden="true"></span>
                      <span class="is-open">Open incident</span>
                      <span class="sep" aria-hidden="true">·</span>
                      <span>worker</span>
                      <span class="sep" aria-hidden="true">·</span>
                      <span>production</span>
                      <span class="sep" aria-hidden="true">·</span>
                      <span>{REGION}</span>
                    </p>
                    <p class="incident-title">
                      Errors in <b>worker</b> started 3 minutes after <b>release #128</b>
                      <span class="release">feat: checkout flow</span> reached production.
                    </p>
                    <ul class="incident-facts">
                      <li><b>47</b> occurrences</li>
                      <li>Alarm <b>worker · errors</b> triggered</li>
                      <li>Trace and logs attached</li>
                    </ul>
                  </div>

                  <div class="incident-agent">
                    <p class="agent-label">Agent · fix proposed · waiting for approval</p>
                    <p class="agent-body">
                      <code>handleCheckout</code> reads <code>order.items</code> on jobs that carry no order. Proposed:
                      validate the job payload and skip the job.
                      <span class="agent-diff">api/src/worker.ts · +4 −1</span>
                    </p>
                    <div class="agent-controls">
                      <span class="ctl ctl-primary">Review &amp; approve</span>
                      <span class="ctl">Discard</span>
                      <span class="toggle">
                        <span class="toggle-track" aria-hidden="true"><span class="toggle-knob"></span></span>
                        Unattended fixes <b>Off</b>
                      </span>
                    </div>
                  </div>
                </section>

                <IssuesInbox />

                <div class="strip">
                  <div class="strip-col metrics-col">
                    <p class="strip-label">Metrics <span>worker · invocations and errors · last 3 hours</span></p>
                    <MetricsPanel />
                  </div>
                  <div class="strip-col trace-col">
                    <p class="strip-label">Traces <span>the request that hands the job to worker</span></p>
                    <TraceWaterfall />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </BrowserFrame>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :root {
    --ink: var(--stp-text-primary);
    --ink-2: rgb(196, 204, 204);
    --ink-3: rgb(138, 148, 148);
    --line: rgba(255, 255, 255, 0.07);
    --brand: var(--stp-color-brand);
    --error: var(--stp-status-error);
  }

  /* ── Nav ──────────────────────────────────────────────────────────────── */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1360px;
    margin: 0 auto;
    padding: 22px 28px;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .nav a {
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .nav a:hover {
    color: var(--ink);
  }
  .nav-cta {
    padding: 8px 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    color: var(--ink) !important;
  }

  /* ── Headline band ────────────────────────────────────────────────────── */
  .band {
    max-width: 1360px;
    margin: 0 auto;
    padding: 46px 28px 36px;
  }
  .eyebrow {
    margin: 0 0 18px;
    color: var(--brand);
    font-family: var(--font-geist-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 4.6vw, 4.15rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: var(--ink);
  }
  .muted {
    color: var(--ink-3);
  }
  .sub {
    max-width: 66ch;
    margin: 24px 0 0;
    color: var(--ink-2);
    font-size: 1.05rem;
    line-height: 1.62;
  }
  .sub b {
    color: var(--ink);
    font-weight: 500;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 14px 26px;
    margin-top: 30px;
  }
  .btn-quiet {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    /* Centred on the command row, not on the switcher under it. */
    margin-top: 10px;
    color: var(--ink-2);
    font-weight: 500;
  }
  .btn-quiet:hover {
    color: var(--ink);
  }
  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 28px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .proof li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ink-3);
    font-size: 0.8rem;
  }
  .proof li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--brand);
    opacity: 0.8;
  }

  /* ── The stage: one Console window, full width ────────────────────────── */
  .stage {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    padding: 14px 28px 110px;
  }
  .stage::before {
    content: '';
    position: absolute;
    left: 14%;
    right: 14%;
    top: 30px;
    height: 380px;
    background: radial-gradient(closest-side, rgba(54, 190, 190, 0.16), transparent);
    filter: blur(30px);
    pointer-events: none;
  }
  .stage-head {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 16px;
    margin: 0 0 14px;
  }
  .stage-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-geist-mono);
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .dim {
    color: var(--ink-3);
    font-weight: 400;
  }
  .stage-meta {
    margin: 0;
    color: var(--ink-3);
    font-size: 0.82rem;
  }
  .shell-wrap {
    position: relative;
  }
  .shell-wrap :global(.surface-frame) {
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.09),
      0 50px 120px -40px rgba(0, 0, 0, 0.8),
      0 0 160px rgba(54, 190, 190, 0.06);
  }

  /* ── Console chrome inside the frame ──────────────────────────────────── */
  .shell {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    background-color: rgb(24, 31, 31);
    /* The faint plotting grid the product paints behind its chrome. */
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.014) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.014) 1px, transparent 1px);
    background-size: 28px 28px;
    font-size: 0.82rem;
  }
  .mark {
    flex: none;
  }
  .region {
    font-family: var(--font-geist-mono);
    font-size: 0.74rem;
  }
  .shell-body {
    display: grid;
    grid-template-columns: 182px minmax(0, 1fr);
    align-items: stretch;
  }
  .ops {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    padding: 18px 20px 22px;
  }

  /* The shared nav ships with Overview highlighted; this screen is the Issues page, so the
     highlight moves to the Issues row (third group, fifth row). */
  .shell-body :global(.console-nav__item.is-active) {
    background: none;
    color: var(--stp-text-muted);
    font-weight: 400;
  }
  .shell-body :global(.console-nav__item.is-active)::before {
    display: none;
  }
  .shell-body :global(.console-nav__item.is-active .console-nav__glyph) {
    color: var(--stp-text-subtle);
  }
  .shell-body :global(.console-nav__group:nth-child(3) .console-nav__item:nth-child(5)) {
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink);
    font-weight: 600;
  }
  .shell-body :global(.console-nav__group:nth-child(3) .console-nav__item:nth-child(5))::before {
    content: '';
    position: absolute;
    left: -10px;
    top: 4px;
    bottom: 4px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--brand);
  }
  .shell-body :global(.console-nav__group:nth-child(3) .console-nav__item:nth-child(5) .console-nav__glyph) {
    color: var(--brand);
  }

  /* ── Incident summary ─────────────────────────────────────────────────── */
  .incident {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 0 22px;
    padding: 14px 18px 15px 20px;
    border-radius: var(--stp-radius-large);
    background: rgba(0, 0, 0, 0.2);
    box-shadow:
      inset 3px 0 0 var(--error),
      inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }
  .incident-main {
    min-width: 0;
  }
  .incident-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--ink-3);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .incident-status .is-open {
    color: var(--error);
  }
  .sep {
    color: rgba(255, 255, 255, 0.18);
  }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--error);
    box-shadow: 0 0 0 3px rgba(235, 97, 97, 0.18);
  }
  .incident-title {
    margin: 9px 0 0;
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .incident-title b {
    font-weight: 600;
  }
  .release {
    padding: 1px 7px;
    border-radius: var(--stp-radius-small);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    color: var(--ink-2);
    font-family: var(--font-geist-mono);
    font-size: 0.76rem;
    white-space: nowrap;
  }
  .incident-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-3);
    font-size: 0.78rem;
  }
  .incident-facts b {
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .incident-agent {
    min-width: 0;
    padding-left: 22px;
    box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0.07);
  }
  .agent-label {
    margin: 0;
    color: var(--brand);
    font-family: var(--font-geist-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .agent-body {
    margin: 8px 0 0;
    color: var(--ink-2);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .agent-body code {
    color: var(--ink);
    font-family: var(--font-geist-mono);
    font-size: 0.92em;
  }
  .agent-diff {
    color: var(--ink-3);
    font-family: var(--font-geist-mono);
    font-size: 0.72rem;
    white-space: nowrap;
  }
  .agent-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-top: 12px;
  }
  /* Drawn as controls, kept as spans: a recreation must not hand the reader a focus stop that
     leads nowhere. The one filled brand button on this screen stays the inbox's own. */
  .ctl {
    display: inline-flex;
    align-items: center;
    padding: 6px 11px;
    border-radius: var(--stp-radius-medium);
    background: rgba(255, 255, 255, 0.03);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .ctl-primary {
    background: color-mix(in srgb, var(--brand) 9%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) 55%, transparent);
    color: var(--brand);
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    color: var(--ink-3);
    font-size: 0.74rem;
  }
  .toggle b {
    color: var(--ink-2);
    font-weight: 600;
  }
  .toggle-track {
    position: relative;
    width: 26px;
    height: 15px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .toggle-knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: rgb(166, 174, 174);
  }

  /* ── Metrics and traces, side by side under the inbox ─────────────────── */
  .strip {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 16px;
    align-items: stretch;
  }
  .strip-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .strip-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 0;
    padding: 0 2px;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 620;
  }
  .strip-label span {
    color: var(--ink-3);
    font-size: 0.74rem;
    font-weight: 400;
  }
  /* The metrics surface has four cards and its own toolbar. This strip wants exactly one — the
     worker's invocations with the error spike, the incident seen from CloudWatch — drawn tall
     enough to stand beside the trace. */
  .metrics-col :global(.metrics) {
    flex: 1;
    min-height: 0;
    gap: 0;
  }
  .metrics-col :global(.metrics__toolbar) {
    display: none;
  }
  .metrics-col :global(.metrics__grid) {
    flex: 1;
    min-height: 0;
    grid-template-columns: minmax(0, 1fr);
  }
  .metrics-col :global(.metric-card:not(:nth-child(2))) {
    display: none;
  }
  .metrics-col :global(.metric-card__plot) {
    flex: 1;
    min-height: 0;
  }
  .metrics-col :global(.metric-card__svg),
  .metrics-col :global(.metric-card__axis) {
    height: 100%;
    min-height: 220px;
  }
  .trace-col :global(.trace) {
    flex: 1;
  }
  .trace-col :global(.trace__waterfall) {
    flex: 1;
  }

  /* ── Motion ───────────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .eyebrow,
    h1,
    .sub,
    .ctas,
    .proof,
    .stage {
      opacity: 0;
      transform: translateY(10px);
      animation: arrive 640ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }
    h1 {
      animation-delay: 70ms;
    }
    .sub {
      animation-delay: 150ms;
    }
    .ctas {
      animation-delay: 230ms;
    }
    .proof {
      animation-delay: 310ms;
    }
    .stage {
      transform: translateY(16px);
      animation-duration: 820ms;
      animation-delay: 380ms;
    }
    .pulse {
      animation: pulse 1.8s ease-in-out infinite;
    }
  }
  @keyframes arrive {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px rgba(235, 97, 97, 0.18);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(235, 97, 97, 0.05);
    }
  }

  /* ── Narrower viewports ───────────────────────────────────────────────── */
  @media (max-width: 1180px) {
    .shell-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .shell-body :global(.console-nav) {
