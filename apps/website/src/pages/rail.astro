---
// concept: One persistent seam down the page — what you do on the left, in serif, what Stacktape does on the right, in dense product UI — with the six things Stacktape does as six rows, each explained for a first-time visitor and shown as a real screen of the product.
// copy-angle: The left column is a checklist of your part (four ticks, the rest a dash); the right column earns each "nothing" with a precise, recognisable Console or wizard screen for the same example app.
import BaseLayout from '../layouts/BaseLayout.astro';
import Closing from '../variants/rail/Closing.astro';
import ColumnHeaders from '../variants/rail/ColumnHeaders.astro';
import { HEADLINE } from '../variants/rail/data';
import Features from '../variants/rail/Features.astro';
import Hero from '../variants/rail/Hero.astro';
import SiteFooter from '../variants/rail/SiteFooter.astro';
import SiteNav from '../variants/rail/SiteNav.astro';
import Testimonials from '../variants/rail/Testimonials.astro';
import '../variants/rail/rail.css';
---

<BaseLayout
  title={`Stacktape — ${HEADLINE}`}
  description="Stacktape puts your app on your own AWS account and does the DevOps work for you: it reads your code, sets up the infrastructure, deploys, and keeps the app running, monitored, secured and within budget."
  htmlClass="rl-html"
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,400..600,50;1,9..144,400..600,50&family=Manrope:wght@400;500;600&family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('rl-js');
    </script>
  </Fragment>
  <div class="rl-root">
    <SiteNav />
    <ColumnHeaders />
    <main>
      <Hero />
      <Features />
      <Testimonials />
      <Closing />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
