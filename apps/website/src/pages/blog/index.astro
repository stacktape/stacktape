---
import PlainPage from '../../components/PlainPage.astro';
import { legacyPosts } from '../../content/legacy/posts';

const POSTS = [
  { href: '/blog/stacktape-v4', title: 'Stacktape v4: what changed', date: 'September 2026' },
  ...legacyPosts.toReversed().map(({ slug, title, date }) => ({ href: `/blog/${slug}`, title, date }))
];
---

<PlainPage
  title="Blog"
  description="Writing from the Stacktape team about deploying to AWS."
  lead="Writing from the Stacktape team about deploying and running applications on AWS."
>
  <ul class="posts">
    {
      POSTS.map((post) => (
        <li>
          <a href={post.href}>
            <span class="post-title">{post.title}</span>
            <span class="post-date">{post.date}</span>
            <span class="post-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p>
    Release notes for every CLI version are in the
    <a href="https://github.com/stacktape/stacktape/releases">changelog on GitHub</a>.
  </p>
</PlainPage>

<style>
  .posts {
    margin: 0 0 var(--brand-space-5);
    padding: 0;
    border-block-start: 1px solid var(--brand-border);
    list-style: none;
  }

  .posts li {
    border-block-end: 1px solid var(--brand-border);
  }

  .posts a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: var(--brand-space-4);
    padding: var(--brand-space-5) var(--brand-space-3);
    color: var(--brand-text);
    text-decoration: none;
  }

  .posts a:hover {
    background: var(--brand-surface);
  }

  .post-title {
    font: var(--brand-weight-label) var(--brand-type-lead) / 1.35 var(--brand-font-heading);
  }

  .post-date {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  .post-arrow {
    color: var(--brand-teal);
  }

  @media (max-width: 36rem) {
    .posts a {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--brand-space-2) var(--brand-space-4);
    }

    .post-arrow {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
