---
// concept: Two tracks, one page. A sparse gold "You" track on the left states the little you have to do, while the teal "Stacktape" track on the right tells the whole story in six large sections, each with a plain-words explanation and a faithful recreation of the product screen that does the work.
// copy-angle: Explain before you impress. Every section names the job, says what it means in words a Heroku or Vercel developer already knows, shows the exact screen, and says "nothing to do" out loud where that is the honest answer.
import BaseLayout from '../layouts/BaseLayout.astro';
import Closing from '../variants/duet/Closing.astro';
import ColumnHeaders from '../variants/duet/ColumnHeaders.astro';
import { HEADLINE, SECTIONS, SUBHEADLINE } from '../variants/duet/data';
import Hero from '../variants/duet/Hero.astro';
import ConsoleProject from '../variants/duet/previews/ConsoleProject.astro';
import Costs from '../variants/duet/previews/Costs.astro';
import Incident from '../variants/duet/previews/Incident.astro';
import Observability from '../variants/duet/previews/Observability.astro';
import Review from '../variants/duet/previews/Review.astro';
import Security from '../variants/duet/previews/Security.astro';
import SiteFooter from '../variants/duet/SiteFooter.astro';
import SiteNav from '../variants/duet/SiteNav.astro';
import Testimonials from '../variants/duet/Testimonials.astro';
import Track from '../variants/duet/Track.astro';
import '../variants/duet/duet.css';

const previews = [Review, ConsoleProject, Observability, Incident, Security, Costs];
---

<BaseLayout title={`Stacktape — ${HEADLINE}`} description={SUBHEADLINE} htmlClass="du-html">
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&family=Red+Hat+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('du-js');
    </script>
  </Fragment>

  <div class="du-root">
    <SiteNav />
    <main>
      <Hero />
      <ColumnHeaders />
      {
        SECTIONS.map((section, index) => {
          const Preview = previews[index];
          return (
            <Track section={section}>
              {Preview && <Preview />}
            </Track>
          );
        })
      }
      <Closing />
      <Testimonials />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<script>
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-du-enter]'));
  const root = document.documentElement;

  if (!root.classList.contains('du-js') || !('IntersectionObserver' in window)) {
    for (const section of sections) section.classList.add('is-in');
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.02 }
    );
    for (const section of sections) observer.observe(section);

    // Belt and braces: a restored scroll position or an anchor jump must never leave a section
    // invisible, so anything whose top has passed the bottom of the viewport is revealed as well.
    const sweep = () => {
      const line = window.innerHeight * 0.94;
      for (const section of sections) {
        if (section.getBoundingClientRect().top < line) section.classList.add('is-in');
      }
    };
    window.addEventListener('scroll', sweep, { passive: true });
    window.addEventListener('load', sweep);
    sweep();
  }
</script>
