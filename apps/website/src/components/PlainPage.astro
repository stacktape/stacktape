---
import BrandHead from '../brand/BrandHead.astro';
import SiteFooter from '../brand/SiteFooter.astro';
import SiteHeader from '../brand/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

type Props = {
  title: string;
  description: string;
  lead?: string;
  noindex?: boolean;
  wide?: boolean;
};

const { title, description, lead, noindex = false, wide = false } = Astro.props;
---

<BaseLayout title={`${title} — Stacktape`} {description} {noindex} htmlClass="brand">
  <BrandHead slot="head" />
  <div class="page">
    <SiteHeader />
    <main class:list={['site-frame', 'content', 'page-prose', { 'content--wide': wide }]}>
      <header class="intro">
        <slot name="eyebrow" />
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
      </header>
      <slot />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .content {
    --site-width: 49rem;
    flex: 1;
    min-width: 0;
    padding-block: clamp(var(--brand-space-6), 5vw, var(--brand-space-8)) var(--brand-space-9);
    overflow-wrap: anywhere;
  }

  .content--wide {
    --site-width: 76rem;
  }

  .intro {
    display: grid;
    justify-items: start;
    gap: var(--brand-space-4);
    margin-block-end: var(--brand-space-6);
  }

  :global(:where(.page-prose) :where(h1, h2, h3, h4)) {
    font-family: var(--brand-font-heading);
    font-weight: var(--brand-weight-heading);
    line-height: var(--brand-leading-heading);
    letter-spacing: var(--brand-tracking-heading);
    color: var(--brand-text);
  }

  h1 {
    margin: 0;
    font-size: var(--brand-type-display);
    text-wrap: balance;
  }

  :global(:where(.page-prose) :where(h2, h3, h4, [id])) {
    scroll-margin-block-start: var(--brand-space-9);
  }

  :global(:where(.page-prose) :where(h2)) {
    margin-block: var(--brand-space-7) var(--brand-space-3);
    font-size: var(--brand-type-title);
  }

  :global(:where(.page-prose) :where(h3, h4)) {
    margin-block: var(--brand-space-5) var(--brand-space-2);
    font-size: var(--brand-type-lead);
  }

  :global(:where(.page-prose) :where(p, ul, ol, address, blockquote)) {
    margin-block: 0 var(--brand-space-4);
    color: var(--brand-muted);
  }

  .intro .lead {
    max-width: 67ch;
    margin: 0;
    font-size: var(--brand-type-lead);
  }

  :global(:where(.page-prose) :where(ul:not([class]), ol:not([class]))) {
    padding-inline-start: var(--brand-space-5);
    list-style: revert;
  }

  :global(:where(.page-prose) :where(ul:not([class]), ol:not([class])) > li + li) {
    margin-block-start: var(--brand-space-2);
  }

  :global(:where(.page-prose) :where(a:not(.stp-ui-button))) {
    color: var(--brand-teal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  :global(:where(.page-prose) :where(a:not(.stp-ui-button):hover)) {
    color: var(--brand-text);
  }

  :global(:where(.page-prose) :where(code, pre)) {
    font-family: var(--brand-font-mono);
    font-size: 0.9em;
    color: var(--brand-text);
  }

  :global(:where(.page-prose) :where(pre)) {
    margin-block: var(--brand-space-4);
    padding: var(--brand-space-4);
    overflow-x: auto;
    border-radius: var(--brand-radius);
    background: var(--brand-inset);
  }

  :global(:where(.page-prose) :where(img)) {
    max-width: 100%;
    height: auto;
  }
</style>
