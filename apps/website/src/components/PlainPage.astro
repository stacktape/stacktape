---
/**
 * The shell for the site's plain pages (pricing, blog): the wordmark, one column of text on the
 * page's surface, and a way back. Used by the pages the homepage links to before those pages have
 * their real design; it deliberately carries no variant's styling so it fits under any of them.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from './Logo.astro';

type Props = {
  title: string;
  description: string;
  /** The line under the title. */
  lead?: string;
};

const { title, description, lead } = Astro.props;
---

<BaseLayout title={`${title} — Stacktape`} description={description}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </Fragment>
  <div class="pp-root">
    <header class="pp-header">
      <a href="/" aria-label="Stacktape home"><Logo height={24} /></a>
      <nav aria-label="Primary">
        <a href="https://docs.stacktape.com">Docs</a>
        <a href="/pricing">Pricing</a>
        <a href="/blog">Blog</a>
        <a href="https://console.stacktape.com">Sign in</a>
      </nav>
    </header>
    <main class="pp-main">
      <h1>{title}</h1>
      {lead ? <p class="pp-lead">{lead}</p> : null}
      <slot />
    </main>
    <footer class="pp-footer">
      <span>© 2026 Stacktape</span>
      <a href="/">Back to the homepage</a>
    </footer>
  </div>
</BaseLayout>

<style>
  .pp-root {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.55;
    color: var(--stp-text-primary);
  }

  .pp-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 20px 24px;
  }

  .pp-header nav {
    display: flex;
    gap: 20px;
    font-size: 15px;
    font-weight: 500;
  }

  .pp-header a,
  .pp-footer a {
    color: var(--stp-text-muted);
    text-decoration: none;
  }

  .pp-header a:hover,
  .pp-footer a:hover {
    color: var(--stp-text-primary);
  }

  .pp-main {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 64px 24px 96px;
    flex: 1;
  }

  .pp-main :global(h1) {
    margin: 0 0 16px;
    font-size: clamp(34px, 4.5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .pp-lead {
    margin: 0 0 40px;
    font-size: 19px;
    color: #b7c0c2;
  }

  .pp-main :global(h2) {
    margin: 40px 0 8px;
    font-size: 22px;
    font-weight: 600;
  }

  .pp-main :global(p) {
    margin: 0 0 16px;
    color: #b7c0c2;
  }

  .pp-main :global(a) {
    color: var(--stp-color-brand);
  }

  .pp-main :global(ul) {
    margin: 0 0 16px;
    padding-left: 20px;
    color: #b7c0c2;
  }

  .pp-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 24px;
    border-top: 1px solid var(--stp-border-subtle);
    font-size: 14px;
    color: var(--stp-text-muted);
  }

  @media (max-width: 600px) {
    .pp-header nav {
      gap: 14px;
      font-size: 14px;
    }
  }
</style>
