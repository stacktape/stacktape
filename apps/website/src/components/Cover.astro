.stp-cover {
  --cover-scale: 0.45;
  position: relative;
  display: block;
  width: 100%;
  aspect-ratio: 1517 / 1204;
  overflow: visible;
}

/* The design canvas. It keeps its 1517x1204 design pixels and is scaled as a whole by the frame. */
.cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 1517px;
  height: 1204px;
  background: transparent;
  overflow: hidden;
  font-family: ui-sans-serif, system-ui, sans-serif;
