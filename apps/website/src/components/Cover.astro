---
/**
 * The Stacktape "cover": the Console's project dashboard tilted in 3D with the CLI deploy terminal
 * floating in front of it. A hand-built HTML replica rather than a screenshot, so it stays sharp at
 * every size and remains editable.
 *
 * Ported verbatim from the README cover (readme-cover/cover-docs.html, the transparent variant for
 * dark pages). The markup, its Tailwind utilities and the style block are the original's; the only
 * changes are mechanical: the inline tailwind.config's named colours became arbitrary-value
 * utilities, the Tabler webfont icons became inline SVGs, and the 1517x1204 canvas is wrapped in a
 * frame that scales it to its container's width.
 *
 * Fonts: the console is Montserrat and the terminal JetBrains Mono, both loaded here, so a page
 * needs nothing extra.
 */
type Props = {
  /** Extra classes for the outer frame. */
  class?: string;
};

const { class: className } = Astro.props;
---

<div
  class:list={['stp-cover', className]}
  role="img"
  aria-label="Stacktape Console showing acme-project, with a terminal deploying to production in front of it"
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
  />
  <div class="cover" aria-hidden="true">
    <div class="glow"></div>

    <!-- ============================ CONSOLE ============================ -->
    <div class="console-window page-grid w-[1400px] rounded-[10px] overflow-hidden font-[Montserrat,ui-sans-serif,sans-serif] font-medium text-[13.5px] text-[rgba(255,255,255,0.87)]">
