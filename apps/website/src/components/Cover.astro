  <script is:inline>
  /* Scale the 1517px-wide design canvas to the frame's width. Runs synchronously right after the
     frame is parsed, so the CSS fallback scale is never painted at a size that overflows. */
  (() => {
    const frame = document.currentScript && document.currentScript.parentElement;
    if (!frame) return;
    const apply = (width) => frame.style.setProperty('--cover-scale', String(width / 1517));
    apply(frame.clientWidth);
    new ResizeObserver((entries) => apply(entries[0].contentRect.width)).observe(frame);
  })();
  </script>
