---
/** A section pack's product picture: the phone crop on narrow screens, the desktop crop otherwise, at 1× and 2×. */
import type { SECTION_PACKS } from '../../sections';

type Picture = NonNullable<(typeof SECTION_PACKS)[number]['picture']>;
type Props = { picture: Picture };

const { picture } = Astro.props;
const { desktop, phone } = picture;
const set = (small: { src: string }, large: { src: string }) => `${small.src} 1x, ${large.src} 2x`;
---

<picture class="shot">
  <source
    media="(max-width: 40rem)"
    type="image/webp"
    srcset={set(phone.small, phone.large)}
    width={phone.small.width}
    height={phone.small.height}
  />
  <source
    media="(max-width: 40rem)"
    srcset={set(phone.smallPng, phone.largePng)}
    width={phone.small.width}
    height={phone.small.height}
  />
  <source type="image/webp" srcset={set(desktop.small, desktop.large)} />
  <img
    src={desktop.smallPng.src}
    srcset={`${desktop.largePng.src} 2x`}
    width={desktop.small.width}
    height={desktop.small.height}
    alt={picture.alt}
    loading="lazy"
  />
</picture>

<style>
  .shot {
    display: block;
    padding: var(--brand-space-4);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-page);
    box-shadow: var(--brand-shadow);
  }

  .shot img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
</style>
