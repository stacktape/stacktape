---
/**
 * Structure C, the short page: hero, how it works, Deploys, three customer quotes, then capability blocks
 * (Monitoring and incidents, Security, Costs), a small "also included" grid and the closing command box. The quotes
 * sit below Deploys so heroes with their own trust row (H3) don't stack two in a row.
 */
import BrandHead from '../../../brand/BrandHead.astro';
import SiteFooter from '../../../brand/SiteFooter.astro';
import SiteHeader from '../../../brand/SiteHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Block from './Block.astro';
import Closing from './Closing.astro';
import Deploys from './Deploys.astro';
import Incidents from './Incidents.astro';
import Included from './Included.astro';
import { pack } from './packs';
import Proof from './Proof.astro';
import Shot from './Shot.astro';
import Steps from './Steps.astro';
import './structure.css';

const secures = pack('secures');
const costs = pack('costs');
---

<BaseLayout
  title="Stacktape: AWS DevOps, fully automated"
  description="Stacktape reads your repository, designs the AWS infrastructure, deploys it to your own AWS account and keeps it running."
  htmlClass="brand structure-c"
  noindex={Astro.url.pathname !== '/'}
>
  <BrandHead slot="head" />
  <SiteHeader startHref="#install" />
  <main>
    <slot name="hero" />
    <Steps />
    <Deploys />
    <Proof />
    <Incidents />
    <Block id="security" marker={secures.name} title={secures.title} text={secures.text} points={secures.gets}>
      <Shot slot="picture" picture={secures.picture} />
    </Block>
    <Block id="costs" marker={costs.name} title={costs.title} text={costs.text} points={costs.gets}>
      <p class="c-small">AWS bills you directly. Stacktape’s fee is a separate invoice.</p>
      <Shot slot="picture" picture={costs.picture} />
    </Block>
    <Included />
    <Closing />
  </main>
  <SiteFooter homeHref={Astro.url.pathname} />
</BaseLayout>
