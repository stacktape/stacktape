---
/**
 * How it starts: three steps of `stacktape init`, next to the wizard's real Deploy step (where it deploys). Heroes
 * already show the Review screen, so this section shows the next one.
 */
import Tape from '../../../brand/Tape.astro';
import target from './deploy-target.webp';
import targetPhone from './deploy-target-phone.webp';

const steps = [
  {
    title: 'Run one command in your repo',
    text: 'Claude Code or Codex reads the code on your machine, or the built-in scanner reads manifests and lockfiles. No source code goes to Stacktape.'
  },
  {
    title: 'Review the setup in your browser',
    text: 'Every resource shows why it exists, the line of code behind it and a monthly estimate. What the code did not settle is listed and changes with one click.'
  },
  {
    title: 'Deploy to your AWS account',
    text: 'With your local AWS credentials and no Stacktape account. Later, a Git rule in the Console deploys every push to the branches you choose.'
  }
] as const;
---

<section class="site-frame c-section steps" id="designs" aria-labelledby="designs-title">
  <div class="c-intro">
    <Tape variant="marker">How it starts</Tape>
    <h2 class="c-h2" id="designs-title">From your repo to AWS, with a look at every resource first.</h2>
    <ol class="steps__list">
      {
        steps.map((step, index) => (
          <li class="steps__item">
            <Tape variant="count" tone="teal">
              {index + 1}
            </Tape>
            <div>
              <h3>{step.title}</h3>
              <p class="c-muted">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
  <figure class="steps__picture">
    <picture class="c-shot">
      <source media="(max-width: 40rem)" srcset={`${targetPhone.src} 2x`} width={targetPhone.width / 2} height={targetPhone.height / 2} />
      <img
        src={target.src}
        srcset={`${target.src} 2x`}
        width={target.width / 2}
        height={target.height / 2}
        loading="lazy"
        alt="The init wizard's Deploy step: Deploy to dev, stacktape.yml saved in the project, and where it deploys: AWS account acme-dev, region Ireland (eu-west-1), stage dev."
      />
    </picture>
  </figure>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 30rem) minmax(0, 1fr);
    align-items: center;
    gap: var(--brand-space-7) var(--brand-space-9);
  }

  .steps__list {
    display: grid;
    gap: var(--brand-space-5);
    margin: var(--brand-space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .steps__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--brand-space-4);
  }

  h3 {
    margin: 0 0 var(--brand-space-1);
    font-size: var(--brand-type-base);
    font-weight: var(--brand-weight-label);
  }

  .steps__picture {
    margin: 0;
  }

  @media (max-width: 64rem) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
