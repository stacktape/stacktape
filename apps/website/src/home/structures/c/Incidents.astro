---
/** Monitoring and incidents as one block: what breaks, and what the team sees when it does. */
import Block from './Block.astro';
import incident from './incident.webp';
import { sectionPack } from '../../sections';
import { pack } from './packs';

/** On phones the incident screen is unreadable, so the monitors pack's phone crop stands in. */
const monitors = pack('monitors');
const { phone } = monitors.picture;
const incidents = sectionPack('incidents');
---

<Block
  id="incidents"
  marker="Monitoring and incidents"
  title={`${monitors.title} and ${incidents.title.toLowerCase()}`}
  text={monitors.text}
>
  <p>{incidents.text}</p>

  <figure slot="picture" class="incidents__picture">
    <picture>
      <source
        media="(max-width: 40rem)"
        type="image/webp"
        srcset={`${phone.small.src} 1x, ${phone.large.src} 2x`}
        width={phone.small.width}
        height={phone.small.height}
      />
      <img
        class="c-frame"
        src={incident.src}
        width={incident.width}
        height={incident.height}
        loading="lazy"
        alt="An incident in the Stacktape Console: API error rate above 5% on checkout-api production, with an AI assessment and a draft fix pull request. On phones: the Requests and Errors metric cards."
      />
    </picture>
    <figcaption class="c-muted">
      <span class="incidents__wide"
        >An incident with its signals, the release that was live and an AI assessment on your organization’s AI key. Fix
        with AI opens a draft pull request and deploys nothing.</span
      >
      <span class="incidents__narrow">Requests and errors for the last 24 hours, in the Console.</span>
    </figcaption>
  </figure>
</Block>

<style>
  .incidents__narrow {
    display: none;
  }

  @media (max-width: 40rem) {
    .incidents__wide {
      display: none;
    }

    .incidents__narrow {
      display: inline;
    }
  }

  .incidents__picture {
    display: grid;
    gap: var(--brand-space-3);
    margin: 0;
    font-size: var(--brand-type-sm);
  }
</style>
