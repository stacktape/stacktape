---
import { BENCHMARKS, formatValue, toolName } from '../../../variants/readme/benchmarks';
import type { ChartView } from './bench';

type Props = {
  /** Used for tab and panel ids. */
  id: string;
  /** What the bars measure, above the tabs. */
  kicker: string;
  /** One view has no tabs. */
  views: ChartView[];
};

const { id, kicker, views } = Astro.props;
const selected = views[0]?.id;
const tabbed = views.length > 1;
---

<div class="chart" data-sa-tabs>
  <div class="card">
    <div class="top">
      <p class="kicker">{kicker}</p>
      {
        tabbed && (
          <div class="tabs" role="tablist" aria-label={kicker}>
            {views.map((view) => (
              <button
                class="sa-tab"
                type="button"
                role="tab"
                id={`${id}-${view.id}`}
                aria-controls={`${id}-${view.id}-panel`}
                aria-selected={view.id === selected ? 'true' : 'false'}
                tabindex={view.id === selected ? 0 : -1}
                data-tab={view.id}
              >
                {view.label}
              </button>
            ))}
          </div>
        )
      }
    </div>
    <div class="panels">
      {
        views.map((view) => (
          <figure
            class="panel"
            id={`${id}-${view.id}-panel`}
            role={tabbed ? 'tabpanel' : undefined}
            aria-labelledby={tabbed ? `${id}-${view.id}` : undefined}
            data-panel={view.id}
            data-active={String(view.id === selected)}
          >
            <figcaption class="title">{view.title}</figcaption>
            {view.groups.map((group) => (
              <div class="group">
                <p class="group-label">{group.label}</p>
                <ol class="rows">
                  {group.values.map((value) => (
                    <li class:list={['row', value.tool === 'stacktape' && 'row--us']}>
                      <span>{toolName(BENCHMARKS, value.tool)}</span>
                      <span class="track" aria-hidden="true">
                        <span class="bar" style={`--sa-bar: ${(value.median / view.max) * 100}%`} />
                      </span>
                      <span class="value">{formatValue(value.median, group.unit)}</span>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
            {view.note && <p class="note">{view.note}</p>}
          </figure>
        ))
      }
    </div>
  </div>
  <p class="foot"><slot /></p>
</div>

<script>
  import './tabs';
</script>

<style>
  .chart {
    display: grid;
    align-content: start;
    gap: var(--brand-space-3);
  }

  .card {
    display: grid;
    align-content: start;
    gap: var(--brand-space-4);
    padding: var(--brand-space-5);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-surface);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--brand-space-3);
  }

  .kicker {
    font-weight: var(--brand-weight-label);
  }

  .tabs {
    display: flex;
    gap: var(--brand-space-1);
    margin-inline-start: calc(-1 * var(--brand-space-3));
  }

  .panels {
    display: grid;
  }

  .panel {
    grid-area: 1 / 1;
    display: grid;
    align-content: start;
    gap: var(--brand-space-4);
  }

  .panel[data-active='false'] {
    visibility: hidden;
  }

  .title,
  .note,
  .foot {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  .note,
  .foot {
    font-size: var(--brand-type-xs);
    line-height: 1.5;
  }

  .group {
    display: grid;
    gap: var(--brand-space-1);
  }

  .group-label {
    font-size: var(--brand-type-sm);
    font-weight: var(--brand-weight-label);
  }

  .rows {
    display: grid;
    gap: 0.125rem;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 3.5rem;
    align-items: center;
    gap: var(--brand-space-3);
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    line-height: 1.4;
  }

  .row--us {
    color: var(--brand-text);
    font-weight: var(--brand-weight-label);
  }

  .track {
    display: block;
    block-size: 0.625rem;
  }

  .bar {
    display: block;
    inline-size: var(--sa-bar);
    block-size: 100%;
    border-radius: var(--brand-radius-small);
    background: color-mix(in srgb, var(--brand-muted) 32%, transparent);
  }

  .row--us .bar {
    background: var(--brand-teal);
  }

  .value {
    font-family: var(--brand-font-mono);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  @media (max-width: 40rem) {
    .card {
      padding: var(--brand-space-4);
    }

    .row {
      grid-template-columns: 6rem minmax(0, 1fr) 3.25rem;
      gap: var(--brand-space-2);
    }
  }
</style>
