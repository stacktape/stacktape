---
import { sectionPack } from '../../sections';
import Facts from './Facts.astro';
import Section from './Section.astro';
import Shot from './Shot.astro';
import incidentLarge from './shots/incident-2448.webp';
import incidentPhoneLarge from './shots/incident-phone-large.webp';
import incidentPhoneSmall from './shots/incident-phone-small.webp';
import incidentSmall from './shots/incident-1224.webp';

const pack = sectionPack('incidents');
---

<Section
  id="incidents"
  index={6}
  name={pack.name}
  title={pack.title}
  line={pack.text}
>
  <div class="body">
    <Shot
      desktop={{ small: incidentSmall, large: incidentLarge }}
      phone={{ small: incidentPhoneSmall, large: incidentPhoneLarge }}
      alt="An incident in the Stacktape Console: API error rate above 5% on checkout-api production, with an AI assessment and a draft fix opened as a pull request."
      sizes="(min-width: 92rem) 58rem, (min-width: 64rem) 64vw, 94vw"
    />
    <Facts facts={pack.gets} />
  </div>
</Section>

<style>
  .body {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    align-items: start;
    gap: var(--brand-space-7);
  }

  @media (max-width: 64rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--brand-space-6);
    }
  }
</style>
