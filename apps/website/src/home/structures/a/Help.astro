---
import { SECTION_PACKS } from '../../sections';
import Facts from './Facts.astro';
import Section from './Section.astro';

const pack = SECTION_PACKS.find((candidate) => candidate.id === 'expert-help');
if (!pack) throw new Error('No expert help pack');
---

<Section
  id={pack.id}
  index={8}
  name={pack.name}
  title={`${pack.title}.`}
  line="On Flexible, your team gets a shared Slack channel with the founders."
>
  <Facts figure={pack.figure} facts={pack.facts} row />
</Section>
