---
import { sectionPack } from '../../sections';
import Facts from './Facts.astro';
import Section from './Section.astro';

const pack = sectionPack('expert-help');
---

<Section
  id={pack.id}
  index={8}
  name={pack.name}
  title={pack.title}
  line={pack.text}
>
  <Facts facts={pack.gets} row />
</Section>
