---
/**
 * The three things a CTO checks first, right after the hero, each with a link to its evidence.
 * Sources: docs/cli/synth.mdx and the owner's yes to "your app keeps running" (scores/pick, 25 Nov);
 * LICENSE:1 and docs/getting-started/open-source-cli.mdx:17; docs/managing-costs/overview.mdx:10, :26 and
 * src/pages/pricing.astro:13-14, :29.
 */
const facts = [
  {
    title: 'Your AWS account',
    text: 'Stacktape deploys standard CloudFormation stacks to your account. Stop using it and your app keeps running.',
    href: 'https://docs.stacktape.com/cli/synth'
  },
  {
    title: 'Open-source CLI (MIT)',
    text: 'The CLI deploys with your own AWS credentials. No Stacktape account needed.',
    href: 'https://github.com/stacktape/stacktape'
  },
  {
    title: 'AWS prices',
    text: 'AWS bills you directly. The Console is free up to $200 a month of AWS spend, then 19–25% of it.',
    href: '/pricing'
  }
];
---

<section class="proof sa-proof" aria-label="What you can check">
  <ul class="site-frame list">
    {
      facts.map((fact) => (
        <li>
          <a class="brand-link title" href={fact.href}>
            {fact.title}
          </a>
          <p>{fact.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .proof {
    padding-block-start: var(--brand-space-8);
  }

  .list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--brand-space-6);
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    align-content: start;
    gap: var(--brand-space-1);
    padding-block-start: var(--brand-space-4);
    border-block-start: 1px solid var(--brand-border);
  }

  .title {
    justify-self: start;
    color: var(--brand-text);
    font-weight: var(--brand-weight-label);
    text-decoration-color: var(--brand-border);
  }

  p {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    line-height: 1.5;
  }

  @media (max-width: 48rem) {
    .list {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--brand-space-4);
    }
  }
</style>
