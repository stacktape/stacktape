---
import { codeParts } from '../../code-text';

type Props = {
  /** The headline fact, set large. */
  figure?: { value: string; label: string };
  facts: readonly string[];
  /** Lay the facts out in a row instead of a column. */
  row?: boolean;
};

const { figure, facts, row = false } = Astro.props;
---

<div class:list={['facts', row && 'facts--row']}>
  {
    figure && (
      <div class="figure">
        <p class="value">{figure.value}</p>
        <p class="label">{figure.label}</p>
      </div>
    )
  }
  {
    facts.map((fact) => (
      <p class="fact">{codeParts(fact).map(({ part, code }) => (code ? <code>{part}</code> : part))}</p>
    ))
  }
</div>

<style>
  .facts {
    display: grid;
    align-content: start;
    gap: var(--brand-space-4);
  }

  .facts--row {
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--brand-space-5) var(--brand-space-6);
  }

  .figure,
  .fact {
    padding-block-start: var(--brand-space-4);
    border-block-start: 1px solid var(--brand-border);
  }

  .value {
    font: var(--brand-weight-heading) var(--brand-type-title) / 1.15 var(--brand-font-heading);
    letter-spacing: -0.02em;
  }

  .label,
  .fact {
    color: var(--brand-muted);
    line-height: 1.5;
  }

  .label {
    margin-block-start: var(--brand-space-2);
  }

  code {
    color: var(--brand-text);
    font: 0.9em var(--brand-font-mono);
  }
</style>
