---
import type { ImageMetadata } from 'astro';
import { TESTIMONIALS } from '../../../variants/session/data';
import eric from './shots/eric-allam.webp';
import henry from './shots/henry-garrett.webp';
import rhys from './shots/rhys-williams.webp';

/* The old site's quotes, verbatim. The owner confirmed Trigger.dev's quote stays (25 Nov). */
const photos: Record<string, ImageMetadata> = { 'Eric Allam': eric, 'Henry Garrett': henry, 'Rhys Williams': rhys };
const quotes = TESTIMONIALS.filter((item) => item.name in photos);
---

<section class="customers" aria-labelledby="customers-title">
  <div class="site-frame">
    <h2 id="customers-title">What customers say</h2>
    <div class="grid">
      {
        quotes.map((item) => (
          <figure class="quote">
            <blockquote>{item.quote}</blockquote>
            <figcaption>
              <img src={photos[item.name]?.src} width="48" height="48" alt="" loading="lazy" decoding="async" />
              <span>
                <strong>{item.name}</strong>
                <span>{item.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .customers {
    padding-block-start: var(--sa-section-gap);
  }

  h2 {
    margin-block-end: var(--brand-space-7);
    font: var(--brand-weight-heading) clamp(1.875rem, 1.4rem + 1.6vw, 3rem) / 1.1 var(--brand-font-heading);
    letter-spacing: var(--brand-tracking-heading);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--brand-space-5);
  }

  .quote {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--brand-space-6);
    padding: var(--brand-space-6);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-surface);
  }

  blockquote {
    font-size: var(--brand-type-lead);
    line-height: 1.6;
    text-wrap: pretty;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: var(--brand-space-3);
    font-size: var(--brand-type-sm);
  }

  figcaption img {
    flex: none;
    border-radius: 50%;
  }

  figcaption > span {
    display: grid;
    color: var(--brand-muted);
  }

  figcaption strong {
    color: var(--brand-text);
    font-weight: var(--brand-weight-label);
  }

  @media (max-width: 64rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .quote {
      padding: var(--brand-space-5);
    }
  }
</style>
