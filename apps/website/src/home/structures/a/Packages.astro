---
import { sectionPack } from '../../sections';
import { PACKAGING_VIEWS, RUN } from './bench';
import Chart from './Chart.astro';
import Facts from './Facts.astro';
import Section from './Section.astro';
import Shot from './Shot.astro';

const pack = sectionPack('packages');
const { picture } = pack;
if (!picture) throw new Error('The packages pack has no picture');
---

<Section
  id="packages"
  index={2}
  name={pack.name}
  title={pack.title}
  line={pack.text}
  source={{ label: `Measured ${RUN.label}`, href: RUN.readme }}
>
  <div class="body">
    <Chart id="packaging" kicker="Seconds to package" views={PACKAGING_VIEWS}>
      Median of 10 runs on a dedicated EC2 machine, lower is better. After a change to the source, every tool takes
      about the same time.{' '}<a class="brand-link" href={RUN.readme}>All results</a>
    </Chart>
    <div class="side">
      <Shot
        desktop={{ small: picture.desktop.small, large: picture.desktop.large }}
        phone={{ small: picture.phone.small, large: picture.phone.large }}
        alt={picture.alt}
        sizes="(min-width: 92rem) 50rem, (min-width: 64rem) 56vw, 94vw"
      />
      <Facts facts={pack.gets} />
    </div>
  </div>
</Section>

<style>
  .body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: var(--brand-space-5) var(--brand-space-7);
  }

  .side {
    display: grid;
    gap: var(--brand-space-5);
  }

  @media (max-width: 64rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--brand-space-6);
    }
  }
</style>
