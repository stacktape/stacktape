---
import { ButtonLink } from '@stacktape/ui-react/button';
import { bars, FIRST_RUN, runDate } from '../../heroes/b/bench';
import Race from '../../heroes/b/Race.astro';
import Shot from '../../heroes/b/Shot.astro';
import type { SECTION_PACKS } from '../../sections';
import editorLarge from './shots/editor-1114.webp';
import editorSmall from './shots/editor-557.webp';

/** The picture and the points for one capability from the section packs. */
type Props = { pack: (typeof SECTION_PACKS)[number] };

const { pack } = Astro.props;
/*
 * Heroes show the wizard's Review screen (hero b, the pack's picture for Designs) and its Analyze screen (hero a), so
 * this page shows a different task: the generated config, open in the wizard's editor.
 */
const editor = { small: editorSmall, large: editorLarge };
const picture =
  pack.id === 'designs'
    ? {
        desktop: editor,
        phone: editor,
        alt: 'The generated stacktape.ts in the init wizard’s editor: a Postgres database with deletion protection, seven days of backups and a free-storage alarm, with no type errors.'
      }
    : pack.picture;

/** Where each screen lives, for the window's title bar. */
const WHERE: Record<string, string> = {
  designs: 'Example: saas-starter · init wizard, config editor',
  monitors: 'Example: Northwind Labs · metrics',
  secures: 'Example: Northwind Labs · guardrails',
  costs: 'Example: storefront · costs'
};
/* Support by plan, as `src/pages/pricing.astro` lists it (Flexible :47, Enterprise :58). */
const SUPPORT = [
  { plan: 'Flexible', help: 'A shared Slack channel with the founders' },
  { plan: 'Enterprise', help: 'Up to 24×7 premium support' }
];

const packaging = bars('packaging', 'empty-cache', 'lambda-25');
const ratio = picture ? picture.desktop.small.width / picture.desktop.small.height : 1;
const wide = ratio > 2.5;
/** A portrait picture would grow too tall in the wide column, so it gets an even split. */
const tall = ratio < 1.2;
---

<div class:list={['b-pack', { 'b-pack--wide': wide, 'b-pack--tall': tall }]}>
  {
    pack.id === 'packages' ? (
      <div class="b-pack__bench" data-races>
        <Race
          title="Package 25 Lambda functions"
          detail="Empty build cache, median of 10 runs"
          bars={packaging}
          scale={Math.max(...packaging.map((bar) => bar.seconds))}
        />
        <p class="b-pack__run">
          Preliminary run, {runDate(FIRST_RUN.date)}, on a dedicated EC2 c7i.2xlarge.{' '}
          <a class="brand-link" href="/benchmarks">
            All benchmarks
          </a>
        </p>
      </div>
    ) : picture ? (
      <div class="b-frame">
        <div class="b-frame__bar" aria-hidden="true">
          <span class="b-frame__dots">
            <i />
            <i />
            <i />
          </span>
          <span class="b-frame__where">{WHERE[pack.id]}</span>
        </div>
        <Shot
          class="b-pack__shot"
          small={picture.desktop.small}
          large={picture.desktop.large}
          phone={{ small: picture.phone.small, large: picture.phone.large }}
          alt={picture.alt}
          sizes="(min-width: 90rem) 52rem, (min-width: 64rem) 60vw, 94vw"
        />
      </div>
    ) : (
      <div class="b-pack__people">
        <dl class="b-pack__plans">
          {SUPPORT.map((row) => (
            <div>
              <dt>{row.plan}</dt>
              <dd>{row.help}</dd>
            </div>
          ))}
        </dl>
        <ButtonLink variant="secondary" className="brand-button" href="https://cal.com/stacktape/30min">
          Talk to a founder
        </ButtonLink>
      </div>
    )
  }

  <div class="b-pack__facts">
    {picture || pack.id === 'packages' ? <ul>{pack.gets.map((point) => <li>{point.replaceAll('`', '')}</li>)}</ul> : null}
  </div>
</div>

<style>
  .b-pack {
    display: grid;
    grid-template-columns: minmax(0, 2.6fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--brand-space-6) clamp(2rem, 1rem + 3vw, 5rem);
  }

  .b-pack--wide {
    grid-template-columns: minmax(0, 1fr);
  }

  .b-pack--tall {
    grid-template-columns: minmax(0, 36rem) minmax(0, 1fr);
  }

  .b-pack--wide .b-pack__facts {
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    padding-top: 0;
  }

  .b-pack__shot {
    display: block;
    width: 100%;
    height: auto;
  }

  .b-pack__bench,
  .b-pack__people {
    display: grid;
    gap: var(--brand-space-6);
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-inset);
  }

  .b-pack__people {
    justify-items: start;
    align-content: center;
    min-height: 14rem;
  }

  .b-pack__plans {
    display: grid;
    gap: var(--brand-space-4);
    margin: 0;
  }

  .b-pack__plans div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--brand-space-4);
    align-items: baseline;
  }

  .b-pack__plans dt {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  .b-pack__plans dd {
    margin: 0;
    font: var(--brand-weight-heading) var(--brand-type-lead) / 1.3 var(--brand-font-heading);
  }

  .b-pack__run {
    color: var(--brand-muted);
    font-size: var(--brand-type-xs);
  }

  .b-pack__facts {
    display: grid;
    gap: var(--brand-space-5);
    padding-top: var(--brand-space-5);
  }

  .b-pack__value {
    font: var(--brand-weight-heading) var(--brand-type-lead) / 1.3 var(--brand-font-heading);
  }

  .b-pack__label,
  .b-pack__facts li {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  .b-pack__label {
    margin-top: var(--brand-space-2);
  }

  .b-pack__facts ul {
    display: grid;
    gap: var(--brand-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .b-pack__facts li {
    padding-left: var(--brand-space-4);
    border-left: 1px solid var(--brand-border);
  }

  @media (max-width: 64rem) {
    .b-pack {
      grid-template-columns: minmax(0, 1fr);
    }

    .b-pack__facts {
      padding-top: 0;
    }
  }
</style>
