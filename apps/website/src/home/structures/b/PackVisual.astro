---
import { ButtonLink } from '@stacktape/ui-react/button';
import { bars, FIRST_RUN, runDate } from '../../heroes/b/bench';
import Race from '../../heroes/b/Race.astro';
import Shot from '../../heroes/b/Shot.astro';
import { SECTION_PACKS } from '../../sections';
import scanLarge from './shots/scan-2880.webp';
import scanSmall from './shots/scan-1440.webp';
import scanPhoneLarge from './shots/scan-phone-800.webp';
import scanPhoneSmall from './shots/scan-phone-400.webp';

/** The picture and the headline figure for one capability from the section packs. */
type Props = { pack: (typeof SECTION_PACKS)[number] };

const { pack } = Astro.props;
const { figure } = pack;
/*
 * Hero B already shows the wizard's Review screen, the pack's picture for Designs, so this page shows the step
 * before it: the coding agent reading the repository.
 */
const picture =
  pack.id === 'designs'
    ? {
        desktop: { small: scanSmall, large: scanLarge },
        phone: { small: scanPhoneSmall, large: scanPhoneLarge },
        alt: 'The init wizard’s Analyze step: Claude Code reads the saas-starter repository, read-only, while stacktape.yml waits for the first finding.'
      }
    : pack.picture;

/** Where each screen lives, for the window's title bar. */
const WHERE: Record<string, string> = {
  designs: 'stacktape init · wizard in your browser',
  monitors: 'console.stacktape.com · metrics',
  secures: 'console.stacktape.com · guardrails',
  costs: 'console.stacktape.com · costs · storefront'
};
/* Support by plan, as `src/pages/pricing.astro` lists it (Flexible :47, Enterprise :58). */
const SUPPORT = [
  { plan: 'Flexible', help: 'A shared Slack channel with the founders' },
  { plan: 'Enterprise', help: 'Up to 24×7 premium support' }
];
/* Facts that repeat the step's own line (from the hero's steps) are left out. */
const REPEATS: Record<string, string> = { designs: 'docs/cli/init.mdx:47-48', packages: 'docs/packaging/overview.mdx:37' };
const facts = pack.facts.filter((fact) => fact.source !== REPEATS[pack.id]);
const packaging = bars('packaging', 'empty-cache', 'lambda-25');
const wide = picture ? picture.desktop.small.width / picture.desktop.small.height > 2.5 : false;
---

<div class:list={['b-pack', { 'b-pack--wide': wide }]}>
  {
    pack.id === 'packages' ? (
      <div class="b-pack__bench" data-races>
        <Race
          title="Package 25 Lambda functions"
          detail="Empty build cache, median of 10 runs"
          bars={packaging}
          scale={Math.max(...packaging.map((bar) => bar.seconds))}
        />
        <p class="b-pack__run">
          Preliminary run, {runDate(FIRST_RUN.date)}, on a dedicated EC2 c7i.2xlarge.{' '}
          <a class="brand-link" href="/benchmarks">
            All benchmarks
          </a>
        </p>
      </div>
    ) : picture ? (
      <div class="b-frame">
        <div class="b-frame__bar" aria-hidden="true">
          <span class="b-frame__dots">
            <i />
            <i />
            <i />
          </span>
          <span class="b-frame__where">{WHERE[pack.id]}</span>
        </div>
        <Shot
          class="b-pack__shot"
          small={picture.desktop.small}
          large={picture.desktop.large}
          phone={{ small: picture.phone.small, large: picture.phone.large }}
          alt={picture.alt}
          sizes="(min-width: 90rem) 52rem, (min-width: 64rem) 60vw, 94vw"
        />
      </div>
    ) : (
      <div class="b-pack__people">
        <dl class="b-pack__plans">
          {SUPPORT.map((row) => (
            <div>
              <dt>{row.plan}</dt>
              <dd>{row.help}</dd>
            </div>
          ))}
        </dl>
        <ButtonLink variant="secondary" className="brand-button" href="https://cal.com/stacktape/30min">
          Talk to a founder
        </ButtonLink>
      </div>
    )
  }

  <div class="b-pack__facts">
    {
      pack.id === 'packages' || !picture ? null : (
        <div class="b-pack__figure">
          <p class="b-pack__value">{figure.value}</p>
          <p class="b-pack__label">{figure.label}</p>
        </div>
      )
    }
    {picture || pack.id === 'packages' ? <ul>{facts.map((fact) => <li>{fact.text.replaceAll('`', '')}</li>)}</ul> : null}
  </div>
</div>

<style>
  .b-pack {
    display: grid;
    grid-template-columns: minmax(0, 2.6fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--brand-space-6) clamp(2rem, 1rem + 3vw, 5rem);
  }

  .b-pack--wide {
    grid-template-columns: minmax(0, 1fr);
  }

  .b-pack--wide .b-pack__facts {
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    padding-top: 0;
  }

  .b-pack__shot {
    display: block;
    width: 100%;
    height: auto;
  }

  .b-pack__bench,
  .b-pack__people {
    display: grid;
    gap: var(--brand-space-6);
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-inset);
  }

  .b-pack__people {
    justify-items: start;
    align-content: center;
    min-height: 14rem;
  }

  .b-pack__plans {
    display: grid;
    gap: var(--brand-space-4);
    margin: 0;
  }

  .b-pack__plans div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--brand-space-4);
    align-items: baseline;
  }

  .b-pack__plans dt {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  .b-pack__plans dd {
    margin: 0;
    font: var(--brand-weight-heading) var(--brand-type-lead) / 1.3 var(--brand-font-heading);
  }

  .b-pack__run {
    color: var(--brand-muted);
    font-size: var(--brand-type-xs);
  }

  .b-pack__facts {
    display: grid;
    gap: var(--brand-space-5);
    padding-top: var(--brand-space-5);
  }

  .b-pack__value {
    font: var(--brand-weight-heading) var(--brand-type-lead) / 1.3 var(--brand-font-heading);
  }

  .b-pack__label,
  .b-pack__facts li {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  .b-pack__label {
    margin-top: var(--brand-space-2);
  }

  .b-pack__facts ul {
    display: grid;
    gap: var(--brand-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .b-pack__facts li {
    padding-left: var(--brand-space-4);
    border-left: 1px solid var(--brand-border);
  }

  @media (max-width: 64rem) {
    .b-pack {
      grid-template-columns: minmax(0, 1fr);
    }

    .b-pack__facts {
      padding-top: 0;
    }
  }
</style>
