---
import Tape from '../../../brand/Tape.astro';
import { CommandBox } from '../../../brand/CommandBox';
import { WIZARD_PRIVACY } from '../../sections';
---

<section class="b-closing site-frame" aria-labelledby="b-closing-title">
  <div class="b-closing__copy">
    <p class="b-closing__marker home-wide"><Tape variant="marker">Try it</Tape></p>
    <h2 id="b-closing-title">See what Stacktape builds for your app</h2>
    <p class="b-closing__line home-wide">{WIZARD_PRIVACY}</p>
    <p class="b-closing__line home-phone">Run it in your app's folder. Nothing deploys until you say so.</p>
  </div>
  <div class="b-closing__start home-wide">
    <CommandBox client:visible label="Run in your project" preselect={false} />
    <a class="brand-link brand-link--muted" href="https://console.stacktape.com">Already using Stacktape? Open the Console</a>
  </div>
  <div class="b-closing__start home-phone">
    <CommandBox client:media="(max-width: 40rem)" single />
    <a class="brand-link b-closing__console" href="https://console.stacktape.com">Open the Console</a>
  </div>
</section>

<style>
  .b-closing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--brand-space-6) clamp(2rem, 1rem + 4vw, 7rem);
    padding-block: clamp(4rem, 2.5rem + 4vw, 8rem);
    border-top: 1px solid var(--brand-border);
  }

  .b-closing__marker {
    margin-bottom: var(--brand-space-5);
  }

  h2 {
    font: var(--brand-weight-heading) clamp(2.25rem, 1.5rem + 2.4vw, 4rem) / 1.04 var(--brand-font-heading);
    letter-spacing: var(--brand-tracking-heading);
  }

  .b-closing__line {
    max-width: 30rem;
    margin-top: var(--brand-space-4);
    color: var(--brand-muted);
    font-size: var(--brand-type-lead);
  }

  .b-closing__start {
    display: grid;
    gap: var(--brand-space-3);
    min-width: 0;
    font-size: var(--brand-type-sm);
  }

  .b-closing__start > a {
    justify-self: start;
  }

  @media (max-width: 64rem) {
    .b-closing {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .b-closing {
      gap: var(--brand-space-4);
      padding-block: var(--home-section-space);
    }

    h2 {
      font-size: 1.75rem;
      line-height: 1.1;
    }

    .b-closing__line {
      margin-top: var(--brand-space-3);
      color: var(--home-soft);
      font-size: var(--brand-type-base);
      line-height: 1.5;
    }

    .b-closing__console {
      display: inline-flex;
      align-items: center;
      min-height: var(--brand-control-height);
      padding-inline: var(--brand-space-4);
      border: 1px solid var(--brand-border);
      color: var(--brand-text);
      font-size: var(--home-caption);
      text-decoration: none;
    }

    .b-closing__console:hover {
      background: var(--brand-surface);
    }
  }
</style>
