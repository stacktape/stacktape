---
import Tape from '../../../brand/Tape.astro';
import { CommandBox } from '../../../brand/CommandBox';
import MobileCommand from '../../../brand/MobileCommand.astro';
import { COMMANDS } from '../../../brand/install-commands';
import { WIZARD_PRIVACY } from '../../sections';

const pageUrl = new URL('/', Astro.site ?? Astro.url);
const shareText = `Run this in your app’s folder to preview your AWS setup:\n\n${COMMANDS[0].command}\n\n${pageUrl}`;
---

<section class="b-closing site-frame" aria-labelledby="b-closing-title">
  <div class="b-closing__copy">
    <p class="b-closing__marker home-wide"><Tape variant="marker">Try it</Tape></p>
    <h2 id="b-closing-title">See what Stacktape builds for your app</h2>
    <p class="b-closing__line home-wide">{WIZARD_PRIVACY}</p>
    <p class="b-closing__line home-phone">Run it in your app's folder. Nothing deploys until you say so.</p>
  </div>
  <div class="b-closing__start home-wide">
    <CommandBox client:visible label="Run in your project" preselect={false} />
    <a class="brand-link brand-link--muted" href="https://console.stacktape.com">Already using Stacktape? Open the Console</a>
  </div>
  <div class="b-closing__start home-phone">
    <MobileCommand />
    <div class="b-closing__actions">
      <button class="b-closing__secondary" type="button" data-share-setup={shareText} hidden>Share setup command</button>
      <a class="brand-link b-closing__secondary" href="https://console.stacktape.com">Open the Console</a>
    </div>
    <p class="b-closing__share-status" role="status" data-share-status></p>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-share-setup]');
  const status = document.querySelector<HTMLElement>('[data-share-status]');
  const text = button?.dataset.shareSetup;
  if (button && status && text && typeof navigator.share === 'function' && (navigator.canShare?.({ text }) ?? true)) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      status.textContent = '';
      try {
        await navigator.share({ text });
      } catch (error) {
        if (!(error instanceof DOMException && error.name === 'AbortError')) {
          status.textContent = 'Couldn’t share the command. You can copy it above.';
        }
      }
    });
  }
</script>

<style>
  .b-closing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--brand-space-6) clamp(2rem, 1rem + 4vw, 7rem);
    padding-block: clamp(4rem, 2.5rem + 4vw, 8rem);
    border-top: 1px solid var(--brand-border);
  }

  .b-closing__marker {
    margin-bottom: var(--brand-space-5);
  }

  h2 {
    font: var(--brand-weight-heading) clamp(2.25rem, 1.5rem + 2.4vw, 4rem) / 1.04 var(--brand-font-heading);
    letter-spacing: var(--brand-tracking-heading);
  }

  .b-closing__line {
    max-width: 30rem;
    margin-top: var(--brand-space-4);
    color: var(--brand-muted);
    font-size: var(--brand-type-lead);
  }

  .b-closing__start {
    display: grid;
    gap: var(--brand-space-3);
    min-width: 0;
    font-size: var(--brand-type-sm);
  }

  .b-closing__start > a {
    justify-self: start;
  }

  @media (max-width: 64rem) {
    .b-closing {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .b-closing {
      gap: var(--brand-space-4);
      padding-block: var(--home-section-space);
    }

    h2 {
      font-size: 1.75rem;
      line-height: 1.1;
    }

    .b-closing__line {
      margin-top: var(--brand-space-3);
      color: var(--home-soft);
      font-size: var(--brand-type-base);
      line-height: 1.5;
    }

    .b-closing__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--brand-space-2);
    }

    .b-closing__secondary:not([hidden]) {
      display: inline-flex;
      align-items: center;
      min-height: var(--brand-control-height);
      padding-inline: var(--brand-space-4);
      border: 1px solid var(--brand-border);
      color: var(--brand-text);
      font-size: var(--home-caption);
      text-decoration: none;
      cursor: pointer;
    }

    .b-closing__secondary:hover {
      background: var(--brand-surface);
    }

    .b-closing__share-status {
      color: var(--brand-muted);
      font-size: var(--home-caption);
    }

    .b-closing__share-status:empty {
      position: absolute;
    }
  }
</style>
