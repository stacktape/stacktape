---
import { TESTIMONIALS } from '../../../variants/readme/data';

/*
 * The old site's three quotes, word for word. The owner confirmed Trigger.dev's quote stays (25 Nov). Receipts leads:
 * its quote is the most specific and Receipts is still a customer; Trigger.dev has since left, so the title says
 * "have said" rather than implying all three use Stacktape today.
 */
const ORDER = ['Henry Garrett', 'Rhys Williams', 'Eric Allam'];
const QUOTES = ORDER.map((name) => {
  const found = TESTIMONIALS.find((item) => item.name === name);
  if (!found) throw new Error(`No testimonial from ${name}`);
  return found;
});
---

<section class="b-proof site-frame" aria-labelledby="b-proof-title">
  <h2 id="b-proof-title" class="b-proof__title">What teams have said about Stacktape</h2>
  <ul class="b-proof__quotes">
    {
      QUOTES.map((item) => (
        <li>
          <blockquote>
            <p>“{item.quote}”</p>
          </blockquote>
          <p class="b-proof__who">
            <strong>{item.name}</strong>
            <span>{item.role}</span>
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .b-proof {
    padding-block: var(--brand-space-7) clamp(2rem, 1rem + 3vw, 4rem);
    border-top: 1px solid var(--brand-border);
  }

  .b-proof__title {
    margin-bottom: var(--brand-space-6);
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    font-weight: var(--brand-weight-label);
  }

  .b-proof__quotes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--brand-space-6) clamp(2rem, 1rem + 3vw, 5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each name sits right under its quote, not at the bottom of the tallest one. */
  .b-proof__quotes li {
    display: grid;
    align-content: start;
    gap: var(--brand-space-5);
  }

  blockquote {
    margin: 0;
    font-size: var(--brand-type-base);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .b-proof__who {
    display: grid;
    font-size: var(--brand-type-sm);
  }

  .b-proof__who span {
    color: var(--brand-muted);
  }

  @media (max-width: 64rem) {
    .b-proof__quotes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
