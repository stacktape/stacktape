---
import Tape from '../../../brand/Tape.astro';
import { codeParts } from '../../code-text';
import type { SECTION_PACKS } from '../../sections';

/**
 * One section: its number, title and text from the section pack, the measured figure when the text quotes one, the
 * docs link, the picture (the slot), and the pack's one to three points under it.
 */
type Props = {
  pack: (typeof SECTION_PACKS)[number];
  index: number;
  docs?: { label: string; href: string };
};

const { pack, index, docs } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const figure = pack.figure;
const slowest = figure ? Math.max(...figure.bars.map((bar) => bar.seconds)) : 1;
/** Text with backtick-marked code set in mono. */
const words = (text: string) => codeParts(text);
---

<section class="b-step" id={pack.id} aria-labelledby={`${pack.id}-title`}>
  <header class="b-step__head">
    <div class="b-step__intro">
      <p class="b-step__marker"><Tape variant="marker">{number}</Tape></p>
      <h2 id={`${pack.id}-title`}>{pack.title}</h2>
    </div>
    <div class="b-step__aside">
      <p class="b-step__line">{words(pack.text).map(({ part, code }) => (code ? <code>{part}</code> : part))}</p>
      {
        figure ? (
          <figure class="b-step__figure">
            <figcaption>{figure.label}</figcaption>
            <ol>
              {figure.bars.map((bar) => (
                <li class:list={{ 'is-us': bar.stacktape }}>
                  <span>{bar.tool}</span>
                  <i style={`--b-bar: ${(bar.seconds / slowest) * 100}%`} />
                  <b>{bar.seconds.toFixed(1)} s</b>
                </li>
              ))}
            </ol>
            <a class="brand-link brand-link--muted" href={figure.link}>
              Preliminary benchmark run, {figure.runDate}
            </a>
          </figure>
        ) : null
      }
      {
        docs ? (
          <a class="brand-link b-step__docs" href={docs.href}>
            {docs.label}
          </a>
        ) : null
      }
    </div>
  </header>
  <slot />
  {
    pack.gets.length > 0 ? (
      <ul class="b-step__points" style={`--b-points: ${pack.gets.length}`}>
        {pack.gets.map((point) => (
          <li>{words(point).map(({ part, code }) => (code ? <code>{part}</code> : part))}</li>
        ))}
      </ul>
    ) : null
  }
</section>

<style>
  .b-step {
    display: grid;
    gap: clamp(2rem, 1.5rem + 1.5vw, 3rem);
    padding-block: clamp(4rem, 2.5rem + 4vw, 8rem);
  }

  .b-step__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--brand-space-5) clamp(2rem, 1rem + 3vw, 5rem);
  }

  .b-step__marker {
    margin-bottom: var(--brand-space-4);
  }

  h2 {
    max-width: 16ch;
    font: var(--brand-weight-heading) clamp(2rem, 1.4rem + 1.8vw, 3.25rem) / 1.06 var(--brand-font-heading);
    letter-spacing: var(--brand-tracking-heading);
    text-wrap: balance;
  }

  .b-step__aside {
    display: grid;
    justify-items: start;
    gap: var(--brand-space-4);
  }

  .b-step__line {
    max-width: 34rem;
    font-size: var(--brand-type-lead);
    line-height: 1.5;
    text-wrap: pretty;
  }

  code {
    font: 0.9em var(--brand-font-mono);
  }

  .b-step__docs {
    font-size: var(--brand-type-sm);
  }

  .b-step__figure {
    display: grid;
    gap: var(--brand-space-2);
    width: min(100%, 30rem);
    margin: 0;
    font-size: var(--brand-type-xs);
  }

  .b-step__figure figcaption {
    color: var(--brand-muted);
  }

  .b-step__figure ol {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .b-step__figure li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) 3.5rem;
    align-items: center;
    gap: var(--brand-space-3);
    color: var(--brand-muted);
  }

  .b-step__figure li i {
    width: var(--b-bar);
    height: 0.5rem;
    background: var(--brand-border);
  }

  .b-step__figure li b {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .b-step__figure li.is-us {
    color: var(--brand-text);
    font-weight: var(--brand-weight-label);
  }

  .b-step__figure li.is-us i {
    background: var(--brand-teal);
  }

  /*
   * The points share a row of three equal columns: two points take two of them and one point one, from the left, so a
   * point is never wider than a third and no empty column keeps a rule.
   */
  .b-step__points {
    --b-gap: clamp(1.5rem, 1rem + 2vw, 3rem);

    display: grid;
    grid-template-columns: repeat(var(--b-points), minmax(0, 1fr));
    width: calc((100% - 2 * var(--b-gap)) * var(--b-points) / 3 + (var(--b-points) - 1) * var(--b-gap));
    gap: var(--brand-space-5) var(--b-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .b-step__points li {
    padding-top: var(--brand-space-4);
    border-top: 1px solid var(--brand-border);
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    line-height: 1.55;
    text-wrap: pretty;
  }

  @media (max-width: 52rem) {
    .b-step__head,
    .b-step__points {
      grid-template-columns: minmax(0, 1fr);
    }

    .b-step__points {
      width: auto;
    }
  }
</style>
