---
import { BENCHMARKS, findGroup, runReadme } from '../../../variants/readme/benchmarks';
import { codeParts } from '../../code-text';

/*
 * The questions a CTO decides on, first the real choice (a PaaS, a DevOps hire or Stacktape), then cost, exit, scale,
 * networking, data and escape hatches. Sources: Heroku/Render = bench git-push / warm / container-node (Stacktape 23 Oct
 * rerun with code swap on every push, Heroku and Render 22 Oct); DevOps = the eight sections; cost =
 * pages/pricing.astro (Free plan, Flexible bands, $250 at $1,000, "When a Free organization passes $200": one 7-day
 * grace, then new deploys pause, running infrastructure untouched); lock-in = docs/getting-started/open-source-cli.mdx
 * (what works without an account, "Go back to working without an account": the stacktape-app.com domain), uptime
 * checks need the Console (docs/observability/uptime-checks.mdx); scale = docs/resources/compute/web-service.mdx:196,
 * :253-262; private database = docs/resources/databases/relational-database.mdx:210-213, :252-261, :298, :622; data =
 * business/05-product-principles.md §1, docs/observability/error-tracking.mdx:70-72, security-scanning.mdx (OSV.dev),
 * docs/cli/init.mdx:15-21, docs/observability/incident-ai.mdx (what the providers receive); escape hatches =
 * docs/configuration/overrides-and-escape-hatches.mdx:10-16.
 */
const push = findGroup('git-push', 'warm', 'container-node').group.values;
const pushSeconds = (tool: string) => {
  const found = push.find((value) => value.tool === tool);
  if (!found) throw new Error(`No Git push time for ${tool}`);
  return found.median.toFixed(1);
};
/* Stacktape's pushes are the 23 Oct rerun; Heroku and Render are from 22 Oct. Both runs must be in the data. */
for (const date of ['2026-10-22', '2026-10-23']) {
  if (!BENCHMARKS.runs.some((run) => run.date === date)) throw new Error(`The benchmark data has no run of ${date}`);
}

type Question = { q: string; a: string; link?: { label: string; href: string } };

const QUESTIONS: Question[] = [
  {
    q: 'Why not Heroku or Render?',
    a: `Your app runs in your own AWS account at AWS prices, and you can add CloudFormation resources and CDK constructs to the generated stack. You still get push-to-deploy and pull request previews. In our preliminary Git push benchmark of 22–23 October 2026, a warm Node.js code change took ${pushSeconds('stacktape')} seconds with Stacktape and code swap turned on, ${pushSeconds('heroku')} seconds on Heroku and ${pushSeconds('render')} seconds on Render. Heroku was faster for Python.`,
    link: { label: 'Git push results on GitHub', href: runReadme('2026-10-23') }
  },
  {
    q: 'Why not hire a DevOps engineer?',
    a: 'Your developers get deploy pipelines, permissions, monitoring and incident alerts without building them. Your team still owns the AWS account, approves changes and responds to incidents. On Flexible, you can ask the founders in Slack when you get stuck.'
  },
  {
    q: 'What does it cost?',
    a: 'The CLI is free. The Console is free up to $200 a month of managed AWS spend. The first time you go over, you have seven days to upgrade. After that, new deploys of Console-connected stacks pause until you upgrade or the next month starts, and your running apps are not affected. Flexible costs 19–25% of the whole managed spend, $250 a month at $1,000, for the whole team.',
    link: { label: 'Pricing', href: '/pricing' }
  },
  {
    q: 'Are we locked in?',
    a: 'Your AWS resources run in your account as standard CloudFormation stacks, and the Stacktape config stays in your repository. The open-source CLI (MIT) deploys with your own AWS credentials, without the Console. To deploy that way, first replace a Stacktape-provided domain with your own and remove Console-only settings such as uptime checks. Deploy history, error tracking and incidents live in the Console.',
    link: { label: 'Using the CLI without an account', href: 'https://docs.stacktape.com/getting-started/open-source-cli' }
  },
  {
    q: 'Will it scale with us?',
    a: 'Your app runs on AWS services such as Lambda, ECS Fargate and Aurora. For a container service, you set the minimum and maximum number of containers and the CPU or memory level that adds more. Lambda functions scale on their own. Stacktape is AWS only and needs no Kubernetes.'
  },
  {
    q: 'Can our database stay private?',
    a: 'Yes. By default, an RDS database accepts connections from anywhere with valid credentials. With `scoping-workloads-in-vpc`, only the services that list it in `connectTo` and the IP addresses you allow can reach it. Add a bastion host if your team needs a tunnel. Aurora Serverless v2 always requires a VPC mode.'
  },
  {
    q: 'What leaves our AWS account?',
    a: 'Application logs, build artifacts and application secrets stay in your account. The Console receives error details and short log excerpts with recognized sensitive patterns masked, plus metrics, check results and security findings. Dependency scans send package names and versions to OSV.dev. Init sends the generated config and region to Stacktape for pricing. During init, Claude Code or Codex sends the files it reads to its provider, while Files only scans locally. With incident AI on, the provider receives the incident evidence, and an investigating agent sends the code and command output it reads to its provider.',
    link: {
      label: 'What leaves your AWS account',
      href: 'https://docs.stacktape.com/observability/error-tracking#what-leaves-your-aws-account'
    }
  },
  {
    q: 'What if we need something Stacktape doesn’t support?',
    a: 'You can override properties of the CloudFormation resources Stacktape generates, such as a Lambda function’s reserved concurrency. You can also add raw CloudFormation resources or AWS CDK constructs to the same stack.'
  }
];
---

<section class="b-questions site-frame" aria-labelledby="b-questions-title">
  <div class="b-questions__head">
    <h2 id="b-questions-title">Questions</h2>
  </div>
  <dl class="b-questions__list">
    {
      QUESTIONS.map((item) => (
        <div>
          <dt>{item.q}</dt>
          <dd>
            {codeParts(item.a).map(({ part, code }) => (code ? <code>{part}</code> : part))}
            {item.link ? (
              <a class="brand-link brand-link--muted b-questions__link" href={item.link.href}>
                {item.link.label}
              </a>
            ) : null}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  /* The heading sits above the answers: a one-word title does not need a column of its own. */
  .b-questions {
    display: grid;
    gap: var(--brand-space-6);
    padding-block: clamp(4rem, 2.5rem + 4vw, 8rem);
    border-top: 1px solid var(--brand-border);
  }

  h2 {
    font: var(--brand-weight-heading) var(--brand-type-title) / 1.15 var(--brand-font-heading);
    letter-spacing: var(--brand-tracking-heading);
  }

  .b-questions__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--brand-space-6) clamp(2rem, 1rem + 3vw, 5rem);
    margin: 0;
  }

  dt {
    margin-bottom: var(--brand-space-2);
    font: var(--brand-weight-label) var(--brand-type-lead) / 1.3 var(--brand-font-heading);
  }

  dd {
    margin: 0;
    color: var(--brand-muted);
  }

  dd code {
    color: var(--brand-text);
    font: 0.9em var(--brand-font-mono);
    overflow-wrap: anywhere;
  }

  .b-questions__link {
    display: block;
    width: fit-content;
    margin-top: var(--brand-space-2);
    font-size: var(--brand-type-sm);
  }

  @media (max-width: 64rem) {
    .b-questions__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
