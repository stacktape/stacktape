---
import { BENCHMARKS, findGroup, runReadme } from '../../../variants/readme/benchmarks';
import { codeParts } from '../../code-text';

/*
 * The questions a CTO decides on, first the real choice (a PaaS, a DevOps hire or Stacktape), then cost, exit, scale,
 * networking, data and escape hatches. Sources: Heroku/Render = bench git-push / warm / container-node (Stacktape 23 Oct
 * rerun with code swap on every push, Heroku and Render 22 Oct); DevOps = the eight sections; cost =
 * pages/pricing.astro (Free plan, Flexible bands, $250 at $1,000, "When a Free organization passes $200": one 7-day
 * grace, then new deploys pause, running infrastructure untouched); lock-in = docs/getting-started/open-source-cli.mdx
 * (what works without an account, "Go back to working without an account": the stacktape-app.com domain), uptime
 * checks need the Console (docs/observability/uptime-checks.mdx); scale = docs/resources/compute/web-service.mdx:196,
 * :253-262; private database = docs/resources/databases/relational-database.mdx:210-213, :252-261, :298, :622; data =
 * business/05-product-principles.md §1, docs/observability/error-tracking.mdx:70-72, security-scanning.mdx (OSV.dev),
 * docs/cli/init.mdx:15-21, docs/observability/incident-ai.mdx (what the providers receive); escape hatches =
 * docs/configuration/overrides-and-escape-hatches.mdx:10-16.
 */
const push = findGroup('git-push', 'warm', 'container-node').group.values;
const pushSeconds = (tool: string) => {
  const found = push.find((value) => value.tool === tool);
  if (!found) throw new Error(`No Git push time for ${tool}`);
  return found.median.toFixed(1);
};
/* Stacktape's pushes are the 23 Oct rerun; Heroku and Render are from 22 Oct. Both runs must be in the data. */
for (const date of ['2026-10-22', '2026-10-23']) {
  if (!BENCHMARKS.runs.some((run) => run.date === date)) throw new Error(`The benchmark data has no run of ${date}`);
}

type Question = { q: string; a: string; link?: { label: string; href: string } };

/** The real choice (a PaaS or a DevOps hire) stays open; the rest is an index a buyer opens. */
const OPEN_BY_DEFAULT = 2;

const QUESTIONS: Question[] = [
  {
    q: 'Why not Heroku or Render?',
    a: `Your app runs in your own AWS account at AWS prices, with CloudFormation and CDK when you need more. Push-to-deploy and PR previews still work. A warm Git push of our Node.js test service went live in ${pushSeconds('stacktape')} s with code swap, against ${pushSeconds('heroku')} s on Heroku and ${pushSeconds('render')} s on Render.`,
    link: { label: 'Git push results on GitHub', href: runReadme('2026-10-23') }
  },
  {
    q: 'Why not hire a DevOps engineer?',
    a: 'Your developers get pipelines, permissions, monitoring and incident alerts on day one. On Flexible, the founders answer your AWS questions in Slack.'
  },
  {
    q: 'What does it cost?',
    a: 'The CLI is free, and so is the Console up to $200 a month of managed AWS spend. Above that, Flexible costs 19–25% of it, $250 a month at $1,000, never per seat. Running apps are never paused.',
    link: { label: 'Pricing', href: '/pricing' }
  },
  {
    q: 'Are we locked in?',
    a: 'Your resources are standard CloudFormation stacks in your AWS account, and they keep running if you stop paying. The MIT-licensed CLI deploys them without the Console.',
    link: { label: 'Using the CLI without an account', href: 'https://docs.stacktape.com/getting-started/open-source-cli' }
  },
  {
    q: 'Will it scale with us?',
    a: 'Your app runs on Lambda, ECS Fargate and Aurora, and you set how far each container service scales. There’s no Kubernetes cluster and no server to patch.'
  },
  {
    q: 'Can our database stay private?',
    a: 'Yes. With `scoping-workloads-in-vpc`, only the services that list it in `connectTo` can reach it, and your team connects through a bastion host.'
  },
  {
    q: 'What leaves our AWS account?',
    a: 'Logs, build artifacts and secrets stay in your account. The Console receives errors with masked log excerpts, metrics, check results and security findings, and init sends Stacktape only the generated config for pricing.',
    link: {
      label: 'What leaves your AWS account',
      href: 'https://docs.stacktape.com/observability/error-tracking#what-leaves-your-aws-account'
    }
  },
  {
    q: 'What if we need something Stacktape doesn’t support?',
    a: 'Add raw CloudFormation resources or AWS CDK constructs to the same stack, or override what Stacktape generates, such as a Lambda’s reserved concurrency.'
  }
];
---

<section class="b-questions site-frame" aria-labelledby="b-questions-title">
  <h2 id="b-questions-title">Questions</h2>
  <div class="b-questions__list">
    {
      QUESTIONS.map((item, index) => (
        <details class="b-question" open={index < OPEN_BY_DEFAULT}>
          <summary>{item.q}</summary>
          <div class="b-question__answer">
            <p>{codeParts(item.a).map(({ part, code }) => (code ? <code>{part}</code> : part))}</p>
            {item.link ? (
              <a class="brand-link brand-link--muted b-question__link" href={item.link.href}>
                {item.link.label}
              </a>
            ) : null}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /*
   * One column of native <details> rows, no script: the questions read as a short index on every screen, and a buyer
   * opens the one about price, lock-in or data. The heading sits above the list.
   */
  .b-questions {
    display: grid;
    gap: var(--brand-space-6);
    padding-block: clamp(4rem, 2.5rem + 4vw, 8rem);
    border-top: 1px solid var(--brand-border);
  }

  h2 {
    font: var(--brand-weight-heading) var(--brand-type-title) / 1.15 var(--brand-font-heading);
    letter-spacing: var(--brand-tracking-heading);
  }

  .b-questions__list {
    max-width: 56rem;
    border-bottom: 1px solid var(--brand-border);
  }

  .b-question {
    border-top: 1px solid var(--brand-border);
  }

  summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--brand-space-4);
    padding-block: var(--brand-space-4);
    font: var(--brand-weight-label) var(--brand-type-lead) / 1.3 var(--brand-font-heading);
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /*
   * No teal anywhere in this section (owner, 25 Nov): a plain grey plus that turns into a minus, brightening on hover,
   * and a white focus outline instead of the brand's teal one.
   */
  summary::after {
    flex: none;
    width: 1ch;
    color: var(--brand-muted);
    font: var(--brand-weight-label) var(--brand-type-lead) / 1 var(--brand-font-mono);
    content: '+';
  }

  .b-question[open] > summary::after {
    content: '−';
  }

  summary:hover::after {
    color: var(--brand-text);
  }

  .b-questions :focus-visible {
    outline: 2px solid var(--brand-text);
    outline-offset: 2px;
  }

  .b-question__answer {
    max-width: 48rem;
    padding-bottom: var(--brand-space-5);
    color: var(--brand-muted);
  }

  .b-question__answer p {
    margin: 0;
  }

  .b-question__answer code {
    color: var(--brand-text);
    font: 0.9em var(--brand-font-mono);
    overflow-wrap: anywhere;
  }

  .b-question__link {
    display: block;
    width: fit-content;
    margin-top: var(--brand-space-2);
    font-size: var(--brand-type-sm);
  }
</style>
