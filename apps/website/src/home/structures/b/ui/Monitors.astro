---
import Window from './console/Window.astro';

/**
 * Error tracking in the Console (apps/console/ui IssuesPage), filtered to acme-shop production, at the hero's time,
 * 13:06 (heroes/h5/console/data.ts). The organization's four open errors are all on production, as the hero's stage
 * overview and sidebar count them (COUNTS.errors): the TypeError, the payment error and two worker errors. Rows are in
 * the page's default order, last seen first. The hero's incident is the last: the 10:12 release broke order totals for
 * empty carts, 56 events from 10:16 until the 11:04 fix, so it was last seen two hours ago and stays open until someone
 * resolves it.
 * The API and the worker are packaged with `js-bundle`, the packaging whose errors Stacktape reads from the logs
 * without an SDK (docs/observability/error-tracking.mdx, "What reports errors").
 *
 * A phone shows two issues in full, the hero's TypeError among them: message, source line, events and last seen.
 */
const ISSUES = [
  {
    type: 'PaymentProviderError',
    message: 'POST https://api.payments.example/v1/charges answered 502 Bad Gateway',
    resource: 'worker',
    frame: 'chargeOrder',
    file: 'charge.ts:41',
    events: 9,
    since: '1h ago',
    last: '12m ago'
  },
  {
    type: 'Error',
    message: 'connect ETIMEDOUT [redacted:ip]:6379',
    resource: 'worker',
    events: 6,
    since: '5h ago',
    last: '41m ago',
    wide: true
  },
  {
    type: 'Error',
    message: 'Image resize for product 18342 timed out after 30000 ms',
    resource: 'worker',
    frame: 'resizeProductImage',
    file: 'images.ts:19',
    events: 3,
    since: '1d ago',
    last: '1h ago',
    wide: true
  },
  {
    type: 'TypeError',
    message: "Cannot read properties of undefined (reading 'total')",
    resource: 'api',
    frame: 'orderTotals',
    file: 'totals.ts:18',
    events: 56,
    since: '3h ago',
    last: '2h ago'
  }
];
const TABS = [
  { name: 'Open', count: 4, selected: true },
  { name: 'Resolved', count: 11 },
  { name: 'Ignored', count: 1, wide: true },
  { name: 'All', count: 16, wide: true }
];
---

<Window
  label="Error tracking in the Stacktape Console, filtered to acme-shop production: four open issues grouped from runtime errors in the API and worker services, last seen first. One is TypeError: Cannot read properties of undefined (reading 'total') in orderTotals, totals.ts line 18, 56 events since 3 hours ago, last seen 2 hours ago."
  page="Error tracking"
  current="errors"
  openErrors={4}
  organization={false}
>
  <div class="mn-head">
    <h3 class="cn-h1">Error tracking</h3>
    <span class="cn-button cn-wide">Settings</span>
  </div>

  <div class="cn-panel mn-list">
    <div class="mn-filters">
      <span class="cn-segments">
        {
          TABS.map((tab) => (
            <span aria-selected={tab.selected ? 'true' : 'false'} class:list={{ 'cn-wide': tab.wide }}>
              {tab.name} <small>{tab.count}</small>
            </span>
          ))
        }
      </span>
      <span class="mn-field mn-search cn-wide">Search errors</span>
      <span class="mn-field cn-wide"><span class="cn-muted">Project</span> acme-shop</span>
      <span class="mn-field mn-stage"><span class="cn-muted">Stage</span> production</span>
    </div>
    <div class="cn-table" style="--cn-columns: minmax(0, 1fr) 9.5em 6.5em 1.2em 0.6em">
      <div class="cn-table__head">
        <span>Error</span>
        <span class="cn-right">Events</span>
        <span>Last seen ↓</span>
        <span class="cn-wide"></span>
        <span></span>
      </div>
      {
        ISSUES.map((issue) => (
          <div class:list={['mn-row', { 'cn-wide': issue.wide }]}>
            <span class="mn-issue">
              <span class="mn-message">
                {issue.type ? <b>{issue.type}: </b> : null}
                {issue.message}
              </span>
              <span class="cn-sub">
                acme-shop / production · <span class="cn-link">{issue.resource}</span>
                {issue.frame ? (
                  <>
                    {' · '}
                    <span class="cn-mono">{issue.frame}</span> <span class="cn-mono cn-faint">{issue.file}</span>
                  </>
                ) : null}
              </span>
            </span>
            <span class="cn-right mn-count">
              <b class="mn-events">{issue.events}</b> <span class="cn-muted mn-since">since {issue.since}</span>
            </span>
            <span class="cn-status mn-last">
              <i class="cn-dot cn-dot--red" />
              {issue.last}
            </span>
            <span class="cn-wide mn-more">···</span>
            <span class="cn-chevron" />
          </div>
        ))
      }
    </div>
  </div>
</Window>

<style>
  .mn-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mn-list {
    margin-top: 1.4em;
  }

  .mn-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    padding: 0.7em;
    border-bottom: 1px solid var(--cn-line-soft);
  }

  .mn-field {
    display: flex;
    align-items: center;
    gap: 0.5em;
    height: 2.8em;
    padding: 0 1em;
    border: 1px solid var(--cn-line);
    background: var(--cn-page);
    white-space: nowrap;
  }

  .mn-search {
    flex: 1;
    min-width: 7em;
    overflow: hidden;
    color: var(--cn-faint);
  }

  .mn-issue {
    min-width: 0;
  }

  .mn-message {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mn-message b {
    font-weight: 700;
  }

  .mn-events {
    font-weight: 700;
  }

  .mn-since {
    font-size: 0.92em;
  }

  .mn-more {
    color: var(--cn-muted);
    letter-spacing: 0.05em;
  }

  /* A phone: the message on up to two lines, its source line, then the events and when it was last seen. */
  @container (max-width: 520px) {
    .mn-list .cn-table__head {
      display: none;
    }

    .mn-list .mn-row {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: 'issue issue' 'count last';
      gap: 0.5em 1.25em;
    }

    .mn-issue {
      grid-area: issue;
    }

    .mn-message {
      display: -webkit-box;
      white-space: normal;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .mn-issue .cn-sub {
      white-space: normal;
    }

    .mn-count {
      grid-area: count;
      text-align: left;
    }

    .mn-last {
      grid-area: last;
    }

    .mn-row .cn-chevron {
      display: none;
    }

    .mn-stage {
      flex: 1;
    }
  }
</style>
