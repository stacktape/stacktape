---
import Window from './console/Window.astro';

/**
 * One request's trace in the Console (apps/console/ui TraceDetailPage): a `GET /cart` on acme-shop's production API at
 * 10:16, four minutes after the 10:12 release that broke order totals for empty carts (heroes/h5/console/data.ts). The
 * waterfall shows the request's steps, the API's Redis read and two Postgres queries, and the request failing with the
 * TypeError behind the hero's incident, in `orderTotals` (totals.ts:18). The failing step is selected, as the page
 * selects it on opening. The owner asked for traces instead of error tracking here (25 Nov).
 *
 * The API is a container: Stacktape adds an OpenTelemetry collector to the task and the app's OpenTelemetry SDK sends
 * its spans there (docs/observability/tracing.mdx, "Container services"). The sidebar is the hero's 13:06.
 *
 * A phone shows the failure and the waterfall; the selected step's panel is for wider screens.
 */
const TOTAL = 46;
const STEPS = [
  { name: 'GET /cart', depth: 0, start: 0, ms: 46, error: true },
  { name: 'Redis GET', depth: 1, start: 2, ms: 1.1 },
  { name: 'PostgreSQL SELECT cart_items', depth: 1, start: 4, ms: 15 },
  { name: 'PostgreSQL SELECT tax_rates', depth: 1, start: 20, ms: 11 }
];
const FACTS = [
  ['Took', '46 ms, 100% of the request'],
  ['Service', 'api'],
  ['HTTP', 'GET 500'],
  ['Started', 'Nov 25, 2026, 10:16']
];
const at = (ms: number) => `${(ms / TOTAL) * 100}%`;
const duration = (ms: number) => (ms < 10 ? `${ms.toFixed(1)} ms` : `${Math.round(ms)} ms`);
---

<Window
  label="A trace in the Stacktape Console: GET /cart on acme-shop's production API at 10:16, failed with error 500 after 46 ms. Its steps are a Redis read and two Postgres queries; the request failed with TypeError: Cannot read properties of undefined (reading 'total') in orderTotals, totals.ts line 18."
  page="Traces"
  current="traces"
  openErrors={4}
  organization={false}
>
  <p class="tr-crumbs cn-muted">Traces</p>
  <div class="tr-head">
    <h3 class="cn-h1">GET /cart</h3>
    <span class="cn-muted">api in acme-shop / production</span>
    <span class="cn-status cn-status--red"><i class="cn-dot cn-dot--red"></i>Error <span class="cn-muted">500</span></span>
    <span class="tr-related cn-wide">
      <span class="cn-muted">Related</span>
      <span>Traces</span>
      <span>Metrics</span>
      <span>Errors</span>
    </span>
  </div>

  <div class="cn-panel tr-failure">
    <span class="cn-dot cn-dot--red"></span>
    <div>
      <p class="tr-failure__where">Failed in GET /cart</p>
      <p class="cn-muted">TypeError: Cannot read properties of undefined (reading 'total')</p>
    </div>
    <span class="tr-logs cn-wide">Logs of this request</span>
  </div>

  <div class="tr-main">
    <div class="cn-panel tr-waterfall">
      <div class="tr-row tr-row--head">
        <span><b>4 steps</b> <span class="cn-muted">46 ms in all</span></span>
        <span class="tr-axis cn-muted">
          <span>0</span>
          <span>23 ms</span>
          <span>46 ms</span>
        </span>
        <span></span>
      </div>
      {
        STEPS.map((step) => (
          <div class:list={['tr-row', { 'is-error': step.error, 'is-selected': step.error }]}>
            <span class="tr-name" style={`--tr-depth: ${step.depth}`}>
              <i class:list={['cn-dot', { 'cn-dot--red': step.error }]} />
              {step.name}
            </span>
            <span class="tr-track">
              <i style={`left: ${at(step.start)}; width: max(3px, ${at(step.ms)})`} />
            </span>
            <span class="tr-time">{duration(step.ms)}</span>
          </div>
        ))
      }
      <p class="tr-id cn-muted">
        Trace ID <span class="cn-mono">4f0c2a9e81d3b6e7c5a2f19d07b8e3c4</span>
      </p>
    </div>

    <div class="cn-panel tr-step">
      <p class="tr-step__title">GET /cart</p>
      <p class="cn-muted">Request: GET /cart</p>
      <p class="tr-step__label">This step failed with</p>
      <p class="tr-step__error">
        <span><b>TypeError:</b> Cannot read properties of undefined (reading 'total')</span>
        <span class="cn-mono">at orderTotals (src/orders/totals.ts:18:34)</span>
      </p>
      <dl class="tr-facts">
        {
          FACTS.map(([label, value]) => (
            <>
              <dt class="cn-muted">{label}</dt>
              <dd>{value}</dd>
            </>
          ))
        }
      </dl>
      <p class="tr-more cn-muted">Technical details</p>
    </div>
  </div>
</Window>

<style>
  .tr-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4em 0.9em;
    margin-top: 0.35em;
  }

  .tr-related {
    display: flex;
    gap: 1.25em;
    margin-left: auto;
  }

  .tr-failure {
    display: flex;
    align-items: baseline;
    gap: 0.75em;
    margin-top: 1.4em;
    padding: 0.95em 1.25em;
  }

  .tr-failure__where {
    color: var(--cn-red);
    font-weight: 600;
  }

  .tr-logs {
    margin-left: auto;
    align-self: center;
    white-space: nowrap;
  }

  .tr-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 19em);
    align-items: start;
    gap: 1em;
    margin-top: 1em;
  }

  .tr-row {
    display: grid;
    grid-template-columns: minmax(0, 18em) minmax(0, 1fr) 4.5em;
    align-items: center;
    gap: 1em;
    padding: 0.7em 1.25em;
    border-top: 1px solid var(--cn-line-soft);
  }

  .tr-row--head {
    border-top: 0;
    padding-block: 1em 0.75em;
  }

  .tr-row.is-selected {
    background: rgb(255 255 255 / 3%);
  }

  .tr-name {
    display: flex;
    align-items: center;
    gap: 0.6em;
    min-width: 0;
    padding-left: calc(var(--tr-depth) * 1em);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .is-error .tr-name {
    font-weight: 600;
  }

  .tr-axis {
    display: flex;
    justify-content: space-between;
    font-size: 0.92em;
  }

  .tr-track {
    position: relative;
    height: 0.9em;
  }

  .tr-track i {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--cn-teal);
  }

  .is-error .tr-track i {
    background: var(--cn-red);
  }

  .tr-time {
    color: var(--cn-soft);
    text-align: right;
    white-space: nowrap;
  }

  .tr-id {
    padding: 0.9em 1.25em 1.1em;
    border-top: 1px solid var(--cn-line-soft);
    font-size: 0.92em;
  }

  .tr-id .cn-mono {
    margin-left: 0.5em;
    color: var(--cn-soft);
  }

  .tr-step {
    display: grid;
    gap: 0.35em;
    padding: 1.1em 1.25em 1.25em;
  }

  .tr-step__title {
    color: var(--cn-red);
    font-size: 1.08em;
    font-weight: 600;
  }

  .tr-step__label {
    margin-top: 0.6em !important;
    color: var(--cn-muted);
    font-size: 0.92em;
  }

  .tr-step__error {
    display: grid;
    gap: 0.3em;
    padding: 0.7em 0.8em;
    border-left: 2px solid var(--cn-red);
    background: rgb(235 97 97 / 8%);
  }

  .tr-step__error .cn-mono {
    color: var(--cn-muted);
  }

  .tr-facts {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.45em 1em;
    margin-top: 0.7em !important;
  }

  .tr-facts dd {
    margin: 0;
  }

  .tr-more {
    margin-top: 0.5em !important;
  }

  @container (max-width: 860px) {
    .tr-main {
      grid-template-columns: minmax(0, 1fr);
    }

    .tr-step {
      display: none;
    }
  }

  @container (max-width: 520px) {
    .tr-row {
      grid-template-columns: minmax(0, 1fr) 3.75em;
      grid-template-areas: 'name time' 'track track';
      gap: 0.4em 0.75em;
      padding-inline: 0.9em;
    }

    .tr-name {
      grid-area: name;
    }

    .tr-track {
      grid-area: track;
    }

    .tr-time {
      grid-area: time;
    }

    .tr-row--head .tr-axis,
    .tr-row--head > :last-child {
      display: none;
    }

    .tr-failure {
      padding-inline: 0.9em;
    }

    .tr-id {
      display: none;
    }
  }
</style>
