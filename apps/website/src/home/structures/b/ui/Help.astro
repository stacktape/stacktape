---
/*
 * Where help comes from: the Console's Help menu, re-created from apps/console/ui/src/components/Header/HelpMenu.tsx
 * (the call and the Slack channel are listed on plans that include them; channels are named support-*, from
 * RequestDedicatedChannelModal.tsx), and the shared Slack channel itself, drawn plainly rather than as Slack's own UI.
 *
 * The thread is an example. The answer is what the docs say (docs/resources/compute/worker-service.mdx:455-459 and
 * docs/managing-costs/optimization-tips.mdx:256): a fixed outbound IP needs `usePrivateSubnetsWithNAT` and
 * `stackConfig.nat`; `ha-ec2` runs one NAT instance per zone at about $7 a month each with no per-GB fee, against about
 * $32 a month per zone for a NAT Gateway, and outbound calls fail for about a minute when an instance dies.
 */
const MENU = [
  { label: 'Documentation', end: '↗' },
  { label: 'Keyboard shortcuts', end: '?' },
  { label: 'Email support', end: 'support@stacktape.com' },
  { label: 'Book a call with an engineer', end: '' },
  { label: 'Request a Slack channel', end: '' }
];

/** The menu hangs from its button and is torn along the bottom, with the logo label's teeth: 7.25 px apart, 3.4 px deep. */
const MENU_WIDTH = 320;
const teeth = Array.from({ length: Math.floor(MENU_WIDTH / 3.625) + 1 }, (_, k) => {
  const x = Math.min(k * 3.625, MENU_WIDTH);
  return `${MENU_WIDTH - x}px calc(100% - ${k % 2 ? 3.4 : 0}px)`;
});
const tornBottom = `polygon(0 0, 100% 0, ${teeth.join(', ')}, 0 calc(100% - 3.4px))`;
---

<div
  class="hlp"
  role="img"
  aria-label="The Help menu in the Stacktape Console, with documentation, email support, a call with an engineer and a Slack channel. Next to it, the shared channel support-acme-shop: an acme-shop developer asks how to get a fixed outbound IP for the worker without NAT Gateways, and a Stacktape engineer answers with the two settings and what they cost."
>
  <div class="hlp__menu-side">
    <div class="hlp__strip">
      <span class="hlp__trigger"
        ><svg viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="12" cy="12" r="9"></circle><path d="M9.6 9.4a2.5 2.5 0 1 1 3.4 2.3c-.6.3-1 .8-1 1.5v.3"></path><path
            d="M12 16.8v.2"></path></svg
        >Help</span
      >
      <span class="hlp__avatar">JN</span>
    </div>
    <ul class="hlp__menu" style={`clip-path: ${tornBottom}`}>
      {
        MENU.map((item) => (
          <li>
            <span>{item.label}</span>
            {item.end === '?' ? <kbd>?</kbd> : <span class="hlp__end">{item.end}</span>}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="hlp__channel">
    <div class="hlp__channel-head">
      <b># support-acme-shop</b>
      <span>Acme and Stacktape</span>
    </div>
    <div class="hlp__messages">
      <div class="hlp__msg">
        <span class="hlp__face">JN</span>
        <div>
          <p class="hlp__who"><b>Jana Novak</b> <span>Acme · 10:12</span></p>
          <p>
            Our payment provider wants a fixed IP to allowlist calls from the worker. Do we need a NAT Gateway for
            that? It’s $32 a month per zone.
          </p>
        </div>
      </div>
      <div class="hlp__msg">
        <span class="hlp__face hlp__face--team">S</span>
        <div>
          <p class="hlp__who"><b>Matúš</b> <span>Stacktape · 10:19</span></p>
          <p>
            No gateway needed. Set <code>usePrivateSubnetsWithNAT: true</code> on the worker and <code
              >stackConfig.nat: ha-ec2</code
            >. You get one small NAT instance per zone, about $7 a month each, with no per-GB fee.
          </p>
          <p>If an instance dies, outbound calls fail for about a minute. If payments can’t take that, use <code>gateway</code>.</p>
        </div>
      </div>
      <div class="hlp__msg">
        <span class="hlp__face">JN</span>
        <div>
          <p class="hlp__who"><b>Jana Novak</b> <span>Acme · 10:41</span></p>
          <p>Deployed to staging, the provider sees our IP. Thanks!</p>
        </div>
      </div>
    </div>
    <div class="hlp__compose">Message #support-acme-shop</div>
  </div>
</div>

<style>
  .hlp {
    container: hlp / inline-size;
    display: grid;
    grid-template-columns: 21rem minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: start;
    color: var(--stp-text-primary);
    font: 450 var(--stp-font-size-body) / 1.5 var(--brand-font-heading);
  }

  b {
    font-weight: 600;
  }

  code {
    padding: 0.05em 0.35em;
    border: 1px solid var(--stp-border-subtle);
    background: var(--brand-inset);
    font: 0.92em var(--brand-font-mono);
    white-space: nowrap;
  }

  /* The Console's top bar, cut down to the Help button and the avatar, with the menu open under it. */
  .hlp__strip {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--brand-border);
    background: var(--brand-inset);
  }

  .hlp__trigger {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hlp__trigger svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--stp-text-muted);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .hlp__avatar,
  .hlp__face {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--stp-surface-element);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .hlp__menu {
    width: 20rem;
    margin: 0.25rem 0 0 auto;
    padding: 0.35rem 0.35rem 1rem;
    list-style: none;
    border: 1px solid var(--stp-border-subtle);
    background: var(--stp-surface-element);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 9%);
    filter: drop-shadow(0 18px 30px rgb(0 0 0 / 45%));
  }

  .hlp__menu li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.7rem;
  }

  .hlp__menu li:nth-child(5) {
    background: rgb(255 255 255 / 5.5%);
  }

  .hlp__end {
    margin-left: auto;
    color: var(--stp-text-subtle);
    font-size: var(--stp-font-size-caption);
  }

  .hlp__menu kbd {
    margin-left: auto;
    padding: 0 0.4rem;
    border: 1px solid var(--stp-border-subtle);
    color: var(--stp-text-muted);
    font: inherit;
    font-size: var(--stp-font-size-caption);
  }

  .hlp__channel {
    border: 1px solid var(--brand-border);
    background: var(--brand-page);
    box-shadow: var(--brand-shadow);
  }

  .hlp__channel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--brand-border);
  }

  .hlp__channel-head b {
    font-size: 0.95rem;
  }

  .hlp__channel-head span {
    color: var(--stp-text-muted);
  }

  .hlp__messages {
    display: grid;
    gap: 1.1rem;
    padding: 1.2rem 1.25rem;
  }

  .hlp__msg {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  .hlp__msg p + p {
    margin-top: 0.4rem;
  }

  .hlp__face {
    width: 2.25rem;
    height: 2.25rem;
    font-size: 0.75rem;
  }

  .hlp__face--team {
    background: var(--brand-primary);
    color: var(--brand-on-teal);
    font: 700 1rem / 1 var(--brand-font-heading);
  }

  .hlp__who span {
    margin-left: 0.4rem;
    color: var(--stp-text-subtle);
    font-size: var(--stp-font-size-caption);
  }

  .hlp__compose {
    margin: 0 1.25rem 1.25rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--stp-border-subtle);
    background: var(--stp-surface-input);
    color: var(--stp-text-subtle);
  }

  @container hlp (max-width: 46rem) {
    .hlp {
      grid-template-columns: minmax(0, 1fr);
    }

    .hlp__menu-side {
      max-width: 21rem;
    }

    .hlp__messages {
      padding-inline: 0.9rem;
    }

    code {
      white-space: normal;
    }
  }
</style>
