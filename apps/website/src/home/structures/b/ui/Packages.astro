---
import Chart from './bench/Chart.astro';
import { barsOf, runOf, slowest } from './bench/data';

/**
 * Packaging speed from the deploy benchmarks (`src/data/deploy-benchmarks.json`, comparison `packaging`, view
 * `empty-cache`): seconds to package 1, 5 and 25 Lambda functions with an empty build cache, median of 10 runs, on the
 * 22 October 2026 run. Every tool's bar, fastest first. The run date links to the run's results on GitHub.
 */
/**
 * SST has no packaging-only command, so its time includes `sst diff`; CDK's is its synth, without the zipping it does
 * during the deploy (the data file's notes). The labels say so at the bars.
 */
const LABELS = { sst: 'SST (diff)', cdk: 'AWS CDK (synth)' };
const large = barsOf('packaging', 'empty-cache', 'lambda-25', {}, LABELS);
const one = barsOf('packaging', 'empty-cache', 'lambda-1', {}, LABELS);
const five = barsOf('packaging', 'empty-cache', 'lambda-5', {}, LABELS);
const us = large.find((bar) => bar.us);
if (!us) throw new Error('The packaging benchmark has no Stacktape value');
const small = slowest(one, five);
const run = runOf(0);
---

<figure class="bn">
  <div class="bn-main">
    <div class="bn-stat">
      <p class="bn-stat__value">{us.seconds.toFixed(1)}<small>s</small></p>
      <p class="bn-stat__what">to package 25 Lambda functions from an empty build cache</p>
      <a class="brand-link bn-stat__run" href={run.link}>Median of 10 runs, {run.label}</a>
    </div>
    <Chart size="large" bars={large} scale={30} ticks={[0, 10, 20, 30]} phoneTicks={[0, 15, 30]} />
  </div>
  <div class="bn-more">
    <Chart title="1 function" detail="Empty build cache" bars={one} scale={small} />
    <Chart title="5 functions" detail="Empty build cache" bars={five} scale={small} />
  </div>
</figure>
