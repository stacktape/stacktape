---
import Chart from './bench/Chart.astro';
import { barsOf, runLabel, slowest } from './bench/data';

/**
 * Packaging speed from the deploy benchmarks (`src/data/deploy-benchmarks.json`, comparison `packaging`, view
 * `empty-cache`): seconds to package 1, 5 and 25 Lambda functions with an empty build cache, median of 10 runs, on the
 * 22 October 2026 run. Every tool's bar, fastest first. The notes are the data file's own.
 */
const large = barsOf('packaging', 'empty-cache', 'lambda-25');
const one = barsOf('packaging', 'empty-cache', 'lambda-1');
const five = barsOf('packaging', 'empty-cache', 'lambda-5');
const us = large.find((bar) => bar.us);
const next = large.find((bar) => !bar.us);
if (!us || !next) throw new Error('The packaging benchmark has no Stacktape or rival value');
const small = slowest(one, five);
---

<figure class="bn">
  <div class="bn-main">
    <div class="bn-stat">
      <p class="bn-stat__value">{us.seconds.toFixed(1)}<small>s</small></p>
      <p class="bn-stat__what">to package 25 Lambda functions from an empty build cache</p>
      <p class="bn-stat__against">{next.label}, the next fastest: {next.seconds.toFixed(1)} s</p>
    </div>
    <Chart
      size="large"
      title="Package 25 Lambda functions"
      detail="Empty build cache. Median of 10 runs; lower is better."
      bars={large}
      scale={30}
      ticks={[0, 10, 20, 30]}
    />
  </div>
  <div class="bn-more">
    <Chart title="1 function" detail="Empty build cache" bars={one} scale={small} />
    <Chart title="5 functions" detail="Empty build cache" bars={five} scale={small} />
  </div>
  <figcaption class="bn-foot">
    <span><b>Preliminary run, {runLabel(0)},</b> on a dedicated EC2 c7i.2xlarge (8 vCPUs, 16 GB) in eu-west-1.</span>
    <span>
      After a source change, packaging takes about the same time with every tool. SST's time includes <code>sst diff</code>,
      because SST has no packaging-only command; CDK's excludes zipping, which CDK does during the deploy.
    </span>
  </figcaption>
</figure>
