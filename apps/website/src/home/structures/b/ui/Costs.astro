---
import { ResourceIcon } from '@stacktape/ui-react/resource-icon';
import Window from './console/Window.astro';

/*
 * The Console's stage page, Costs tab (apps/console/ui/src/pages/ProjectsPage/StageDetails/Costs.tsx), in the Console
 * shell the other steps use (ui/console/Window.astro), then the budget's own page (BudgetsPage/BudgetDetailPage.tsx)
 * as a second screen, for the example app acme-shop. Stages, repository and account are the hero's.
 *
 * The figures are the hero's (heroes/h5/console/data.ts COSTS): $286.40 for 1–25 November, $331.95 for October, and the
 * Console's pace as the hero shows it (about 24.5 days of data, times 30): $350.69, 6% more. Shares are rounded, as the Console rounds
 * them. Row icons are the Console's ResourceIcon, rendered on the server.
 *
 * The budget watches the whole acme-production account (docs/managing-costs/budgets.mdx:10, the docs' example name),
 * which runs this stage plus a little account-wide spend: $320 limit, alerts at 80% and on a forecast; spend passed
 * $256 on 22 November and AWS forecast $352.80 a day ago.
 */

const STAGE_TABS = ['production', 'staging', 'pr-218', 'dev-maya'];

/** `resource` is the Stacktape resource type the Console's ResourceIcon draws; null for costs outside resources. */
const ROWS: { name: string; type: string; resource: string | null; share: number; october: string; november: string }[] = [
  { name: 'api', type: 'Web service', resource: 'web-service', share: 32, october: '$108.40', november: '$92.10' },
  { name: 'database', type: 'SQL database', resource: 'relational-database', share: 25, october: '$85.20', november: '$71.40' },
  { name: 'Not tied to one resource', type: 'Other AWS costs', resource: null, share: 17, october: '$50.55', november: '$47.30' },
  { name: 'worker', type: 'Worker service', resource: 'worker-service', share: 13, october: '$44.10', november: '$38.60' },
  { name: 'cache', type: 'Redis', resource: 'redis', share: 9, october: '$29.75', november: '$24.80' },
  { name: 'web', type: 'Website', resource: 'hosting-bucket', share: 4, october: '$12.90', november: '$11.30' },
  { name: 'jobQueue', type: 'SQS queue', resource: 'sqs-queue', share: 0, october: '$1.05', november: '$0.90' }
];

const ALERTS = [
  { when: '1d ago', event: 'Forecast over', spend: '$352.80 of $320.00' },
  { when: '3d ago', event: 'Reached 80%', spend: '$257.40 of $320.00' }
];
---

<div
  class="cst"
  role="img"
  aria-label="The Costs tab of acme-shop’s production stage in the Stacktape Console: $286.40 so far in November, $350.69 by the end of the month at this pace, split by resource with the API service at 32%. Below it, the budget page of the production AWS account: AWS forecasts $352.80 of the $320.00 limit, and the alerts it sent at 80% and on the forecast."
>
  <Window label="The Costs tab of acme-shop’s production stage in the Stacktape Console" page="acme-shop" pageMenu current="projects" openErrors={5}>
    <div class="cst__page">
      <div class="cst__project">
        <h3 class="cn-h1">acme-shop</h3>
        <span class="cst__repo cn-wide">
          <span class="cn-link">acme/acme-shop</span>
          <span class="cn-link cn-muted">Deploys on push to main · previews for pull requests</span>
        </span>
      </div>
      <div class="cst__stages">
        <span class="cn-segments">
          {
            STAGE_TABS.map((stage, at) => (
              <span class:list={{ 'cn-wide': stage === 'dev-maya' }} aria-selected={at === 0 ? 'true' : 'false'}>
                <i class="cn-dot" />
                {stage}
              </span>
            ))
          }
        </span>
        <span class="cn-button cn-wide">+ New stage</span>
        <span class="cst__account cn-faint cn-wide">acme-production · us-east-1</span>
      </div>
      <div class="cn-tabs cst__tabs">
        <span>Overview</span>
        <span>Activity</span>
        <span aria-selected="true">Costs</span>
        <span class="cn-wide">Configuration</span>
        <span class="cn-wide">Diagram</span>
        <span class="cn-wide">Danger zone</span>
        <span class="cn-tabs__end cn-wide">
          <span class="cn-muted cst__running">Running a41c9e2 on main · <span class="cn-link">View deploy</span></span>
          <span class="cn-button cn-button--primary">Deploy stage</span>
        </span>
      </div>

      <div class="cn-panel cst__panel">
        <div class="cst__total">
          <span>
            <span class="cst__dim">November 2026 so far</span>
            <strong>$286.40</strong>
            <span class="cst__dim"
              >$350.69 by Nov 30 at this pace, 6% more than October ($331.95) · Report updated 1h ago</span
            >
          </span>
          <span class="cst__month"><span class="cst__dim">Month</span> November 2026</span>
        </div>
        <div class="cst__grid">
          <span class="cst__th">Resource</span>
          <span class="cst__th cst__type">Type</span>
          <span class="cst__th cst__num">Share</span>
          <span class="cst__th cst__num cst__oct">All of October</span>
          <span class="cst__th cst__num">↓ November so far</span>
          {
            ROWS.map((row) => (
              <>
                <span class:list={['cst__name', !row.resource && 'cst__dim']}>
                  <span class="cst__icon">{row.resource && <ResourceIcon resourceType={row.resource} size={20} />}</span>
                  {row.name}
                </span>
                <span class="cst__type cst__dim">{row.type}</span>
                <span class="cst__num cst__share">
                  <span class="cst__meter">
                    <span style={`width: ${row.share}%`} />
                  </span>
                  <span class="cst__pct">{row.share}%</span>
                </span>
                <span class="cst__num cst__oct cst__dim">{row.october}</span>
                <span class="cst__num">
                  <b>{row.november}</b>
                </span>
              </>
            ))
          }
        </div>
      </div>
    </div>
  </Window>

  <div class="cst__budget">
    <p class="cst__dim">Budgets</p>
    <p class="cst__budget-title"><b>Production account</b> <span class="cst__dim">Budget · Whole AWS account</span></p>
    <div class="cst__alert">
      <i></i>
      <span>
        <b class="cst__warn">Forecast over by $32.80</b>
        <span class="cst__dim">AWS forecasts $352.80 of $320.00, AWS alert 1d ago</span>
        <span class="cst__full"></span>
      </span>
      <span class="cst__drives">See what drives it</span>
    </div>
    <div class="cst__sent">
      <b>Alerts sent</b>
      {
        ALERTS.map((alert) => (
          <span class="cst__sent-row">
            <span class="cst__dim">{alert.when}</span>
            <span class="cst__warn">
              <i />
              {alert.event}
            </span>
            <span>{alert.spend}</span>
            <span class="cst__ok">
              <i />
              Sent
            </span>
          </span>
        ))
      }
    </div>
    <p class="cst__fact">
      <span><span class="cst__dim">AWS account</span> acme-production</span>
      <span><span class="cst__dim">Over the limit</span> It alerts; nothing stops</span>
    </p>
  </div>
</div>

<style>
  .cst {
    --cst-warn: #ed8b00;
    --cst-hair: var(--stp-border-subtle);
    --cst-raised: linear-gradient(var(--stp-surface-element), color-mix(in srgb, var(--stp-surface-element) 88%, #000));
    container: cst / inline-size;
    color: var(--stp-text-primary);
    font: 450 var(--stp-font-size-body) / 1.45 var(--brand-font-heading);
  }


  .cst :is(b, strong) {
    font-weight: 600;
  }

  .cst u {
    text-decoration: underline dotted rgb(255 255 255 / 50%);
    text-underline-offset: 0.22em;
  }

  .cst__dim {
    color: var(--stp-text-muted);
  }








  /* The page inside the Console shell; the table drops columns by its width, which the sidebar narrows. */
  .cst__page {
    container: cstp / inline-size;
  }

  .cst__project {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }



  .cst__repo {
    display: flex;
    gap: 1.25em;
  }

  .cst__account {
    margin-left: auto;
  }

  .cst__tabs {
    margin: 1em 0 1.4em;
  }

  .cst__stages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }




  /* The chosen stage is the filled piece of the tape strip, torn on the side where the next piece starts. */










  .cst__total {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
  }

  .cst__total > span:first-child {
    display: grid;
    gap: 0.1rem;
  }

  .cst__total strong {
    font: 700 1.5rem / 1.25 var(--brand-font-heading);
  }

  .cst__month {
    padding: 0.55rem 1rem;
    border: 1px solid var(--cst-hair);
    background: var(--stp-surface-input);
    white-space: nowrap;
  }

  .cst__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) 11rem 8rem 9rem;
  }

  .cst__grid > * {
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 2.9rem;
    padding-inline: 1rem;
    border-top: 1px solid var(--cst-hair);
  }

  .cst__grid .cst__th {
    min-height: 2.2rem;
    background: color-mix(in srgb, var(--stp-surface-element) 92%, #000);
    color: var(--stp-text-muted);
    font-size: var(--stp-font-size-caption);
    font-weight: 500;
  }

  .cst__num {
    justify-content: flex-end;
    font-variant-numeric: tabular-nums;
  }

  .cst__name {
    gap: 0.6rem;
    font-weight: 600;
  }

  .cst__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
  }

  .cst__share {
    gap: 1.1rem;
  }

  .cst__pct {
    min-width: 2.4em;
    text-align: right;
  }

  .cst__meter {
    position: relative;
    width: 5.5rem;
    height: 4px;
    background: rgb(255 255 255 / 8%);
  }

  .cst__meter span {
    position: absolute;
    inset: 0 auto 0 0;
    min-width: 4px;
    background: var(--brand-teal);
  }

  /* The budget's own page, a second screen in front of the Costs tab's lower edge. */
  .cst__budget {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.5rem;
    width: min(37rem, 100%);
    margin: -2rem 1.25rem 0 auto;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--brand-border);
    background: var(--brand-page);
    box-shadow: 0 22px 52px rgb(0 0 0 / 50%);
  }

  .cst__budget-title b {
    margin-right: 0.5rem;
    font: 600 1.15rem / 1.3 var(--brand-font-heading);
  }

  .cst__alert {
    display: grid;
    grid-template-columns: 0.5rem minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.75rem;
    margin-top: 0.4rem;
    padding: 0.8rem 1rem;
    background: var(--cst-raised);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 9%);
  }

  .cst__alert > i,
  .cst__sent i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--cst-warn);
  }

  .cst__alert > i {
    margin-top: 0.4rem;
  }

  .cst__alert > span:nth-child(2) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.5rem;
  }

  .cst__warn {
    color: var(--cst-warn);
  }

  .cst__full {
    width: min(100%, 22rem);
    height: 4px;
    margin-top: 0.35rem;
    background: var(--cst-warn);
  }

  .cst__drives {
    align-self: center;
    font-weight: 500;
    white-space: nowrap;
  }

  .cst__sent {
    display: grid;
    padding: 0.7rem 1rem 0.3rem;
    background: var(--cst-raised);
  }

  .cst__sent > b {
    margin-bottom: 0.3rem;
  }

  .cst__sent-row {
    display: grid;
    grid-template-columns: 4rem 8.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.45rem;
    border-top: 1px solid var(--cst-hair);
  }

  .cst__sent-row > span:nth-child(2),
  .cst__ok {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
  }

  .cst__ok {
    font-weight: 450;
  }

  .cst__ok i {
    background: var(--stp-status-success);
  }

  .cst__fact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
  }

  .cst__fact .cst__dim {
    margin-right: 0.5rem;
  }

  /* The live release fits beside the tabs only on a wide page; Deploy stage stays. */
  @container cstp (max-width: 56rem) {
    .cst__running {
      display: none;
    }
  }

  @container cstp (max-width: 44rem) {
    .cst__grid > .cst__oct {
      display: none;
    }

    .cst__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) 9.5rem 8.5rem;
    }
  }

  /* A phone: resource, share and this month's spend. */
  @container cstp (max-width: 30rem) {
    .cst__month,
    .cst__grid > .cst__type,
    .cst__meter {
      display: none;
    }

    .cst__grid {
      grid-template-columns: minmax(0, 1fr) 3.5rem 5.5rem;
    }

    .cst__grid > * {
      padding-inline: 0.7rem;
    }
  }

  /* On a phone the budget follows the table instead of covering its edge. */
  @container cst (max-width: 34rem) {
    .cst__drives,
    .cst__sent-row > span:nth-child(3) {
      display: none;
    }

    .cst__budget {
      width: auto;
      margin: 1rem 0 0;
      box-shadow: var(--brand-shadow);
    }

    .cst__sent-row {
      grid-template-columns: 3.2rem minmax(0, 1fr) auto;
    }
  }
</style>
