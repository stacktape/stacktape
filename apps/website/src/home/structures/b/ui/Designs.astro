---
import '@stacktape/ui-react/isometric-diagram.css';
import { ResourceIcon } from '@stacktape/ui-react/resource-icon';
import { getResourceVisual } from '@stacktape/ui-react/resource-icon/catalog';
import diagram from './designs/diagram.svg?raw';

/**
 * What `stacktape init` proposes for acme-shop, simplified from the wizard's Review (apps/init-ui/src/steps/
 * ReviewStep.tsx on ui/init-wizard-redesign): the diagram of what gets created, the monthly estimate, and each resource
 * with the line of code it is there for and its price. The owner asked for a simpler picture than the real screen (25
 * Nov), so the wizard's header, stepper, editor, traffic examples and bottom bar are left out.
 *
 * The row icons are the real ResourceIcon, rendered on the server. `designs/diagram.svg` is the real IsometricDiagram
 * from @stacktape/ui-react, rendered once with `renderToStaticMarkup` under Bun for this config, cropped to its content
 * with its labels 1.3× larger (as the wizard's minLabelSize does in a small frame), so the page ships no script for it:
 *
 *   web: hosting-bucket (single-page app) · api: web-service, js-bundle, 1 vCPU, 2 GB, 2–4 instances, connectTo
 *   database, cache, jobQueue · worker: worker-service, js-bundle, 0.5 vCPU, 1 GB, 2 instances, connectTo jobQueue,
 *   database, cache · jobQueue: sqs-queue · database: relational-database, postgres 16, db.t4g.medium, 50 GB,
 *   accessibilityMode vpc · cache: redis, valkey, cache.t4g.small
 *
 * It is the config acme-shop runs in the hero's Console (heroes/h5/console/data.ts). The estimate is its fixed monthly
 * price at AWS list prices in us-east-1, as the wizard's estimator computes it: Postgres db.t4g.medium with 50 GB gp3
 * ($47.45 + $5.75), two Fargate tasks of 1 vCPU / 2 GB ($72.08) and two of 0.5 vCPU / 1 GB ($36.04), a cache.t4g.small
 * Valkey node ($18.69): $180 a month. Every resource's October bill in the hero (heroes/h5/console/data.ts COSTS) is its
 * estimate here plus what it used; the hero's $331.95 also holds $50.55 not tied to a resource.
 *
 * A phone shows the estimate and three resources, without the diagram.
 */
const ROWS = [
  {
    type: 'web-service',
    title: 'API service',
    price: '$72',
    usage: true,
    why: 'Fastify server',
    where: 'api/src/server.ts:9',
    phone: true
  },
  {
    type: 'relational-database',
    title: 'Postgres database',
    price: '$53',
    why: 'Postgres driver',
    where: 'api/package.json:21',
    phone: true
  },
  { type: 'worker-service', title: 'Worker service', price: '$36', why: 'Queue consumer', where: 'worker/src/index.ts:6' },
  { type: 'redis', title: 'Redis cache', price: '$19', why: 'Redis client', where: 'api/package.json:24' },
  { type: 'hosting-bucket', title: 'Website', why: 'Vite app', where: 'web/package.json:7', phone: true },
  { type: 'sqs-queue', title: 'SQS queue', why: 'SQS client', where: 'api/package.json:12' }
];
/** A resource's colour: its AWS category's, the same the diagram paints it in. */
const tone = (type: string) => `var(--stp-aws-category-${getResourceVisual(type)?.category ?? 'compute'})`;
---

<div
  class="wz"
  role="img"
  aria-label="What stacktape init proposes for acme-shop: a diagram of the website, the API service, the worker service, the SQS queue, Postgres and Redis; an estimate of $180 a month plus usage; and each resource with the line of code it is there for and its price."
>
  <div class="wz-in" aria-hidden="true">
    <div class="wz-diagram">
      <div class="stp-diagram" set:html={diagram} />
    </div>

    <div class="wz-side">
      <div class="wz-total">
        <p class="wz-eyebrow">Estimated monthly cost</p>
        <p class="wz-figure"><b>$180</b> /month <span class="wz-usage">+ usage</span></p>
        <p class="wz-faint">AWS list prices in us-east-1</p>
      </div>
      <ul class="wz-rows">
        {
          ROWS.map((row) => (
            <li class:list={['wz-row', { 'wz-row--more': !row.phone }]}>
              <span class="wz-tile" style={`--wz-tone: ${tone(row.type)}`}>
                <ResourceIcon resourceType={row.type} size={18} />
              </span>
              <span class="wz-row__name">
                <strong>{row.title}</strong>
                <small>
                  {row.why} <span>in {row.where}</span>
                </small>
              </span>
              {row.price ? (
                <span class="wz-price">
                  <span>
                    <b>{row.price}</b>/mo
                  </span>
                  {row.usage ? <small>+ usage</small> : null}
                </span>
              ) : (
                <span class="wz-price wz-price--muted">Pay per use</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  .wz {
    --wz-line: rgb(255 255 255 / 8%);
    --wz-strong: rgb(255 255 255 / 95%);
    --wz-muted: rgb(180 186 186);
    --wz-faint: rgb(124 132 132);

    container-type: inline-size;
    border: 1px solid var(--brand-border);
    background: var(--brand-inset);
    color: var(--brand-text);
    font: 500 0.875rem / 1.45 var(--brand-font-heading);
    font-variant-numeric: tabular-nums;
  }

  .wz :is(p, ul) {
    margin: 0;
    padding: 0;
  }

  .wz-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 27rem);
  }

  /* The diagram fills its half; its toolbar (search, zoom) is for the Console, where a stage has many resources. */
  .wz-diagram {
    position: relative;
    align-self: center;
    aspect-ratio: 946 / 485;
    margin: clamp(0.5rem, 0.25rem + 1vw, 1.25rem);
  }

  /* The picture sits on the panel itself, without the Console's own canvas colour behind it. */
  .wz-diagram > :global(:first-child) {
    position: absolute;
    inset: 0;
    background: none;
  }

  .wz-side {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    padding: clamp(1.25rem, 0.75rem + 1.5vw, 2rem);
    border-left: 1px solid var(--brand-border);
  }

  .wz-eyebrow {
    color: var(--wz-faint);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .wz-figure {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-top: 0.35rem !important;
    color: var(--wz-muted);
  }

  .wz-figure b {
    color: var(--wz-strong);
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .wz-usage {
    margin-left: 0.35rem;
    padding: 0.1rem 0.5rem;
    background: rgb(255 255 255 / 7%);
    font-size: 0.75rem;
  }

  .wz-faint {
    color: var(--wz-faint);
    font-size: 0.75rem;
  }

  .wz-rows {
    display: grid;
    list-style: none;
  }

  /* A row: the resource's icon, its name and the code line it is there for, and its price. */
  .wz-row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--wz-line);
  }

  .wz-tile {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--wz-tone), transparent 60%);
    background: color-mix(in srgb, var(--wz-tone), transparent 86%);
    color: var(--wz-tone);
  }

  .wz-row__name {
    display: grid;
    min-width: 0;
  }

  .wz-row__name strong {
    color: var(--wz-strong);
    font-weight: 600;
  }

  .wz-row__name small {
    color: var(--wz-muted);
    font-size: 0.8rem;
  }

  .wz-row__name small span {
    color: var(--wz-faint);
  }

  .wz-price {
    display: grid;
    justify-items: end;
    color: var(--wz-muted);
    white-space: nowrap;
  }

  .wz-price b {
    display: inline;
    color: var(--wz-strong);
    font-size: 1rem;
    font-weight: 600;
  }

  .wz-price small {
    font-size: 0.75rem;
  }

  .wz-price--muted {
    font-size: 0.8rem;
  }

  /* Narrower: the diagram above, the costs under it. A phone shows the costs and three resources only. */
  @container (max-width: 760px) {
    .wz-in {
      grid-template-columns: minmax(0, 1fr);
    }

    .wz-side {
      border-top: 1px solid var(--brand-border);
      border-left: 0;
    }
  }

  @container (max-width: 520px) {
    .wz-diagram,
    .wz-row--more {
      display: none;
    }

    .wz-side {
      border-top: 0;
    }
  }
</style>
