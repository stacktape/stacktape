---
/*
 * The Console's incident page, Overview tab, for the example app acme-shop, re-created in HTML from
 * apps/console/ui/src/pages/IncidentsPage/IncidentDetailPage.tsx (header, status rows, IncidentUnfolding, "Where it
 * fails" and the "About this incident" facts), in the tape look with square corners.
 *
 * The story is one release: v000042 ("Read tax rates from Redis") was deployed at 14:31. From 14:36 checkout throws a
 * TypeError because the Redis cache is empty after the deploy; the API error-rate alarm fires at 14:37, when the
 * incident opens, and the checkout synthetic test fails from 14:40. It is 14:55: open for 18 minutes, deployed 6
 * minutes before it opened. Fix with AI has opened draft pull request #212, which is not merged or deployed.
 */
const START = 14 * 60 + 25;
const NOW = 14 * 60 + 55;
const at = (minute: number) => `${(((minute - START) / (NOW - START)) * 100).toFixed(2)}%`;

const LANES = [
  { label: 'TypeError: Cannot read properties of undefined (reading ‘currency’)', from: 14 * 60 + 36 },
  { label: 'API error rate above 5%', from: 14 * 60 + 37 },
  { label: 'Synthetic test “checkout-flow”', from: 14 * 60 + 40 }
];
const TICKS = [
  { label: '14:25', minute: START },
  { label: '14:35', minute: 14 * 60 + 35 },
  { label: '14:45', minute: 14 * 60 + 45 },
  { label: 'now', minute: NOW }
];
/** Where the deploy line sits on the tracks, as a share of their width. */
const DEPLOY_SHARE = (14 * 60 + 31 - START) / (NOW - START);

const FRAMES = [
  ['calculateTotals', '/app/src/pricing/totals.ts', '42:31'],
  ['buildOrderSummary', '/app/src/orders/summary.ts', '118:22'],
  ['createCheckoutSession', '/app/src/routes/checkout.ts', '67:18']
];
---

<div
  class="inc"
  role="img"
  aria-label="An incident in the Stacktape Console: API error rate above 5% on acme-shop / production, critical, 3 of 3 signals failing. The likely cause is release v000042, deployed 6 minutes before the incident opened, which reads tax rates from an empty Redis cache. A draft fix is ready as pull request #212."
>
  <div class="inc__top">
    <span class="inc__logo">stack<span>tape</span></span>
    <span class="inc__path">Acme <span>/</span> <b>Incidents</b></span>
  </div>

  <div class="inc__page">
    <p class="inc__crumb">Incidents</p>
    <div class="inc__head">
      <h3>API error rate above 5%</h3>
      <p class="inc__meta"><b>Critical</b> · acme-shop / production</p>
      <span class="inc__actions">
        <span class="inc__btn inc__btn--primary">Acknowledge</span>
        <span class="inc__btn">Resolve</span>
        <span class="inc__btn inc__btn--more"
          ><svg viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="6" cy="12" r="1.6"></circle><circle cx="12" cy="12" r="1.6"></circle><circle cx="18" cy="12" r="1.6"
            ></circle></svg
          ></span
        >
      </span>
    </div>

    <div class="inc__tabs">
      <span class="is-on">Overview</span><span>Signals</span><span>AI assessment</span><span>Timeline</span>
      <span class="inc__related"><span>Related</span> Logs <span>·</span> Metrics <span>·</span> Errors</span>
    </div>

    <div class="inc__grid">
      <div class="inc__main">
        <div class="inc__card">
          <div class="inc__status">
            <i class="is-red"></i>
            <p><b class="inc__red">Still failing</b> for 18m · 3 of 3 signals failing · last failure 1m ago</p>
            <span class="inc__aside-text">Not acknowledged</span>
          </div>
          <div class="inc__status">
            <i class="is-amber"></i>
            <p>
              <b>Likely cause</b> Checkout requests fail with a TypeError in <code>calculateTotals</code>. Release v000042
              reads tax rates from Redis, and the cache was empty after the deploy.
            </p>
            <span class="inc__link-button">View assessment</span>
          </div>
          <div class="inc__status">
            <i class="is-teal"></i>
            <p>
              <b>Draft fix ready</b> Load the rates from Postgres when the cache is empty, and fill the cache again,
              in{' '}<u>pull request #212</u>.
            </p>
            <span class="inc__link-button">View fix</span>
          </div>
        </div>

        <div class="inc__card inc__unfold">
          <div class="inc__lanes" style={`--inc-deploy-share: ${DEPLOY_SHARE}`}>
            <span class="inc__mark">Deploy succeeded 14:31</span>
            {
              LANES.map((lane) => (
                <div class="inc__lane">
                  <span class="inc__lane-label">{lane.label}</span>
                  <span class="inc__track">
                    <span class="inc__bar" style={`left: ${at(lane.from)}`} />
                  </span>
                </div>
              ))
            }
            <div class="inc__axis">
              <span></span>
              <span class="inc__ticks">
                {TICKS.map((tick) => <span style={`left: ${at(tick.minute)}`}>{tick.label}</span>)}
              </span>
            </div>
          </div>
        </div>

        <div class="inc__card inc__fails">
          <div class="inc__fails-head">
            <b>Where it fails</b>
            <span><u>Logs of the last failed request</u> <u>Open the error</u></span>
          </div>
          <p class="inc__error">
            <b>TypeError: Cannot read properties of undefined (reading ‘currency’)</b>
            <span>Uncaught exception in api · 214 occurrences so far</span>
          </p>
          <div class="inc__stack">
            {
              FRAMES.map(([fn, file, line], index) => (
                <code class:list={[index === 0 && 'is-top']}>
                  at <em>{fn}</em> ({file}:<strong>{line}</strong>)
                </code>
              ))
            }
          </div>
        </div>
      </div>

      <dl class="inc__card inc__about">
        <div class="inc__about-head">About this incident</div>
        <div>
          <dt>Stage</dt>
          <dd><u>acme-shop</u> / <u>production</u><span>eu-central-1</span></dd>
        </div>
        <div>
          <dt>Running</dt>
          <dd><u>v000042</u><span>Deployed 6 minutes before it opened</span></dd>
        </div>
        <div>
          <dt>Commit</dt>
          <dd><code>4c1e9a27b</code><span>Read tax rates from Redis</span></dd>
        </div>
        <div>
          <dt>Changes</dt>
          <dd><u>Since v000041</u></dd>
        </div>
      </dl>
    </div>
  </div>
</div>

<style>
  .inc {
    --inc-amber: #ed8b00;
    --inc-line: var(--stp-border-subtle);
    container: inc / inline-size;
    overflow: hidden;
    border: 1px solid var(--brand-border);
    background: var(--brand-inset);
    box-shadow: var(--brand-shadow);
    color: var(--stp-text-primary);
    font: 450 var(--stp-font-size-body) / 1.45 var(--brand-font-heading);
  }

  b,
  strong {
    font-weight: 600;
  }

  u {
    text-decoration: underline dotted rgb(255 255 255 / 50%);
    text-underline-offset: 0.22em;
  }

  code {
    font-family: var(--brand-font-mono);
  }

  .inc__top {
    display: flex;
    gap: 2.5rem;
    align-items: center;
    padding: 0.7rem 1rem;
  }

  .inc__logo {
    display: inline-flex;
    gap: 0.13em;
    align-items: center;
    letter-spacing: -0.03em;
    font: 700 1.05rem / 1 var(--brand-font-heading);
  }

  .inc__logo > span {
    padding: 0.17em 0.36em 0.21em;
    color: var(--brand-on-teal);
    background: var(--brand-primary);
    clip-path: var(--brand-tape-clip);
  }

  .inc__path {
    font-weight: 600;
  }

  .inc__path span {
    margin-inline: 0.7rem;
    color: var(--stp-text-subtle);
  }

  .inc__page {
    padding: 1.1rem 2rem 2rem;
    background: var(--brand-page);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 7.5%);
  }

  .inc__crumb {
    color: var(--stp-text-muted);
  }

  .inc__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    margin-top: 0.35rem;
  }

  .inc__head h3 {
    color: var(--stp-text-strong);
    letter-spacing: -0.02em;
    font: 600 1.5rem / 1.25 var(--brand-font-heading);
  }

  .inc__meta {
    color: var(--stp-text-muted);
  }

  .inc__meta b,
  .inc__red {
    color: var(--stp-status-error);
  }

  .inc__actions {
    display: flex;
    gap: 0.5rem;
    align-self: center;
    margin-left: auto;
  }

  .inc__btn {
    padding: 0.55rem 1rem;
    background: var(--brand-control);
    box-shadow: var(--brand-edge);
    font-weight: 500;
  }

  .inc__btn--primary {
    color: var(--brand-on-teal);
    background: var(--brand-primary);
    box-shadow: var(--brand-edge-primary);
  }

  .inc__btn--more {
    display: flex;
    align-items: center;
    padding-inline: 0.7rem;
  }

  .inc__btn--more svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentcolor;
  }

  .inc__tabs {
    display: flex;
    gap: 1.6rem;
    align-items: center;
    margin: 1rem 0 1.1rem;
    border-bottom: 1px solid var(--inc-line);
    font-weight: 500;
  }

  .inc__tabs > span {
    position: relative;
    padding-block: 0.4rem 0.75rem;
  }

  /* The selected section tab is underlined with a short strip of teal tape, torn at both ends. */
  .inc__tabs > .is-on::after {
    position: absolute;
    right: 2px;
    bottom: -2px;
    left: 2px;
    height: 5px;
    content: '';
    background: var(--brand-primary);
    clip-path: polygon(2px 0, calc(100% - 2px) 0, 100% 50%, calc(100% - 2px) 100%, 2px 100%, 0 50%);
  }

  .inc__related {
    display: flex;
    gap: 0.6rem;
    margin-left: auto;
  }

  .inc__related span {
    color: var(--stp-text-muted);
    font-weight: 450;
  }

  .inc__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 1.25rem;
    align-items: start;
  }

  .inc__main {
    display: grid;
    gap: 1.1rem;
    min-width: 0;
  }

  .inc__card {
    margin: 0;
    background: linear-gradient(var(--stp-surface-element), color-mix(in srgb, var(--stp-surface-element) 88%, #000));
    box-shadow:
      0 2px 6px rgb(0 0 0 / 35%),
      inset 0 1px 0 rgb(255 255 255 / 9%);
  }

  .inc__status {
    display: grid;
    grid-template-columns: 0.5rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: start;
    padding: 0.75rem 1rem;
  }

  .inc__status + .inc__status {
    border-top: 1px solid var(--inc-line);
  }

  .inc__status i {
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.4rem;
    border-radius: 50%;
  }

  .inc__status i.is-red {
    background: var(--stp-status-error);
  }

  .inc__status i.is-amber {
    background: var(--inc-amber);
  }

  .inc__status i.is-teal {
    background: var(--stp-status-success);
  }

  .inc__status p {
    color: var(--stp-text-muted);
  }

  .inc__status p b {
    margin-right: 0.35rem;
  }

  .inc__status p b:not(.inc__red) {
    color: var(--stp-text-primary);
  }

  .inc__aside-text {
    color: var(--stp-text-muted);
  }

  .inc__link-button {
    align-self: center;
    font-weight: 500;
  }

  .inc__unfold {
    padding: 0.75rem 1rem;
  }

  .inc__lanes {
    position: relative;
    display: grid;
    gap: 0.55rem;
    padding-top: 1.6rem;
  }

  .inc__lane,
  .inc__axis {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
  }

  .inc__lane-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .inc__track {
    position: relative;
    height: 6px;
    background: rgb(255 255 255 / 8%);
  }

  .inc__bar {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    background: var(--stp-status-error);
  }

  /* The deploy line sits at its time on the tracks' scale, which starts after the labels' column. */
  .inc__mark {
    position: absolute;
    top: 0;
    bottom: 1.3rem;
    left: calc((100% - 1rem) * 0.8 / 1.8 + 1rem + (100% - 1rem) / 1.8 * var(--inc-deploy-share));
    padding-left: 0.45rem;
    border-left: 1px solid var(--stp-text-subtle);
    color: var(--stp-text-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .inc__ticks {
    position: relative;
    height: 1.2rem;
    color: var(--stp-text-subtle);
    font-size: var(--stp-font-size-caption);
  }

  .inc__ticks span {
    position: absolute;
    translate: -50% 0;
  }

  .inc__ticks span:first-child {
    translate: 0 0;
  }

  .inc__ticks span:last-child {
    translate: -100% 0;
  }

  .inc__fails {
    padding: 0.75rem 1rem 1rem;
  }

  .inc__fails-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
  }

  .inc__fails-head span {
    display: flex;
    gap: 1rem;
    color: var(--stp-text-muted);
    font-weight: 600;
  }

  .inc__error {
    display: grid;
    margin: 0.9rem 0 0.75rem;
  }

  .inc__error span {
    color: var(--stp-text-muted);
  }

  .inc__stack {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1.1rem;
    overflow-x: auto;
    border: 1px solid var(--inc-line);
    background: var(--brand-inset);
    color: var(--stp-text-muted);
    font-size: 0.8rem;
    white-space: pre;
  }

  .inc__stack em {
    font-style: normal;
  }

  .inc__stack .is-top {
    color: var(--stp-text-primary);
  }

  .inc__stack .is-top em {
    color: var(--brand-teal);
  }

  .inc__stack .is-top strong {
    color: var(--inc-amber);
  }

  .inc__about-head {
    padding: 0.75rem 1rem;
    font-weight: 600;
  }

  .inc__about > div:not(.inc__about-head) {
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--inc-line);
  }

  .inc__about dt {
    color: var(--stp-text-subtle);
    font-size: var(--stp-font-size-caption);
  }

  .inc__about dd {
    margin: 0;
  }

  .inc__about dd span {
    display: block;
    color: var(--stp-text-subtle);
  }

  @container inc (max-width: 62rem) {
    .inc__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .inc__about {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .inc__about-head {
      grid-column: 1 / -1;
    }

    .inc__related {
      display: none;
    }
  }

  /* A phone: the Console's narrow incident page, the facts and the stack trace below the fold are left out. */
  @container inc (max-width: 34rem) {
    .inc {
      font-size: 0.8rem;
    }

    .inc__top {
      justify-content: space-between;
    }

    .inc__page {
      padding: 0.9rem 0.9rem 1.1rem;
    }

    .inc__head h3 {
      font-size: 1.2rem;
    }

    .inc__actions {
      order: 3;
      margin: 0.5rem 0 0;
    }

    .inc__btn--more,
    .inc__tabs > span:nth-child(n + 3),
    .inc__fails,
    .inc__about {
      display: none;
    }

    .inc__status {
      grid-template-columns: 0.5rem minmax(0, 1fr);
    }

    .inc__status > span {
      grid-column: 2;
    }

    .inc__lane,
    .inc__axis {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    .inc__axis > span:first-child {
      display: none;
    }

    .inc__mark {
      display: none;
    }
  }
</style>
