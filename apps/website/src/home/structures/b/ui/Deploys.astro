---
import Chart from './bench/Chart.astro';
import { barsOf, runOf, slowest } from './bench/data';

/**
 * Deploy speed from the deploy benchmarks (`src/data/deploy-benchmarks.json`): seconds until the changed code answers.
 * The headline is a code change to 25 Lambda functions from the command line; under it, a container code change and a
 * Git push of a Node.js service. Every tool's bar, fastest first; the run dates link to the runs' results on GitHub.
 * The owner had the cases where another tool is faster (a Python Git push, a 5-function shared-code change) and the
 * footnote removed (25 Nov).
 *
 * Stacktape's container and Git push times use code swap, which is opt-in and covers code changes only, so the bar says
 * so. Heroku's container time and its Git push time are one measurement, a build from the pushed source (`heroku
 * builds:create`), so both bars say that.
 */
const SWAP = { stacktape: 'code swap enabled' };
const large = barsOf('lambda-deploy', 'handler', 'lambda-25');
const container = barsOf('container-deploy', 'code-change', 'container-node', {
  ...SWAP,
  heroku: 'the same build from source as under Git push'
});
const pushNode = barsOf('git-push', 'warm', 'container-node', {
  ...SWAP,
  heroku: 'build from the pushed source',
  render: 'build from the pushed source'
});
const us = large.find((bar) => bar.us);
if (!us) throw new Error('The Lambda deploy benchmark has no Stacktape value');
const small = slowest(container, pushNode);
const cli = runOf(0);
const push = runOf(1);
---

<figure class="bn">
  <div class="bn-main">
    <div class="bn-stat">
      <p class="bn-stat__value">{us.seconds.toFixed(1)}<small>s</small></p>
      <p class="bn-stat__what">to deploy updated handlers to 25 Lambda functions and get a response from the new code</p>
      <p class="bn-stat__how">Median of 10 runs; lower is better.</p>
      <p class="bn-stat__run">
        Preliminary runs, <a class="brand-link" href={cli.link}>{cli.label}</a> and, for Stacktape's Git push,{' '}
        <a class="brand-link" href={push.link}>{push.label}</a>
      </p>
    </div>
    <Chart size="large" bars={large} scale={80} ticks={[0, 20, 40, 60, 80]} />
  </div>
  <div class="bn-more">
    <Chart title="Containers" detail="A code change to a Node.js service" bars={container} scale={small} />
    <Chart title="Git push" detail="Node.js service, build machine already running" bars={pushNode} scale={small} />
  </div>
</figure>
