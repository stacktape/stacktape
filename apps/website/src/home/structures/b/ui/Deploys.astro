---
import Tape from '../../../../brand/Tape.astro';
import Chart from './bench/Chart.astro';
import { barsOf, runLabel, slowest } from './bench/data';

/**
 * Deploy speed from the deploy benchmarks (`src/data/deploy-benchmarks.json`): seconds until the changed code answers.
 * The headline is a code change to 25 Lambda functions from the command line. Then a container code change and a Git
 * push of a Node.js service, and the two cases where another tool is faster: a Git push of a Python service (Heroku)
 * and a shared-code change to 5 functions (CDK hotswap). Every tool's bar, fastest first; the notes are the data file's.
 *
 * Stacktape's container and Git push times use code swap, which is opt-in and covers code changes only. Without it the
 * data file's note gives its normal image deploy of the Node.js service as 40.1 s on 17 October, slower than Heroku's
 * 26.6 s; the footnote says so.
 */
const large = barsOf('lambda-deploy', 'handler', 'lambda-25');
const container = barsOf('container-deploy', 'code-change', 'container-node', { stacktape: 'Stacktape*' });
const pushNode = barsOf('git-push', 'warm', 'container-node', { stacktape: 'Stacktape*' });
const pushPython = barsOf('git-push', 'warm', 'container-python', { stacktape: 'Stacktape*' });
const shared = barsOf('lambda-deploy', 'shared', 'lambda-5');
const us = large.find((bar) => bar.us);
const next = large.find((bar) => !bar.us);
if (!us || !next) throw new Error('The Lambda deploy benchmark has no Stacktape or rival value');
const small = slowest(container, pushNode, pushPython, shared);
---

<figure class="bn">
  <div class="bn-main">
    <div class="bn-stat">
      <p class="bn-stat__value">{us.seconds.toFixed(1)}<small>s</small></p>
      <p class="bn-stat__what">until a code change to 25 Lambda functions answers requests</p>
      <p class="bn-stat__against">{next.label}, the next fastest: {next.seconds.toFixed(1)} s</p>
    </div>
    <Chart
      size="large"
      title="Deploy a code change to 25 Lambda functions"
      detail="From the command line until the new code answers. Median of 10 runs; lower is better."
      bars={large}
      scale={80}
      ticks={[0, 20, 40, 60, 80]}
    />
  </div>
  <div class="bn-more">
    <Chart title="Containers" detail="A code change to a Node.js service" bars={container} scale={small} />
    <Chart title="Git push" detail="Node.js service, build machine already running" bars={pushNode} scale={small} />
  </div>
  <div class="bn-more">
    <p class="bn-more__label"><Tape tone="gray">Where Stacktape is slower</Tape></p>
    <Chart title="Git push" detail="Python service, build machine already running" bars={pushPython} scale={small} />
    <Chart title="Shared code" detail="A change to code that 5 functions import" bars={shared} scale={small} />
  </div>
  <figcaption class="bn-foot">
    <span>
      <b>Preliminary runs, {runLabel(0)},</b> on a dedicated EC2 c7i.2xlarge in eu-west-1. Stacktape's Git pushes ran on
      its build runner on {runLabel(1)}, median of 5 to 6 runs; Heroku and Render built from the pushed source.
    </span>
    <span>
      * With code swap, an opt-in setting for code changes only. Without it, the Node.js service's image deploy took
      40.1 s (17 October), slower than Heroku. CDK hotswap leaves the CloudFormation stack out of date; AWS documents it
      for development stacks.
    </span>
  </figcaption>
</figure>
