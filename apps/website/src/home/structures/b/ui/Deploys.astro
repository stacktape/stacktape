---
import Chart from './bench/Chart.astro';
import { barsOf, runOf, slowest } from './bench/data';

/**
 * Deploy speed from the deploy benchmarks (`src/data/deploy-benchmarks.json`): seconds until the changed code answers.
 * The headline is a code change to 25 Lambda functions from the command line; under it, a container code change and a
 * Git push of a Node.js service. Every tool's bar, fastest first; the run date links to the CLI run's results on
 * GitHub (the Git push run's link shows on wide screens). The owner had the slower cases, the footnote and the
 * caveat notes removed (25 Nov, TASTE 39 and 41).
 *
 * Stacktape's container and Git push times use code swap, an opt-in setting for code changes, so those bars say
 * "code swap". Its Git push median is of 5 runs (23 October); Heroku's container and Git push times are one build from
 * the pushed source (`heroku builds:create`). The data file and the GitHub results hold those details.
 */
const large = barsOf('lambda-deploy', 'handler', 'lambda-25');
const container = barsOf('container-deploy', 'code-change', 'container-node', { stacktape: 'code swap' });
const pushNode = barsOf('git-push', 'warm', 'container-node', { stacktape: 'code swap' });
const us = large.find((bar) => bar.us);
if (!us) throw new Error('The Lambda deploy benchmark has no Stacktape value');
const small = slowest(container, pushNode);
const cli = runOf(0);
const push = runOf(1);
---

<figure class="bn">
  <div class="bn-main">
    <div class="bn-stat">
      <p class="bn-stat__value">{us.seconds.toFixed(1)}<small>s</small></p>
      <p class="bn-stat__what">to deploy a code change to 25 Lambda functions from the CLI</p>
      <a class="brand-link bn-stat__run" href={cli.link}>Median of 10 CLI runs, {cli.label}</a>
      <a class="brand-link bn-stat__run bn-stat__run--wide" href={push.link}>Git push, {push.label}</a>
    </div>
    <Chart size="large" bars={large} scale={80} ticks={[0, 20, 40, 60, 80]} phoneTicks={[0, 40, 80]} />
  </div>
  <div class="bn-more">
    <Chart title="Containers" detail="A code change to a Node.js service" bars={container} scale={small} />
    <Chart title="Git push" detail="Node.js service, warm build machine" bars={pushNode} scale={small} />
  </div>
</figure>
