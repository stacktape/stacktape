---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { SECTION_PACKS } from '../../sections';
import Step from './Step.astro';

/**
 * The eight sections in the order `sections.ts` lists them, each with its picture: `ui/<name>.astro`, where `<name>` is
 * the section's `name` (Designs, Packages, …). A section without a picture file shows its words only.
 */
const pictures = import.meta.glob<{ default: AstroComponentFactory }>('./ui/*.astro', { eager: true });
const pictureFor = (name: string) => pictures[`./ui/${name}.astro`]?.default;

const DOCS: Record<string, { label: string; href: string }> = {
  designs: { label: 'How init works', href: 'https://docs.stacktape.com/cli/init' },
  packages: { label: 'Packaging', href: 'https://docs.stacktape.com/packaging/overview' },
  deploys: { label: 'Deploys and CI/CD', href: 'https://docs.stacktape.com/ci-cd-and-gitops/overview' },
  monitors: { label: 'Tracing', href: 'https://docs.stacktape.com/observability/tracing' },
  secures: { label: 'Guardrails', href: 'https://docs.stacktape.com/guardrails/overview' },
  incidents: { label: 'Incidents', href: 'https://docs.stacktape.com/observability/incidents' },
  costs: { label: 'Costs', href: 'https://docs.stacktape.com/managing-costs/overview' },
  'expert-help': { label: 'Book a technical demo', href: 'https://cal.com/stacktape/30min' }
};
const ROWS = SECTION_PACKS.map((pack, index) => ({ pack, index, Picture: pictureFor(pack.name) }));
const pad = (index: number) => String(index + 1).padStart(2, '0');
---

<div class="b-steps site-frame" data-steps>
  <nav class="b-steps__rail" aria-label="Steps">
    <p class="b-steps__jump">Jump to a step</p>
    <ol>
      {
        SECTION_PACKS.map((pack, index) => (
          <li>
            <a class="b-steps__link" href={`#${pack.id}`} data-step-link={pack.id}>
              <span class="b-steps__num">{pad(index)}</span>
              <span class="b-steps__name">{pack.title}</span>
              <span class="b-steps__short">{pack.name}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="b-steps__body">
    {
      ROWS.map(({ pack, index, Picture }) => (
        <Step pack={pack} index={index} docs={DOCS[pack.id]}>
          {Picture ? <Picture /> : null}
        </Step>
      ))
    }
  </div>
</div>

<script>
  for (const steps of document.querySelectorAll<HTMLElement>('[data-steps]')) {
    const links = new Map(
      Array.from(steps.querySelectorAll<HTMLAnchorElement>('[data-step-link]')).map((link) => [
        link.dataset.stepLink,
        link
      ])
    );
    const sections = Array.from(steps.querySelectorAll<HTMLElement>('section[id]'));
    const list = steps.querySelector<HTMLElement>('.b-steps__rail ol');
    let frame = 0;
    let shown: string | undefined;
    /**
     * The current step is the last one whose top has passed the middle of the window. On a narrow screen the rail is a
     * strip that scrolls sideways, so it scrolls the current step into view.
     */
    const update = () => {
      frame = 0;
      const middle = window.innerHeight / 2;
      const current = sections.findLast((section) => section.getBoundingClientRect().top < middle)?.id;
      for (const [key, link] of links) {
        if (key === current) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      }
      const link = current === undefined ? undefined : links.get(current);
      if (current !== shown && link && list && list.scrollWidth > list.clientWidth) {
        list.scrollTo({ left: link.offsetLeft - list.offsetLeft, behavior: 'smooth' });
      }
      shown = current;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true }
    );
    update();
  }
</script>

<style>
  .b-steps {
    display: grid;
    grid-template-columns: minmax(13rem, 15rem) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 2.5vw, 4rem);
  }

  .b-steps__rail {
    padding-block: clamp(4rem, 2.5rem + 4vw, 8rem);
  }

  .b-steps__rail ol {
    position: sticky;
    top: calc(4.25rem + var(--brand-space-7));
    display: grid;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--brand-border);
    list-style: none;
  }

  .b-steps__link {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: baseline;
    padding: 0.55rem 0.75rem 0.55rem var(--brand-space-4);
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    line-height: 1.35;
    text-decoration: none;
  }

  /* The current step is a selected row, so it gets the Console's grey tape, torn at its right end. */
  .b-steps__link::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--brand-control);
    box-shadow: var(--brand-edge);
    /* Four teeth, the logo label's, at the row's height. */
    clip-path: polygon(
      0 0,
      calc(100% - 0.22rem) 0,
      100% 12.5%,
      calc(100% - 0.22rem) 25%,
      100% 37.5%,
      calc(100% - 0.22rem) 50%,
      100% 62.5%,
      calc(100% - 0.22rem) 75%,
      100% 87.5%,
      calc(100% - 0.22rem) 100%,
      0 100%
    );
    content: '';
    opacity: 0;
  }

  .b-steps__num {
    font: var(--brand-type-xs) / 1 var(--brand-font-mono);
  }

  .b-steps__name {
    justify-self: start;
    font-family: var(--brand-font-heading);
    font-weight: var(--brand-weight-label);
  }

  .b-steps__link:hover,
  .b-steps__link[aria-current='step'] {
    color: var(--brand-text);
  }

  .b-steps__link[aria-current='step']::before {
    opacity: 1;
  }

  .b-steps__link:focus-visible {
    outline: 2px solid var(--brand-focus);
    outline-offset: 2px;
  }

  .b-steps__body {
    min-width: 0;
  }

  .b-steps__jump,
  .b-steps__short {
    display: none;
  }

  /*
   * Narrower screens have no room for the rail beside the steps. It becomes a strip under the site header that scrolls
   * sideways: each step by its short name, the current one on tape.
   */
  @media (max-width: 64rem) {
    .b-steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .b-steps__rail {
      position: sticky;
      z-index: 5;
      top: 4.25rem;
      display: flex;
      align-items: center;
      gap: var(--brand-space-3);
      margin-top: var(--brand-space-6);
      padding-block: var(--brand-space-2);
      border-bottom: 1px solid var(--brand-border);
      background: var(--brand-page);
    }

    .b-steps__jump {
      display: block;
      flex: none;
      color: var(--brand-muted);
      font-size: var(--brand-type-xs);
    }

    .b-steps__rail ol {
      position: static;
      display: flex;
      gap: var(--brand-space-1);
      min-width: 0;
      overflow-x: auto;
      border-left: 0;
      scrollbar-width: none;
    }

    .b-steps__link {
      grid-template-columns: auto auto;
      gap: var(--brand-space-2);
      padding: 0.35rem 0.75rem;
      white-space: nowrap;
    }

    .b-steps__name {
      display: none;
    }

    .b-steps__short {
      display: inline;
      font-family: var(--brand-font-heading);
      font-weight: var(--brand-weight-label);
    }
  }
</style>
