---
/**
 * The README cover from `main` (`src/components/Cover.astro`, September 2026): the Console's stage page tilted in 3D
 * with the CLI's deploy terminal in front of it. Same canvas, same layout, same content, same tilt. What changed is
 * only what the new brand asks for: the new logo, the Console's graphite colours instead of the grid texture, teal
 * buttons from the kit, tape for the selected tab, the selected stage and the counts, the brand teal instead of cyan,
 * and no glow.
 *
 * The 1517 x 1204 design canvas is scaled as a whole to the frame's width, so it stays sharp at every size.
 */
import Logo from '../../../brand/Logo.astro';
import { NAV, RESOURCES } from './console';
import Icon from './Icon.astro';
import './fonts.css';

const chevron = '<path d="M6 9l6 6l6 -6" />';
const plus = '<path d="M12 5l0 14" /><path d="M5 12l14 0" />';
const stageTabs = ['Overview', 'Activity', 'Logs', 'Metrics', 'Costs', 'Configuration', 'Danger zone'];
const deployed = [
  { name: 'web', type: 'Next.js Web', done: true },
  { name: 'apiService', type: 'Web Service · Fargate', done: true },
  { name: 'worker', type: 'Lambda Function', done: true },
  { name: 'cache', type: 'Redis · ElastiCache', done: true },
  { name: 'mainDatabase', type: 'Aurora · PostgreSQL 16', done: false, spinner: '⠹' },
  { name: 'firewall', type: 'Web Application Firewall', done: false, spinner: '⠻' }
];
---

<div
  class="h7-cover"
  role="img"
  aria-label="The Stacktape Console showing the stages and resources of acme-project, with a terminal in front of it deploying the project to production"
>
  <div class="canvas" aria-hidden="true">
    <div class="console">
      <div class="chrome">
        <div class="lights"><span></span><span></span><span></span></div>
        <div class="address">
          <Icon
            stroke
            class="lock"
            markup='<path d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6z" /><path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0" /><path d="M8 11v-4a4 4 0 1 1 8 0v4" />'
          />
          console.stacktape.com/projects/acme-project/staging
        </div>
        <div class="chrome-end"></div>
      </div>

      <header class="topbar">
        <Logo width={118} alt="" class="logo" />
        <div class="crumbs">
          <span>Stacktape</span><Icon stroke class="caret" markup={chevron} />
          <span class="slash">/</span>
          <span>acme-project</span><Icon stroke class="caret" markup={chevron} />
        </div>
        <div class="grow"></div>
        <div class="account">
          <span class="button"><Icon stroke markup={plus} /> Create new project</span>
          <span class="menu"
            ><Icon
              stroke
              markup='<path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M12 16v.01" /><path d="M12 13a2 2 0 0 0 .914 -3.782a1.98 1.98 0 0 0 -2.414 .483" />'
            /> Help <Icon stroke class="caret" markup={chevron} /></span
          >
          <span class="menu"
            ><Icon
              stroke
              markup='<path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />'
            /> JD <Icon stroke class="caret" markup={chevron} /></span
          >
        </div>
      </header>

      <div class="body">
        <nav class="nav">
          {
            NAV.map((entry) =>
              'section' in entry ? (
                <div class="nav-section">{entry.section}</div>
              ) : (
                <div class:list={['nav-item', { 'nav-docs': entry.docs }]}>
                  <Icon markup={entry.icon.markup} viewBox={entry.icon.viewBox} stroke={entry.icon.stroke} />
                  <span>{entry.label}</span>
                  {entry.badge && <span class:list={['count', `count-${entry.badge.tone}`]}>{entry.badge.count}</span>}
                  {entry.end && (
                    <div class="nav-end">
                      <Icon markup={entry.end} />
                    </div>
                  )}
                </div>
              )
            )
          }
        </nav>

        <section class="project">
          <div class="row">
            <span class="eyebrow">Project <span class="hint">?</span></span>
            <span class="square"><Icon stroke markup='<path d="M11 7l-5 5l5 5" /><path d="M17 7l-5 5l5 5" />' /></span>
          </div>
          <div class="row title-row">
            <span class="title">acme-project</span>
            <span class="square"
              ><Icon
                stroke
                markup='<path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z" /><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />'
              /></span
            >
          </div>
          <div class="repo">
            <Icon
              stroke
              markup='<path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />'
            />
            <span>acme/acme-project</span>
          </div>
          <div class="eyebrow stages-label">Stages <span class="hint">?</span></div>
          <span class="button wide"><Icon stroke markup={plus} /> New stage</span>
          <div class="well stages">
            <div class="stage selected">
              <span class="stage-name">staging</span>
              <div class="stage-meta">
                <div>eu-west-1</div>
                <div>Updated 2 hours ago</div>
              </div>
            </div>
            <div class="stage">
              <span class="stage-name">production</span>
              <div class="stage-meta">
                <div>eu-west-1</div>
                <div class="deploying"><span class="dot"></span>Deploying…</div>
              </div>
            </div>
          </div>
        </section>

        <section class="main">
          <div class="stage-head">
            <div>
              <div class="eyebrow">Stage</div>
              <div class="title">staging</div>
            </div>
            <span class="button">Deploy stage <Icon stroke markup={chevron} /></span>
          </div>

          <div class="well tabs">
            {stageTabs.map((tab, index) => <div class:list={['tab', { selected: index === 0 }]}>{tab}</div>)}
          </div>

          <div class="eyebrow small">Quick links</div>
          <div class="grid links">
            <div class="tile">
              <div class="tile-name">web URL</div>
              <div class="tile-meta">https://acme.com</div>
            </div>
            <div class="tile">
              <div class="tile-name">apiService URL</div>
              <div class="tile-meta">https://api.acme.com</div>
            </div>
          </div>

          <div class="eyebrow small">Resources</div>
          <div class="grid">
            {
              RESOURCES.map((resource) => (
                <div class="tile resource">
                  <Icon class="resource-icon" markup={resource.icon.markup} viewBox={resource.icon.viewBox} />
                  <div>
                    <div class="tile-name">{resource.name}</div>
                    <div class="tile-meta">{resource.type}</div>
                  </div>
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>

    <div class="terminal">
      <div class="terminal-bar">
        <div class="lights"><span></span><span></span><span></span></div>
        <div class="terminal-title">stacktape — deploy · zsh</div>
        <div class="terminal-end"></div>
      </div>
      <div class="terminal-body">
        <div class="t-command">
          <span class="t-accent t-bold">$</span>{' '}<span class="t-bright">stacktape deploy</span>{' '}<span class="t-muted"
            >--stage production --region eu-west-1</span
          >
        </div>
        <div class="t-status">
          <span class="t-accent t-bold t-wide">DEPLOYING</span>
          <span class="t-bright t-bold t-gap">acme-project</span>
          <span class="t-dim t-arrow">→</span>
          <span class="t-bright">production</span>
          <span class="t-dim t-region">eu-west-1</span>
          <span class="t-dim t-time">3m 02s</span>
        </div>
        <div class="t-phases">
          <div><span class="t-mark t-done">✓</span><span>Initialize</span></div>
          <div><span class="t-mark t-done">✓</span><span>Package</span></div>
          <div>
            <span class="t-mark t-accent">⠹</span><span class="t-accent">Deploy</span><span class="t-dim t-note">almost there</span>
          </div>
          <div><span class="t-mark"></span><span class="t-dim">Outputs</span></div>
        </div>
        <div class="t-heading">
          <span class="t-bright t-bold">Deploying via CloudFormation</span><span class="t-dim t-gap-xs">+33 create</span>
        </div>
        <div class="t-progress">
          <span class="t-done">███████████████████████████</span><span class="t-track">░░░</span>
          <span class="t-bright t-bold t-note">91%</span><span class="t-muted t-gap-sm">(30/33 resources)</span>
        </div>
        <div class="t-resources">
          {
            deployed.map((row) => (
              <>
                <span class:list={[row.done ? 't-done' : 't-accent']}>{row.done ? '✓' : row.spinner}</span>
                <span class="t-bright t-bold">{row.name}</span>
                <span class="t-muted">{row.type}</span>
                <span class:list={[row.done ? 't-muted' : 't-accent']}>{row.done ? 'created' : 'creating…'}</span>
              </>
            ))
          }
        </div>
        <div class="t-keys">
          <span class="t-key">c</span> cancel &amp; rollback <span class="t-key">ctrl+c</span> quit
          <span class="t-key">↑↓</span> scroll
        </div>
      </div>
    </div>
  </div>
  <script is:inline>
    /* Scale the design canvas to the frame's width. Runs right after the frame is parsed, so the CSS fallback scale
       is never painted at a size that overflows. */
    (() => {
      const frame = document.currentScript && document.currentScript.parentElement;
      if (!frame) return;
      const apply = (width) => frame.style.setProperty('--cover-scale', String(width / 1517));
      apply(frame.clientWidth);
      new ResizeObserver((entries) => apply(entries[0].contentRect.width)).observe(frame);
    })();
  </script>
</div>

<style>
  /* The frame fills its container's width, reserves the canvas' aspect ratio and carries the scale. */
  .h7-cover {
    --cover-scale: 0.45;
    /* The cover's own graphite, one step lighter than the page so the window stands off it; the texture is gone. */
    --c-chrome: rgb(27 33 33);
    --c-window: rgb(27 33 33);
    --c-tile: linear-gradient(145deg, rgb(32 39 39 / 98%), rgb(28 35 35 / 98%));
    --c-line: var(--brand-border);
    --c-text: rgb(255 255 255 / 87%);
    --c-muted: rgb(160 160 160);
    --c-dim: #6b7878;
    --c-teal: var(--brand-teal);
    position: relative;
    display: block;
    inline-size: 100%;
    aspect-ratio: 1517 / 1204;
  }

  .canvas {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 1517px;
    block-size: 1204px;
    overflow: hidden;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
    -webkit-font-smoothing: auto;
    transform: scale(var(--cover-scale));
    transform-origin: top left;
  }

  .canvas :global(svg) {
    inline-size: 1em;
    block-size: 1em;
    flex: none;
  }

  /* ---- The Console window ---- */
  .console {
    position: absolute;
    inset-block-start: 56px;
    inset-inline-start: 24px;
    inline-size: 1400px;
    overflow: hidden;
    border-radius: 10px;
    background: var(--c-window);
    color: var(--c-text);
    font: 500 13.5px / 1.5 Montserrat, ui-sans-serif, sans-serif;
    transform: perspective(2200px) rotateY(-10deg) rotateX(2.5deg);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 11%),
      0 46px 90px -30px rgb(0 0 0 / 80%),
      0 16px 38px -18px rgb(0 0 0 / 55%);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    block-size: 40px;
    padding-inline: 16px;
    border-block-end: 1px solid var(--c-line);
    background: #0c1111;
  }

  .lights {
    display: flex;
    gap: 8px;
  }

  .lights span {
    inline-size: 12px;
    block-size: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .lights span:nth-child(2) {
    background: #febc2e;
  }

  .lights span:nth-child(3) {
    background: #28c840;
  }

  .address {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-inline: auto;
    padding: 4px 14px;
    border: 1px solid var(--c-line);
    border-radius: 6px;
    background: #161c1c;
    color: var(--c-muted);
    font-size: 12px;
  }

  .address :global(.lock) {
    font-size: 11px;
  }

  .chrome-end {
    inline-size: 56px;
  }

  .topbar {
    display: flex;
    align-items: center;
    gap: 28px;
    block-size: 60px;
    padding-inline: 22px;
    border-block-end: 1px solid var(--c-line);
    background: var(--c-chrome);
  }

  .topbar :global(.logo) {
    display: block;
    flex: none;
    block-size: auto;
  }

  .crumbs {
    display: flex;
    flex: none;
    align-items: center;
    gap: 10px;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
  }

  .crumbs :global(.caret) {
    margin-inline-start: -4px;
    color: var(--c-muted);
    font-size: 14px;
  }

  .slash {
    color: #848484;
    font-weight: 500;
  }

  .grow {
    flex: 1;
  }

  .account {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .menu :global(.caret) {
    color: var(--c-muted);
    font-size: 14px;
  }

  /* The kit's primary button: the teal gradient with its light top edge. */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: var(--brand-radius);
    background: var(--brand-primary);
    box-shadow: var(--brand-edge-primary);
    color: var(--brand-on-teal);
    font-weight: 600;
    white-space: nowrap;
  }

  .button.wide {
    inline-size: 100%;
    margin-block: 12px;
  }

  .body {
    display: flex;
  }

  .nav {
    display: flex;
    flex: none;
    flex-direction: column;
    inline-size: 230px;
    padding-block: 14px;
    border-inline-end: 1px solid var(--c-line);
    background: var(--c-chrome);
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    block-size: 36px;
    margin: 2px 8px;
    padding: 0 12px 0 20px;
    color: rgb(255 255 255 / 85%);
  }

  .nav-item > :global(svg) {
    font-size: 18px;
  }

  .nav-item span {
    font-size: 14px;
    font-weight: 400;
  }

  .nav-end {
    display: flex;
    flex: none;
    align-items: center;
    margin-inline-start: auto;
    font-size: 20px;
  }

  .nav-section {
    margin: 15px 0 5px 28px;
    color: var(--c-muted);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nav-docs {
    margin-block-start: 18px;
  }

  /* Counts are printed on label tape, torn like the logo's label. Red and amber stay for issues and alarms. */
  .nav-item .count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 22px;
    block-size: 19px;
    margin-inline-start: -6px;
    padding-inline: 0.55em;
    clip-path: var(--brand-tape-clip);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }

  .count-red {
    background: linear-gradient(180deg, #c8413f, #a8302f);
  }

  .count-amber {
    background: linear-gradient(180deg, #e9b23a, #cf9218);
    color: #3d2c00 !important;
  }

  .project {
    flex: none;
    inline-size: 280px;
    padding: 18px 20px;
    border-inline-end: 1px solid var(--c-line);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .title-row {
    margin-block-start: 12px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--c-muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .eyebrow.small {
    margin-block-end: 8px;
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  .hint {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 15px;
    block-size: 15px;
    border: 1px solid #848484;
    border-radius: 50%;
    color: #848484;
    font-size: 10px;
  }

  .square {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 32px;
    block-size: 32px;
    border: 1px solid var(--c-line);
    border-radius: 6px;
    background: rgb(34 40 40);
    color: var(--c-muted);
    font-size: 16px;
  }

  .title {
    color: #fff;
    font-size: 21px;
    font-weight: 700;
  }

  .repo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-block-start: 14px;
    color: var(--c-muted);
  }

  .repo :global(svg) {
    font-size: 18px;
  }

  .stages-label {
    margin-block-start: 24px;
  }

  /* The dark well that holds tabs; the selected item is a piece of grey tape. */
  .well {
    border-radius: 12px;
    background: rgb(0 0 0 / 25%);
    box-shadow:
      inset 0 1px 3px rgb(0 0 0 / 30%),
      0 1px 0 rgb(255 255 255 / 5%);
  }

  .stages {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 6px 2px;
  }

  .stage {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 14px;
  }

  .stage-name {
    color: rgb(190 190 190 / 85%);
    font-weight: 700;
  }

  .stage-meta {
    color: rgb(140 140 140);
    font-size: 12.2px;
    line-height: 1.375;
    text-align: end;
    white-space: nowrap;
  }

  /* The selected stage row: grey tape, cut straight on the left and torn on the right, like the Console's nav. */
  .stage.selected {
    background: var(--brand-control);
    box-shadow: var(--brand-edge);
    clip-path: polygon(
      0 0,
      calc(100% - 3.4px) 0%,
      100% 10%,
      calc(100% - 3.4px) 20%,
      100% 30%,
      calc(100% - 3.4px) 40%,
      100% 50%,
      calc(100% - 3.4px) 60%,
      100% 70%,
      calc(100% - 3.4px) 80%,
      100% 90%,
      calc(100% - 3.4px) 100%,
      0 100%
    );
  }

  .stage.selected .stage-name {
    color: #fff;
  }

  .deploying {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--c-teal);
    font-weight: 600;
  }

  /* The cover's one moving part, as in the original: the deploying stage's status dot pulses. */
  .dot {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--c-teal);
    animation: h7-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes h7-pulse {
    50% {
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }

  .main {
    flex: 1;
    min-inline-size: 0;
    padding: 16px 28px;
  }

  .stage-head {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-block-end: 16px;
  }

  .stage-head .title {
    margin-block-start: 2px;
  }

  .tabs {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-block-end: 16px;
    padding: 5.5px;
  }

  .tab {
    padding: 5.5px 11.5px;
    color: rgb(190 190 190 / 80%);
    font-size: 13.2px;
    font-weight: 600;
  }

  /* One strip of tape torn into pieces: the first piece is cut straight on its outer end, torn where it meets the next. */
  .tab.selected {
    background: var(--brand-control);
    box-shadow: var(--brand-edge);
    color: var(--c-text);
    clip-path: polygon(
      0 0%,
      calc(100% - 0px) 0%,
      calc(100% - 3.4px) 12.5%,
      calc(100% - 0px) 25%,
      calc(100% - 3.4px) 37.5%,
      calc(100% - 0px) 50%,
      calc(100% - 3.4px) 62.5%,
      calc(100% - 0px) 75%,
      calc(100% - 3.4px) 87.5%,
      calc(100% - 0px) 100%,
      0 100%
    );
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .links {
    margin-block-end: 16px;
  }

  .tile {
