---
import { CommandBox } from '../../../brand/CommandBox';
import './font.css';
import Costs from './console/Costs.astro';
import './console/console.css';
import Deploy from './console/Deploy.astro';
import Incidents from './console/Incidents.astro';
import Overview from './console/Overview.astro';
import Security from './console/Security.astro';
import Uptime from './console/Uptime.astro';
import { SCREENS } from './screens';

type Props = { subheadline?: string };

const {
  subheadline = 'Stacktape reads your repository, designs the infrastructure like a senior DevOps team would, deploys it to your own AWS account and makes sure your app runs flawlessly forever after. It keeps you in the loop for any decision that requires human attention.'
} = Astro.props;

/** The Console screens behind the tabs, rebuilt in HTML from the real Console. */
const CONSOLE = {
  infrastructure: Overview,
  deploys: Deploy,
  monitoring: Uptime,
  incidents: Incidents,
  security: Security,
  costs: Costs
};


---

<section class="h5" aria-labelledby="h5-title">
  <div class="h5__top">
    <h1 id="h5-title" class="h5__title">
      <span>AWS DevOps,</span>
      <span class="h5__tape">fully automated.</span>
    </h1>
    <div class="h5__words">
      <p class="h5__lead">{subheadline}</p>
    </div>
    <section class="h5__setup" aria-labelledby="h5-setup">
      <h2 id="h5-setup" class="h5__setup-title">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M4 5h16v14H4zM8 10l2.5 2L8 14M12.5 14H16"></path></svg
        >Run the setup wizard
      </h2>
      <p class="h5__setup-text">
        Run this in your app's folder to review the proposed AWS resources and estimated cost before you deploy.
      </p>
      <CommandBox client:load id="install" preselect={false} />
    </section>
  </div>

  <div class="h5__product">
    <p class="h5__open">
      <span class="h5__label">Open source</span>
      The MIT-licensed CLI deploys CloudFormation stacks in your AWS account. No Stacktape account required.
    </p>
    <div class="h5__strip" role="tablist" aria-label="What Stacktape runs for you" data-h5-tabs>
      {
        SCREENS.map((screen, at) => (
          <button
            type="button"
            role="tab"
            class="h5__tab"
            id={`h5-tab-${screen.file}`}
            aria-controls={`h5-screen-${screen.file}`}
            aria-selected={at === 0 ? 'true' : 'false'}
            tabindex={at === 0 ? 0 : -1}
          >
            {screen.tab}
          </button>
        ))
      }
    </div>
    <div class="h5__window">
      {
        SCREENS.map((screen, at) => {
          const Screen = CONSOLE[screen.file];
          return (
            <div
              id={`h5-screen-${screen.file}`}
              class="h5__screen"
              role="tabpanel"
              aria-labelledby={`h5-tab-${screen.file}`}
              hidden={at > 0}
            >
              <div role="img" aria-label={screen.description}>
                <Screen />
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

</section>

<script>
  import './tabs';
</script>

<style>
  .h5 {
    --h5-serif: 'H5 Newsreader', Georgia, 'Times New Roman', serif;
    --h5-soft: color-mix(in srgb, var(--brand-text), transparent 22%);
    --h5-rule: rgb(255 255 255 / 8%);
    /* The site header's content width, so the window and the trust row line up with the logo and the header's links. */
    --h5-frame: min(var(--site-width, 76rem), 100% - 2 * var(--brand-space-5));
    /*
     * The Console's tape tabs (brand-identity session, tape_look.py tabs_css and final_looks.py fitting_clip): one
     * strip torn into pieces. A piece's torn right end has the same teeth as the next piece's torn left end, so
     * neighbours fit with an even gap; the two outer ends of the strip are cut straight. Five teeth per end keep the
     * logo label's pitch (about 7 px) at this tab height.
     */
    --h5-tooth: 3.4px;
    --h5-torn-right:
      100% 0%, calc(100% - var(--h5-tooth)) 10%, 100% 20%, calc(100% - var(--h5-tooth)) 30%, 100% 40%,
      calc(100% - var(--h5-tooth)) 50%, 100% 60%, calc(100% - var(--h5-tooth)) 70%, 100% 80%,
      calc(100% - var(--h5-tooth)) 90%, 100% 100%;
    --h5-torn-left:
      var(--h5-tooth) 100%, 0% 90%, var(--h5-tooth) 80%, 0% 70%, var(--h5-tooth) 60%, 0% 50%, var(--h5-tooth) 40%,
      0% 30%, var(--h5-tooth) 20%, 0% 10%, var(--h5-tooth) 0%;
    border-block-end: 1px solid var(--h5-rule);
    /* Near flat: the page's graphite, turning a shade towards the logo's teal behind the window. */
    background: linear-gradient(
      180deg,
      var(--brand-page) 30%,
      color-mix(in oklab, var(--brand-page), var(--brand-primary-bottom) 12%)
    );
  }

  /*
   * The top block: the headline set like the logo, its second line printed on the logo's teal tape, with the
   * subheadline under it; beside them the Console's own "Run the setup wizard" card, which gives the command the
   * surface it is designed to sit on.
   */
  .h5__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(29rem, 36vw, 35rem);
    grid-template-areas: 'title setup' 'words setup';
    grid-template-rows: auto 1fr;
    align-items: center;
    gap: clamp(1.75rem, 2.2vw, 2.5rem) clamp(2.5rem, 5vw, 6.5rem);
    inline-size: var(--h5-frame);
    margin: 0 auto;
    padding-block-start: clamp(3rem, 4.4vw, 5.5rem);
  }

  .h5__title {
    grid-area: title;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.06em;
    margin: 0;
    color: var(--brand-text);
    font: 800 clamp(2.75rem, 1.2rem + 3.9vw, 6rem) / 1.02 var(--brand-font-heading);
    letter-spacing: -0.045em;
  }

  /*
   * The logo's label at headline size: white on the primary teal. At this size the label's four big teeth per end
   * would read as broken (TASTE 7), so the ends tear in eight small teeth, about the logo's pitch scaled to the text.
   */
  .h5__tape {
    --h5-headline-tooth: 0.055em;
    margin-inline-start: -0.12em;
    padding: 0.02em 0.2em 0.08em 0.12em;
    background: var(--brand-primary);
    box-shadow: var(--brand-edge-primary);
    color: var(--brand-on-teal);
    white-space: nowrap;
    clip-path: polygon(
      calc(100% - var(--h5-headline-tooth)) 0%,
      100% 6.25%,
      calc(100% - var(--h5-headline-tooth)) 12.50%,
      100% 18.75%,
      calc(100% - var(--h5-headline-tooth)) 25%,
      100% 31.25%,
      calc(100% - var(--h5-headline-tooth)) 37.50%,
      100% 43.75%,
      calc(100% - var(--h5-headline-tooth)) 50%,
      100% 56.25%,
      calc(100% - var(--h5-headline-tooth)) 62.50%,
      100% 68.75%,
      calc(100% - var(--h5-headline-tooth)) 75%,
      100% 81.25%,
      calc(100% - var(--h5-headline-tooth)) 87.50%,
      100% 93.75%,
      calc(100% - var(--h5-headline-tooth)) 100%,
      var(--h5-headline-tooth) 100%,
      0% 93.75%,
      var(--h5-headline-tooth) 87.50%,
      0% 81.25%,
      var(--h5-headline-tooth) 75%,
      0% 68.75%,
      var(--h5-headline-tooth) 62.50%,
      0% 56.25%,
      var(--h5-headline-tooth) 50%,
      0% 43.75%,
      var(--h5-headline-tooth) 37.50%,
      0% 31.25%,
      var(--h5-headline-tooth) 25%,
      0% 18.75%,
      var(--h5-headline-tooth) 12.50%,
      0% 6.25%,
      var(--h5-headline-tooth) 0%
    );
  }

  .h5__words {
    grid-area: words;
    align-self: start;
  }

  .h5__lead {
    max-inline-size: 46rem;
    margin: 0;
    color: var(--h5-soft);
    font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.3rem);
    line-height: 1.55;
  }

  /* The Console's card: its surface, a heading with the terminal icon, one sentence, the command, three steps. */
  .h5__setup {
    grid-area: setup;
    align-self: center;
    padding: clamp(1.5rem, 2vw, 2.25rem);
    border: 1px solid rgb(255 255 255 / 7%);
    background: var(--brand-surface);
    box-shadow: 0 24px 60px rgb(0 0 0 / 35%);
  }

  .h5__setup-title {
    display: flex;
    align-items: center;
    gap: var(--brand-space-3);
    margin: 0;
    color: var(--brand-text);
    font: 650 clamp(1.15rem, 1rem + 0.35vw, 1.4rem) / 1.2 var(--brand-font-heading);
    letter-spacing: -0.01em;
  }

  .h5__setup-title svg {
    flex: none;
    inline-size: 1.35em;
    block-size: 1.35em;
    fill: none;
    stroke: var(--brand-muted);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .h5__setup-text {
    margin: var(--brand-space-3) 0 var(--brand-space-5);
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    line-height: 1.55;
  }

  /* "Open source" on grey label tape, as a line over the Console window. */
  .h5__open {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--brand-space-2) var(--brand-space-3);
    margin: 0 0 var(--brand-space-2);
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    text-align: center;
  }

  .h5__label {
    padding: 0.2em 0.7em 0.25em;
    background: var(--brand-control);
    box-shadow: var(--brand-edge);
    color: var(--brand-text);
    font: 600 var(--brand-type-xs) / 1.3 var(--brand-font-heading);
    clip-path: var(--brand-tape-clip);
  }

  /* The product: the Console's tab strip, and under it the real Console window. */
  .h5__product {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--brand-space-4);
    inline-size: var(--h5-frame);
    margin: clamp(2.25rem, 2.6vw, 3.25rem) auto 0;
  }

  .h5__strip {
    display: flex;
    max-inline-size: 100%;
    padding: 3px;
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-inset);
  }

  .h5__tab {
    position: relative;
    isolation: isolate;
    flex: none;
    block-size: 2.4em;
    padding: 0 1.5em;
    border: 0;
    background: none;
    color: var(--brand-muted);
    font: 500 clamp(0.875rem, 0.8rem + 0.18vw, 1.0625rem) / 1 var(--brand-font-heading);
    cursor: pointer;
  }

  /* The piece of tape. The button itself is not cut, so its focus ring stays whole. */
  .h5__tab::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: '';
    clip-path: polygon(var(--h5-torn-right), var(--h5-torn-left));
    pointer-events: none;
  }

  .h5__tab:first-child::before {
    clip-path: polygon(0% 0%, var(--h5-torn-right), 0% 100%);
  }

  .h5__tab:last-child::before {
    clip-path: polygon(100% 0%, 100% 100%, var(--h5-torn-left));
  }

  .h5__tab:hover:not([aria-selected='true'])::before {
    background: rgb(255 255 255 / 4.5%);
  }

  .h5__tab[aria-selected='true'] {
    color: var(--brand-text);
  }

  /* The Console's grey tape: the secondary control's surface with its light top edge. */
  .h5__tab[aria-selected='true']::before {
    background: var(--stp-control-surface, var(--brand-control));
    box-shadow: var(--brand-edge);
  }

  /* Outside the piece, so the ring never hides the torn ends. */
  .h5__tab:focus-visible {
    z-index: 1;
    outline: 2px solid var(--brand-focus);
    outline-offset: 1px;
  }

  /* The window is the container the rebuilt Console scales to: it is laid out in Console pixels of `100cqw / 1280`. */
  .h5__window {
    container: h5-console / inline-size;
    inline-size: 100%;
    border: 1px solid rgb(255 255 255 / 11%);
    border-radius: var(--brand-radius);
    background: var(--brand-inset);
    box-shadow: 0 34px 80px rgb(0 0 0 / 42%);
  }

  .h5__screen {
    border-radius: inherit;
  }

  .h5__screen[hidden] {
    display: none;
  }

  @media (max-width: 64rem) {
    .h5__top {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'title' 'words' 'setup';
      grid-template-rows: none;
    }

    .h5__setup {
      max-inline-size: 40rem;
    }
  }

  @media (max-width: 40rem) {
    .h5 {
      --h5-frame: calc(100% - 2 * var(--brand-space-4));
    }

    /*
     * On a phone the Console comes right after the words, so the first screen shows what Stacktape did; the setup card
     * follows the window. The header's Get started button jumps to it (#install). The top block's parts join the
     * hero's own column for that.
     */
    .h5 {
      display: flex;
      flex-direction: column;
    }

    .h5__top {
      display: contents;
    }

    .h5__title,
    .h5__words {
      inline-size: var(--h5-frame);
      margin-inline: auto;
    }

    .h5__title {
      margin-block-start: var(--brand-space-5);
      font-size: 2.45rem;
    }

    .h5__words {
      margin-block-start: var(--brand-space-4);
    }

    .h5__lead {
      font-size: 1rem;
    }

    .h5__product {
      order: 1;
    }

    /* The card runs edge to edge, so the command gets the phone's whole width. */
    .h5__setup {
      order: 2;
      margin-block-start: var(--brand-space-6);
      padding: var(--brand-space-5) var(--brand-space-4);
      border-inline: 0;
    }

    .h5__setup-text {
      margin-block-end: var(--brand-space-4);
    }

    .h5__open {
      font-size: var(--brand-type-xs);
    }

    .h5__product {
      margin-block-start: var(--brand-space-5);
      gap: var(--brand-space-2);
    }

    /* Six tabs do not fit one row on a phone: two rows of three, each row a strip cut straight at its outer ends. */
    .h5__strip {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 3px;
      align-self: stretch;
    }

    .h5__tab {
      block-size: 2.25rem;
      padding-inline: 0.25rem;
      font-size: 0.8125rem;
    }

    .h5__tab:nth-child(3n + 1)::before {
      clip-path: polygon(0% 0%, var(--h5-torn-right), 0% 100%);
    }

    .h5__tab:nth-child(3n)::before {
      clip-path: polygon(100% 0%, 100% 100%, var(--h5-torn-left));
    }

  }

  /* On the narrowest phones the command and its tabs are set a step smaller, so neither wraps nor scrolls. */
  @media (max-width: 24rem) {
    .h5__setup :global(.brand-command__words) {
      font-size: var(--brand-type-sm);
    }

    .h5__setup :global(.brand-tabs) {
      --stp-tab-font-size: var(--brand-type-xs);
    }
  }
</style>
