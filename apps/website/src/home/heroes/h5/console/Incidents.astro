---
/** Every incident of the organization, with its severity printed on label tape. */
import { INCIDENT_TABS, INCIDENTS, PROJECT } from './data';
import Icon from './Icon.astro';
import Shell from './Shell.astro';
---

<Shell crumb="Incidents" page="incidents" view="incidents">
  <div class="cx-title">
    <span class="cx-h1">Incidents</span>
    <Icon name="help" />
  </div>
  <div class="cx-card">
    <div class="cx-toolbar">
      <span class="cx-seg">
        <span class="cx-seg__tab">Active <span class="cx-quiet">{INCIDENT_TABS.active}</span></span>
        <span class="cx-seg__tab">Resolved <span class="cx-quiet">{INCIDENT_TABS.resolved}</span></span>
        <span class="cx-seg__tab is-on">All <span class="cx-quiet">{INCIDENT_TABS.all}</span></span>
      </span>
      <span class="cx-input"><Icon name="search" />Search incident titles</span>
      <span class="cx-select">Project <b>All</b><Icon name="down" /></span>
      <span class="cx-select">Stage <b>All</b><Icon name="down" /></span>
      <span class="cx-btn cx-filters"><Icon name="filter" />Filters</span>
    </div>
    <div class="cx-table cx-table--incidents">
      <div class="cx-tr cx-tr--head">
        <span class="cx-th">Severity</span>
        <span class="cx-th">Incident</span>
        <span class="cx-th">Status</span>
        <span class="cx-th">Opened</span>
        <span class="cx-th"></span>
      </div>
      {
        INCIDENTS.map((incident) => (
          <div class="cx-tr">
            <span class="cx-td">
              <span class={`cx-label cx-label--${incident.severity.toLowerCase()}`}>{incident.severity}</span>
            </span>
            <span class="cx-td cx-stack">
              <b>{incident.title}</b>
              <span class="cx-quiet cx-clip">
                {PROJECT} / {incident.where} · {incident.detail}
              </span>
            </span>
            <span class="cx-td cx-stack">
              <span class:list={[incident.status === 'Open' ? 'cx-red' : 'cx-ok']}>
                <i class="cx-dot brand-round" />
                {incident.status}
              </span>
              {incident.by && <span class="cx-quiet">{incident.by}</span>}
            </span>
            <span class="cx-td">{incident.opened}</span>
            <span class="cx-td cx-chev">
              <Icon name="right" />
            </span>
          </div>
        ))
      }
    </div>
  </div>
</Shell>
