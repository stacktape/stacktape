---
/** What the production stage cost this month, split by resource. */
import { COSTS, MONTH, PROJECT, RESOURCES } from './data';
import Icon from './Icon.astro';
import ResIcon from './ResIcon.astro';
import Shell from './Shell.astro';
import StageHead from './StageHead.astro';
---

<Shell crumb={PROJECT} crumbMenu page="projects" phoneCrumb={`${PROJECT} / production`} view="costs">
  <StageHead section="Costs" />
  <div class="cx-card">
    <div class="cx-month">
      <div>
        <span class="cx-quiet">November 2026 so far</span>
        <strong>{MONTH.total}</strong>
        <span class="cx-quiet"
          >{MONTH.pace} by Nov 30 at this pace, {MONTH.change} than October ({MONTH.october}) · Report updated 1h ago</span
        >
      </div>
      <span class="cx-select">Month <b>November 2026</b><Icon name="down" /></span>
    </div>
    <div class="cx-table cx-table--costs">
      <div class="cx-tr cx-tr--head">
        <span class="cx-th">Resource</span>
        <span class="cx-th">Type</span>
        <span class="cx-th cx-num">Share</span>
        <span class="cx-th cx-num">All of October</span>
        <span class="cx-th cx-num">↓ November so far</span>
        <span class="cx-th"></span>
      </div>
      {
        COSTS.map((row) => (
          <div class="cx-tr">
            <span class="cx-td cx-name">
              {row.name ? (
                <>
                  <ResIcon name={row.name} />
                  {row.name}
                </>
              ) : (
                <span class="cx-quiet cx-indent">Not tied to one resource</span>
              )}
            </span>
            <span class="cx-td cx-quiet">{row.name ? RESOURCES[row.name].label : 'Other AWS costs'}</span>
            <span class="cx-td cx-share">
              <span class="cx-meter">
                <i style={`width: ${Math.max(row.share, 1)}%`} />
              </span>
              {row.share}%
            </span>
            <span class="cx-td cx-num cx-quiet">{row.october}</span>
            <span class="cx-td cx-num">
              <b>{row.november}</b>
            </span>
            <span class="cx-td cx-chev">{row.name && <Icon name="right" />}</span>
          </div>
        ))
      }
    </div>
  </div>
</Shell>
