---
/** Security findings across every stage, each with the fix and where it is, and the summary cards they add up to. */
import { FINDINGS, PROJECT } from './data';
import Icon from './Icon.astro';
import Shell from './Shell.astro';

const count = (severity: string) => FINDINGS.filter((finding) => finding.severity === severity).length;
const NOW = { critical: count('Critical'), high: count('High') };
const LATER = { medium: count('Medium'), low: count('Low') };
---

<Shell crumb="Security" page="security" open="security">
  <div class="cx-title">
    <span class="cx-h1">Security</span>
    <Icon name="help" />
  </div>
  <div class="cx-summary">
    <span class="cx-card">
      <b>Fix now</b>
      <strong class="cx-red">{NOW.critical + NOW.high}</strong>
      <span class="cx-quiet">{NOW.critical} critical, {NOW.high} high</span>
    </span>
    <span class="cx-card">
      <b>Fix when you can</b>
      <strong>{LATER.medium + LATER.low}</strong>
      <span class="cx-quiet">{LATER.medium} medium, {LATER.low} low</span>
    </span>
    <span class="cx-card">
      <b>Stacks scanned</b>
      <strong class="cx-amber">2 of 5</strong>
      <span class="cx-quiet"><u>3 not scanned yet</u><Icon name="help" /></span>
    </span>
    <span class="cx-card">
      <b>Score of scanned stacks</b>
      <strong class="cx-amber">75/100</strong>
      <span class="cx-quiet">100 is best<Icon name="help" /></span>
    </span>
  </div>
  <div class="cx-card">
    <div class="cx-toolbar cx-toolbar--split">
      <span class="cx-seg">
        <span class="cx-seg__tab is-on">All fixes</span>
        <span class="cx-seg__tab">Config</span>
        <span class="cx-seg__tab">Packages</span>
        <span class="cx-seg__tab">By stack</span>
      </span>
    </div>
    <div class="cx-toolbar">
      <span class="cx-input"><Icon name="search" />Search findings</span>
      <span class="cx-select">Project <b>All</b><Icon name="down" /></span>
      <span class="cx-select">Stage <b>All</b><Icon name="down" /></span>
      <span class="cx-select">Status <b>Open</b><Icon name="down" /></span>
      <span class="cx-select">Severity <b>All</b><Icon name="down" /></span>
      <span class="cx-btn cx-filters"><Icon name="filter" />Filters</span>
    </div>
    <div class="cx-table cx-table--security">
      <div class="cx-tr cx-tr--head">
        <span class="cx-th">Severity</span>
        <span class="cx-th">What to fix</span>
        <span class="cx-th">Where</span>
        <span class="cx-th">Last seen</span>
        <span class="cx-th"></span>
      </div>
      {
        FINDINGS.map((finding) => (
          <div class="cx-tr">
            <span class="cx-td">
              <span class={`cx-label cx-label--${finding.severity.toLowerCase()}`}>{finding.severity}</span>
            </span>
            <span class="cx-td cx-stack">
              <b>{finding.title}</b>
              <span class="cx-quiet">{finding.fix}</span>
            </span>
            <span class="cx-td cx-stack">
              <span>
                {PROJECT} / {finding.stage}
              </span>
              <span class="cx-quiet">{finding.where}</span>
            </span>
            <span class="cx-td">{finding.seen}</span>
            <span class="cx-td cx-chev">
              <Icon name="right" />
            </span>
          </div>
        ))
      }
    </div>
  </div>
</Shell>
