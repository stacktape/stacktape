---
/** One deploy: its steps on a shared timeline, what it changed, and who started it. */
import { DEPLOY_FACTS, DEPLOY_STEPS, DEPLOY_TOTAL, PROJECT } from './data';
import Icon from './Icon.astro';
import ResIcon from './ResIcon.astro';
import Shell from './Shell.astro';

const at = (seconds: number) => `${(seconds / DEPLOY_TOTAL) * 100}%`;
---

<Shell crumb={PROJECT} crumbMenu page="projects" phoneCrumb={`${PROJECT} / production`}>
  <p class="cx-path">{PROJECT} <span>/</span> production <span>/</span> Activity</p>
  <div class="cx-deploy-head">
    <div>
      <span class="cx-h1">Fix order totals for empty carts</span>
      <p class="cx-quiet">Deploy <i class="cx-dot brand-round" /><b>Succeeded</b> Live on production</p>
    </div>
    <span class="cx-btn"><Icon name="back" />Roll back to previous</span>
    <span class="cx-btn">Deploy stage</span>
    <span class="cx-link">Open web<Icon name="external" /></span>
  </div>
  <div class="cx-sections">
    <span class="cx-section is-on">Logs</span>
    <span class="cx-section">Configuration</span>
    <span class="cx-section">CloudFormation template</span>
  </div>
  <div class="cx-deploy">
    <div class="cx-card">
      <div class="cx-sections cx-sections--card">
        <span class="cx-section is-on">Steps</span>
        <span class="cx-section">Log</span>
        <Icon name="copy" class="cx-copy" />
      </div>
      {
        DEPLOY_STEPS.map((step) => (
          <div class="cx-step">
            <span class="cx-done brand-round">
              <Icon name="check" />
            </span>
            <Icon name="right" class="cx-step__open" />
            <b>
              {step.name} {step.note && <span class="cx-quiet">{step.note}</span>}
            </b>
            <span class="cx-bar">
              <i style={`left: ${at(step.from)}; width: max(0.35em, ${at(step.to - step.from)})`} />
            </span>
            <span class="cx-num">{step.took}</span>
          </div>
        ))
      }
      <div class="cx-changed">
        <p>
          <b>What this deploy changed</b>
          <u>View the diff</u>
        </p>
        <p class="cx-quiet">Compared with <u>Show order totals in the cart</u>, deployed 3h ago</p>
        <p class="cx-diff">
          <ResIcon name="api" />
          <b>api</b>
          <span class="cx-quiet">image</span>
          <code>acme-shop/api:1.42.0 → 1.42.1</code>
        </p>
      </div>
    </div>
    <div class="cx-card cx-facts">
      <b>About this deploy</b>
      {
        DEPLOY_FACTS.map((fact) => (
          <p>
            <span class="cx-quiet">{fact.label}</span>
            {fact.kind === 'commit' ? (
              <span class="cx-commit">{fact.value}</span>
            ) : fact.kind === 'link' ? (
              <u>{fact.value}</u>
            ) : (
              <span>{fact.value}</span>
            )}
          </p>
        ))
      }
    </div>
  </div>
</Shell>
