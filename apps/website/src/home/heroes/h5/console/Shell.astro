---
/**
 * The Console's frame with its tape look: the top bar, the sidebar (the selected row is a piece of grey tape torn at
 * its right end, counts are torn labels) and the raised page the screen's content sits on.
 */
import { COUNTS, ORG, USER } from './data';
import Icon from './Icon.astro';

type Section = 'observability' | 'security';
type Page = 'projects' | 'incidents' | 'uptime' | 'security';
type Props = { crumb: string; crumbMenu?: boolean; page: Page; open?: Section; phoneCrumb?: string };

const { crumb, crumbMenu = false, page, open, phoneCrumb = crumb } = Astro.props;

/** The phone's bottom bar, as the Console draws it below 40rem. */
const BOTTOM = [
  { icon: 'projects', label: 'Projects', on: page === 'projects', count: 0 },
  { icon: 'incidents', label: 'Incidents', on: page === 'incidents', count: COUNTS.incidents },
  { icon: 'errors', label: 'Errors', on: false, count: COUNTS.errors },
  { icon: 'metrics', label: 'Activity', on: false, count: 0 },
  { icon: 'more', label: 'More', on: page === 'uptime' || page === 'security', count: 0 }
] as const;

const SECTIONS = [
  { id: 'organization', label: 'Organization', count: 0, tone: '' },
  {
    id: 'observability',
    label: 'Observability',
    count: COUNTS.errors,
    tone: 'red',
    rows: [
      { icon: 'logs', label: 'Logs' },
      { icon: 'metrics', label: 'Metrics' },
      { icon: 'traces', label: 'Traces' },
      { icon: 'uptime', label: 'Uptime', page: 'uptime' },
      { icon: 'synthetics', label: 'Synthetics' },
      { icon: 'errors', label: 'Error tracking', count: COUNTS.errors, tone: 'red' }
    ]
  },
  {
    id: 'security',
    label: 'Security',
    count: COUNTS.security,
    tone: 'amber',
    rows: [
      { icon: 'shield', label: 'Overview', page: 'security', count: COUNTS.security, tone: 'amber' },
      { icon: 'globe', label: 'Exposure' },
      { icon: 'guardrails', label: 'Guardrails' },
      { icon: 'settings', label: 'Settings' }
    ]
  },
  { id: 'alerting', label: 'Alerting', count: 0, tone: '' },
  { id: 'configuration', label: 'Configuration', count: 0, tone: '' }
] as const;
---

<div class="cx-app">
  <div class="cx-top">
    <img class="cx-logo" src="/brand/logo-wordmark.svg" alt="" width="132" height="32" />
    <span class="cx-crumbs">
      <span class="cx-crumb">{ORG}<Icon name="down" /></span>
      <span class="cx-slash">/</span>
      <span class="cx-crumb">{crumb}{crumbMenu && <Icon name="down" />}</span>
    </span>
    <span class="cx-find"><Icon name="search" />Find<kbd>Ctrl K</kbd></span>
    <span class="cx-btn"><Icon name="plus" />New project</span>
    <span class="cx-help"><Icon name="help" />Help<Icon name="down" /></span>
    <span class="cx-avatar"><i class="brand-round">{USER}</i><Icon name="down" /></span>
    <span class="cx-phone-crumb">{phoneCrumb}</span>
    <Icon name="search" class="cx-phone-search" />
  </div>
  <div class="cx-side">
    <span class:list={['cx-nav', page === 'projects' && 'is-on']}><Icon name="projects" />Projects</span>
    <span class:list={['cx-nav', page === 'incidents' && 'is-on']}
      ><Icon name="incidents" />Incidents<span class="cx-count cx-count--red">{COUNTS.incidents}</span></span
    >
    {
      SECTIONS.map((section) => {
        const expanded = 'rows' in section && section.id === open;
        return (
          <>
            <span class="cx-group">
              {section.label}
              {section.count > 0 && !expanded && (
                <span class={`cx-count cx-count--${section.tone}`}>{section.count}</span>
              )}
              <Icon name={expanded ? 'down' : 'right'} />
            </span>
            {expanded &&
              section.rows.map((row) => (
                <span class:list={['cx-nav', 'page' in row && row.page === page && 'is-on']}>
                  <Icon name={row.icon} />
                  {row.label}
                  {'count' in row && <span class={`cx-count cx-count--${row.tone}`}>{row.count}</span>}
                </span>
              ))}
          </>
        );
      })
    }
    <span class="cx-collapse"><Icon name="collapse" />Collapse</span>
  </div>
  <div class="cx-page">
    <slot />
  </div>
  <div class="cx-bottom">
    {
      BOTTOM.map((item) => (
        <span class:list={['cx-bottom__item', item.on && 'is-on']}>
          <Icon name={item.icon} />
          {item.count > 0 && <span class="cx-count cx-count--red">{item.count}</span>}
          {item.label}
        </span>
      ))
    }
  </div>
</div>
