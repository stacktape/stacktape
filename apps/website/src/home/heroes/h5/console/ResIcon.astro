---
/**
 * A resource's icon: the Console's own `ResourceIcon`, rendered on the server. Its sizes are scaled to the window by
 * the `.cx-res` rules, which repeat the Console's `stp-ui-resource-icon` rules (no square, lines in the category
 * colour) in Console pixels.
 */
import { ResourceIcon } from '@stacktape/ui-react/resource-icon';
import { RESOURCES, type ResourceName } from './data';

type Props = { name: ResourceName };
---

<span class="cx-res"><ResourceIcon resourceType={RESOURCES[Astro.props.name].type} size={20} /></span>
