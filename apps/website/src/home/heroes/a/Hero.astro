---
import { ButtonLink } from '@stacktape/ui-react/button';
import { CommandBox } from '../../../brand/CommandBox';
import '../../../brand/site.css';
import consoleSmall from './shots/console-1440.webp';
import consoleLarge from './shots/console-2880.webp';
import consolePhone from './shots/console-phone.webp';
import reviewSmall from './shots/review-1440.webp';
import reviewLarge from './shots/review-2880.webp';
import reviewPhone from './shots/review-phone.webp';
import scanSmall from './shots/scan-1440.webp';
import scanLarge from './shots/scan-2880.webp';
import scanPhone from './shots/scan-phone.webp';

type Props = {
  subheadline?: string;
};

const {
  subheadline = 'Stacktape reads your repo, then builds and runs its AWS infrastructure the way a senior DevOps team would.'
} = Astro.props;

/**
 * The real product as a stack of three sheets, like the three sheets in the logo. The selected sheet is in front;
 * the others show their edges behind it. Phones get a crop of the part that matters, because the whole window
 * would be too small to read.
 */
const sheets = [
  {
    id: 'reads',
    short: 'Reads',
    rest: ' your repo',
    caption: 'The CLI’s wizard. The coding agent you already use reads the code on your machine; no code goes to Stacktape.',
    alt: 'Stacktape init reading a Next.js project: the file tree on the left, the configuration being written on the right.',
    small: scanSmall,
    large: scanLarge,
    phone: scanPhone
  },
  {
    id: 'designs',
    short: 'Designs',
    rest: ' the setup',
    caption: 'Every resource with its reason and estimated monthly cost. Nothing is created until you confirm.',
    alt: 'The init wizard’s Review step: an architecture diagram, an estimated $32 a month, and the generated stacktape.yml.',
    small: reviewSmall,
    large: reviewLarge,
    phone: reviewPhone
  },
  {
    id: 'runs',
    short: 'Runs it',
    rest: ' in your AWS account',
    caption: 'The Console: every stage, deploy and resource of the app, running in your AWS account.',
    alt: 'The Stacktape Console showing the storefront project’s staging stage as an architecture diagram.',
    small: consoleSmall,
    large: consoleLarge,
    phone: consolePhone
  }
];
const selected = 'designs';
const depths = [selected, ...sheets.map((sheet) => sheet.id).filter((sheetId) => sheetId !== selected)];
---

<section class="hero" aria-labelledby="hero-a-title">
  <div class="site-frame top">
    <div class="copy">
      <h1 id="hero-a-title"><span>AWS DevOps,</span> <span>fully automated.</span></h1>
      <p class="lead">{subheadline}</p>
    </div>
    <div class="action">
      <CommandBox client:load id="install" label="Get started" preselect={false} />
      <div class="next">
        <ButtonLink variant="secondary" className="brand-button" href="https://docs.stacktape.com">
          Read the docs
        </ButtonLink>
        <p class="own">
          Runs in your AWS account as standard CloudFormation. Stop using Stacktape and your app keeps running.
        </p>
      </div>
    </div>
  </div>

  <div class="site-frame product" data-hero-a>
    <div class="bar">
      <div class="tabs" role="tablist" aria-label="What Stacktape does">
        {
          sheets.map((sheet, index) => (
            <button
              class="tab"
              type="button"
              role="tab"
              id={`see-${sheet.id}`}
              aria-controls={`sheet-${sheet.id}`}
              aria-selected={sheet.id === selected ? 'true' : 'false'}
              tabindex={sheet.id === selected ? 0 : -1}
              data-sheet={sheet.id}
            >
              <span class="num" aria-hidden="true">
                {index + 1}
              </span>
              <span>
                {sheet.short}
                <span class="rest">{sheet.rest}</span>
              </span>
            </button>
          ))
        }
      </div>
      {
        sheets.map((sheet) => (
          <p class="caption" data-caption={sheet.id} hidden={sheet.id !== selected}>
            {sheet.caption}
          </p>
        ))
      }
    </div>

    <div class="stack">
      {
        sheets.map((sheet) => (
          <picture
            class="sheet"
            id={`sheet-${sheet.id}`}
            role="tabpanel"
            aria-labelledby={`see-${sheet.id}`}
            aria-hidden={sheet.id === selected ? undefined : 'true'}
            data-sheet={sheet.id}
            data-depth={depths.indexOf(sheet.id)}
          >
            <source media="(max-width: 40rem)" srcset={sheet.phone.src} width={sheet.phone.width} height={sheet.phone.height} />
            <img
              src={sheet.small.src}
              srcset={`${sheet.small.src} 1440w, ${sheet.large.src} 2880w`}
              sizes="(min-width: 95rem) 88rem, 92vw"
              width={sheet.small.width}
              height={sheet.small.height}
              alt={sheet.alt}
              fetchpriority={sheet.id === selected ? 'high' : 'auto'}
              decoding="async"
            />
          </picture>
        ))
      }
    </div>
  </div>
</section>

<script>
  /* The selected sheet moves to the front; the others keep their order behind it. A link to a tab's id selects it. */
  for (const root of document.querySelectorAll<HTMLElement>('[data-hero-a]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const sheets = Array.from(root.querySelectorAll<HTMLElement>('.sheet'));
    const select = (id: string, focus = false) => {
      const order = sheets.toSorted((a, b) => Number(a.dataset.depth) - Number(b.dataset.depth)).map((s) => s.dataset.sheet);
      const next = [id, ...order.filter((other) => other !== id)];
      for (const sheet of sheets) {
        sheet.dataset.depth = String(next.indexOf(sheet.dataset.sheet));
        if (sheet.dataset.sheet === id) sheet.removeAttribute('aria-hidden');
        else sheet.setAttribute('aria-hidden', 'true');
      }
      for (const caption of root.querySelectorAll<HTMLElement>('[data-caption]')) caption.hidden = caption.dataset.caption !== id;
      for (const tab of tabs) {
        const active = tab.dataset.sheet === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      }
    };
    const linked = tabs.find((tab) => `#${tab.id}` === window.location.hash);
    if (linked?.dataset.sheet) select(linked.dataset.sheet);
    root.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>('[data-sheet]');
      if (!target?.dataset.sheet || target.dataset.depth === '0') return;
      select(target.dataset.sheet);
      history.replaceState(null, '', `#see-${target.dataset.sheet}`);
    });
    root.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      const step = key === 'ArrowRight' ? 1 : key === 'ArrowLeft' ? -1 : 0;
      const current = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      const next = tabs[(current + step + tabs.length) % tabs.length]?.dataset.sheet;
      if (step && next) select(next, true);
    });
  }
</script>

<style>
  .hero {
    padding-block-start: clamp(var(--brand-space-7), 6vw, 6.5rem);
  }

  /* The headline keeps its two lines; the command box takes the rest of the row, up to 38 rem. */
  .top {
    display: grid;
    grid-template-columns: auto minmax(0, 38rem);
    justify-content: space-between;
    align-items: end;
    gap: var(--brand-space-6) var(--brand-space-7);
  }

  h1 {
    font: var(--brand-weight-heading) var(--brand-type-display) / var(--brand-leading-heading)
      var(--brand-font-heading);
    letter-spacing: var(--brand-tracking-heading);
  }

  h1 span {
    display: block;
    white-space: nowrap;
  }

  .lead {
    max-inline-size: 36rem;
    margin-block-start: var(--brand-space-5);
    color: var(--brand-muted);
    font-size: 1.25rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .action {
    display: grid;
    gap: var(--brand-space-3);
  }

  .next {
    display: flex;
    align-items: center;
    gap: var(--brand-space-4);
  }

  .next :global(.brand-button) {
    flex: none;
  }

  .own {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    line-height: 1.45;
  }

  .product {
    margin-block-start: clamp(var(--brand-space-7), 5vw, 4.5rem);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--brand-space-3) var(--brand-space-6);
    margin-block-end: var(--brand-space-3);
  }

  .tabs {
    display: flex;
    gap: var(--brand-space-2);
  }

  /* A tape tab: plain text until selected, then teal tape behind the label. */
  .tab {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--brand-space-2);
    padding: 0.45em 0.95em;
    border: 0;
    background: none;
    color: var(--brand-muted);
    font: var(--brand-weight-label) var(--brand-type-sm) / 1.2 var(--brand-font-body);
    cursor: pointer;
  }

  .tab::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: '';
    clip-path: var(--brand-tape-clip);
  }

  .tab:hover {
    color: var(--brand-text);
  }

  .tab[aria-selected='true'] {
    color: var(--brand-on-teal);
  }

  .tab[aria-selected='true']::before {
    background: var(--brand-primary);
    box-shadow: var(--brand-edge-primary);
  }

  .num {
    font-family: var(--brand-font-mono);
    font-size: var(--brand-type-xs);
    opacity: 0.7;
  }

  .caption {
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
  }

  /* Each sheet behind the front one sits one offset up and to the right, and darker. */
  .stack {
    --offset: clamp(0.625rem, 1.2vw, 1.75rem);
    display: grid;
    padding-block-start: calc(2 * var(--offset));
    padding-inline-end: calc(2 * var(--offset));
  }

  .sheet {
    grid-area: 1 / 1;
    display: block;
    overflow: hidden;
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-inset);
    box-shadow: var(--brand-shadow-menu);
    transition:
      transform 220ms ease,
      filter 220ms ease;
  }

  .sheet img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .sheet[data-depth='0'] {
    z-index: 3;
  }

  .sheet[data-depth='1'] {
    z-index: 2;
    transform: translate(var(--offset), calc(-1 * var(--offset)));
    filter: brightness(0.7);
    cursor: pointer;
  }

  .sheet[data-depth='2'] {
    z-index: 1;
    transform: translate(calc(2 * var(--offset)), calc(-2 * var(--offset)));
    filter: brightness(0.5);
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition: none;
    }
  }

  @media (max-width: 64rem) {
    .top {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .action {
      max-inline-size: 40rem;
    }
  }

  /*
   * Phones: the product follows the command box, so a readable crop is on the first screen.
   * The docs link and the ownership line move under it.
   */
  @media (max-width: 40rem) {
    .hero {
      display: flex;
      flex-direction: column;
      gap: var(--brand-space-5);
      padding-block-start: var(--brand-space-6);
    }

    .top {
      display: contents;
    }

    .copy,
    .action :global(.brand-command),
    .next {
      inline-size: min(var(--site-width, 76rem), calc(100% - 2 * var(--site-gutter, var(--brand-space-4))));
      margin-inline: auto;
    }

    .action {
      display: contents;
    }

    .action :global(.brand-command) {
      order: 1;
    }

    .product {
      display: flex;
      flex-direction: column;
      gap: var(--brand-space-3);
      order: 2;
      margin-block-start: 0;
    }

    .bar {
      display: contents;
    }

    .stack {
      order: 1;
    }

    .caption {
      order: 2;
    }

    .next {
      flex-direction: column;
      align-items: flex-start;
      order: 3;
    }

    .lead {
      margin-block-start: var(--brand-space-4);
      font-size: var(--brand-type-base);
    }

    .rest {
      display: none;
    }
  }
</style>
