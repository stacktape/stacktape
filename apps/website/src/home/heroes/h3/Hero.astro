---
import { ButtonLink } from '@stacktape/ui-react/button';
import { runReadme } from '../../../variants/readme/benchmarks';
import { CommandBox } from '../../../brand/CommandBox';
import './font.css';
import { VIEWS } from './views';

type Props = { subheadline?: string };

const {
  subheadline = 'Stacktape reads your repo, designs the AWS setup, then deploys, monitors and secures it in your own AWS account.'
} = Astro.props;

/** Every picture in `images/`, by file name. Plain files the build copies, so no image service is needed. */
const files = import.meta.glob<string>('./images/*', { eager: true, query: '?url', import: 'default' });
const image = (name: string) => {
  const url = files[`./images/${name}`];
  if (!url) throw new Error(`The H3 hero has no image named ${name}.`);
  return url;
};

const sky = `--h3-sky-wide: url(${image('sky-3200.webp')}); --h3-sky: url(${image('sky-2400.webp')}); --h3-sky-small: url(${image('sky-1400.webp')}); --h3-sky-phone: url(${image('sky-phone.webp')})`;

const proof = [
  { figure: 'MIT', text: 'Open-source CLI. Works without a Stacktape account.', href: 'https://github.com/stacktape/stacktape' },
  {
    figure: '10.7 s',
    text: 'A Lambda change, live. CDK hotswap: 13.2 s. Preliminary run, 22 Oct 2026.',
    href: runReadme('2026-10-22')
  },
  {
    figure: '$0',
    text: 'Stacktape fee while the stacks it manages spend up to $200 a month on AWS.',
    href: '/pricing'
  }
];
---

<section class="atmo" aria-labelledby="h3-title" style={sky}>
  <div class="atmo__copy">
    <h1 id="h3-title" class="h3-display atmo__title">AWS DevOps, fully automated.</h1>
    <p class="atmo__lead">{subheadline}</p>
    <div class="atmo__start">
      <CommandBox client:load id="install" preselect={false} />
      <ButtonLink variant="secondary" className="brand-button atmo__docs" href="https://docs.stacktape.com"
        >Read the docs</ButtonLink
      >
    </div>
    <p class="atmo__own">
      Runs in your AWS account on standard CloudFormation. Stop using Stacktape and your app keeps running.
    </p>
  </div>

  <div class="atmo__stage" data-h3-views>
    <div class="atmo__window">
      {
        VIEWS.map((view, index) => (
          <picture id={`screen-${view.key}`} role="tabpanel" aria-labelledby={`see-${view.key}`} hidden={index > 0}>
            <source media="(max-width: 40rem)" srcset={image(`${view.key}-phone.webp`)} width="960" height="600" />
            <img
              src={image(`${view.key}-1280.webp`)}
              srcset={`${image(`${view.key}-1280.webp`)} 1280w, ${image(`${view.key}-2560.webp`)} 2560w`}
              sizes="(min-width: 90rem) 62rem, 88vw"
              width="2560"
              height="1369"
              alt={view.alt}
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              decoding="async"
            />
          </picture>
        ))
      }
      <span class="atmo__tape atmo__tape--left" aria-hidden="true"></span>
      <span class="atmo__tape atmo__tape--right" aria-hidden="true"></span>
    </div>
    <div class="atmo__tabs" role="tablist" aria-label="What Stacktape runs for you">
      {
        VIEWS.map((view, index) => (
          <button
            type="button"
            role="tab"
            id={`see-${view.key}`}
            aria-controls={`screen-${view.key}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
          >
            {view.label}
          </button>
        ))
      }
    </div>
  </div>

  <ul class="atmo__proof" aria-label="Customers and facts" data-hero-trust>
    <li class="atmo__logo">
      <img src={image('receipts.svg')} alt="Receipts" width="214" height="42" class="atmo__receipts" />
    </li>
    <li class="atmo__logo">
      <img src={image('lastmyle.webp')} alt="Lastmyle" width="200" height="45" />
    </li>
    {
      proof.map((item) => (
        <li>
          <a href={item.href}>
            <strong class="h3-display">{item.figure}</strong>
            <span>{item.text}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  import './switch-views';
</script>

<style>
  .atmo {
    --h3-serif: 'H3 Newsreader', Georgia, 'Times New Roman', serif;
    --h3-ink: color-mix(in srgb, var(--brand-text), transparent 14%);
    --h3-line: rgb(255 255 255 / 9%);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-block-end: 1px solid var(--h3-line);
    background: image-set(var(--h3-sky-small) 1x, var(--h3-sky) 2x) center bottom / cover no-repeat var(--brand-inset);
  }

  @media (min-width: 72rem) {
    .atmo {
      background-image: var(--h3-sky);
    }
  }

  /* The sky runs edge to edge; on wide screens a wider painting keeps the mesas beside the window. */
  @media (min-width: 110rem) {
    .atmo {
      background-image: var(--h3-sky-wide);
    }
  }

  .h3-display {
    margin: 0;
    font-family: var(--h3-serif);
    font-weight: 500;
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.022em;
    line-height: 1.02;
    text-wrap: balance;
  }

  /* A soft shade behind the words, so the sky's brush strokes never cross the headline at full strength. */
  .atmo::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: '';
    background: radial-gradient(ellipse 46% 26% at 50% 15%, rgb(9 16 16 / 50%), transparent 100%);
    pointer-events: none;
  }

  .atmo__copy {
    display: grid;
    justify-items: center;
    padding: clamp(3rem, 3.3vw, 3.75rem) var(--brand-space-5) 0;
    text-align: center;
  }

  .atmo__title {
    font-size: clamp(2.6rem, 1.3rem + 4vw, 6rem);
    text-shadow: 0 2px 30px rgb(8 14 14 / 45%);
  }

  .atmo__lead {
    max-inline-size: min(76rem, 44rem + 20vw);
    margin: clamp(0.9rem, 1.2vw, 1.4rem) 0 0;
    color: var(--h3-ink);
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.35rem);
    line-height: 1.5;
    text-wrap: balance;
  }

  .atmo__start {
    display: flex;
    align-items: center;
    gap: var(--brand-space-4);
    margin-block-start: clamp(1.75rem, 2.2vw, 2.5rem);
    text-align: start;
  }

  .atmo__start :global(.brand-command) {
    inline-size: 36rem;
    box-shadow: 0 18px 48px rgb(4 9 9 / 55%);
  }

  .atmo__start :global(.atmo__docs) {
    flex: none;
  }

  .atmo__own {
    margin: var(--brand-space-4) 0 0;
    color: var(--h3-ink);
    font-size: var(--brand-type-sm);
  }

  /* The product window, taped onto the sky. */
  .atmo__stage {
    position: relative;
    inline-size: min(62rem, 100% - 2 * clamp(1.5rem, 7vw, 8rem));
    margin: clamp(2.75rem, 3vw, 3.25rem) auto 0;
  }

  .atmo__window {
    position: relative;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: var(--brand-radius);
    background: var(--brand-page);
    box-shadow:
      0 2px 0 rgb(255 255 255 / 4%) inset,
      0 40px 90px rgb(3 8 8 / 60%),
      0 10px 24px rgb(3 8 8 / 35%);
  }

  .atmo__window picture,
  .atmo__window img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: inherit;
  }

  .atmo__window picture[hidden] {
    display: none;
  }

  /* Matte teal tape over two corners. The teeth are the logo label's, sized by the strip's font size. */
  .atmo__tape {
    position: absolute;
    z-index: 2;
    inset-block-start: 0;
    inline-size: clamp(3.75rem, 6vw, 7.25rem);
    block-size: clamp(1.45rem, 2vw, 2.35rem);
    font-size: clamp(0.95rem, 1.3vw, 1.45rem);
    filter: drop-shadow(0 0.4rem 0.55rem rgb(0 0 0 / 38%));
  }

  .atmo__tape::before {
    position: absolute;
    inset: 0;
    content: '';
    clip-path: var(--brand-tape-clip);
    background:
      linear-gradient(90deg, rgb(255 255 255 / 7%), transparent 35%, transparent 70%, rgb(0 0 0 / 10%)),
      var(--brand-primary);
    box-shadow: var(--brand-edge-primary);
  }

  .atmo__tape--left {
    inset-inline-start: 0;
    transform: translate(-66%, -12%) rotate(-33deg);
  }

  .atmo__tape--right {
    inset-inline-end: 0;
    transform: translate(62%, -16%) rotate(39deg);
  }

  .atmo__tabs {
    position: absolute;
    z-index: 3;
    inset-block-end: 0;
    inset-inline-start: 50%;
    display: flex;
    gap: var(--brand-space-1);
    padding: 0.3rem;
    border: 1px solid var(--h3-line);
    border-radius: var(--brand-radius);
    background: color-mix(in srgb, var(--brand-inset), transparent 6%);
    box-shadow: var(--brand-shadow-menu);
    transform: translate(-50%, 50%);
  }

  .atmo__tabs button {
    position: relative;
    isolation: isolate;
    flex: none;
    padding: 0.55rem 1rem;
    border: 0;
    background: none;
    color: var(--brand-muted);
    font: var(--brand-weight-label) var(--brand-type-sm) / 1.2 var(--brand-font-body);
    cursor: pointer;
  }

  .atmo__tabs button:hover {
    color: var(--brand-text);
  }

  .atmo__tabs button[aria-selected='true'] {
    color: var(--brand-on-teal);
  }

  .atmo__tabs button[aria-selected='true']::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: '';
    clip-path: var(--brand-tape-clip);
    background: var(--brand-primary);
    box-shadow: var(--brand-edge-primary);
  }

  .atmo__tabs button:focus-visible {
    outline: 2px solid var(--brand-focus);
    outline-offset: 1px;
  }

  /* The trust row is the panel's bottom edge, over the darkest ground of the picture. */
  .atmo__proof {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: clamp(3.25rem, 3.6vw, 3.75rem) 0 0;
    padding: 0 max(0rem, (100% - 110rem) / 2);
    border-block-start: 1px solid var(--h3-line);
    background: linear-gradient(rgb(12 19 19 / 30%), rgb(12 19 19 / 70%));
    list-style: none;
  }

  .atmo__proof li {
    display: grid;
    min-block-size: 5.25rem;
    border-inline-start: 1px solid var(--h3-line);
  }

  .atmo__proof li:first-child {
    border-inline-start: 0;
  }

  .atmo__logo {
    place-items: center;
  }

  .atmo__logo img {
    inline-size: auto;
    block-size: 1.75rem;
    max-inline-size: 70%;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.78;
  }

  .atmo__logo .atmo__receipts {
    block-size: 1.4rem;
  }

  .atmo__proof a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--brand-space-4);
    padding: var(--brand-space-4);
    color: inherit;
    text-decoration: none;
  }

  .atmo__proof a:hover strong {
    color: var(--brand-teal);
  }

  .atmo__proof strong {
    flex: none;
    font-size: clamp(1.6rem, 1.2rem + 0.9vw, 2.25rem);
  }

  .atmo__proof span {
    max-inline-size: 14rem;
    color: var(--brand-muted);
    font-size: var(--brand-type-xs);
    line-height: 1.45;
  }

  @media (max-width: 64rem) {
    .atmo__start {
      flex-direction: column;
      align-items: stretch;
      inline-size: min(36rem, 100%);
    }

    .atmo__start :global(.brand-command) {
      inline-size: 100%;
    }

    .atmo__start :global(.atmo__docs) {
      align-self: center;
    }

    .atmo__proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .atmo__proof li:nth-child(odd) {
      border-inline-start: 0;
    }

    .atmo__proof li {
      border-block-start: 1px solid var(--h3-line);
      min-block-size: 6rem;
    }

    .atmo__proof li:nth-child(-n + 2) {
      border-block-start: 0;
    }

    .atmo__proof li:last-child {
      grid-column: 1 / -1;
      border-inline-start: 0;
    }
  }

  @media (max-width: 40rem) {
    .atmo {
      background-image: var(--h3-sky-phone);
    }

    .atmo__copy {
      padding: var(--brand-space-6) var(--brand-space-4) 0;
    }

    .atmo__start {
      margin-block-start: var(--brand-space-5);
    }

    /*
     * The kit's box gives Copy its own row on narrow screens and keeps room for a third line. On the phone hero,
     * Copy sits beside the command instead, and the box is only as tall as its lines.
     */
    .atmo__start :global(.brand-command) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .atmo__start :global(.brand-command)::before {
      grid-area: 1 / 1 / 3 / -1;
      content: '';
      border-block-end: 1px solid var(--brand-border);
      border-start-start-radius: inherit;
      border-start-end-radius: inherit;
      background: var(--brand-surface);
    }

    .atmo__start :global(.brand-command .install-code__head) {
      display: contents;
    }

    .atmo__start :global(.brand-command .install-code__tabs) {
      grid-area: 1 / 1 / 2 / -1;
      padding: var(--brand-space-2);
    }

    .atmo__start :global(.brand-command .install-code__arch) {
      grid-area: 2 / 1 / 3 / 2;
      justify-self: start;
      margin: 0 var(--brand-space-2) var(--brand-space-2);
    }

    .atmo__start :global(.brand-command .install-code__copy) {
      --stp-control-height: 2rem;
      z-index: 1;
      grid-area: 3 / 2 / 4 / 3;
      align-self: start;
      margin: 0.6rem var(--brand-space-2) 0 0;
    }

    /* The lines use the full width; only the first one leaves room for Copy. */
    .atmo__start :global(.brand-command .install-code__pre) {
      grid-area: 3 / 1 / 4 / -1;
      grid-template-columns: minmax(0, 1fr);
      min-block-size: 0;
    }

    .atmo__start :global(.brand-command .install-code__line:first-child) {
      max-inline-size: calc(100% - 6.75rem);
    }

    /* With an architecture row (the installer tabs), Copy moves there and the long command scrolls. */
    .atmo__start :global(.brand-command:has(.install-code__arch) .install-code__copy) {
      grid-area: 2 / 2 / 3 / 3;
      align-self: center;
      margin: 0 var(--brand-space-2) var(--brand-space-2) 0;
    }

    .atmo__start :global(.brand-command:has(.install-code__arch) .install-code__line:first-child) {
      inline-size: max-content;
      max-inline-size: none;
    }

    .atmo__start :global(.brand-command:has(.install-code__arch) .install-code__line:first-child .install-code__cmd) {
      overflow: visible;
    }

    /* Without one (npx), the short command shares its line with Copy. */
    .atmo__start :global(.brand-command .install-code__line:first-child .install-code__cmd) {
      min-inline-size: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .atmo__lead {
      text-wrap: pretty;
    }

    .atmo__stage {
      inline-size: calc(100% - 2.5rem);
      margin-block-start: var(--brand-space-7);
    }

    .atmo__tape {
      inline-size: 3.25rem;
      block-size: 1.2rem;
      font-size: 0.8rem;
    }

    .atmo__tape--left {
      transform: translate(-38%, -30%) rotate(-33deg);
    }

    .atmo__tape--right {
      transform: translate(36%, -34%) rotate(39deg);
    }

    .atmo__tabs {
      position: static;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-block-start: var(--brand-space-5);
      transform: none;
    }

    .atmo__tabs button {
      padding: 0.55rem 0.25rem;
      font-size: var(--brand-type-xs);
    }

    .atmo__proof {
      margin-block-start: var(--brand-space-7);
    }

    .atmo__proof a {
      flex-direction: column;
      gap: var(--brand-space-1);
      text-align: center;
    }
  }
</style>
