---
import type { ImageMetadata } from 'astro';

type Pair = { small: ImageMetadata; large: ImageMetadata };

/**
 * A product screenshot at two widths: the 1× file and the 2× capture. Plain <img>, so the build needs no Sharp.
 * `phone` swaps in a tighter crop on narrow screens, where the whole window would be too small to read.
 */
type Props = Pair & {
  alt: string;
  sizes: string;
  phone?: Pair;
  class?: string;
  eager?: boolean;
};

const { small, large, phone, alt, sizes, class: className, eager = false } = Astro.props;
const srcset = (pair: Pair) => `${pair.small.src} ${pair.small.width}w, ${pair.large.src} ${pair.large.width}w`;
---

<picture class="b-shot">
  {phone ? <source media="(max-width: 40rem)" srcset={srcset(phone)} sizes="94vw" /> : null}
  <img
    class={className}
    src={small.src}
    srcset={srcset({ small, large })}
    {sizes}
    width={small.width}
    height={small.height}
    {alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
</picture>

<style>
  .b-shot {
    display: block;
  }
</style>
