---
import { ButtonLink } from '@stacktape/ui-react/button';
import { CommandBox } from '../../../brand/CommandBox';
import Logo from '../../../brand/Logo.astro';
import Tape from '../../../brand/Tape.astro';
import '../../../brand/site.css';
import { lit, rows } from './flow';
import Glyph from './Glyph.astro';

type Props = {
  subheadline?: string;
};

const {
  subheadline = 'Stacktape reads your repository, designs the infrastructure like a senior DevOps team would, deploys it to your own AWS account and makes sure your app runs flawlessly forever after. It keeps you in the loop for any decision that requires human attention.'
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-h6-title">
  <div class="site-frame intro">
    <h1 id="hero-h6-title"><span class="line">AWS DevOps,</span> <span class="line">fully automated.</span></h1>
    <p class="lead">{subheadline}</p>
    <div class="start">
      <CommandBox client:load id="install" label="Get started" preselect={false} />
      <div class="docs">
        <ButtonLink href="https://docs.stacktape.com" className="brand-button" variant="secondary">Read the docs</ButtonLink>
        <p>Runs in your AWS account as standard CloudFormation. Stop using Stacktape and your app keeps running.</p>
      </div>
    </div>
  </div>

  <figure class="site-frame diagram" data-hero-h6 data-lit={lit}>
    <figcaption class="sr-only">
      How Stacktape works: it reads the files in your repository, writes a stacktape.yml with one resource for each
      part of your app, and deploys those resources as AWS services in your account. The Console then collects
      metrics and errors and alerts you in Slack.
    </figcaption>
    <div class="flow">
      <div class="panel repo">
        <div class="head">
          <strong>Your repository</strong>
          <span class="sub"><Glyph name="branch" /> acme-shop · main</span>
        </div>
        {
          rows.map((row) => (
            <div class:list={['cell', { 'is-on': row.id === lit }]} data-row={row.id}>
              <Glyph name="file" />
              <span class="text">
                <code>{row.file}</code>
                <span class="note">{row.found}</span>
              </span>
            </div>
          ))
        }
        <div class="foot added">
          <Glyph name="file" />
          <span class="text">
            <code>stacktape.yml</code>
            <span class="note">added by Stacktape</span>
          </span>
        </div>
      </div>

      <div class="gutter g1" aria-hidden="true">
        <div class="step"><Tape variant="marker">stacktape init</Tape></div>
        {rows.map((row) => <span class:list={['link', { 'is-on': row.id === lit }]} data-row={row.id} />)}
        <div class="link link--back"><Tape tone="gray" variant="count">writes</Tape></div>
      </div>

      <div class="panel cli">
        <div class="head">
          <strong><Logo variant="icon" width={22} alt="" /> Stacktape CLI</strong>
          <span class="sub"><Glyph name="file" /> stacktape.yml</span>
        </div>
        {
          rows.map((row) => (
            <div class:list={['cell', { 'is-on': row.id === lit }]} data-row={row.id}>
              <span class="yml">
                {row.resources.map(([name, type]) => (
                  <code>
                    <span class="key">{name}:</span>
                    <span class="pair">
                      <span class="prop">type:</span> <span class="value">{type}</span>
                    </span>
                  </code>
                ))}
              </span>
            </div>
          ))
        }
        <div class="foot">
          <span class="note">YAML or TypeScript, committed to your repo</span>
        </div>
      </div>

      <div class="gutter g2" aria-hidden="true">
        <div class="step"><Tape variant="marker">stacktape deploy</Tape></div>
        {rows.map((row) => <span class:list={['link', { 'is-on': row.id === lit }]} data-row={row.id} />)}
        <span />
      </div>

      <div class="panel aws">
        <div class="head">
          <strong>Your AWS account</strong>
          <span class="sub">production · eu-west-1</span>
        </div>
        {
          rows.map((row) => (
            <div class:list={['cell', { 'is-on': row.id === lit }]} data-row={row.id}>
              <span class="icons">
                {row.icons.map(([glyph, category]) => (
                  <span class="tile" style={`--category: var(--stp-aws-category-${category})`}>
                    <Glyph name={glyph} />
                  </span>
                ))}
              </span>
              <span class="text">
                <span class="service">{row.service}</span>
                <span class="note">{row.role}</span>
              </span>
            </div>
          ))
        }
        <div class="foot">
          <span class="note">+ VPC, IAM roles, security groups, log groups</span>
        </div>
      </div>

      <div class="ret" aria-hidden="true">
        <div class="step"><Tape>metrics, errors</Tape></div>
      </div>

      <div class="card console">
        <Glyph name="console" />
        <span class="text">
          <strong>Stacktape Console</strong>
          <span class="note">Deploys, logs, metrics and errors</span>
        </span>
      </div>

      <div class="link link--back g3" aria-hidden="true"><div class="step"><Tape>alerts you</Tape></div></div>

      <div class="card alert">
        <Glyph name="bell" />
        <span class="text">
          <strong>Alert in Slack</strong>
          <span class="note">api: error rate above 1% in production</span>
        </span>
      </div>
    </div>
  </figure>
</section>

<script>
  /*
   * One part of the app is lit across all three panels from the start. Pointing at another part lights its file,
   * its stacktape.yml lines and its AWS service instead; leaving the diagram goes back to the first.
   */
  for (const root of document.querySelectorAll<HTMLElement>('[data-hero-h6]')) {
    const parts = Array.from(root.querySelectorAll<HTMLElement>('[data-row]'));
    const light = (id: string | undefined) => {
      for (const part of parts) part.classList.toggle('is-on', part.dataset.row === id);
    };
    root.addEventListener('pointerover', (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>('[data-row]')?.dataset.row;
      if (row) light(row);
    });
    root.addEventListener('pointerleave', () => light(root.dataset.lit));
  }
</script>

<style>
  .hero {
    --line: color-mix(in srgb, var(--brand-teal) 34%, var(--brand-border));
    --on: color-mix(in srgb, var(--brand-teal) 12%, transparent);
    padding-block: clamp(var(--brand-space-6), 3.6vw, 5rem) clamp(var(--brand-space-7), 4vw, 4.5rem);
  }

  /* Headline over subheadline on the left; the command box on the right, level with the subheadline's last line. */
  .intro {
    display: grid;
    grid-template:
      'title start' auto
      'lead start' auto / minmax(0, 1fr) minmax(0, 36rem);
    column-gap: var(--brand-space-8);
    align-items: end;
  }

  h1 {
    grid-area: title;
    font-family: var(--brand-font-heading);
    font-size: var(--brand-type-display);
    font-weight: var(--brand-weight-heading);
    line-height: var(--brand-leading-heading);
    letter-spacing: var(--brand-tracking-heading);
  }

  .line {
    white-space: nowrap;
    display: block;
  }

  .lead {
    grid-area: lead;
    margin-block-start: var(--brand-space-5);
    max-inline-size: 38rem;
    font-size: var(--brand-type-lead);
    line-height: 1.55;
    color: var(--brand-muted);
  }

  .start {
    grid-area: start;
    display: flex;
    flex-direction: column;
    gap: var(--brand-space-3);
  }

  .docs {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--brand-space-4);
    align-items: center;
    color: var(--brand-muted);
    font-size: var(--brand-type-sm);
    line-height: 1.45;
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The diagram. */
  .diagram {
    margin-block-start: clamp(var(--brand-space-6), 3.2vw, 4rem);
  }

  /* The diagram's type grows a little on wide screens; everything inside is sized in em from here. */
  .flow {
    --gutter: clamp(8.75rem, 4rem + 6vw, 9.5rem);
    --loop-gap: var(--brand-space-6);
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) var(--gutter) minmax(0, 1.12fr)
      var(--gutter) minmax(0, 1fr);
    grid-template-rows: repeat(7, auto) auto;
    font-size: clamp(0.8125rem, 0.62rem + 0.22vw, 0.9375rem);
  }

  .panel,
  .gutter {
    display: grid;
    grid-row: 1 / 8;
    grid-template-rows: subgrid;
  }

  .panel {
    overflow: hidden;
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-surface);
    box-shadow: var(--brand-shadow), var(--brand-edge);
  }

  .repo {
    grid-column: 1;
  }

  .g1 {
    grid-column: 2;
  }

  .cli {
    grid-column: 3;
  }

  .g2 {
    grid-column: 4;
  }

  .aws {
    grid-column: 5;
  }

  /* The parts that are Stacktape (the CLI's config and the Console) get a teal edge; the rest is yours. */
  .cli,
  .console {
    border-color: color-mix(in srgb, var(--brand-teal) 40%, var(--brand-border));
  }

  .head {
    display: grid;
    gap: 0.2em;
    padding: 1.15em 1.15em 0.85em;
    border-block-end: 1px solid var(--brand-border);
    background: var(--brand-inset);
  }

  .head strong {
    display: flex;
    align-items: center;
    gap: var(--brand-space-2);
    font: var(--brand-weight-label) 1.2em / 1.3 var(--brand-font-heading);
  }

  .head strong :global(img) {
    margin-inline: -0.2rem -0.1rem;
  }

  .sub {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--brand-muted);
    font: 0.88em / 1.4 var(--brand-font-mono);
  }

  .sub :global(.glyph) {
    inline-size: 0.9rem;
    block-size: 0.9rem;
  }

  .cell,
  .foot {
    display: flex;
    align-items: center;
    gap: 0.85em;
    min-block-size: 3.75em;
    padding: 0.55em 1.15em;
    transition: background-color 160ms ease;
  }

  .cell + .cell {
    border-block-start: 1px solid color-mix(in srgb, var(--brand-border) 60%, transparent);
  }

  .foot {
    border-block-start: 1px solid var(--brand-border);
    background: var(--brand-inset);
  }

  .cell.is-on {
    background: var(--on);
  }

  .cell > :global(.glyph),
  .foot > :global(.glyph),
  .card > :global(.glyph) {
    inline-size: 1.35em;
    block-size: 1.35em;
  }

  .cell :global(.glyph) {
    color: var(--brand-muted);
  }

  .cell.is-on > :global(.glyph) {
    color: var(--brand-teal);
  }

  .text {
    display: grid;
    min-inline-size: 0;
    gap: 0.1rem;
  }

  code {
    font-family: var(--brand-font-mono);
    font-size: 1em;
    line-height: 1.45;
  }

  .repo code {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .note {
    color: var(--brand-muted);
    font-size: 0.92em;
    line-height: 1.4;
  }

  .added code,
  .added :global(.glyph) {
    color: var(--brand-teal);
  }

  .yml {
    display: grid;
    gap: 0.4em;
  }

  .yml code,
  .pair {
    display: block;
  }

  .pair {
    padding-inline-start: 2ch;
  }

  .key {
    color: var(--brand-text);
  }

  .prop {
    color: var(--brand-muted);
  }

  .value {
    color: var(--brand-teal);
  }

  .icons {
    display: flex;
    gap: 0.3em;
    inline-size: 4.1em;
  }

  /* An AWS service tile: the glyph in its AWS category colour on a tint of the same colour. */
  .tile {
    display: grid;
    place-items: center;
    inline-size: 1.9em;
    block-size: 1.9em;
    border-radius: var(--brand-radius-small);
    background: color-mix(in srgb, var(--category) 16%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--category) 32%, transparent);
    color: var(--category);
  }

  .tile :global(.glyph) {
    inline-size: 1.2em;
    block-size: 1.2em;
    color: inherit;
  }

  .service {
    font-weight: var(--brand-weight-label);
    font-size: 1.06em;
    line-height: 1.35;
  }

  /* Gutters: the step label level with the panel heads, one arrow per part of the app. */
  .step {
    display: grid;
    place-items: center;
  }

  .link {
    position: relative;
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 0 50%, var(--line) 0 3px, transparent 3.5px);
  }

  .link--back {
    background-position: 100% 0;
    background-image: radial-gradient(circle at 100% 50%, var(--line) 0 3px, transparent 3.5px);
  }

  .link::before,
  .link::after,
  .ret::before,
  .ret::after {
    position: absolute;
    content: '';
  }

  .link::before {
    inset-inline: 0 0.3rem;
    inset-block-start: 50%;
    border-block-start: 1.5px solid var(--line);
  }

  .link::after {
    inset-inline-end: 0;
    inset-block-start: calc(50% - 0.25rem + 0.75px);
    inline-size: 0.45rem;
    block-size: 0.5rem;
    background: var(--line);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .link--back::before {
    inset-inline: 0.3rem 0;
  }

  .link--back::after {
    inset-inline: 0 auto;
    clip-path: polygon(100% 0, 0 50%, 100% 100%);
  }

  .link :global(.tape) {
    position: relative;
    z-index: 1;
  }

  /* Every step label is the size of the command labels, so the loop's labels do not outrank init and deploy. */
  .step :global(.tape) {
    font-size: var(--brand-type-xs);
  }

  .link.is-on {
    --line: var(--brand-teal);
  }

  /* The loop back: the AWS account reports to the Console, the Console alerts you. */
  .ret,
  .card,
  .g3 {
    grid-row: 8;
  }

  .card,
  .g3 {
    margin-block-start: var(--loop-gap);
  }

  .card {
    display: flex;
    align-items: center;
    gap: 0.85em;
    padding: 0.85em 1.15em;
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius);
    background: var(--brand-surface);
  }

  .card strong {
    font: var(--brand-weight-label) 1.06em / 1.35 var(--brand-font-heading);
  }

  .card :global(.glyph) {
    color: var(--brand-teal);
  }

  .alert {
    grid-column: 1;
  }

  .g3 {
    grid-column: 2;
  }

  .console {
    grid-column: 3;
  }

  /* An elbow from the bottom of the AWS panel, down and left into the Console card. */
  .ret {
    position: relative;
    grid-column: 4 / 6;
  }

  .ret::before {
    inset-block-start: 0;
    inset-inline-start: 0.3rem;
    inline-size: calc((100% + var(--gutter)) / 2 - 0.3rem);
    block-size: calc((100% + var(--loop-gap)) / 2);
    border-inline-end: 1.5px solid var(--line);
    border-block-end: 1.5px solid var(--line);
    border-end-end-radius: var(--brand-radius);
  }

  .ret::after {
    inset-block-start: calc((100% + var(--loop-gap)) / 2 - 0.25rem + 0.75px);
    inset-inline-start: 0;
    inline-size: 0.45rem;
    block-size: 0.5rem;
    background: var(--line);
    clip-path: polygon(100% 0, 0 50%, 100% 100%);
  }

  .ret .step {
    position: absolute;
    z-index: 1;
    inset-block-start: calc((100% + var(--loop-gap)) / 2);
    inset-inline-start: calc(var(--gutter) + (100% - var(--gutter)) / 4);
    translate: -50% -50%;
  }

  @media (prefers-reduced-motion: reduce) {
    .cell {
      transition: none;
    }
  }

  /*
   * Below 72 rem the three panels no longer fit side by side. They stack in reading order, and each step is one
   * arrow from panel to panel with its label on the line.
   */
  @media (max-width: 72rem) {
    .intro {
      grid-template: 'title' 'lead' 'start' / minmax(0, 40rem);
      row-gap: var(--brand-space-6);
    }

    .lead {
      margin-block-start: 0;
    }

    .flow {
      display: flex;
      flex-direction: column;
      max-inline-size: 40rem;
    }

    .panel {
      grid-template-rows: none;
    }

    .gutter,
    .ret,
    .g3 {
      display: grid;
      justify-items: center;
      margin-block-start: 0;
      background: none;
    }

    .gutter > :not(.step),
    .ret::before,
    .ret::after,
    .g3::before,
    .g3::after {
      display: none;
    }

    .ret .step {
      position: static;
      translate: none;
    }

    .step {
      justify-items: center;
    }

    .step::before,
    .step::after {
      content: '';
      inline-size: 0.6rem;
      background: var(--line);
    }

    .step::before {
      block-size: 0.75rem;
      clip-path: polygon(calc(50% - 0.75px) 0, calc(50% + 0.75px) 0, calc(50% + 0.75px) 100%, calc(50% - 0.75px) 100%);
    }

    .step::after {
      block-size: 1.1rem;
      clip-path: polygon(
        calc(50% - 0.75px) 0,
        calc(50% + 0.75px) 0,
        calc(50% + 0.75px) calc(100% - 0.35rem),
        100% calc(100% - 0.35rem),
        50% 100%,
        0 calc(100% - 0.35rem),
        calc(50% - 0.75px) calc(100% - 0.35rem)
      );
    }

    .card {
      margin-block-start: 0;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      padding-block-start: var(--brand-space-6);
    }

    .intro {
      row-gap: var(--brand-space-4);
    }

    .lead {
      font-size: var(--brand-type-base);
    }

    .docs {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
      row-gap: var(--brand-space-3);
    }

    .diagram {
      margin-block-start: var(--brand-space-7);
    }
  }
</style>
