---
import type { Glyph } from './flow';

type Props = { name: Glyph | 'file' | 'branch' | 'console' | 'bell' };

const { name } = Astro.props;
---

<svg class="glyph" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
  {
    name === 'cdn' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <ellipse cx="12" cy="12" rx="3.6" ry="8.5" />
        <path d="M3.5 12h17" />
      </>
    )
  }
  {
    name === 'bucket' && (
      <>
        <ellipse cx="12" cy="6.5" rx="7.5" ry="2.5" />
        <path d="M4.5 6.5l1.8 11.2c.2 1.3 2.7 2.3 5.7 2.3s5.5-1 5.7-2.3l1.8-11.2" />
      </>
    )
  }
  {
    name === 'container' && (
      <>
        <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z" />
        <path d="M4 7.5l8 4.5 8-4.5M12 12v9" />
      </>
    )
  }
  {
    name === 'database' && (
      <>
        <ellipse cx="12" cy="5.5" rx="7" ry="2.5" />
        <path d="M5 5.5v13c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-13M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5" />
      </>
    )
  }
  {
    name === 'queue' && (
      <>
        <rect x="2.5" y="7.5" width="5" height="9" rx="1" />
        <rect x="9.5" y="7.5" width="5" height="9" rx="1" />
        <rect x="16.5" y="7.5" width="5" height="9" rx="1" />
      </>
    )
  }
  {name === 'lambda' && <path d="M5 20.5l6.2-11M7.5 3.5h2.8l7.4 17h2.3" />}
  {name === 'cache' && <path d="M13.5 2.5L5 13.5h6.5l-1 8 8.5-11h-6.5z" />}
  {
    name === 'file' && (
      <>
        <path d="M6.5 2.5h7.5l4.5 4.5v14.5h-12z" />
        <path d="M14 2.5V7h4.5" />
      </>
    )
  }
  {
    name === 'branch' && (
      <>
        <circle cx="6.5" cy="5.5" r="2" />
        <circle cx="6.5" cy="18.5" r="2" />
        <circle cx="17.5" cy="7.5" r="2" />
        <path d="M6.5 7.5v9M17.5 9.5c0 4.5-11 3-11 7" />
      </>
    )
  }
  {
    name === 'console' && (
      <>
        <rect x="2.5" y="4" width="19" height="16" rx="2" />
        <path d="M2.5 8.5h19M6.5 16.5l3.5-3.5 3 2.5 4.5-4.5" />
      </>
    )
  }
  {
    name === 'bell' && (
      <>
        <path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.5 1.5h-15z" />
        <path d="M10 20.5a2 2 0 0 0 4 0" />
      </>
    )
  }
</svg>

<style>
  .glyph {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
