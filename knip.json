{
  "entry": ["scripts/agents/*.ts", "scripts/workspace/*.mjs"],
  "ignoreFiles": ["scripts/agents/*.ts", "scripts/workspace/*.mjs"],
  "workspaces": {
    "apps/cli": {
      "entry": [
        "src/api/cli/compiled-entry.ts",
        "src/api/cli/index.ts",
        "src/api/local/*.ts",
        "src/api/npm/ts/index.ts",
        "src/api/npm/bin/stacktape.js",
        "helper-lambdas/*/index.ts",
        "scripts/**/*.ts",
        "scripts/**/*.mjs",
        "tests/**/*.spec.ts",
        "**/*.spec.ts",
        "**/*.test.ts"
      ],
      "project": ["**/*.{ts,tsx,js}"],
      "ignore": ["@generated/**", "starter-projects/**", "_test-stacks/**", "__release-npm/**"]
    },
    "apps/docs": {
      "entry": ["src/**/*.astro"]
    },
    "apps/website": {
      "entry": ["src/**/*.astro"]
    },
    "apps/console/api": {
      "entry": ["src/**/*.ts"]
    },
    "apps/console/ui": {
      "entry": ["src/**/*.tsx"]
    },
    "packages/*": {
      "entry": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"]
    }
  }
}
